{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ash-dotfiles.dev/schemas/metadata.json",
  "title": "ASH Theme Metadata",
  "type": "object",
  "required": [
    "name",
    "slug"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "variant": {
      "type": "string",
      "enum": [
        "dark",
        "light"
      ]
    },
    "family": {
      "type": "string"
    },
    "seed": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "hue": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": true
}