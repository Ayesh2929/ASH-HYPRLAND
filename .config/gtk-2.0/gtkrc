# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.0 — GTK 2.0 CONFIGURATION                        ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

# GTK 2.0 Theme Settings
gtk-theme-name         = "Catppuccin-Mocha-Standard-Mauve-Dark"
gtk-icon-theme-name    = "Papirus-Dark"
gtk-cursor-theme-name  = "Bibata-Modern-Ice"
gtk-cursor-theme-size  = 24
gtk-font-name          = "JetBrains Mono 11"

# Interface
gtk-button-images      = 0
gtk-menu-images        = 0
gtk-toolbar-style      = 0
gtk-xft-antialias      = 1
gtk-xft-hinting        = 1
gtk-xft-hintstyle      = "hintfull"
gtk-xft-rgba           = "rgb"

# Enable application-prefer-dark-theme
gtk-application-prefer-dark-theme = 1

# Color scheme (Catppuccin Mocha approximation)
style "default" {
    bg[NORMAL]       = "#1e1e2e"
    bg[PRELIGHT]     = "#313244"
    bg[SELECTED]     = "#cba6f7"
    bg[INSENSITIVE]  = "#181825"
    bg[ACTIVE]       = "#313244"

    fg[NORMAL]       = "#cdd6f4"
    fg[PRELIGHT]     = "#cdd6f4"
    fg[SELECTED]     = "#1e1e2e"
    fg[INSENSITIVE]  = "#7f849c"
    fg[ACTIVE]       = "#cdd6f4"

    base[NORMAL]     = "#1e1e2e"
    base[PRELIGHT]   = "#313244"
    base[SELECTED]   = "#cba6f7"
    base[INSENSITIVE] = "#181825"
    base[ACTIVE]     = "#313244"

    text[NORMAL]     = "#cdd6f4"
    text[PRELIGHT]   = "#cdd6f4"
    text[SELECTED]   = "#1e1e2e"
    text[INSENSITIVE] = "#7f849c"
    text[ACTIVE]     = "#cdd6f4"
}

class "*" style "default"