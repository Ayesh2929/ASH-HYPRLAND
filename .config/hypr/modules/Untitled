bindel = , XF86AudioRaiseVolume, exec, ~/.config/hypr/scripts/volume.sh up 3
bindel = , XF86AudioLowerVolume, exec, ~/.config/hypr/scripts/volume.sh down 3
bindl = , XF86AudioMute, exec, ~/.config/hypr/scripts/volume.sh toggle-mute
bindl = , XF86AudioMicMute, exec, ~/.config/hypr/scripts/volume.sh toggle-mic
bindel = , XF86MonBrightnessUp, exec, ~/.config/hypr/scripts/brightness.sh up 5
bindel = , XF86MonBrightnessDown,exec, ~/.config/hypr/scripts/brightness.sh down 5
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPause, exec, playerctl pause
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPrev, exec, playerctl previous
bindl = , XF86AudioStop, exec, playerctl stop
bind = , XF86Display, exec, ~/.config/hypr/scripts/monitor-layout.sh pick
bind = , XF86TouchpadToggle, exec, ~/.config/hypr/scripts/touchpad.sh toggle
bind = , XF86WLAN, exec, ~/.config/hypr/scripts/wifi-toggle.sh
bind = , XF86Bluetooth, exec, ~/.config/hypr/scripts/bluetooth-toggle.sh
bind = , XF86Calculator, exec, qalculate-gtk
bind = , XF86Explorer, exec, thunar
bind = , XF86Sleep, exec, systemctl suspend
bind = , XF86PowerOff, exec, ~/.config/rofi/scripts/powermenu.s