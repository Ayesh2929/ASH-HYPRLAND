// ╔═══════════════════════════════════════════════════════════════════════════════╗
// ║           ASH DOTFILES v3.0 — WAYBAR BOTTOM BAR (OPTIONAL)                 ║
// ║           Secondary status bar with media, tasks, and quick actions        ║
// ╚═══════════════════════════════════════════════════════════════════════════════╝

{
    "name":          "bottom-bar",
    "layer":         "top",
    "position":      "bottom",
    "height":        32,
    "margin-top":    0,
    "margin-left":   12,
    "margin-right":  12,
    "margin-bottom": 6,
    "spacing":       4,
    "exclusive":     true,
    "passthrough":   false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/player-full",
        "custom/separator",
        "mpris"
    ],

    "modules-center": [
        "wlr/taskbar"
    ],

    "modules-right": [
        "custom/vpn",
        "custom/separator",
        "custom/disk",
        "custom/separator",
        "custom/cpu-temp",
        "custom/separator",
        "custom/session-restore",
        "custom/separator",
        "custom/ash-version"
    ],

    // ══════════════════════════════════════════════════════════════════════════
    // 🎵 MPRIS PLAYER (built-in)
    // ══════════════════════════════════════════════════════════════════════════
    "mpris": {
        "format":               "{player_icon}  {title}",
        "format-paused":        "{player_icon}  <i>{title}</i>",
        "player-icons": {
            "default":          "⏵",
            "mpv":              "🎬",
            "spotify":          "🎵",
            "firefox":          "🌐",
            "chromium":         "🌐",
            "vlc":              "🎬"
        },
        "status-icons": {
            "Playing":          "▶",
            "Paused":           "⏸",
            "Stopped":          "⏹"
        },
        "max-length":           40,
        "on-click":             "playerctl play-pause",
        "on-click-right":       "playerctl next",
        "on-scroll-up":         "playerctl next",
        "on-scroll-down":       "playerctl previous",
        "tooltip":              true,
        "tooltip-format":       "Player: {player}\n{status}: {title}\nArtist: {artist}\nAlbum: {album}"
    },

    // ══════════════════════════════════════════════════════════════════════════
    // 🎵 CUSTOM PLAYER (full info)
    // ══════════════════════════════════════════════════════════════════════════
    "custom/player-full": {
        "exec":        "~/.config/waybar/scripts/media/player.sh status",
        "interval":    2,
        "return-type": "json",
        "format":      "{}",
        "on-click":    "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "max-length":  50
    },

    // ══════════════════════════════════════════════════════════════════════════
    // 🗂️ TASKBAR
    // ══════════════════════════════════════════════════════════════════════════
    "wlr/taskbar": {
        "format":               "{icon}",
        "icon-size":            18,
        "icon-theme":           "Papirus-Dark",
        "tooltip-format":       "{title}",
        "on-click":             "activate",
        "on-click-middle":      "close",
        "on-click-right":       "fullscreen",
        "ignore-list":          ["Alacritty"],
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        },
        "rewrite": {
            "Firefox Web Browser": "Firefox",
            "Foot Server":         "Foot"
        }
    },

    // ══════════════════════════════════════════════════════════════════════════
    // 🔒 VPN STATUS
    // ══════════════════════════════════════════════════════════════════════════
    "custom/vpn": {
        "exec":        "~/.config/waybar/scripts/system/vpn.sh status",
        "interval":    15,
        "return-type": "json",
        "format":      "{}",
        "on-click":    "~/.config/hypr/scripts/network/network-toggle.sh",
        "tooltip":     true
    },

    // ══════════════════════════════════════════════════════════════════════════
    // 💾 DISK USAGE
    // ══════════════════════════════════════════════════════════════════════════
    "custom/disk": {
        "exec":        "~/.config/waybar/scripts/hardware/disk.sh status /",
        "interval":    30,
        "return-type": "json",
        "format":      "{}",
        "on-click":    "kitty --class=btop -e btop",
        "tooltip":     true
    },

    // ══════════════════════════════════════════════════════════════════════════
    // 🌡️ CPU TEMPERATURE
    // ══════════════════════════════════════════════════════════════════════════
    "custom/cpu-temp": {
        "exec":        "~/.config/waybar/scripts/hardware/cpu-temp.sh status",
        "interval":    5,
        "return-type": "json",
        "format":      "{}",
        "on-click":    "kitty --class=btop -e btop",
        "tooltip":     true
    },

    // ══════════════════════════════════════════════════════════════════════════
    // 🔄 SESSION RESTORE
    // ══════════════════════════════════════════════════════════════════════════
    "custom/session-restore": {
        "exec":        "~/.config/hypr/scripts/system/session-restore.sh status",
        "interval":    30,
        "return-type": "json",
        "format":      "{}",
        "on-click":    "~/.config/hypr/scripts/system/session-restore.sh restore",
        "on-click-right": "~/.config/hypr/scripts/system/session-restore.sh save",
        "tooltip":     true
    },

    // ══════════════════════════════════════════════════════════════════════════
    // ℹ️ ASH VERSION
    // ══════════════════════════════════════════════════════════════════════════
    "custom/ash-version": {
        "exec":        "echo '{\"text\": \" ASH v3.0\", \"tooltip\": \"ASH Dotfiles v3.0.0\\nHyprland Desktop\\nClick for help\"}'",
        "interval":    "once",
        "return-type": "json",
        "format":      "{}",
        "on-click":    "kitty -e ash help",
        "on-click-right": "ash doctor"
    },

    // ── Separator ─────────────────────────────────────────────────────────────
    "custom/separator": {
        "format":  "|",
        "tooltip": false
    }
}