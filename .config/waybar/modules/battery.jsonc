// ╔═══════════════════════════════════════════════════════════════════════════════╗
// ║           ASH DOTFILES v3.0 — WAYBAR BATTERY MODULE CONFIG                 ║
// ╚═══════════════════════════════════════════════════════════════════════════════╝
{
    "battery": {
        "interval":         30,
        "states": {
            "full":         100,
            "good":         80,
            "warning":      30,
            "critical":     15
        },
        "format":           "{icon}  {capacity}%",
        "format-charging":  "󰂄  {capacity}%",
        "format-plugged":   "󰚥  {capacity}%",
        "format-full":      "󰁹  Full",
        "format-alt":       "{icon}  {time}",
        "format-icons":     ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
        "tooltip-format":   "Battery: {capacity}%\nStatus: {timeTo}\nPower: {power}W",
        "tooltip-format-charging": "Charging: {capacity}%\nTime to full: {timeTo}\nPower: {power}W",
        "on-click":         "~/.config/hypr/scripts/system/power-profile.sh picker"
    }
}