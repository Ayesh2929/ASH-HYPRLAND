// ╔═══════════════════════════════════════════════════════════════════════════════╗
// ║           ASH DOTFILES v3.0 — WAYBAR NETWORK MODULE CONFIG                 ║
// ╚═══════════════════════════════════════════════════════════════════════════════╝
{
    "network": {
        "interval":              5,
        "format-wifi":           "  {essid} {signalStrength}%",
        "format-ethernet":       "󰈀  {ipaddr}",
        "format-linked":         "󰈀  {ifname} (No IP)",
        "format-disconnected":   "󰖪  Offline",
        "format-alt":            "  {ifname}: {ipaddr}/{cidr}",
        "tooltip-format-wifi":   "SSID: {essid}\nSignal: {signalStrength}%\nFrequency: {frequency}GHz\nIP: {ipaddr}\nGateway: {gwaddr}\n↑ {bandwidthUpBits}  ↓ {bandwidthDownBits}",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}\n↑ {bandwidthUpBits}  ↓ {bandwidthDownBits}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click":              "~/.config/hypr/scripts/network/wifi-toggle.sh connect",
        "on-click-right":        "nm-connection-editor",
        "on-click-middle":       "~/.config/hypr/scripts/network/wifi-toggle.sh toggle",
        "max-length":            30
    }
}