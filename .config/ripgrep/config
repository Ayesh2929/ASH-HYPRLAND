# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.0 — RIPGREP CONFIGURATION                        ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

# Smart case (case insensitive unless uppercase in query)
--smart-case

# Show line numbers
--line-number

# Show column numbers for matches
--column

# Colorize output
--color=always

# Pretty output (group by file, add headings)
--pretty

# Follow symlinks
--follow

# Search hidden files by default
--hidden

# Global ignore patterns
--glob=!.git
--glob=!.hg
--glob=!.svn
--glob=!node_modules
--glob=!__pycache__
--glob=!.mypy_cache
--glob=!target
--glob=!dist
--glob=!build
--glob=!.cache
--glob=!*.lock
--glob=!*.min.js
--glob=!*.min.css

# Max file size (skip files > 10MB)
--max-filesize=10M

# Context lines
--context=2

# Max depth
--max-depth=10

# Encoding
--encoding=auto

# Sort by path
--sort=path