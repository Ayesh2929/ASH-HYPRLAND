# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.0 — BTOP ASH DARK THEME                         ║
# ║           Catppuccin Mocha-inspired theme for btop++                       ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

# Main background, empty for terminal default
theme[main_bg]="#1e1e2e"

# Main text color
theme[main_fg]="#cdd6f4"

# Title color for boxes
theme[title]="#cba6f7"

# Highlight and selected text color
theme[hi_fg]="#89b4fa"

# Background color of selected item in processes box
theme[selected_bg]="#313244"

# Foreground color of selected item in processes box
theme[selected_fg]="#cdd6f4"

# Color of inactive/disabled text
theme[inactive_fg]="#7f849c"

# Color of text appearing on top of graphs
# 0 = auto, 1 = black, 2 = white
theme[graph_text]="#a6adc8"

# Main box outline color
theme[meter_bg]="#313244"

# Gradient colors for process cpu and memory bars
# Only 2 colors needed, more is more
theme[proc_misc]="#94e2d5"

# CPU box color gradients
theme[cpu_start]="#a6e3a1"
theme[cpu_mid]="#f9e2af"
theme[cpu_end]="#f38ba8"

# Memory/disks color gradients
theme[free_start]="#94e2d5"
theme[free_mid]="#89b4fa"
theme[free_end]="#cba6f7"

theme[cached_start]="#a6e3a1"
theme[cached_mid]="#94e2d5"
theme[cached_end]="#89b4fa"

theme[available_start]="#cba6f7"
theme[available_mid]="#89b4fa"
theme[available_end]="#94e2d5"

theme[used_start]="#f9e2af"
theme[used_mid]="#fab387"
theme[used_end]="#f38ba8"

# Download color gradient
theme[download_start]="#89b4fa"
theme[download_mid]="#94e2d5"
theme[download_end]="#a6e3a1"

# Upload color gradient
theme[upload_start]="#cba6f7"
theme[upload_mid]="#f38ba8"
theme[upload_end]="#fab387"

# Process box gradient from most to least used
theme[process_start]="#f38ba8"
theme[process_mid]="#f9e2af"
theme[process_end]="#a6e3a1"