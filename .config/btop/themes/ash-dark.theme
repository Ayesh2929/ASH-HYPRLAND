# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.0 — BTOP ASH-DARK THEME                          ║
# ║           Catppuccin Mocha inspired dark theme for btop                    ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

# Main background, empty or #color
theme[main_bg]="#1e1e2e"

# Main text color
theme[main_fg]="#cdd6f4"

# Title color for boxes
theme[title]="#cba6f7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#89b4fa"

# Background color of selected item in processes box
theme[selected_bg]="#313244"

# Foreground color of selected item in processes box
theme[selected_fg]="#cdd6f4"

# Color of inactive/disabled text
theme[inactive_fg]="#6c7086"

# Color of text appearing on top of graphs, i.e uptime and current network speed
theme[graph_text]="#a6adc8"

# Background color of the "box" shown in mobile mode
theme[meter_bg]="#313244"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#94e2d5"

# Cpu box outline color
theme[cpu_box]="#cba6f7"

# Memory/disks box outline color
theme[mem_box]="#89b4fa"

# Net up/down box outline color
theme[net_box]="#a6e3a1"

# Processes box outline color
theme[proc_box]="#fab387"

# Box divider line and small boxes line color
theme[div_line]="#45475a"

# Temperature graph colors for temperatures ≤50, ≤60, ≤70, ≤80, ≤90 and >90
theme[temp_start]="#a6e3a1"
theme[temp_0_5]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_0_8]="#fab387"
theme[temp_end]="#f38ba8"
theme[temp_over]="#f38ba8"

# CPU graph colors for cpu usage from ≤1%, 10%, 25%, 50%, 75%, 90% and ≥100%
theme[cpu_start]="#a6e3a1"
theme[cpu_mid]="#f9e2af"
theme[cpu_end]="#f38ba8"

# Mem/Disk graph colors from empty to full
theme[free_start]="#a6e3a1"
theme[free_mid]="#89b4fa"
theme[free_end]="#cba6f7"

# Download speed graph colors from 0 speed to max speed
theme[download_start]="#89b4fa"
theme[download_mid]="#94e2d5"
theme[download_end]="#a6e3a1"

# Upload speed graph colors from 0 speed to max speed
theme[upload_start]="#cba6f7"
theme[upload_mid]="#f9e2af"
theme[upload_end]="#fab387"

# Process box color gradient for threads, memory, and cpu usage from 0 to 100%
theme[process_start]="#89b4fa"
theme[process_mid]="#cba6f7"
theme[process_end]="#f38ba8"