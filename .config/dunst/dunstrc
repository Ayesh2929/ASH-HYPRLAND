# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.0 — DUNST NOTIFICATION DAEMON                    ║
# ║           Beautiful notifications with dynamic colors                      ║
# ║           Colors auto-generated by theme-engine.sh                        ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

[global]
    # ══════════════════════════════════════════════════════════════════════════
    # 🖥️ DISPLAY
    # ══════════════════════════════════════════════════════════════════════════

    # Monitor to display notifications on
    monitor         = 0

    # Follow mouse or keyboard focus
    follow          = mouse

    # Notification area dimensions
    # width can be:
    #   N     = fixed width
    #   (N,M) = min-max range (dynamic)
    width           = (300, 500)
    height          = (0, 400)

    # Position on screen
    # Values: top-left, top-center, top-right
    #         bottom-left, bottom-center, bottom-right
    #         left-center, center, right-center
    origin          = top-right

    # Offset from screen edge (x, y)
    offset          = 16 52

    # Scale for HiDPI (0 = auto-detect)
    scale           = 0

    # Maximum number of notifications on screen
    notification_limit = 5

    # ══════════════════════════════════════════════════════════════════════════
    # 🎨 APPEARANCE
    # ══════════════════════════════════════════════════════════════════════════

    # Background transparency (0-100, 0=opaque)
    transparency    = 8

    # Gap between notifications
    gap_size        = 8

    # Padding inside notifications
    padding         = 14
    horizontal_padding = 16

    # Icon-text padding
    text_icon_padding = 10

    # Border around the whole notification window
    frame_width     = 2
    frame_color     = #cba6f7

    # Corner radius
    corner_radius   = 12

    # Icon corner radius
    icon_corner_radius = 6

    # ══════════════════════════════════════════════════════════════════════════
    # 📝 TEXT & FONTS
    # ══════════════════════════════════════════════════════════════════════════

    font            = JetBrainsMono Nerd Font 11

    # Line height (padding between lines of text)
    line_height     = 0

    # Markup support (html-like tags)
    # none = no markup
    # strip = remove markup tags
    # full = render all markup
    markup          = full

    # Format string for notifications
    # Available: %a (app name), %s (summary), %b (body), %i (icon path),
    #            %I (icon name), %p (progress), %n (progress bar), %% (literal %)
    format          = "<b>%s</b>\n%b"

    # Alignment of message text
    alignment       = left
    vertical_alignment = center

    # Show age of message when message is older than show_age_threshold
    show_age_threshold = 90

    # Ellipsize long lines (start, middle, end)
    ellipsize       = middle

    # Ignore newlines in notification body
    ignore_newline  = no

    # Merge multiple notifications with same content
    stack_duplicates    = true
    hide_duplicate_count = false

    # Show how many messages are hidden
    show_indicators = yes

    # ══════════════════════════════════════════════════════════════════════════
    # 🖼️ ICONS
    # ══════════════════════════════════════════════════════════════════════════

    # Icon theme(s) to use
    icon_theme      = Papirus-Dark,Papirus,hicolor

    # Enable recursive icon lookup
    enable_recursive_icon_lookup = true

    # Icon position (left, right, off, top)
    icon_position   = left

    # Icon size limits
    min_icon_size   = 32
    max_icon_size   = 64

    # ══════════════════════════════════════════════════════════════════════════
    # ⏱️ TIMEOUTS
    # ══════════════════════════════════════════════════════════════════════════

    # Default timeout (ms) — overridden per urgency
    # -1 = never expire
    timeout         = 8000

    # ══════════════════════════════════════════════════════════════════════════
    # 📜 HISTORY
    # ══════════════════════════════════════════════════════════════════════════

    # Keep history of dismissed notifications
    sticky_history  = yes
    history_length  = 50

    # ══════════════════════════════════════════════════════════════════════════
    # 🔔 MISC
    # ══════════════════════════════════════════════════════════════════════════

    # Always run script rule even if other rule disables notification
    always_run_script = true

    # Title and class for Dunst windows
    title           = Dunst
    class           = Dunst

    # Ignore DBUS close signal
    ignore_dbusclose = false

    # Force X11 (instead of Wayland)
    force_xwayland  = false

    # Force legacy Xinerama (Wayland)
    force_xinerama  = false

    # Sort notifications (urgent > normal > low)
    sort            = yes

    # ══════════════════════════════════════════════════════════════════════════
    # 🖱️ MOUSE ACTIONS
    # ══════════════════════════════════════════════════════════════════════════

    # Left click
    mouse_left_click    = close_current

    # Middle click (do_action = run action, close_current)
    mouse_middle_click  = do_action, close_current

    # Right click
    mouse_right_click   = close_all

    # Double left click (invoke default action)
    # mouse_left_click  = do_action

    # ══════════════════════════════════════════════════════════════════════════
    # ⌨️ KEYBOARD SHORTCUTS
    # ══════════════════════════════════════════════════════════════════════════

    close           = ctrl+space
    close_all       = ctrl+shift+space
    history         = ctrl+grave
    context         = ctrl+shift+period

    # ══════════════════════════════════════════════════════════════════════════
    # 📦 PROGRESS BAR
    # ══════════════════════════════════════════════════════════════════════════

    # Show progress bar
    progress_bar    = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4

    # ══════════════════════════════════════════════════════════════════════════
    # 🎨 WAYLAND
    # ══════════════════════════════════════════════════════════════════════════

    # Layer to render on (background, bottom, top, overlay)
    layer           = top

    # ══════════════════════════════════════════════════════════════════════════
    # 🎬 ANIMATIONS (Dunst 1.9+)
    # ══════════════════════════════════════════════════════════════════════════

    # Animation enable/disable
    # enable_recursive_icon_lookup = true

# ══════════════════════════════════════════════════════════════════════════════
# 🔴 URGENCY: LOW
# ══════════════════════════════════════════════════════════════════════════════

[urgency_low]
    background      = "#313244ee"
    foreground      = "#a6adc8"
    frame_color     = "#45475a"
    timeout         = 6000
    default_icon    = dialog-information
    format          = "<i>%s</i>\n%b"
    icon_position   = left

# ══════════════════════════════════════════════════════════════════════════════
# 🟡 URGENCY: NORMAL
# ══════════════════════════════════════════════════════════════════════════════

[urgency_normal]
    background      = "#313244ee"
    foreground      = "#cdd6f4"
    frame_color     = "#cba6f7"
    timeout         = 8000
    default_icon    = dialog-information
    icon_position   = left

# ══════════════════════════════════════════════════════════════════════════════
# 🔴 URGENCY: CRITICAL
# ══════════════════════════════════════════════════════════════════════════════

[urgency_critical]
    background      = "#f38ba822"
    foreground      = "#cdd6f4"
    frame_color     = "#f38ba8"
    timeout         = 0
    default_icon    = dialog-error
    icon_position   = left

# ══════════════════════════════════════════════════════════════════════════════
# 🎯 APP-SPECIFIC RULES
# ══════════════════════════════════════════════════════════════════════════════

# ASH Theme Engine
[ash-theme]
    appname         = "ASH Theme Engine"
    background      = "#1e1e2eee"
    foreground      = "#cba6f7"
    frame_color     = "#cba6f7"
    timeout         = 3000

# ASH Volume notifications
[ash-volume]
    appname         = "Volume"
    timeout         = 1500
    format          = "%s\n%b"

# ASH Brightness notifications
[ash-brightness]
    appname         = "Brightness"
    timeout         = 1200

# Screenshot notifications
[ash-screenshot]
    appname         = "ASH Screenshot"
    timeout         = 5000
    background      = "#313244ee"
    foreground      = "#a6e3a1"
    frame_color     = "#a6e3a1"

# Recording active
[ash-recorder-active]
    appname         = "ASH Recorder"
    summary         = "*Recording*"
    background      = "#f38ba822"
    frame_color     = "#f38ba8"
    foreground      = "#f38ba8"
    timeout         = 0

# Network notifications
[ash-network]
    appname         = "ASH Network"
    timeout         = 3000
    background      = "#313244ee"
    foreground      = "#89b4fa"
    frame_color     = "#89b4fa"

# Battery critical
[battery-critical]
    appname         = "ASH Battery"
    urgency         = critical
    summary         = "*CRITICAL*"
    background      = "#f38ba822"
    frame_color     = "#f38ba8"
    foreground      = "#f38ba8"
    timeout         = 0

# Spotify
[spotify]
    appname         = "Spotify"
    background      = "#1db954aa"
    frame_color     = "#1db954"
    foreground      = "#ffffff"
    timeout         = 3000

# Discord
[discord]
    appname         = "discord"
    timeout         = 5000

# System notifications (from notify-send)
[system-notify]
    appname         = "notify-send"
    timeout         = 5000