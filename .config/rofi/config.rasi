/* ╔═══════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v3.0 — ROFI GLOBAL CONFIGURATION                         ║
   ╚═══════════════════════════════════════════════════════════════════════════╝ */

configuration {
    /* ── Modi / Modes ──────────────────────────────────────────────────────── */
    modi:                       "drun,run,window,ssh";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-drun:               "  Apps";
    display-run:                "  Run";
    display-window:             "🪟  Windows";
    display-ssh:                "  SSH";

    /* ── Behavior ──────────────────────────────────────────────────────────── */
    matching:                   "fuzzy";
    sort:                       true;
    sorting-method:             "fzf";
    case-sensitive:             false;
    cycle:                      true;
    normalize-match:            true;

    /* ── drun settings ─────────────────────────────────────────────────────── */
    drun-display-format:        "{name}";
    drun-match-fields:          "name,generic,comment,categories,exec";
    drun-show-actions:          false;

    /* ── Terminal ──────────────────────────────────────────────────────────── */
    terminal:                   "kitty";

    /* ── Keyboard ──────────────────────────────────────────────────────────── */
    kb-cancel:                  "Escape,Super_L";
    kb-accept-entry:            "Return,KP_Enter";
    kb-row-up:                  "Up,Control+k";
    kb-row-down:                "Down,Control+j";
    kb-page-prev:               "Page_Up";
    kb-page-next:               "Page_Down";
    kb-mode-previous:           "Shift+Left";
    kb-mode-next:               "Shift+Right,Control+Tab";
    kb-entry-history-up:        "Control+p";
    kb-entry-history-down:      "Control+n";

    /* ── History ───────────────────────────────────────────────────────────── */
    disable-history:            false;
    max-history-size:           25;

    /* ── Misc ──────────────────────────────────────────────────────────────── */
    show-match:                 true;
    no-lazy-grab:               false;
    parse-hosts:                false;
    parse-known-hosts:          true;
}

/* Import dynamic theme (generated by theme-engine.sh) */
@import "themes/ash-dynamic.rasi"