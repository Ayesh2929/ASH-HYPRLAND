# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.0 — KVANTUM THEME CONFIGURATION                  ║
# ║           Elegant dark Qt5/Qt6 theme                                       ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

[%General]
author              = ASH Dotfiles
comment             = ASH Dynamic Dark Theme
x11drag             = true
alt_mnemonic        = true
left_tabs           = true
attach_active_tab   = false
mirror_doc_tabs     = true
group_toolbar_buttons = false
toolbar_item_spacing = 0
toolbar_interior_spacing = 2
spread_progressbar  = true
progressbar_animation = true
composite           = true
menu_shadow_depth   = 6
tooltip_shadow_depth = 6
splitter_width      = 6
scroll_width        = 8
scroll_min_extent   = 36
slider_width        = 4
slider_handle_width = 16
slider_handle_length = 16
center_toolbar_handle = true
check_size          = 14
tree_branch_line    = false
groupbox_top_label  = false
inline_spin_indicators = false
vertical_spin_indicators = false
fill_rubberband     = false
menubar_mouse_tracking = true
merge_menubar_with_toolbar = false
small_icon_size     = 16
large_icon_size     = 32
button_icon_size    = 16
toolbar_icon_size   = 22
animate_states      = true
button_css_border   = true
combo_as_lineedit   = false
combo_menu          = true
dark_titlebar       = true
popup_blurring      = true
reduce_window_opacity = false
reduce_menu_opacity = 0
blurring            = true
translucent_windows = true
menu_blur_devider   = 0
tooltip_blurring    = true

[GeneralColors]
window.color        = #1e1e2e
base.color          = #313244
alt.base.color      = #181825
button.color        = #45475a
light.color         = #585b70
mid.light.color     = #6c7086
dark.color          = #11111b
mid.color           = #181825
highlight.color     = #cba6f7
inactive.highlight.color = #89b4fa
tooltip.base.color  = #313244
text.color          = #cdd6f4
window.text.color   = #cdd6f4
button.text.color   = #cdd6f4
disabled.text.color = #7f849c
tooltip.text.color  = #cdd6f4
highlight.text.color = #1e1e2e
link.color          = #89b4fa
link.visited.color  = #cba6f7

[Hacks]
transparent_dolphin_view = true
blur_konsole        = true
transparent_ktitle_label = true
transparent_menutitle = true
respect_darkness    = true
kcapacitybar_color  = true
force_size_grip     = false
iconless_pushbutton = false
iconless_menu       = false
single_top_toolbar  = false
tiled_menu_bar      = false
no_submenu_arrow    = false
centered_forms      = false
middle_click_scroll = false
opaque_colors       = false
no_window_pattern   = true