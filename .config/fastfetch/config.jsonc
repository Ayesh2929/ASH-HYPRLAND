// ╔═══════════════════════════════════════════════════════════════════════════════╗
// ║           ASH DOTFILES v3.0 — FASTFETCH CONFIGURATION                      ║
// ║           System info display with ASH branding                            ║
// ╚═══════════════════════════════════════════════════════════════════════════════╝

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "~/.config/fastfetch/logo.txt",
        "color": {
            "1": "magenta",
            "2": "blue",
            "3": "cyan"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        }
    },

    "display": {
        "separator":     "  ",
        "color":         "magenta",
        "brightColor":   true,
        "size": {
            "ndigits": 2,
            "maxPrefix": "giga"
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "╭──────────────────────────────────────────╮"
        },
        {
            "type": "title",
            "format": "│  \u001b[1;35m{user-name}\u001b[0m @ \u001b[1;34m{host-name}\u001b[0m  │"
        },
        {
            "type": "custom",
            "format": "├──────────────────────────────────────────┤"
        },
        {
            "type": "os",
            "key": "│  \u001b[1;35m OS",
            "keyWidth": 14,
            "format": "{pretty-name} {version}"
        },
        {
            "type": "kernel",
            "key": "│  \u001b[1;34m Kernel",
            "keyWidth": 14,
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "│  \u001b[1;36m Uptime",
            "keyWidth": 14,
            "format": "{days}d {hours}h {minutes}m"
        },
        {
            "type": "shell",
            "key": "│   Shell",
            "keyWidth": 14,
            "format": "{name} {version}"
        },
        {
            "type": "display",
            "key": "│  \u001b[1;35m Display",
            "keyWidth": 14,
            "format": "{width}x{height} @ {refresh-rate}Hz"
        },
        {
            "type": "wm",
            "key": "│  \u001b[1;34m WM",
            "keyWidth": 14,
            "format": "{name} {version}"
        },
        {
            "type": "wmtheme",
            "key": "│  \u001b[1;36m WM Theme",
            "keyWidth": 14
        },
        {
            "type": "theme",
            "key": "│  \u001b[1;35m GTK Theme",
            "keyWidth": 14
        },
        {
            "type": "icons",
            "key": "│  \u001b[1;34m Icons",
            "keyWidth": 14
        },
        {
            "type": "cursor",
            "key": "│   Cursor",
            "keyWidth": 14
        },
        {
            "type": "font",
            "key": "│   Font",
            "keyWidth": 14,
            "format": "{name} {size}pt"
        },
        {
            "type": "terminal",
            "key": "│  \u001b[1;35m Terminal",
            "keyWidth": 14,
            "format": "{name} {version}"
        },
        {
            "type": "terminalfont",
            "key": "│   Term Font",
            "keyWidth": 14
        },
        {
            "type": "custom",
            "format": "├──────────────────────────────────────────┤"
        },
        {
            "type": "cpu",
            "key": "│  \u001b[1;34m CPU",
            "keyWidth": 14,
            "format": "{name} ({cores-physical}C/{cores-logical}T)"
        },
        {
            "type": "gpu",
            "key": "│  \u001b[1;35m GPU",
            "keyWidth": 14,
            "format": "{name}",
            "hideType": "integrated"
        },
        {
            "type": "memory",
            "key": "│  \u001b[1;36m RAM",
            "keyWidth": 14,
            "format": "{used} / {total} ({percentage}%)"
        },
        {
            "type": "disk",
            "key": "│  \u001b[1;34m Disk",
            "keyWidth": 14,
            "format": "{used} / {total} ({percentage}%)",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": "│  \u001b[1;35m Battery",
            "keyWidth": 14,
            "format": "{capacity}% [{status}]"
        },
        {
            "type": "custom",
            "format": "├──────────────────────────────────────────┤"
        },
        {
            "type": "packages",
            "key": "│  \u001b[1;35m Packages",
            "keyWidth": 14,
            "format": "{count} (pacman), {all} total"
        },
        {
            "type": "locale",
            "key": "│   Locale",
            "keyWidth": 14
        },
        {
            "type": "custom",
            "format": "╰──────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 4
        }
    ]
}