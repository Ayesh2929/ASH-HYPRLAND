// ╔═══════════════════════════════════════════════════════════════════════════════╗
// ║           ASH DOTFILES v3.0 — FASTFETCH SYSTEM INFO CONFIGURATION          ║
// ║           Beautiful system information display                             ║
// ╚═══════════════════════════════════════════════════════════════════════════════╝
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "~/.config/fastfetch/logo.txt",
        "color": {
            "1": "35",
            "2": "33"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys":   "35",
            "title":  "35",
            "output": "37"
        },
        "keyWidth": 14
    },

    "modules": [
        {
            "type": "title",
            "format": "{6}@{7}",
            "color": {
                "user": "35",
                "at": "37",
                "host": "33"
            }
        },
        "separator",
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "35",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "kernel",
            "key": "  Kernel",
            "keyColor": "35",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": " 󰔟 Uptime",
            "keyColor": "35"
        },
        {
            "type": "packages",
            "key": " 󰏗 Packages",
            "keyColor": "35"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "keyColor": "35",
            "format": "{name} {version}"
        },
        {
            "type": "display",
            "key": " 󰍹 Display",
            "keyColor": "35",
            "format": "{width}x{height} @ {refresh-rate}Hz"
        },
        {
            "type": "de",
            "key": "  Desktop",
            "keyColor": "35"
        },
        {
            "type": "wm",
            "key": "  WM",
            "keyColor": "35",
            "format": "{name} ({type})"
        },
        {
            "type": "wmtheme",
            "key": "  WM Theme",
            "keyColor": "35"
        },
        {
            "type": "theme",
            "key": "  Theme",
            "keyColor": "35"
        },
        {
            "type": "icons",
            "key": "  Icons",
            "keyColor": "35"
        },
        {
            "type": "font",
            "key": "  Font",
            "keyColor": "35",
            "format": "{name} {size}"
        },
        {
            "type": "cursor",
            "key": " 󰳽 Cursor",
            "keyColor": "35",
            "format": "{name} ({size}px)"
        },
        {
            "type": "terminal",
            "key": "  Terminal",
            "keyColor": "35"
        },
        {
            "type": "terminalfont",
            "key": "  Term Font",
            "keyColor": "35"
        },
        "separator",
        {
            "type": "cpu",
            "key": "  CPU",
            "keyColor": "35",
            "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}GHz"
        },
        {
            "type": "gpu",
            "key": " 󰾲 GPU",
            "keyColor": "35",
            "format": "{name} [{memory}]",
            "detectionMethod": "pci"
        },
        {
            "type": "memory",
            "key": " 󰍛 Memory",
            "keyColor": "35",
            "format": "{used} / {total} ({percentage}%)"
        },
        {
            "type": "swap",
            "key": " 󰾵 Swap",
            "keyColor": "35",
            "format": "{used} / {total} ({percentage}%)"
        },
        {
            "type": "disk",
            "key": " 󰋊 Disk",
            "keyColor": "35",
            "format": "{used} / {total} ({percentage}%) — {filesystem}",
            "folders": "/"
        },
        {
            "type": "localip",
            "key": " 󰈀 Local IP",
            "keyColor": "35",
            "showIPv6": false,
            "defaultRouteOnly": true,
            "compact": true
        },
        {
            "type": "battery",
            "key": " 󰁹 Battery",
            "keyColor": "35",
            "format": "{capacity}% [{status}]"
        },
        {
            "type": "poweradapter",
            "key": " 󰚥 Power",
            "keyColor": "35"
        },
        {
            "type": "player",
            "key": "  Music",
            "keyColor": "35",
            "format": "{artist} — {title} [{status}]"
        },
        "separator",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}