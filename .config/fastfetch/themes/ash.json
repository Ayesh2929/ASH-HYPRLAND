{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "none",
        "padding": { "top": 0, "left": 0, "right": 0 }
    },

    "display": {
        "separator":   "  ",
        "keyWidth":    14,
        "color":       "magenta",
        "brightColor": true,
        "size": {
            "ndigits":   2,
            "maxPrefix": "giga"
        }
    },

    "modules": [
        {
            "type":   "custom",
            "format": "\u001b[1;35m╭─────────────────────────────────────────╮\u001b[0m"
        },
        {
            "type":   "title",
            "format": "\u001b[1;35m│\u001b[0m  \u001b[1;35m{6}\u001b[0m @ \u001b[1;34m{7}\u001b[0m"
        },
        {
            "type":   "custom",
            "format": "\u001b[1;35m├─────────────────────────────────────────┤\u001b[0m"
        },
        {
            "type":     "os",
            "key":      "\u001b[1;35m│\u001b[0m  \u001b[35m OS\u001b[0m",
            "keyWidth": 14
        },
        {
            "type":     "kernel",
            "key":      "\u001b[1;35m│\u001b[0m  \u001b[34m Kernel\u001b[0m",
            "keyWidth": 14
        },
        {
            "type":     "uptime",
            "key":      "\u001b[1;35m│\u001b[0m  \u001b[36m Uptime\u001b[0m",
            "keyWidth": 14
        },
        {
            "type":     "shell",
            "key":      "\u001b[1;35m│\u001b[0m   Shell\u001b[0m",
            "keyWidth": 14,
            "format":   "{name} {version}"
        },
        {
            "type":     "packages",
            "key":      "\u001b[1;35m│\u001b[0m  \u001b[35m Pkgs\u001b[0m",
            "keyWidth": 14
        },
        {
            "type":     "wm",
            "key":      "\u001b[1;35m│\u001b[0m  \u001b[34m WM\u001b[0m",
            "keyWidth": 14
        },
        {
            "type":     "terminal",
            "key":      "\u001b[1;35m│\u001b[0m   Terminal\u001b[0m",
            "keyWidth": 14
        },
        {
            "type":   "custom",
            "format": "\u001b[1;35m├─────────────────────────────────────────┤\u001b[0m"
        },
        {
            "type":     "cpu",
            "key":      "\u001b[1;35m│\u001b[0m   CPU\u001b[0m",
            "keyWidth": 14,
            "format":   "{name} ({cores-physical}C)"
        },
        {
            "type":       "gpu",
            "key":        "\u001b[1;35m│\u001b[0m  \u001b[35m GPU\u001b[0m",
            "keyWidth":   14,
            "format":     "{name}",
            "hideType":   "integrated"
        },
        {
            "type":     "memory",
            "key":      "\u001b[1;35m│\u001b[0m  \u001b[36m RAM\u001b[0m",
            "keyWidth": 14,
            "format":   "{used} / {total} ({percentage}%)"
        },
        {
            "type":     "disk",
            "key":      "\u001b[1;35m│\u001b[0m   Disk\u001b[0m",
            "keyWidth": 14,
            "format":   "{used} / {total} ({percentage}%)",
            "folders":  "/"
        },
        {
            "type":   "custom",
            "format": "\u001b[1;35m╰─────────────────────────────────────────╯\u001b[0m"
        },
        "break",
        {
            "type":        "colors",
            "symbol":      "circle",
            "paddingLeft": 2
        }
    ]
}