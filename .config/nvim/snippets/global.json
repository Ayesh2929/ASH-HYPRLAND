{
    "Shebang Bash": {
        "prefix": ["shebang", "bash-header", "sh!"],
        "body": [
            "#!/bin/bash",
            "# ╔═══════════════════════════════════════════════════════════════╗",
            "# ║  ${1:Script Name} — ${2:Description}",
            "# ╚═══════════════════════════════════════════════════════════════╝",
            "",
            "set -euo pipefail",
            "IFS=$$'\\n\\t'",
            "",
            "$0"
        ],
        "description": "Bash script header with error handling"
    },
    "Date ISO": {
        "prefix": ["date", "dateiso"],
        "body": ["$(date -Iseconds)"],
        "description": "ISO 8601 date string"
    },
    "TODO": {
        "prefix": ["todo"],
        "body": ["TODO: ${1:description}"],
        "description": "TODO comment"
    },
    "FIXME": {
        "prefix": ["fixme"],
        "body": ["FIXME: ${1:description}"],
        "description": "FIXME comment"
    },
    "NOTE": {
        "prefix": ["note"],
        "body": ["NOTE: ${1:description}"],
        "description": "NOTE comment"
    },
    "HACK": {
        "prefix": ["hack"],
        "body": ["HACK: ${1:description}"],
        "description": "HACK comment"
    },
    "Box Comment": {
        "prefix": ["box", "section"],
        "body": [
            "# ═══════════════════════════════════════════════════════════════",
            "# ${1:SECTION TITLE}",
            "# ═══════════════════════════════════════════════════════════════",
            "$0"
        ],
        "description": "Box section comment"
    },
    "Timestamp": {
        "prefix": ["ts", "timestamp"],
        "body": ["$(date '+%Y-%m-%d %H:%M:%S')"],
        "description": "Current timestamp"
    },
    "UUID": {
        "prefix": ["uuid"],
        "body": ["$(cat /proc/sys/kernel/random/uuid)"],
        "description": "Generate UUID"
    },
    "Copyright": {
        "prefix": ["copyright"],
        "body": [
            "Copyright (c) $(date +%Y) ${1:Author}",
            "Licensed under the ${2:MIT} License"
        ],
        "description": "Copyright notice"
    }
}