{
    "Module": {
        "prefix": ["mod", "module"],
        "body": [
            "local M = {}",
            "",
            "$0",
            "",
            "return M"
        ],
        "description": "Lua module template"
    },
    "Function": {
        "prefix": ["fn", "function"],
        "body": [
            "function ${1:name}(${2:args})",
            "    $0",
            "end"
        ],
        "description": "Lua function"
    },
    "Local function": {
        "prefix": ["lfn", "local function"],
        "body": [
            "local function ${1:name}(${2:args})",
            "    $0",
            "end"
        ],
        "description": "Local Lua function"
    },
    "Module function": {
        "prefix": ["mfn"],
        "body": [
            "function M.${1:name}(${2:args})",
            "    $0",
            "end"
        ],
        "description": "Module function"
    },
    "For ipairs": {
        "prefix": ["fori", "ipairs"],
        "body": [
            "for ${1:i}, ${2:v} in ipairs(${3:t}) do",
            "    $0",
            "end"
        ],
        "description": "For ipairs loop"
    },
    "For pairs": {
        "prefix": ["forp", "pairs"],
        "body": [
            "for ${1:k}, ${2:v} in pairs(${3:t}) do",
            "    $0",
            "end"
        ],
        "description": "For pairs loop"
    },
    "If": {
        "prefix": ["if"],
        "body": [
            "if ${1:condition} then",
            "    $0",
            "end"
        ],
        "description": "If statement"
    },
    "If else": {
        "prefix": ["ife", "ifelse"],
        "body": [
            "if ${1:condition} then",
            "    $2",
            "else",
            "    $0",
            "end"
        ],
        "description": "If-else statement"
    },
    "Pcall": {
        "prefix": ["pc", "pcall"],
        "body": [
            "local ${1:ok}, ${2:result} = pcall(${3:func}${4:, args})",
            "if not ${1:ok} then",
            "    ${5:-- handle error}",
            "    return",
            "end",
            "$0"
        ],
        "description": "Protected call with error handling"
    },
    "Require safe": {
        "prefix": ["req", "require"],
        "body": [
            "local ok, ${1:mod} = pcall(require, \"${2:module}\")",
            "if not ok then return end",
            "$0"
        ],
        "description": "Safe require with error handling"
    },
    "Vim keymap": {
        "prefix": ["map", "keymap"],
        "body": [
            "vim.keymap.set(\"${1|n,i,v,x,t,o|}\", \"${2:lhs}\", ${3:rhs}, {",
            "    silent = true,",
            "    desc   = \"${4:description}\",",
            "})"
        ],
        "description": "Vim keymap set"
    },
    "Vim autocmd": {
        "prefix": ["au", "autocmd"],
        "body": [
            "vim.api.nvim_create_autocmd(\"${1:Event}\", {",
            "    group    = vim.api.nvim_create_augroup(\"${2:GroupName}\", { clear = true }),",
            "    pattern  = ${3:\"*\"},",
            "    callback = function(${4:ev})",
            "        $0",
            "    end,",
            "})"
        ],
        "description": "Create autocommand"
    },
    "Vim highlight": {
        "prefix": ["hi", "highlight"],
        "body": [
            "vim.api.nvim_set_hl(0, \"${1:GroupName}\", {",
            "    fg   = \"${2:#color}\",",
            "    bg   = \"${3:#color}\",",
            "    bold = ${4:false},",
            "})"
        ],
        "description": "Set highlight group"
    },
    "Notify": {
        "prefix": ["notify"],
        "body": [
            "vim.notify(${1:\"message\"}, vim.log.levels.${2|INFO,WARN,ERROR,DEBUG|}, {",
            "    title = \"${3:Title}\",",
            "})"
        ],
        "description": "Vim notification"
    },
    "Lazy plugin spec": {
        "prefix": ["lazy", "plugin"],
        "body": [
            "{",
            "    \"${1:author/plugin}\",",
            "    event   = \"${2:VeryLazy}\",",
            "    opts    = {",
            "        $3",
            "    },",
            "    config  = function(_, opts)",
            "        require(\"${4:plugin}\").setup(opts)",
            "    end,",
            "},"
        ],
        "description": "Lazy.nvim plugin specification"
    }
}