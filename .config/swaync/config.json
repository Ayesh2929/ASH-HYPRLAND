{
    "$schema": "/etc/xdg/swaync/configSchema.json",

    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "layer-shell": true,
    "cssPriority": "application",
    "control-center-margin-top": 8,
    "control-center-margin-bottom": 8,
    "control-center-margin-right": 8,
    "control-center-margin-left": 0,
    "notification-2fa-action": true,
    "notification-inline-replies": false,
    "notification-icon-size": 48,
    "notification-body-image-height": 100,
    "notification-body-image-width": 200,
    "timeout": 8,
    "timeout-low": 5,
    "timeout-critical": 0,
    "fit-to-screen": true,
    "relative-timestamps": true,
    "notification-window-width": 420,
    "keyboard-shortcut": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "script-fail-notify": true,

    "widgets": [
        "title",
        "dnd",
        "label",
        "mpris",
        "notifications",
        "buttons-grid"
    ],

    "widget-config": {
        "title": {
            "text": "🔔 Notification Center",
            "clear-all-button": true,
            "button-text": "󰃢  Clear All"
        },
        "dnd": {
            "text": "󰂛  Do Not Disturb"
        },
        "label": {
            "max-lines": 2,
            "text": "ASH Dotfiles v3.0"
        },
        "mpris": {
            "image-size": 96,
            "image-radius": 12
        },
        "buttons-grid": {
            "actions": [
                {
                    "label": "󰖩  WiFi",
                    "command": "~/.config/hypr/scripts/network/wifi-toggle.sh toggle"
                },
                {
                    "label": "󰂯  Bluetooth",
                    "command": "~/.config/hypr/scripts/network/bluetooth-toggle.sh toggle"
                },
                {
                    "label": "󰌌  Night Light",
                    "command": "~/.config/hypr/scripts/hardware/dpms.sh night-toggle"
                },
                {
                    "label": "󰒲  Do Not Disturb",
                    "command": "swaync-client -d"
                },
                {
                    "label": "  Screenshot",
                    "command": "~/.config/hypr/scripts/utils/screenshot.sh area"
                },
                {
                    "label": "  Record",
                    "command": "~/.config/hypr/scripts/media/recorder.sh toggle"
                },
                {
                    "label": "  Lock",
                    "command": "~/.config/hypr/scripts/system/lock.sh"
                },
                {
                    "label": "⚡  Power",
                    "command": "~/.config/hypr/scripts/system/power-profile.sh picker"
                },
                {
                    "label": "🎨  Theme",
                    "command": "~/.config/hypr/scripts/theme/wallpaper-picker.sh"
                },
                {
                    "label": "🎲  Random",
                    "command": "~/.config/hypr/scripts/theme/wallpaper-picker.sh random"
                }
            ]
        }
    },

    "scripts": {
        "example-script": {
            "exec": "echo hello",
            "urgency": "Normal"
        }
    },

    "notification-visibility": {
        "app-image-pattern": {
            "state": "muted",
            "urgency": "Low",
            "app-name": "Image Viewer"
        }
    }
}