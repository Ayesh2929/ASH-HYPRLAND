;; ║           Elkowar's Wacky Widgets — System dashboard                       ║
;; ╚═══════════════════════════════════════════════════════════════════════════════╝

;; ═══════════════════════════════════════════════════════════════════════════════
;; 📊 VARIABLES
;; ═══════════════════════════════════════════════════════════════════════════════

;; System stats (polled every 2 seconds)
(defpoll cpu_usage    :interval "2s"  `~/.config/eww/scripts/system/cpu.sh usage`)
(defpoll cpu_temp     :interval "5s"  `~/.config/eww/scripts/system/cpu.sh temp`)
(defpoll mem_used     :interval "3s"  `~/.config/eww/scripts/system/memory.sh used`)
(defpoll mem_total    :interval "60s" `~/.config/eww/scripts/system/memory.sh total`)
(defpoll mem_pct      :interval "3s"  `~/.config/eww/scripts/system/memory.sh percent`)
(defpoll disk_used    :interval "30s" `df -h / | awk 'NR==2{print $3}'`)
(defpoll disk_total   :interval "60s" `df -h / | awk 'NR==2{print $2}'`)
(defpoll disk_pct     :interval "30s" `df / | awk 'NR==2{print $5}' | tr -d '%'`)
(defpoll uptime       :interval "60s" `uptime -p | sed 's/up //'`)

;; Date / Time (high frequency)
(defpoll time         :interval "1s"  `date '+%H:%M:%S'`)
(defpoll date_day     :interval "60s" `date '+%A'`)
(defpoll date_full    :interval "60s" `date '+%B %d, %Y'`)
(defpoll cal          :interval "3600s" `cal | head -8`)

;; Network
(defpoll wifi_ssid    :interval "10s" `nmcli -t -f active,ssid dev wifi 2>/dev/null | grep '^yes' | cut -d: -f2 || echo "Disconnected"`)
(defpoll wifi_signal  :interval "10s" `nmcli -t -f active,signal dev wifi 2>/dev/null | grep '^yes' | cut -d: -f2 || echo "0"`)
(defpoll local_ip     :interval "30s" `ip -4 addr show | grep -oP '(?<=inet )[\d.]+(?=/)' | grep -v '^127' | head -1 || echo "N/A"`)

;; Media
(defpoll media_status :interval "2s"  `~/.config/eww/scripts/media/player.sh status`)
(defpoll media_title  :interval "2s"  `~/.config/eww/scripts/media/player.sh title`)
(defpoll media_artist :interval "2s"  `~/.config/eww/scripts/media/player.sh artist`)

;; Battery
(defpoll bat_level    :interval "30s" `cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo "100"`)
(defpoll bat_status   :interval "30s" `cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo "Full"`)

;; Workspaces (listen for Hyprland changes)
(deflisten workspaces           `~/.config/eww/scripts/system/workspaces.sh`)
(deflisten active_workspace     `~/.config/eww/scripts/system/active-workspace.sh`)

;; Weather
(defpoll weather_temp :interval "1800s" `curl -s 'wttr.in?format=%t' 2>/dev/null | tr -d '+' || echo "?°C"`)
(defpoll weather_desc :interval "1800s" `curl -s 'wttr.in?format=%C' 2>/dev/null || echo "Unknown"`)
(defpoll weather_icon :interval "1800s" `curl -s 'wttr.in?format=%c' 2>/dev/null || echo "🌤️"`)

;; ═══════════════════════════════════════════════════════════════════════════════
;; 🎨 WIDGETS
;; ═══════════════════════════════════════════════════════════════════════════════

;; ── Clock Card ──────────────────────────────────────────────────────────────

(defwidget clock-card []
  (box :class "card clock-card"
       :orientation "vertical"
       :space-evenly false
       :spacing 8
    (label :class "clock-time"
           :text time)
    (label :class "clock-day"
           :text date_day)
    (label :class "clock-date"
           :text date_full)))

;; ── System Card ─────────────────────────────────────────────────────────────

(defwidget sys-bar [label value max icon class]
  (box :class "sys-bar-container"
       :orientation "vertical"
       :spacing 4
    (box :spacing 8
      (label :class "sys-icon" :text icon)
      (label :class "sys-label" :text label)
      (label :class "sys-value ${class}" :text "${value}${max != "" ? "/" + max : ""}"))
    (scale :class "sys-scale ${class}"
           :value {value}
           :min 0
           :max {max != "" ? max : 100}
           :orientation "horizontal"
           :hexpand true)))

(defwidget system-card []
  (box :class "card system-card"
       :orientation "vertical"
       :space-evenly false
       :spacing 16
    (label :class "card-title" :text "  System")
    (sys-bar :label "CPU"
             :value cpu_usage
             :max "100"
             :icon "󰘚"
             :class {cpu_usage > 80 ? "critical" : cpu_usage > 60 ? "warning" : "normal"})
    (sys-bar :label "RAM"
             :value mem_pct
             :max "100"
             :icon "󰍛"
             :class {mem_pct > 80 ? "critical" : mem_pct > 60 ? "warning" : "normal"})
    (sys-bar :label "Disk"
             :value disk_pct
             :max "100"
             :icon "󰋊"
             :class {disk_pct > 80 ? "critical" : disk_pct > 60 ? "warning" : "normal"})
    (box :spacing 8
      (label :class "sys-icon" :text "🌡️")
      (label :class "sys-label" :text "CPU Temp")
      (label :class "sys-value" :text "${cpu_temp}°C"))
    (box :spacing 8
      (label :class "sys-icon" :text "⏱")
      (label :class "sys-label" :text "Uptime")
      (label :class "sys-value" :text uptime))))

;; ── Media Card ──────────────────────────────────────────────────────────────

(defwidget media-card []
  (box :class "card media-card"
       :orientation "vertical"
       :space-evenly false
       :spacing 12
    (label :class "card-title" :text "󰎃  Now Playing")
    (box :orientation "vertical"
         :spacing 6
         :visible {media_title != ""}
      (label :class "media-title"
             :text {media_title != "" ? media_title : "Nothing playing"}
             :limit-width 30
             :truncate "end")
      (label :class "media-artist"
             :text {media_artist != "" ? media_artist : ""}
             :limit-width 25
             :truncate "end"))
    (box :class "media-controls"
         :spacing 8
         :halign "center"
      (button :class "media-btn"
              :onclick "playerctl previous"
              (label :text "󰒮"))
      (button :class "media-btn play-pause"
              :onclick "playerctl play-pause"
              (label :text {media_status == "Playing" ? "󰏤" : "󰎈"}))
      (button :class "media-btn"
              :onclick "playerctl next"
              (label :text "󰒭")))))

;; ── Network Card ────────────────────────────────────────────────────────────

(defwidget network-card []
  (box :class "card network-card"
       :orientation "vertical"
       :space-evenly false
       :spacing 10
    (label :class "card-title" :text "󰖟  Network")
    (box :spacing 8
      (label :class "net-icon" :text {wifi_signal > 75 ? "󰤨" : wifi_signal > 50 ? "󰤥" : wifi_signal > 25 ? "󰤢" : "󰤟"})
      (label :class "net-ssid" :text wifi_ssid))
    (box :spacing 8
      (label :class "net-icon" :text "")
      (label :class "net-ip"   :text local_ip))
    (box :spacing 8
      (label :class "net-icon" :text "📶")
      (label :class "net-signal" :text "${wifi_signal}%"))))

;; ── Weather Card ────────────────────────────────────────────────────────────

(defwidget weather-card []
  (box :class "card weather-card"
       :orientation "vertical"
       :space-evenly false
       :spacing 8
    (label :class "card-title" :text "🌤️  Weather")
    (label :class "weather-icon" :text weather_icon)
    (label :class "weather-temp" :text weather_temp)
    (label :class "weather-desc" :text weather_desc
           :limit-width 20
           :truncate "end")))

;; ── Quick Launch Buttons ─────────────────────────────────────────────────────

(defwidget quick-launch []
  (box :class "card quick-launch"
       :orientation "vertical"
       :space-evenly false
       :spacing 8
    (label :class "card-title" :text "⚡  Quick Launch")
    (box :class "launch-grid"
         :space-evenly true
         :spacing 8
      (button :class "launch-btn"
              :onclick "kitty &"
              :tooltip "Terminal"
              (label :text ""))
      (button :class "launch-btn"
              :onclick "firefox &"
              :tooltip "Firefox"
              (label :text ""))
      (button :class "launch-btn"
              :onclick "nemo &"
              :tooltip "Files"
              (label :text "󰉋"))
      (button :class "launch-btn"
              :onclick "nvim &"
              :tooltip "Neovim"
              (label :text ""))
      (button :class "launch-btn"
              :onclick "btop &"
              :tooltip "System Monitor"
              (label :text "󰍹"))
      (button :class "launch-btn"
              :onclick "~/.config/rofi/scripts/launcher.sh &"
              :tooltip "App Launcher"
              (label :text "󰍉")))))

;; ═══════════════════════════════════════════════════════════════════════════════
;; 🏠 DASHBOARD WINDOW
;; ═══════════════════════════════════════════════════════════════════════════════

(defwindow dashboard
  :monitor 0
  :geometry (geometry :x "0"
                      :y "0"
                      :width "460px"
                      :height "100%"
                      :anchor "left center")
  :stacking "overlay"
  :exclusive true
  :namespace "eww-dashboard"

  (box :class "dashboard"
       :orientation "vertical"
       :space-evenly false
       :spacing 12
       :vexpand true

    ;; Header
    (box :class "dashboard-header"
         :spacing 12
      (label :class "dashboard-title" :text "ASH Dashboard")
      (label :class "dashboard-version" :text "v3.0"))

    ;; Main content
    (scroll :vscroll true
            :vexpand true
      (box :orientation "vertical"
           :space-evenly false
           :spacing 12
        (clock-card)
        (system-card)
        (media-card)
        (network-card)
        (weather-card)
        (quick-launch)))))