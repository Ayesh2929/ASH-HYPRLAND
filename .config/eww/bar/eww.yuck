;; ╔═══════════════════════════════════════════════════════════════════════════════╗
;; ║           ASH DOTFILES v3.0 — EWW BAR WIDGET                               ║
;; ║           Alternative bar implementation using Elkowar's Wacky Widgets     ║
;; ╚═══════════════════════════════════════════════════════════════════════════════╝

;; ═══════════════════════════════════════════════════════════════════════════════
;; 📊 VARIABLES
;; ═══════════════════════════════════════════════════════════════════════════════

;; Time
(defpoll bar-time     :interval "1s"  `date '+%H:%M:%S'`)
(defpoll bar-date     :interval "60s" `date '+%a %d %b'`)

;; System stats
(defpoll bar-cpu      :interval "3s"  `~/.config/eww/scripts/system/cpu.sh usage`)
(defpoll bar-mem      :interval "5s"  `~/.config/eww/scripts/system/memory.sh percent`)
(defpoll bar-battery  :interval "30s" `cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo 100`)
(defpoll bar-bat-stat :interval "30s" `cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo Full`)

;; Network
(defpoll bar-wifi     :interval "10s" `nmcli -t -f active,ssid dev wifi 2>/dev/null | grep '^yes' | cut -d: -f2 || echo ''`)

;; Audio
(defpoll bar-vol      :interval "2s"  `wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{printf "%.0f", $2*100}' || echo 0`)
(defpoll bar-muted    :interval "2s"  `wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q MUTED && echo true || echo false`)

;; Workspaces (listen)
(deflisten bar-workspaces    `~/.config/eww/scripts/system/workspaces.sh`)
(deflisten bar-active-ws     `~/.config/eww/scripts/system/active-workspace.sh`)

;; ═══════════════════════════════════════════════════════════════════════════════
;; 🧩 WIDGETS
;; ═══════════════════════════════════════════════════════════════════════════════

;; ── Workspace Buttons ─────────────────────────────────────────────────────────

(defwidget bar-workspace [ws active]
  (button
    :class   {ws == active ? "bar-ws active" : "bar-ws"}
    :onclick `hyprctl dispatch workspace ${ws}`
    {ws}))

(defwidget bar-workspaces []
  (box
    :class "bar-workspaces"
    :space-evenly false
    :spacing 4
    (for ws in bar-workspaces
      (bar-workspace
        :ws     {ws.id}
        :active bar-active-ws))))

;; ── Clock ─────────────────────────────────────────────────────────────────────

(defwidget bar-clock []
  (box
    :class "bar-clock"
    :space-evenly false
    :spacing 6
    (label :class "bar-time" :text bar-time)
    (label :class "bar-date" :text bar-date)))

;; ── CPU ───────────────────────────────────────────────────────────────────────

(defwidget bar-cpu-widget []
  (box
    :class   {bar-cpu > 80 ? "bar-stat critical" : bar-cpu > 60 ? "bar-stat warning" : "bar-stat"}
    :tooltip "CPU: ${bar-cpu}%"
    (label :text " ${bar-cpu}%")))

;; ── Memory ────────────────────────────────────────────────────────────────────

(defwidget bar-mem-widget []
  (box
    :class   {bar-mem > 80 ? "bar-stat critical" : bar-mem > 60 ? "bar-stat warning" : "bar-stat"}
    :tooltip "RAM: ${bar-mem}%"
    (label :text "󰍛 ${bar-mem}%")))

;; ── Battery ───────────────────────────────────────────────────────────────────

(defwidget bar-battery-widget []
  (box
    :class   {bar-battery <= 15 ? "bar-stat critical" : bar-battery <= 30 ? "bar-stat warning" : "bar-stat"}
    :visible {bar-battery != 100 || bar-bat-stat == "Charging"}
    :tooltip "${bar-bat-stat}: ${bar-battery}%"
    (label :text {bar-bat-stat == "Charging" ? "󰂄 ${bar-battery}%" :
                  bar-battery <= 10 ? "󰂎 ${bar-battery}%" :
                  bar-battery <= 30 ? "󰁺 ${bar-battery}%" :
                  "󰁼 ${bar-battery}%"})))

;; ── Volume ────────────────────────────────────────────────────────────────────

(defwidget bar-vol-widget []
  (button
    :class   "bar-stat"
    :onclick `~/.config/hypr/scripts/media/volume.sh mute`
    :onscroll `~/.config/hypr/scripts/media/volume.sh {} 5`
    :tooltip "Volume: ${bar-vol}%"
    (label :text {bar-muted == "true" ? "󰝟 Muted" :
                  bar-vol < 33 ? "󰕿 ${bar-vol}%" :
                  bar-vol < 66 ? "󰖀 ${bar-vol}%" :
                  "󰕾 ${bar-vol}%"})))

;; ── WiFi ──────────────────────────────────────────────────────────────────────

(defwidget bar-wifi-widget []
  (box
    :class "bar-stat"
    :tooltip "WiFi: ${bar-wifi}"
    (label :text {bar-wifi != "" ? "  ${bar-wifi}" : "󰖪"})))

;; ── Power Button ──────────────────────────────────────────────────────────────

(defwidget bar-power []
  (button
    :class   "bar-power"
    :onclick `~/.config/rofi/scripts/powermenu.sh`
    :tooltip "Power Menu"
    (label :text "⏻")))

;; ── Launcher ─────────────────────────────────────────────────────────────────

(defwidget bar-launcher []
  (button
    :class   "bar-launcher"
    :onclick `~/.config/rofi/scripts/launcher.sh`
    :tooltip "App Launcher"
    (label :text "  ")))

;; ── Separator ─────────────────────────────────────────────────────────────────

(defwidget separator []
  (label :class "bar-sep" :text "|"))

;; ═══════════════════════════════════════════════════════════════════════════════
;; 🏠 BAR WINDOW
;; ═══════════════════════════════════════════════════════════════════════════════

(defwindow eww-bar
  :monitor   0
  :geometry  (geometry
    :x       "0"
    :y       "0"
    :width   "100%"
    :height  "36px"
    :anchor  "top center")
  :stacking  "fg"
  :exclusive true
  :namespace "eww-bar"

  (centerbox
    :class "eww-bar"

    ;; ── Left ──────────────────────────────────────────────────────────────────
    (box
      :class       "bar-left"
      :space-evenly false
      :spacing     8
      (bar-launcher)
      (bar-workspaces))

    ;; ── Center ────────────────────────────────────────────────────────────────
    (box
      :class       "bar-center"
      (bar-clock))

    ;; ── Right ─────────────────────────────────────────────────────────────────
    (box
      :class       "bar-right"
      :space-evenly false
      :spacing     8
      :halign      "end"
      (bar-wifi-widget)
      (separator)
      (bar-vol-widget)
      (separator)
      (bar-cpu-widget)
      (bar-mem-widget)
      (separator)
      (bar-battery-widget)
      (separator)
      (bar-power))))