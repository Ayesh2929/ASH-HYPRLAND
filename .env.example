# ╔══════════════════════════════════════════════════════════════╗
# ║  ASH DOTFILES — Environment Variables                       ║
# ║  Copy this file to .env and fill in the values              ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Application ──────────────────────────────────────────────
ASH_ENV=development
ASH_VERSION=8.0.0-hyperdrive
ASH_SECRET_KEY=change-me-to-a-random-string

# ── API Server ───────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_LOG_LEVEL=info

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=10

# ── Web Dashboard ────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_APP_TITLE=ASH Dotfiles Dashboard

# ── CI/CD Secrets (set in GitHub Settings > Secrets) ─────────
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
# FLY_API_TOKEN=...
# CODECOV_TOKEN=...
# AUR_SSH_KEY=...
# DOCKER_HUB_TOKEN=...

# ── Optional: OIDC Cloud Providers ──────────────────────────
# AWS_ROLE_ARN=arn:aws:iam::123456789:role/github-actions
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/123/locations/global/workloadIdentityPools/...
# GCP_SERVICE_ACCOUNT=github-actions@project.iam.gserviceaccount.com
