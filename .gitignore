# ═══════════════════════════════════════════════════════════════════════════════
# 🔒 PERSONAL / SENSITIVE DATA
# ═══════════════════════════════════════════════════════════════════════════════

# User-specific overrides (personal settings — not tracked)
config/hypr/UserOverrides/user.conf

# SSH and GPG keys
*.pem
*.key
id_rsa*
id_ed25519*
*.gpg

# API keys and tokens
.env
.env.local
*.secret
secrets.txt
tokens.txt

# ═══════════════════════════════════════════════════════════════════════════════
# 🎨 GENERATED FILES (created at runtime by theme engine)
# ═══════════════════════════════════════════════════════════════════════════════

# Generated theme files
config/hypr/themes/active.conf
config/kitty/themes/current.conf
config/waybar/styles/colors.css
config/rofi/themes/ash-dynamic.rasi
config/fish/themes/current.fish
config/dunst/dunstrc
config/swaync/style.css
config/gtk-3.0/gtk.css
config/gtk-4.0/gtk.css
config/hyprlock/hyprlock.conf

# ═══════════════════════════════════════════════════════════════════════════════
# 📦 PACKAGE MANAGER FILES
# ═══════════════════════════════════════════════════════════════════════════════

# Neovim lazy lockfile (optional — some prefer to track this)
# config/nvim/lazy-lock.json

# Neovim plugin data
config/nvim/.luarc.json

# ═══════════════════════════════════════════════════════════════════════════════
# 🗑️ CACHE & TEMPORARY FILES
# ═══════════════════════════════════════════════════════════════════════════════

# Cache directories
.cache/
*.cache
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# Thumbnail cache
thumbnails/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Rust build artifacts
target/

# ═══════════════════════════════════════════════════════════════════════════════
# 🖥️ OS FILES
# ═══════════════════════════════════════════════════════════════════════════════

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.DocumentRevisions-V100
.fseventsd

# Linux
.directory
.Trash-*

# Windows (if ever used on WSL)
Thumbs.db
ehthumbs.db
Desktop.ini

# ═══════════════════════════════════════════════════════════════════════════════
# 🔧 EDITOR FILES
# ═══════════════════════════════════════════════════════════════════════════════

# Vim/Neovim
.vim/
*.un~
Session.vim
.netrwhist

# VSCode
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml
*.ipr
*.iws

# Emacs
*~
\#*\#
.#*
*.elc
.emacs.d/

# ═══════════════════════════════════════════════════════════════════════════════
# 📋 BACKUP FILES
# ═══════════════════════════════════════════════════════════════════════════════

# Our own backup files
*.bak
*.bak.*
backups/
*.orig

# ═══════════════════════════════════════════════════════════════════════════════
# 🎬 MEDIA FILES (wallpapers stored elsewhere)
# ═══════════════════════════════════════════════════════════════════════════════

# Large media files (wallpapers are in ~/Pictures/Wallpapers, not in repo)
*.jpg
*.jpeg
*.png
*.gif
*.mp4
*.mkv
*.avi
*.webm
*.mp3
*.flac
*.wav

# Except: small assets in hypr/assets/
!config/hypr/assets/**/*.png
!config/hypr/assets/**/*.jpg

# ═══════════════════════════════════════════════════════════════════════════════
# 🔊 SOUND FILES (small OGA files are OK)
# ═══════════════════════════════════════════════════════════════════════════════

# Allow small notification sounds
!config/hypr/assets/sounds/*.oga
!config/hypr/assets/sounds/*.wav

# ═══════════════════════════════════════════════════════════════════════════════
# 📊 RUNTIME STATE
# ═══════════════════════════════════════════════════════════════════════════════

# Runtime state files
*.pid
*.sock
*.lock

# Session files
sessions/
*.session

# History files  
*_history
.bash_history
.fish_history
.python_history
.zsh_history

# ═══════════════════════════════════════════════════════════════════════════════
# 📐 MISC
# ═══════════════════════════════════════════════════════════════════════════════

# Compiled files
*.o
*.so
*.a
*.lib
*.dll
*.exe

# Archives (large)
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip
*.rar
*.7z

# Database files
*.db
*.sqlite
*.sqlite3