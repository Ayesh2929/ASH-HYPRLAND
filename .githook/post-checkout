#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.1.0 — POST-CHECKOUT HOOK                         ║
# ║           Runs after git checkout / git switch                             ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

PREV_HEAD="$1"
NEW_HEAD="$2"
BRANCH_CHECKOUT="$3"

# Colors
readonly R='\033[0m' B='\033[1m' G='\033[92m' C='\033[96m' DIM='\033[2m'

# Only act on branch switches (not file checkouts)
if [[ "${BRANCH_CHECKOUT}" != "1" ]]; then
    exit 0
fi

NEW_BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")

echo ""
echo -e "${B}${C}🪝 Switched to branch: ${G}${NEW_BRANCH}${R}"

# Fix permissions on checked-out branch
find . -name "*.sh" -not -path "./.git/*" -exec chmod +x {} \; 2>/dev/null || true

# Check if .githooks are still configured
HOOKS_PATH=$(git config core.hooksPath 2>/dev/null || echo "")
if [[ "${HOOKS_PATH}" != ".githooks" ]]; then
    echo -e "  ${C}ℹ️  Git hooks not configured — run: bash .githooks/setup.sh${R}"
fi

# Show branch comparison
if [[ "${PREV_HEAD}" != "${NEW_HEAD}" ]]; then
    AHEAD=$(git rev-list "${PREV_HEAD}..${NEW_HEAD}" --count 2>/dev/null || echo "0")
    BEHIND=$(git rev-list "${NEW_HEAD}..${PREV_HEAD}" --count 2>/dev/null || echo "0")
    echo -e "  ${DIM}${AHEAD} commits ahead, ${BEHIND} behind previous${R}"
fi

echo ""