#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.1.0 — PRE-PUSH HOOK                              ║
# ║           Final validation before pushing to remote                        ║
# ║           Bypass: git push --no-verify                                     ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

set -euo pipefail

readonly R='\033[0m' B='\033[1m' G='\033[92m' Y='\033[93m'
readonly RED='\033[91m' C='\033[96m' DIM='\033[2m'

REMOTE="$1"
URL="$2"
BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")

echo ""
echo -e "${B}${C}🪝 Pre-push checks (${BRANCH} → ${REMOTE})...${R}"
echo ""

ERRORS=0

# ═══════════════════════════════════════════════════════════════════════════════
# 1. PROTECT MAIN BRANCH FROM DIRECT PUSH
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}1. Branch protection check...${R}"

# Read stdin for push info
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    # Check if pushing to main
    if [[ "${REMOTE_REF}" == *"refs/heads/main"* ]]; then
        # Allow if on main branch (normal push)
        if [[ "${BRANCH}" != "main" ]]; then
            echo -e "  ${Y}⚠ Pushing non-main branch to main — use PR instead${R}"
        fi

        # Check for force push
        if [[ "${REMOTE_SHA}" != "0000000000000000000000000000000000000000" ]]; then
            LOCAL_COUNT=$(git rev-list "${REMOTE_SHA}..${LOCAL_SHA}" --count 2>/dev/null || echo "0")
            REMOTE_COUNT=$(git rev-list "${LOCAL_SHA}..${REMOTE_SHA}" --count 2>/dev/null || echo "0")

            if (( REMOTE_COUNT > 0 )) && (( LOCAL_COUNT > 0 )); then
                echo -e "  ${Y}⚠ Non-fast-forward push to main detected${R}"
                echo -e "  ${Y}  This may rewrite history — use --force-with-lease${R}"
            fi
        fi
    fi
done

echo -e "  ${G}✓${R} Branch check passed"

# ═══════════════════════════════════════════════════════════════════════════════
# 2. RUN QUICK VALIDATION
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}2. Quick validation...${R}"

# Check all .sh files have valid syntax
SYNTAX_ERRORS=0
while IFS= read -r script; do
    if ! bash -n "${script}" 2>/dev/null; then
        echo -e "  ${RED}❌ Syntax error: ${script}${R}"
        SYNTAX_ERRORS=$((SYNTAX_ERRORS+1))
    fi
done < <(find . -name "*.sh" -not -path "./.git/*" 2>/dev/null)

if (( SYNTAX_ERRORS > 0 )); then
    echo -e "  ${RED}❌ ${SYNTAX_ERRORS} script(s) have syntax errors${R}"
    ERRORS=$((ERRORS+SYNTAX_ERRORS))
else
    echo -e "  ${G}✓${R} All scripts valid"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 3. CHECK FOR WIP/TODO COMMITS
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}3. Checking for WIP commits...${R}"

WIP_COMMITS=$(git log --oneline "@{upstream}..HEAD" 2>/dev/null | \
    grep -iE "^[0-9a-f]+ (WIP|TODO|FIXME|HACK|XXX|TEMP)" || true)

if [[ -n "${WIP_COMMITS}" ]]; then
    echo -e "  ${Y}⚠ WIP commits found:${R}"
    echo "${WIP_COMMITS}" | sed 's/^/    /'
    echo -e "  ${Y}  Consider squashing before push${R}"
    # Warning only — don't block
else
    echo -e "  ${G}✓${R} No WIP commits"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 4. CHECK REQUIRED FILES STILL EXIST
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}4. Checking critical files...${R}"

CRITICAL_FILES=(
    "bin/ash"
    "install.sh"
    "quickstart.sh"
    "README.md"
    "LICENSE"
    ".gitignore"
)

MISSING=0
for file in "${CRITICAL_FILES[@]}"; do
    if [[ ! -f "${file}" ]]; then
        echo -e "  ${RED}❌ Missing critical file: ${file}${R}"
        MISSING=$((MISSING+1))
    fi
done

if (( MISSING > 0 )); then
    echo -e "  ${RED}❌ ${MISSING} critical file(s) missing!${R}"
    ERRORS=$((ERRORS+MISSING))
else
    echo -e "  ${G}✓${R} All critical files present"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 5. SIZE CHECK
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}5. Repository size check...${R}"

REPO_SIZE_KB=$(du -sk . --exclude='.git' 2>/dev/null | cut -f1 || echo "0")
REPO_SIZE_MB=$(( REPO_SIZE_KB / 1024 ))

if (( REPO_SIZE_MB > 100 )); then
    echo -e "  ${Y}⚠ Repository is ${REPO_SIZE_MB}MB — check for large files${R}"
elif (( REPO_SIZE_MB > 50 )); then
    echo -e "  ${Y}⚠ Repository is ${REPO_SIZE_MB}MB${R}"
else
    echo -e "  ${G}✓${R} Repository size: ${REPO_SIZE_MB}MB"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# FINAL RESULT
# ═══════════════════════════════════════════════════════════════════════════════

echo ""
if (( ERRORS > 0 )); then
    echo -e "${RED}${B}❌ PRE-PUSH FAILED — ${ERRORS} error(s)${R}"
    echo -e "  ${Y}Fix errors before pushing${R}"
    echo -e "  ${DIM}Bypass: git push --no-verify${R}"
    exit 1
else
    COMMITS_TO_PUSH=$(git rev-list "@{upstream}..HEAD" --count 2>/dev/null || echo "?")
    echo -e "${G}${B}✅ PRE-PUSH PASSED — Pushing ${COMMITS_TO_PUSH} commit(s) to ${REMOTE}${R}"
fi
echo ""