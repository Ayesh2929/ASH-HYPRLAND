#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.1.0 — COMMIT-MSG HOOK                            ║
# ║           Enforces Conventional Commits format                             ║
# ║           Bypass: git commit --no-verify                                   ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "${COMMIT_MSG_FILE}")

# Colors
readonly R='\033[0m' B='\033[1m' G='\033[92m' Y='\033[93m'
readonly RED='\033[91m' C='\033[96m' DIM='\033[2m' M='\033[95m'

# Skip merge commits
if echo "${COMMIT_MSG}" | head -1 | grep -qE "^Merge "; then
    exit 0
fi

# Skip revert commits
if echo "${COMMIT_MSG}" | head -1 | grep -qE "^Revert "; then
    exit 0
fi

# Skip fixup/squash commits
if echo "${COMMIT_MSG}" | head -1 | grep -qE "^(fixup|squash)! "; then
    exit 0
fi

# Get first line
FIRST_LINE=$(head -1 "${COMMIT_MSG_FILE}")

# ═══════════════════════════════════════════════════════════════════════════════
# CONVENTIONAL COMMIT VALIDATION
# ═══════════════════════════════════════════════════════════════════════════════

# Valid types
VALID_TYPES="feat|fix|docs|style|refactor|perf|test|chore|ci|revert|build"

# Valid scopes for ASH
VALID_SCOPES="hypr|waybar|rofi|fish|nvim|theme|cli|docs|install|scripts|ags|eww|kitty|dunst|swaync|hyprlock|hypridle|gtk|qt|mpv|btop|starship|music|score|workspace|smart|analytics|context|ci"

# Pattern: type(scope): description
# Scope is optional
PATTERN="^(${VALID_TYPES})(\((${VALID_SCOPES}|[a-z0-9-]+)\))?: .{1,72}$"

if ! echo "${FIRST_LINE}" | grep -qE "${PATTERN}"; then
    echo ""
    echo -e "${RED}${B}❌ INVALID COMMIT MESSAGE FORMAT${R}"
    echo ""
    echo -e "  ${RED}Got:${R}"
    echo -e "    ${DIM}${FIRST_LINE}${R}"
    echo ""
    echo -e "  ${G}Expected format:${R}"
    echo -e "    ${C}<type>${R}(${M}<scope>${R}): ${G}<description>${R}"
    echo ""
    echo -e "  ${B}Valid types:${R}"
    echo -e "    ${C}feat${R}      New feature"
    echo -e "    ${C}fix${R}       Bug fix"
    echo -e "    ${C}docs${R}      Documentation"
    echo -e "    ${C}style${R}     Formatting (no logic change)"
    echo -e "    ${C}refactor${R}  Code restructure"
    echo -e "    ${C}perf${R}      Performance improvement"
    echo -e "    ${C}test${R}      Tests"
    echo -e "    ${C}chore${R}     Maintenance/build"
    echo -e "    ${C}ci${R}        CI/CD changes"
    echo -e "    ${C}revert${R}    Revert previous commit"
    echo ""
    echo -e "  ${B}Common scopes:${R}"
    echo -e "    ${M}hypr${R} waybar rofi fish nvim theme cli docs"
    echo -e "    ${M}music${R} score workspace smart analytics context"
    echo ""
    echo -e "  ${B}Examples:${R}"
    echo -e "    ${G}feat(waybar): add GPU temperature module${R}"
    echo -e "    ${G}fix(theme): handle low-saturation wallpapers${R}"
    echo -e "    ${G}docs: update keybind reference${R}"
    echo -e "    ${G}chore: clean up unused scripts${R}"
    echo -e "    ${G}feat(music): add album art color extraction${R}"
    echo ""
    echo -e "  ${Y}Bypass: git commit --no-verify${R}"
    echo ""
    exit 1
fi

# ═══════════════════════════════════════════════════════════════════════════════
# LENGTH CHECKS
# ═══════════════════════════════════════════════════════════════════════════════

# Subject line max 72 chars
SUBJECT_LEN=${#FIRST_LINE}
if (( SUBJECT_LEN > 72 )); then
    echo ""
    echo -e "${Y}⚠ Commit subject too long: ${SUBJECT_LEN} chars (max 72)${R}"
    echo -e "  ${DIM}${FIRST_LINE}${R}"
    echo -e "  ${DIM}$(printf '%.0s─' $(seq 1 72))^${R}"
    echo ""
    # Warning only — don't block
fi

# Body lines max 100 chars
LINE_NUM=0
while IFS= read -r line; do
    LINE_NUM=$((LINE_NUM+1))
    if (( LINE_NUM > 1 )) && (( ${#line} > 100 )); then
        echo -e "${Y}⚠ Line ${LINE_NUM} too long: ${#line} chars (max 100)${R}"
    fi
done < "${COMMIT_MSG_FILE}"

# ═══════════════════════════════════════════════════════════════════════════════
# CONTENT CHECKS
# ═══════════════════════════════════════════════════════════════════════════════

# No trailing period
if echo "${FIRST_LINE}" | grep -qE '\.$'; then
    echo -e "${Y}⚠ Subject should not end with a period${R}"
fi

# Capitalize description
DESC=$(echo "${FIRST_LINE}" | sed 's/^[^:]*: //')
FIRST_CHAR=$(echo "${DESC}" | head -c 1)
if [[ "${FIRST_CHAR}" =~ [A-Z] ]]; then
    echo -e "${Y}⚠ Subject description should start lowercase${R}"
    echo -e "  ${DIM}Got: '${DESC}'${R}"
    echo -e "  ${DIM}Should: '$(echo "${FIRST_CHAR}" | tr '[:upper:]' '[:lower:]')${DESC:1}'${R}"
    # Warning only
fi

# ═══════════════════════════════════════════════════════════════════════════════
# AUTO-ENHANCE
# ═══════════════════════════════════════════════════════════════════════════════

# Add emoji prefix based on type (if not already present)
TYPE=$(echo "${FIRST_LINE}" | grep -oP '^[a-z]+' | head -1)
HAS_EMOJI=$(echo "${FIRST_LINE}" | grep -cP '[\x{1F300}-\x{1F9FF}]' || echo "0")

# Don't auto-add emoji — just validate

echo -e "${G}✅ Commit message valid: ${DIM}${TYPE}${R}"