#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.1.0 — POST-MERGE HOOK                            ║
# ║           Auto-sync system after git pull/merge                            ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

readonly R='\033[0m' B='\033[1m' G='\033[92m' C='\033[96m' DIM='\033[2m'

echo ""
echo -e "${B}${C}🪝 Post-merge: Syncing system...${R}"
echo ""

# Get list of changed files
CHANGED=$(git diff HEAD ORIG_HEAD --name-only 2>/dev/null || echo "")

if [[ -z "${CHANGED}" ]]; then
    echo -e "  ${DIM}No changes detected${R}"
    exit 0
fi

CHANGED_COUNT=$(echo "${CHANGED}" | wc -l)
echo -e "  ${C}${CHANGED_COUNT} file(s) changed${R}"

# ═══════════════════════════════════════════════════════════════════════════════
# 1. FIX PERMISSIONS ON NEW/CHANGED SCRIPTS
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "  Fixing script permissions..."
find . -name "*.sh" -not -path "./.git/*" -exec chmod +x {} \; 2>/dev/null || true
find bin -name "ash*" -exec chmod +x {} \; 2>/dev/null || true
find .local/bin -name "ash*" -exec chmod +x {} \; 2>/dev/null || true
echo -e "  ${G}✓${R} Permissions fixed"

# ═══════════════════════════════════════════════════════════════════════════════
# 2. RELOAD THEME IF COLORS CHANGED
# ═══════════════════════════════════════════════════════════════════════════════

if echo "${CHANGED}" | grep -qE "theme|color|waybar|css|rofi"; then
    echo -e "  Theme files changed — reapplying..."
    if [[ -x ".config/hypr/scripts/theme/theme-engine.sh" ]]; then
        .config/hypr/scripts/theme/theme-engine.sh "" reapply &>/dev/null &
        disown
        echo -e "  ${G}✓${R} Theme reapply started (background)"
    fi
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 3. RELOAD WAYBAR IF ITS CONFIG CHANGED
# ═══════════════════════════════════════════════════════════════════════════════

if echo "${CHANGED}" | grep -q "waybar"; then
    echo -e "  Waybar config changed — reloading..."
    pkill -SIGUSR2 waybar 2>/dev/null || true
    echo -e "  ${G}✓${R} Waybar signaled"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 4. RELOAD HYPRLAND IF CONFIG CHANGED
# ═══════════════════════════════════════════════════════════════════════════════

if echo "${CHANGED}" | grep -q "config/hypr/"; then
    echo -e "  Hyprland config changed — reloading..."
    hyprctl reload 2>/dev/null || true
    echo -e "  ${G}✓${R} Hyprland reloaded"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 5. CHECK FOR NEW DEPENDENCIES
# ═══════════════════════════════════════════════════════════════════════════════

if echo "${CHANGED}" | grep -q "install.sh\|quickstart.sh\|setup/"; then
    echo -e "  ${C}ℹ️  Install scripts changed — run: ash doctor${R}"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 6. NOTIFY USER
# ═══════════════════════════════════════════════════════════════════════════════

if command -v notify-send &>/dev/null && [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    notify-send "🔄 ASH Dotfiles Updated" \
        "${CHANGED_COUNT} files changed\nRun: ash doctor" \
        --app-name="ASH Git" \
        --expire-time=4000 \
        2>/dev/null || true
fi

echo ""
echo -e "${G}${B}✅ Post-merge sync complete${R}"
echo -e "  ${DIM}Run 'ash doctor' to verify system health${R}"
echo ""