#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.1.0 — PREPARE-COMMIT-MSG HOOK                    ║
# ║           Auto-suggests commit type based on changed files                 ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Don't modify merge/squash/amend commits
[[ "${COMMIT_SOURCE}" == "merge" ]] && exit 0
[[ "${COMMIT_SOURCE}" == "squash" ]] && exit 0
[[ "${COMMIT_SOURCE}" == "message" ]] && exit 0

# Only modify if empty (user didn't provide -m)
CURRENT_MSG=$(cat "${COMMIT_MSG_FILE}" | grep -v "^#")
[[ -n "${CURRENT_MSG}" ]] && exit 0

# ═══════════════════════════════════════════════════════════════════════════════
# 🔍 DETECT CHANGE TYPE FROM STAGED FILES
# ═══════════════════════════════════════════════════════════════════════════════

STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || echo "")

# Detect primary type and scope
TYPE="chore"
SCOPE=""

if echo "${STAGED_FILES}" | grep -q "docs/\|README\|\.md$"; then
    TYPE="docs"
fi

if echo "${STAGED_FILES}" | grep -q "\.github/\|ci\|workflow"; then
    TYPE="ci"
    SCOPE="ci"
fi

if echo "${STAGED_FILES}" | grep -qE "config/hypr/scripts/theme/"; then
    TYPE="feat"
    SCOPE="theme"
fi

if echo "${STAGED_FILES}" | grep -qE "config/hypr/"; then
    [[ -z "${SCOPE}" ]] && SCOPE="hypr"
fi

if echo "${STAGED_FILES}" | grep -q "config/waybar/"; then
    [[ -z "${SCOPE}" ]] && SCOPE="waybar"
fi

if echo "${STAGED_FILES}" | grep -q "config/rofi/"; then
    [[ -z "${SCOPE}" ]] && SCOPE="rofi"
fi

if echo "${STAGED_FILES}" | grep -q "config/fish/"; then
    [[ -z "${SCOPE}" ]] && SCOPE="fish"
fi

if echo "${STAGED_FILES}" | grep -q "config/nvim/"; then
    [[ -z "${SCOPE}" ]] && SCOPE="nvim"
fi

if echo "${STAGED_FILES}" | grep -q "bin/ash\|scripts/"; then
    [[ -z "${SCOPE}" ]] && SCOPE="cli"
fi

if echo "${STAGED_FILES}" | grep -q "album-art\|music"; then
    SCOPE="music"
fi

if echo "${STAGED_FILES}" | grep -q "health-score\|score"; then
    SCOPE="score"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 📝 WRITE TEMPLATE
# ═══════════════════════════════════════════════════════════════════════════════

SCOPE_STR=""
[[ -n "${SCOPE}" ]] && SCOPE_STR="(${SCOPE})"

# Count changes
FILE_COUNT=$(echo "${STAGED_FILES}" | grep -c . || echo "0")
ADDITIONS=$(git diff --cached --shortstat 2>/dev/null | grep -oP '\d+(?= insertion)' || echo "0")
DELETIONS=$(git diff --cached --shortstat 2>/dev/null | grep -oP '\d+(?= deletion)' || echo "0")

cat > "${COMMIT_MSG_FILE}" << EOF
${TYPE}${SCOPE_STR}: 

# ── ASH Dotfiles Commit Template ─────────────────────────────────────────
#
# FORMAT: <type>(<scope>): <description>
#
# Types:
#   feat     — New feature
#   fix      — Bug fix
#   docs     — Documentation
#   style    — Formatting (no logic change)
#   refactor — Code restructure
#   perf     — Performance
#   test     — Tests
#   chore    — Maintenance
#   ci       — CI/CD changes
#
# Scopes:
#   hypr waybar rofi fish nvim theme cli docs scripts
#   music score workspace smart analytics context
#   ags eww kitty dunst swaync hyprlock gtk qt
#
# ── Suggested type: ${TYPE} ──
# ── Suggested scope: ${SCOPE:-none} ──
#
# ── Staged files (${FILE_COUNT}): ──
$(echo "${STAGED_FILES}" | sed 's/^/#   /')
#
# ── Stats: +${ADDITIONS} -${DELETIONS} ──
#
# ── Rules: ──
# • Subject: max 72 chars, no trailing period
# • Subject: start lowercase after colon
# • Body: wrap at 100 chars
# • Separate subject from body with blank line
# • Explain WHAT and WHY, not HOW
#
EOF