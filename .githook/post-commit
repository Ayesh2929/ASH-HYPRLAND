#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.1.0 — POST-COMMIT HOOK                           ║
# ║           Runs AFTER successful commit                                     ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

# Colors
readonly G='\033[92m' C='\033[96m' DIM='\033[2m' R='\033[0m'

# Get commit info
HASH=$(git rev-parse --short HEAD)
BRANCH=$(git branch --show-current 2>/dev/null || echo "detached")
MSG=$(git log -1 --format='%s')
AUTHOR=$(git log -1 --format='%an')
FILES=$(git diff-tree --no-commit-id --name-only -r HEAD | wc -l)

echo ""
echo -e "${G}✅ Committed: ${DIM}[${BRANCH}] ${HASH}${R}"
echo -e "   ${C}${MSG}${R}"
echo -e "   ${DIM}${FILES} file(s) changed${R}"
echo ""

# ═══════════════════════════════════════════════════════════════════════════════
# 📊 UPDATE LOCAL STATS
# ═══════════════════════════════════════════════════════════════════════════════

STATS_FILE="${HOME}/.cache/ash-dots/git-stats.txt"
mkdir -p "$(dirname "${STATS_FILE}")" 2>/dev/null || true

{
    echo "$(date '+%Y-%m-%d %H:%M:%S') | ${HASH} | ${BRANCH} | ${FILES} files | ${MSG}"
} >> "${STATS_FILE}" 2>/dev/null || true

# Keep only last 100 entries
if [[ -f "${STATS_FILE}" ]]; then
    tail -100 "${STATS_FILE}" > "${STATS_FILE}.tmp" 2>/dev/null
    mv "${STATS_FILE}.tmp" "${STATS_FILE}" 2>/dev/null || true
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 🔔 DESKTOP NOTIFICATION (if in Hyprland)
# ═══════════════════════════════════════════════════════════════════════════════

if command -v notify-send &>/dev/null && [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    notify-send "✅ Git Commit" \
        "[${BRANCH}] ${MSG}\n${FILES} file(s) — ${HASH}" \
        --app-name="ASH Git" \
        --expire-time=3000 \
        2>/dev/null || true
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 🔢 COMMIT COUNT MILESTONE
# ═══════════════════════════════════════════════════════════════════════════════

TOTAL_COMMITS=$(git rev-list --count HEAD 2>/dev/null || echo "0")
MILESTONES=(10 25 50 100 200 300 500 1000)

for milestone in "${MILESTONES[@]}"; do
    if (( TOTAL_COMMITS == milestone )); then
        echo -e "  🎉 ${G}MILESTONE: ${milestone} commits!${R}"
        if command -v notify-send &>/dev/null; then
            notify-send "🎉 Git Milestone!" \
                "${milestone} commits on ${BRANCH}!" \
                --app-name="ASH Git" \
                --expire-time=5000 \
                2>/dev/null || true
        fi
        break
    fi
done