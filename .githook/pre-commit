#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.1.0 — PRE-COMMIT HOOK                            ║
# ║           Runs BEFORE every commit — validates everything                  ║
# ║           Bypass: git commit --no-verify                                   ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

set -euo pipefail

# Colors
readonly R='\033[0m' B='\033[1m' G='\033[92m' Y='\033[93m'
readonly RED='\033[91m' C='\033[96m' DIM='\033[2m'

# Track results
ERRORS=0
WARNINGS=0
FIXED=0
START_TIME=$(date +%s%N)

echo ""
echo -e "${B}${C}🪝 Pre-commit checks running...${R}"
echo ""

# ═══════════════════════════════════════════════════════════════════════════════
# 1. BLOCK .DS_STORE FILES
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}1. Checking for OS junk files...${R}"

JUNK_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
    grep -iE "(\.DS_Store|Thumbs\.db|desktop\.ini|\.directory|\._)" || true)

if [[ -n "${JUNK_FILES}" ]]; then
    echo -e "  ${RED}❌ OS junk files staged:${R}"
    echo "${JUNK_FILES}" | while read -r file; do
        echo -e "    ${RED}•${R} ${file}"
        git reset HEAD -- "${file}" 2>/dev/null || true
        ((FIXED++)) || true
    done
    echo -e "  ${Y}→ Auto-unstaged. Add to .gitignore!${R}"
    WARNINGS=$((WARNINGS+1))
else
    echo -e "  ${G}✓${R} No junk files"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 2. BLOCK GENERATED FILES
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}2. Checking for generated files...${R}"

GENERATED_PATTERNS=(
    ".config/hypr/themes/active.conf"
    ".config/kitty/themes/current.conf"
    ".config/waybar/styles/colors.css"
    ".config/rofi/themes/ash-dynamic.rasi"
    ".config/fish/themes/current.fish"
    ".config/dunst/dunstrc"
    ".config/swaync/style.css"
    ".config/gtk-3.0/gtk.css"
    ".config/gtk-4.0/gtk.css"
    ".config/hyprlock/hyprlock.conf"
)

STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || echo "")

for pattern in "${GENERATED_PATTERNS[@]}"; do
    if echo "${STAGED_FILES}" | grep -qF "${pattern}"; then
        echo -e "  ${RED}❌ Generated file staged: ${pattern}${R}"
        echo -e "  ${Y}→ This file is auto-generated by theme-engine.sh${R}"
        echo -e "  ${Y}→ Unstaging...${R}"
        git reset HEAD -- "*${pattern}" 2>/dev/null || true
        WARNINGS=$((WARNINGS+1))
        ((FIXED++)) || true
    fi
done

if (( WARNINGS == 0 )); then
    echo -e "  ${G}✓${R} No generated files staged"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 3. BLOCK USER OVERRIDES
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}3. Checking for personal config files...${R}"

if echo "${STAGED_FILES}" | grep -q "UserOverrides/user.conf"; then
    echo -e "  ${RED}❌ UserOverrides/user.conf is staged!${R}"
    echo -e "  ${RED}  This contains YOUR personal settings and must NOT be committed${R}"
    echo -e "  ${Y}→ Unstaging...${R}"
    git reset HEAD -- "*UserOverrides/user.conf" 2>/dev/null || true
    ERRORS=$((ERRORS+1))
else
    echo -e "  ${G}✓${R} Personal config safe"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 4. VALIDATE SHELL SCRIPT SYNTAX
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}4. Validating shell script syntax...${R}"

STAGED_SCRIPTS=$(git diff --cached --name-only --diff-filter=ACM | \
    grep '\.sh$' || true)

SCRIPT_ERRORS=0
if [[ -n "${STAGED_SCRIPTS}" ]]; then
    while IFS= read -r script; do
        [[ -z "${script}" ]] && continue
        [[ ! -f "${script}" ]] && continue

        if bash -n "${script}" 2>/dev/null; then
            echo -e "  ${G}✓${R} ${script}"
        else
            echo -e "  ${RED}❌ SYNTAX ERROR: ${script}${R}"
            bash -n "${script}" 2>&1 | head -5 | sed 's/^/    /'
            SCRIPT_ERRORS=$((SCRIPT_ERRORS+1))
        fi
    done <<< "${STAGED_SCRIPTS}"

    if (( SCRIPT_ERRORS > 0 )); then
        echo -e "  ${RED}❌ ${SCRIPT_ERRORS} script(s) have syntax errors${R}"
        ERRORS=$((ERRORS+SCRIPT_ERRORS))
    else
        echo -e "  ${G}✓${R} All scripts valid"
    fi
else
    echo -e "  ${DIM}No shell scripts staged${R}"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 5. CHECK set -euo pipefail IN SCRIPTS
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}5. Checking error handling (set -euo pipefail)...${R}"

if [[ -n "${STAGED_SCRIPTS}" ]]; then
    MISSING_EUO=0
    while IFS= read -r script; do
        [[ -z "${script}" ]] && continue
        [[ ! -f "${script}" ]] && continue

        if ! head -10 "${script}" | grep -q "set -euo pipefail"; then
            echo -e "  ${Y}⚠${R} Missing 'set -euo pipefail': ${script}"
            MISSING_EUO=$((MISSING_EUO+1))
        fi
    done <<< "${STAGED_SCRIPTS}"

    if (( MISSING_EUO > 0 )); then
        echo -e "  ${Y}⚠ ${MISSING_EUO} script(s) missing error handling${R}"
        WARNINGS=$((WARNINGS+MISSING_EUO))
    else
        echo -e "  ${G}✓${R} All scripts have error handling"
    fi
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 6. AUTO-FIX SCRIPT PERMISSIONS
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}6. Fixing script permissions...${R}"

if [[ -n "${STAGED_SCRIPTS}" ]]; then
    PERM_FIXED=0
    while IFS= read -r script; do
        [[ -z "${script}" ]] && continue
        [[ ! -f "${script}" ]] && continue

        if [[ ! -x "${script}" ]]; then
            chmod +x "${script}"
            git add "${script}"
            echo -e "  ${G}✓${R} Fixed: chmod +x ${script}"
            PERM_FIXED=$((PERM_FIXED+1))
            ((FIXED++)) || true
        fi
    done <<< "${STAGED_SCRIPTS}"

    if (( PERM_FIXED > 0 )); then
        echo -e "  ${G}✓${R} Fixed ${PERM_FIXED} permission(s)"
    else
        echo -e "  ${G}✓${R} All permissions correct"
    fi
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 7. VALIDATE JSON/JSONC FILES
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}7. Validating JSON/JSONC files...${R}"

STAGED_JSON=$(git diff --cached --name-only --diff-filter=ACM | \
    grep -E '\.(json|jsonc)$' | \
    grep -v "lazy-lock.json\|package-lock.json" || true)

JSON_ERRORS=0
if [[ -n "${STAGED_JSON}" ]]; then
    while IFS= read -r file; do
        [[ -z "${file}" ]] && continue
        [[ ! -f "${file}" ]] && continue

        if python3 -c "
import json, re, sys
try:
    content = open('${file}', 'r').read()
    # Remove comments for JSONC
    if '${file}'.endswith('.jsonc'):
        content = re.sub(r'//[^\n]*', '', content)
        content = re.sub(r'/\*.*?\*/', '', content, flags=re.DOTALL)
        content = re.sub(r',(\s*[}\]])', r'\1', content)
    json.loads(content)
except Exception as e:
    print(str(e)[:80])
    sys.exit(1)
" 2>/dev/null; then
            echo -e "  ${G}✓${R} ${file}"
        else
            echo -e "  ${RED}❌ Invalid JSON: ${file}${R}"
            python3 -c "
import json, re, sys
try:
    content = open('${file}').read()
    if '${file}'.endswith('.jsonc'):
        content = re.sub(r'//[^\n]*', '', content)
        content = re.sub(r'/\*.*?\*/', '', content, flags=re.DOTALL)
        content = re.sub(r',(\s*[}\]])', r'\1', content)
    json.loads(content)
except Exception as e:
    print(f'    Error: {e}')
" 2>/dev/null || true
            JSON_ERRORS=$((JSON_ERRORS+1))
        fi
    done <<< "${STAGED_JSON}"

    if (( JSON_ERRORS > 0 )); then
        ERRORS=$((ERRORS+JSON_ERRORS))
    fi
else
    echo -e "  ${DIM}No JSON files staged${R}"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 8. VALIDATE LUA FILES
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}8. Validating Lua files...${R}"

STAGED_LUA=$(git diff --cached --name-only --diff-filter=ACM | \
    grep '\.lua$' || true)

LUA_ERRORS=0
if [[ -n "${STAGED_LUA}" ]] && command -v luac5.4 &>/dev/null; then
    while IFS= read -r file; do
        [[ -z "${file}" ]] && continue
        [[ ! -f "${file}" ]] && continue

        if luac5.4 -p "${file}" 2>/dev/null; then
            echo -e "  ${G}✓${R} ${file}"
        else
            echo -e "  ${RED}❌ Lua syntax error: ${file}${R}"
            luac5.4 -p "${file}" 2>&1 | head -3 | sed 's/^/    /'
            LUA_ERRORS=$((LUA_ERRORS+1))
        fi
    done <<< "${STAGED_LUA}"

    if (( LUA_ERRORS > 0 )); then
        ERRORS=$((ERRORS+LUA_ERRORS))
    fi
elif [[ -n "${STAGED_LUA}" ]]; then
    echo -e "  ${DIM}luac5.4 not installed — skipping Lua checks${R}"
else
    echo -e "  ${DIM}No Lua files staged${R}"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 9. VALIDATE FISH SHELL FILES
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}9. Validating Fish files...${R}"

STAGED_FISH=$(git diff --cached --name-only --diff-filter=ACM | \
    grep '\.fish$' || true)

FISH_ERRORS=0
if [[ -n "${STAGED_FISH}" ]] && command -v fish &>/dev/null; then
    while IFS= read -r file; do
        [[ -z "${file}" ]] && continue
        [[ ! -f "${file}" ]] && continue

        if fish --no-execute "${file}" 2>/dev/null; then
            echo -e "  ${G}✓${R} ${file}"
        else
            echo -e "  ${RED}❌ Fish syntax error: ${file}${R}"
            FISH_ERRORS=$((FISH_ERRORS+1))
        fi
    done <<< "${STAGED_FISH}"

    if (( FISH_ERRORS > 0 )); then
        ERRORS=$((ERRORS+FISH_ERRORS))
    fi
elif [[ -n "${STAGED_FISH}" ]]; then
    echo -e "  ${DIM}fish not installed — skipping Fish checks${R}"
else
    echo -e "  ${DIM}No Fish files staged${R}"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 10. CHECK FOR SECRETS / SENSITIVE DATA
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}10. Scanning for secrets...${R}"

SECRET_PATTERNS=(
    'password\s*=\s*"[^"]{8,}"'
    'api_key\s*=\s*"[^"]{10,}"'
    'secret\s*=\s*"[^"]{8,}"'
    'token\s*=\s*"[^"]{10,}"'
    'BEGIN RSA PRIVATE'
    'BEGIN OPENSSH PRIVATE'
    'ghp_[A-Za-z0-9]{36}'
    'ghs_[A-Za-z0-9]{36}'
    'sk-[A-Za-z0-9]{48}'
    'xoxb-[A-Za-z0-9-]+'
)

SECRETS_FOUND=0
STAGED_CONTENT=$(git diff --cached --diff-filter=ACM -U0 2>/dev/null || echo "")

for pattern in "${SECRET_PATTERNS[@]}"; do
    if echo "${STAGED_CONTENT}" | grep -qiE "${pattern}" 2>/dev/null; then
        echo -e "  ${RED}🚨 POTENTIAL SECRET FOUND: ${pattern}${R}"
        echo "${STAGED_CONTENT}" | grep -iE "${pattern}" | head -3 | \
            sed 's/^/    /'
        SECRETS_FOUND=$((SECRETS_FOUND+1))
    fi
done

if (( SECRETS_FOUND > 0 )); then
    echo -e "  ${RED}❌ ${SECRETS_FOUND} potential secret(s) detected!${R}"
    echo -e "  ${RED}  Review carefully before committing${R}"
    ERRORS=$((ERRORS+SECRETS_FOUND))
else
    echo -e "  ${G}✓${R} No secrets detected"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 11. CHECK FOR DANGEROUS COMMANDS
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}11. Checking for dangerous commands...${R}"

DANGEROUS_PATTERNS=(
    'rm -rf /'
    'rm -rf ~'
    'mkfs\.'
    'dd if=/dev/zero'
    ':(){:|:&};:'
    'chmod -R 777 /'
    'chmod 777 /'
    '> /dev/sda'
    'mv /* '
)

DANGEROUS_FOUND=0
for pattern in "${DANGEROUS_PATTERNS[@]}"; do
    if echo "${STAGED_CONTENT}" | grep -qF "${pattern}" 2>/dev/null; then
        echo -e "  ${RED}🚨 DANGEROUS COMMAND: ${pattern}${R}"
        DANGEROUS_FOUND=$((DANGEROUS_FOUND+1))
    fi
done

if (( DANGEROUS_FOUND > 0 )); then
    echo -e "  ${RED}❌ ${DANGEROUS_FOUND} dangerous command(s) found!${R}"
    ERRORS=$((ERRORS+DANGEROUS_FOUND))
else
    echo -e "  ${G}✓${R} No dangerous commands"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 12. CHECK FOR LARGE FILES
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}12. Checking file sizes...${R}"

MAX_SIZE_KB=500  # 500KB max per file

LARGE_FILES=0
while IFS= read -r file; do
    [[ -z "${file}" ]] && continue
    [[ ! -f "${file}" ]] && continue

    SIZE_KB=$(du -k "${file}" 2>/dev/null | cut -f1 || echo "0")
    if (( SIZE_KB > MAX_SIZE_KB )); then
        echo -e "  ${Y}⚠${R} Large file (${SIZE_KB}KB): ${file}"
        LARGE_FILES=$((LARGE_FILES+1))
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if (( LARGE_FILES > 0 )); then
    echo -e "  ${Y}⚠ ${LARGE_FILES} large file(s) (>${MAX_SIZE_KB}KB)${R}"
    WARNINGS=$((WARNINGS+LARGE_FILES))
else
    echo -e "  ${G}✓${R} All files within size limits"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 13. CHECK CSS BRACE MATCHING
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}13. Validating CSS files...${R}"

STAGED_CSS=$(git diff --cached --name-only --diff-filter=ACM | \
    grep -E '\.(css|scss)$' || true)

CSS_ERRORS=0
if [[ -n "${STAGED_CSS}" ]]; then
    while IFS= read -r file; do
        [[ -z "${file}" ]] && continue
        [[ ! -f "${file}" ]] && continue

        OPENS=$(grep -c '{' "${file}" 2>/dev/null || echo "0")
        CLOSES=$(grep -c '}' "${file}" 2>/dev/null || echo "0")

        if (( OPENS != CLOSES )); then
            echo -e "  ${RED}❌ Mismatched braces: ${file} (${OPENS} opens, ${CLOSES} closes)${R}"
            CSS_ERRORS=$((CSS_ERRORS+1))
        else
            echo -e "  ${G}✓${R} ${file} (${OPENS} blocks)"
        fi
    done <<< "${STAGED_CSS}"

    if (( CSS_ERRORS > 0 )); then
        ERRORS=$((ERRORS+CSS_ERRORS))
    fi
else
    echo -e "  ${DIM}No CSS files staged${R}"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# 14. TRAILING WHITESPACE AUTO-FIX
# ═══════════════════════════════════════════════════════════════════════════════

echo -e "${B}14. Fixing trailing whitespace...${R}"

WS_FIXED=0
while IFS= read -r file; do
    [[ -z "${file}" ]] && continue
    [[ ! -f "${file}" ]] && continue

    # Skip binary files
    if file "${file}" | grep -q "binary\|executable"; then
        continue
    fi

    if grep -qP '\s+$' "${file}" 2>/dev/null; then
        sed -i 's/[[:space:]]*$//' "${file}"
        git add "${file}"
        WS_FIXED=$((WS_FIXED+1))
        ((FIXED++)) || true
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if (( WS_FIXED > 0 )); then
    echo -e "  ${G}✓${R} Fixed trailing whitespace in ${WS_FIXED} file(s)"
else
    echo -e "  ${G}✓${R} No trailing whitespace"
fi

# ═══════════════════════════════════════════════════════════════════════════════
# FINAL RESULT
# ═══════════════════════════════════════════════════════════════════════════════

ELAPSED=$(( ($(date +%s%N) - START_TIME) / 1000000 ))

echo ""
echo -e "${B}════════════════════════════════════════════════════${R}"

STAGED_COUNT=$(git diff --cached --name-only | wc -l)

if (( ERRORS > 0 )); then
    echo -e "${RED}${B}❌ PRE-COMMIT FAILED${R}"
    echo -e "  Errors:   ${RED}${ERRORS}${R}"
    echo -e "  Warnings: ${Y}${WARNINGS}${R}"
    echo -e "  Auto-fixed: ${G}${FIXED}${R}"
    echo -e "  Duration: ${DIM}${ELAPSED}ms${R}"
    echo ""
    echo -e "  ${Y}Fix the errors above, then try again.${R}"
    echo -e "  ${DIM}Bypass: git commit --no-verify${R}"
    echo ""
    exit 1
elif (( WARNINGS > 0 )); then
    echo -e "${Y}${B}⚠ PRE-COMMIT PASSED WITH WARNINGS${R}"
    echo -e "  Files:    ${C}${STAGED_COUNT}${R}"
    echo -e "  Warnings: ${Y}${WARNINGS}${R}"
    echo -e "  Auto-fixed: ${G}${FIXED}${R}"
    echo -e "  Duration: ${DIM}${ELAPSED}ms${R}"
    echo ""
else
    echo -e "${G}${B}✅ PRE-COMMIT PASSED${R}"
    echo -e "  Files:    ${C}${STAGED_COUNT}${R}"
    echo -e "  Auto-fixed: ${G}${FIXED}${R}"
    echo -e "  Duration: ${DIM}${ELAPSED}ms${R}"
    echo ""
fi