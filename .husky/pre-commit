#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  🪝 ASH DOTFILES v5.0 OMEGA — HUSKY PRE-COMMIT HOOK                        ║
# ║  Runs before every commit — the first line of defense                      ║
# ║  Fast, beautiful, comprehensive quality gate                               ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

set -euo pipefail

# ── ANSI PALETTE ──────────────────────────────────────────────────────────────
readonly ESC=$'\033'
readonly R="${ESC}[0m"           # Reset
readonly B="${ESC}[1m"           # Bold
readonly D="${ESC}[2m"           # Dim
readonly I="${ESC}[3m"           # Italic
readonly U="${ESC}[4m"           # Underline

# Foreground colors
readonly BLACK="${ESC}[30m"
readonly RED="${ESC}[31m"
readonly GREEN="${ESC}[32m"
readonly YELLOW="${ESC}[33m"
readonly BLUE="${ESC}[34m"
readonly MAGENTA="${ESC}[35m"
readonly CYAN="${ESC}[36m"
readonly WHITE="${ESC}[37m"
readonly ORANGE="${ESC}[38;5;208m"
readonly PURPLE="${ESC}[38;5;135m"
readonly PINK="${ESC}[38;5;213m"
readonly LIME="${ESC}[38;5;154m"
readonly GOLD="${ESC}[38;5;220m"
readonly SKY="${ESC}[38;5;117m"
readonly LAVENDER="${ESC}[38;5;183m"
readonly MINT="${ESC}[38;5;121m"
readonly PEACH="${ESC}[38;5;217m"
readonly ROSE="${ESC}[38;5;211m"
readonly TEAL="${ESC}[38;5;43m"
readonly CORAL="${ESC}[38;5;203m"
readonly CREAM="${ESC}[38;5;230m"

# Background colors
readonly BG_BLACK="${ESC}[40m"
readonly BG_RED="${ESC}[41m"
readonly BG_GREEN="${ESC}[42m"
readonly BG_BLUE="${ESC}[44m"
readonly BG_DARK="${ESC}[48;5;235m"
readonly BG_DARKER="${ESC}[48;5;232m"
readonly BG_NAVY="${ESC}[48;5;17m"
readonly BG_PURPLE="${ESC}[48;5;55m"
readonly BG_MIDNIGHT="${ESC}[48;5;16m"

# ── CONSTANTS ─────────────────────────────────────────────────────────────────
readonly HOOK_VERSION="5.0.0-omega"
readonly HOOK_NAME="pre-commit"
readonly START_TIME_MS="$(date +%s%3N)"
readonly REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
readonly STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
readonly STAGED_COUNT="$(echo "$STAGED_FILES" | grep -c . 2>/dev/null || echo 0)"

# Check categories
readonly MAX_FILE_SIZE_KB=5120   # 5MB max per file
readonly MAX_TOTAL_SIZE_MB=50    # 50MB max total staged

# ── STATE TRACKING ────────────────────────────────────────────────────────────
CHECKS_PASSED=0
CHECKS_FAILED=0
CHECKS_SKIPPED=0
CHECKS_WARNED=0
ERRORS=()
WARNINGS=()
CHECK_RESULTS=()
TOTAL_CHECKS=0

# ── TIMING ────────────────────────────────────────────────────────────────────
declare -A CHECK_TIMES=()

# ── TERMINAL WIDTH ────────────────────────────────────────────────────────────
TERM_WIDTH="$(tput cols 2>/dev/null || echo 80)"
readonly TERM_WIDTH

# ── UTILITY FUNCTIONS ─────────────────────────────────────────────────────────
hr() {
    local char="${1:-─}"
    local width="${2:-$TERM_WIDTH}"
    local color="${3:-$D}"
    printf "%s%s%s\n" "$color" "$(printf '%*s' "$width" '' | tr ' ' "$char")" "$R" >&2
}

center_text() {
    local text="$1"
    local width="${2:-$TERM_WIDTH}"
    # Strip ANSI for length calculation
    local clean_text
    clean_text="$(echo "$text" | sed 's/\x1b\[[0-9;]*m//g')"
    local text_len="${#clean_text}"
    local padding=$(( (width - text_len) / 2 ))
    printf "%*s%s%*s\n" "$padding" "" "$text" "$padding" "" >&2
}

now_ms() { date +%s%3N; }

elapsed_ms() {
    local start="$1"
    echo $(( $(now_ms) - start ))
}

format_ms() {
    local ms="$1"
    if [[ $ms -lt 1000 ]]; then
        echo "${ms}ms"
    else
        echo "$(( ms / 1000 )).$(( (ms % 1000) / 100 ))s"
    fi
}

# ── BANNER ────────────────────────────────────────────────────────────────────
print_banner() {
    printf "\n" >&2
    printf "%s%s" "$BG_MIDNIGHT" "$GOLD" >&2

    # Top border
    printf "  ╔" >&2
    printf '%*s' $(( TERM_WIDTH - 4 )) '' | tr ' ' '═' >&2
    printf "╗  \n" >&2

    # Title
    printf "  ║" >&2
    local title="${B}${GOLD}  🪝 ASH DOTFILES v5.0 OMEGA — PRE-COMMIT GATE${R}${BG_MIDNIGHT}${GOLD}"
    local title_clean="  🪝 ASH DOTFILES v5.0 OMEGA — PRE-COMMIT GATE"
    local title_pad=$(( TERM_WIDTH - 4 - ${#title_clean} - 2 ))
    printf " %s%s%*s  " "$B" "${GOLD}🪝 ASH DOTFILES v5.0 OMEGA — PRE-COMMIT GATE" \
        "$title_pad" "" >&2
    printf "║  \n" >&2

    # Subtitle
    printf "  ║" >&2
    local sub="  ${D}Quality • Security • Style — Your code guardian${R}${BG_MIDNIGHT}${GOLD}"
    printf "  %s%-*s%s" "${D}${CREAM}" \
        $(( TERM_WIDTH - 8 )) \
        "Quality • Security • Style — Your code guardian" \
        "$GOLD" >&2
    printf "  ║  \n" >&2

    # Divider
    printf "  ╠" >&2
    printf '%*s' $(( TERM_WIDTH - 4 )) '' | tr ' ' '═' >&2
    printf "╣  \n" >&2

    # Stats row
    printf "  ║  " >&2
    printf "%s%-18s%s %s%-12s%s" \
        "${CYAN}${B}" "Staged Files:" "$R$BG_MIDNIGHT$GOLD" \
        "${LIME}${B}" "${STAGED_COUNT}" "$R$BG_MIDNIGHT$GOLD" >&2
    printf " │ " >&2
    printf "%s%-12s%s %s%-20s%s" \
        "${CYAN}${B}" "Repository:" "$R$BG_MIDNIGHT$GOLD" \
        "${LAVENDER}" "$(basename "$REPO_ROOT")" "$R$BG_MIDNIGHT$GOLD" >&2
    local stats_len=$(( 18 + 12 + 12 + 20 + 6 + 6 ))
    printf "%*s  ║  \n" $(( TERM_WIDTH - 4 - stats_len - 4 )) "" >&2

    # Branch row
    printf "  ║  " >&2
    local branch; branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"
    local short_hash; short_hash="$(git rev-parse --short HEAD 2>/dev/null || echo "---")"
    printf "%s%-18s%s %s%-12s%s" \
        "${CYAN}${B}" "Branch:" "$R$BG_MIDNIGHT$GOLD" \
        "${ROSE}${B}" "$branch" "$R$BG_MIDNIGHT$GOLD" >&2
    printf " │ " >&2
    printf "%s%-12s%s %s%-20s%s" \
        "${CYAN}${B}" "HEAD:" "$R$BG_MIDNIGHT$GOLD" \
        "${PEACH}" "$short_hash" "$R$BG_MIDNIGHT$GOLD" >&2
    printf "%*s  ║  \n" $(( TERM_WIDTH - 4 - stats_len - 4 )) "" >&2

    # Bottom border
    printf "  ╚" >&2
    printf '%*s' $(( TERM_WIDTH - 4 )) '' | tr ' ' '═' >&2
    printf "╝  \n" >&2
    printf "%s\n" "$R" >&2
}

# ── CHECK RUNNER ──────────────────────────────────────────────────────────────
run_check() {
    local check_id="$1"
    local check_name="$2"
    local check_icon="$3"
    local check_fn="$4"
    local is_required="${5:-true}"

    ((TOTAL_CHECKS++)) || true
    local t_start; t_start="$(now_ms)"

    # Print running state
    printf "  %s %s%-40s%s %s%s%s" \
        "${check_icon}" \
        "${B}${WHITE}" "$check_name" "$R" \
        "${D}${CYAN}" "running..." "$R" >&2
    printf "\r" >&2

    # Run the check function, capture output
    local check_output=""
    local exit_code=0
    check_output="$($check_fn 2>&1)" || exit_code=$?

    local elapsed; elapsed="$(format_ms "$(elapsed_ms "$t_start")")"
    CHECK_TIMES["$check_id"]="$elapsed"

    if [[ $exit_code -eq 0 ]]; then
        ((CHECKS_PASSED++)) || true
        printf "  %s %s%-40s%s %s%-10s%s %s%s%s\n" \
            "${check_icon}" \
            "${B}${WHITE}" "$check_name" "$R" \
            "${GREEN}${B}" "✓ PASS" "$R" \
            "${D}" "[$elapsed]" "$R" >&2
        CHECK_RESULTS+=("PASS:${check_name}:${elapsed}")

    elif [[ $exit_code -eq 2 ]]; then
        # Exit code 2 = warning (non-fatal)
        ((CHECKS_WARNED++)) || true
        printf "  %s %s%-40s%s %s%-10s%s %s%s%s\n" \
            "${check_icon}" \
            "${B}${WHITE}" "$check_name" "$R" \
            "${YELLOW}${B}" "⚠ WARN" "$R" \
            "${D}" "[$elapsed]" "$R" >&2
        CHECK_RESULTS+=("WARN:${check_name}:${elapsed}")
        WARNINGS+=("${check_name}: ${check_output}")

    elif [[ $exit_code -eq 3 ]]; then
        # Exit code 3 = skipped
        ((CHECKS_SKIPPED++)) || true
        printf "  %s %s%-40s%s %s%-10s%s %s%s%s\n" \
            "${check_icon}" \
            "${B}${WHITE}" "$check_name" "$R" \
            "${D}${WHITE}" "↷ SKIP" "$R" \
            "${D}" "[$elapsed]" "$R" >&2
        CHECK_RESULTS+=("SKIP:${check_name}:${elapsed}")

    else
        ((CHECKS_FAILED++)) || true
        printf "  %s %s%-40s%s %s%-10s%s %s%s%s\n" \
            "${check_icon}" \
            "${B}${WHITE}" "$check_name" "$R" \
            "${RED}${B}" "✗ FAIL" "$R" \
            "${D}" "[$elapsed]" "$R" >&2
        CHECK_RESULTS+=("FAIL:${check_name}:${elapsed}")
        ERRORS+=("${check_name}: ${check_output}")

        if [[ "$is_required" == "true" ]]; then
            # Print failure detail immediately
            if [[ -n "$check_output" ]]; then
                printf "\n" >&2
                echo "$check_output" | head -20 | while IFS= read -r line; do
                    printf "     %s│%s %s%s%s\n" \
                        "${RED}${D}" "$R" "${D}" "$line" "$R" >&2
                done
                printf "\n" >&2
            fi
        fi
    fi

    return $exit_code
}

# ── SECTION HEADER ────────────────────────────────────────────────────────────
print_section() {
    local icon="$1"
    local title="$2"
    local color="${3:-$CYAN}"
    printf "\n" >&2
    hr "─" "$TERM_WIDTH" "${D}"
    printf "  %s %s%s%s%s\n" \
        "$icon" \
        "${color}${B}" "$title" "$R" "" >&2
