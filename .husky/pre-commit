# ── CHECK: Git-crypt encrypted files ──────────────────────────────────────────
check_encrypted_secrets() {
    # Check if secrets/ dir is git-crypt protected
    if ! command -v git-crypt &>/dev/null; then
        return 3
    fi

    local unencrypted=()
    while IFS= read -r file; do
        [[ -f "$file" ]] || continue
        # If file is in secrets/ dir but not encrypted
        if [[ "$file" == secrets/* ]]; then
            if ! git-crypt status "$file" 2>/dev/null | grep -q "encrypted"; then
                unencrypted+=("$file")
            fi
        fi
    done <<< "$STAGED_FILES"

    if [[ ${#unencrypted[@]} -gt 0 ]]; then
        printf "Secrets not encrypted with git-crypt:\n"
        printf "  • %s\n" "${unencrypted[@]}"
        return 1
    fi
}

# ── CHECK: Script permissions ─────────────────────────────────────────────────
check_script_permissions() {
    local wrong_perms=()
    local needs_exec=()

    while IFS= read -r file; do
        [[ -f "$file" ]] || continue

        # Shell scripts should be executable
        if [[ "$file" == *.sh ]] || \
           [[ "$file" == ash-cli/ash ]] || \
           [[ "$file" == scripts/* ]]; then
            if [[ ! -x "$file" ]]; then
                needs_exec+=("$file")
            fi
        fi

        # Config files should NOT be executable
        if [[ "$file" == config/* ]] && \
           [[ "$file" != *.sh ]] && \
           [[ -x "$file" ]]; then
            wrong_perms+=("$file (should not be executable)")
        fi
    done <<< "$STAGED_FILES"

    if [[ ${#needs_exec[@]} -gt 0 ]]; then
        printf "Scripts missing execute permission:\n"
        printf "  • %s\n" "${needs_exec[@]}"
        printf "\nFix with: chmod +x <file>\n"
        return 2  # Warning
    fi

    if [[ ${#wrong_perms[@]} -gt 0 ]]; then
        printf "Files with incorrect permissions:\n"
        printf "  • %s\n" "${wrong_perms[@]}"
        return 2
    fi
}

# ── CHECK: Shebang lines ───────────────────────────────────────────────────────
check_shebangs() {
    local missing_shebang=()
    local bad_shebang=()

    while IFS= read -r file; do
        [[ -f "$file" ]] || continue
        [[ "$file" == *.sh ]] || continue

        local first_line
        first_line="$(head -1 "$file" 2>/dev/null || true)"

        if [[ -z "$first_line" ]] || [[ "$first_line" != "#!"* ]]; then
            missing_shebang+=("$file")
            continue
        fi

        # Check for portable shebang
        if echo "$first_line" | grep -qE '^#!/bin/(sh|bash|zsh)$'; then
            : # Direct path shebangs are OK
        elif echo "$first_line" | grep -qE '^#!/usr/bin/env (bash|sh|fish|python3|node)$'; then
            : # env shebangs preferred
        else
            bad_shebang+=("${file}: ${first_line}")
        fi
    done <<< "$STAGED_FILES"

    local issues=()
    [[ ${#missing_shebang[@]} -gt 0 ]] && \
        issues+=("Missing shebang: ${missing_shebang[*]}")
    [[ ${#bad_shebang[@]} -gt 0 ]] && \
        issues+=("Non-standard shebang: ${bad_shebang[*]}")

    if [[ ${#issues[@]} -gt 0 ]]; then
        printf "Shebang issues:\n"
        printf "  • %s\n" "${issues[@]}"
        return 2
    fi
}

