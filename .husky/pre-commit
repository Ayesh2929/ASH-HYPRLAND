    if [[ -z "$yaml_files" ]]; then
        return 3
    fi

    local failed=()

    while IFS= read -r file; do
        [[ -f "$file" ]] || continue

        if command -v yamllint &>/dev/null; then
            local yamllint_cfg="${REPO_ROOT}/.yamllint.yml"
            local output
            if [[ -f "$yamllint_cfg" ]]; then
                output="$(yamllint -c "$yamllint_cfg" "$file" 2>&1)" || {
                    failed+=("$file"$'\n'"$output")
                }
            else
                output="$(yamllint -d relaxed "$file" 2>&1)" || {
                    failed+=("$file"$'\n'"$output")
                }
            fi
        elif command -v python3 &>/dev/null; then
            local output
            if ! output="$(python3 -c "import yaml,sys; yaml.safe_load(open('$file'))" 2>&1)"; then
                failed+=("${file}: ${output}")
            fi
        fi
    done <<< "$yaml_files"

    if [[ ${#failed[@]} -gt 0 ]]; then
        printf "YAML validation failed:\n"
        printf "  %s\n" "${failed[@]}"
        return 1
    fi
}

