}

# ── STAGED FILE HELPERS ───────────────────────────────────────────────────────
get_staged_by_ext() {
    local ext="$1"
    echo "$STAGED_FILES" | grep -E "\.${ext}$" 2>/dev/null || true
}

has_staged_ext() {
    local ext="$1"
    echo "$STAGED_FILES" | grep -qE "\.${ext}$" 2>/dev/null
}

has_staged_pattern() {
    local pattern="$1"
    echo "$STAGED_FILES" | grep -qE "$pattern" 2>/dev/null
}

# ══════════════════════════════════════════════════════════════════════════════
#  CHECK FUNCTIONS
# ══════════════════════════════════════════════════════════════════════════════

# ── CHECK: No staged files ────────────────────────────────────────────────────
check_has_staged_files() {
    if [[ -z "$STAGED_FILES" ]] || [[ "$STAGED_COUNT" -eq 0 ]]; then
        echo "No staged files — nothing to commit"
        return 3  # Skip
    fi
}

# ── CHECK: Merge conflict markers ─────────────────────────────────────────────
check_no_conflict_markers() {
    local conflict_files=()
    local patterns=(
        "^<<<<<<< "
        "^>>>>>>> "
        "^=======$"
        "^||||||| "
    )

    while IFS= read -r file; do
        [[ -f "$file" ]] || continue
        # Skip binary files
        if file "$file" 2>/dev/null | grep -q "binary"; then
            continue
        fi
        for pattern in "${patterns[@]}"; do
            if grep -qP "$pattern" "$file" 2>/dev/null; then
                conflict_files+=("$file")
                break
            fi
        done
    done <<< "$STAGED_FILES"

    if [[ ${#conflict_files[@]} -gt 0 ]]; then
        printf "Conflict markers found in:\n"
        printf "  • %s\n" "${conflict_files[@]}"
        return 1
    fi
}

# ── CHECK: File size limits ────────────────────────────────────────────────────
check_file_sizes() {
    local oversized=()
    local total_kb=0

    while IFS= read -r file; do
        [[ -f "$file" ]] || continue
        local size_kb
        size_kb="$(du -k "$file" 2>/dev/null | cut -f1 || echo 0)"
        total_kb=$(( total_kb + size_kb ))

        if [[ $size_kb -gt $MAX_FILE_SIZE_KB ]]; then
            oversized+=("${file} (${size_kb}KB > ${MAX_FILE_SIZE_KB}KB limit)")
        fi
    done <<< "$STAGED_FILES"

    local total_mb=$(( total_kb / 1024 ))
    if [[ $total_mb -gt $MAX_TOTAL_SIZE_MB ]]; then
        echo "Total staged size ${total_mb}MB exceeds ${MAX_TOTAL_SIZE_MB}MB limit"
        return 1
    fi

    if [[ ${#oversized[@]} -gt 0 ]]; then
        printf "Files exceeding size limit:\n"
        printf "  • %s\n" "${oversized[@]}"
        return 1
    fi
}

# ── CHECK: No accidental secrets ──────────────────────────────────────────────
check_no_secrets() {
    # Pattern-based secret detection
    local secret_patterns=(
        # Generic secrets
        'password\s*=\s*["\047][^"\047]{8,}'
        'passwd\s*=\s*["\047][^"\047]{8,}'
        'secret\s*=\s*["\047][^"\047]{8,}'
        'api[_-]?key\s*=\s*["\047][^"\047]{16,}'
        'auth[_-]?token\s*=\s*["\047][^"\047]{16,}'
        'access[_-]?token\s*=\s*["\047][^"\047]{16,}'
        'private[_-]?key\s*=\s*["\047][^"\047]{16,}'

        # Cloud providers
        'AKIA[0-9A-Z]{16}'               # AWS access key
        'sk-[a-zA-Z0-9]{48}'             # OpenAI key
        'ghp_[a-zA-Z0-9]{36}'            # GitHub PAT
        'ghs_[a-zA-Z0-9]{36}'            # GitHub app token
        'glpat-[a-zA-Z0-9]{20}'          # GitLab PAT
        'xox[baprs]-[0-9a-zA-Z-]+'       # Slack token
        'AIza[0-9A-Za-z\-_]{35}'         # Google API key
        '[0-9]+-[0-9A-Za-z_]{32}\.apps\.googleusercontent\.com'  # Google OAuth
        'ya29\.[0-9A-Za-z\-_]+'          # Google OAuth token
        'DISCORD_TOKEN\s*=\s*["\047][A-Za-z0-9._-]{50,}'
        'TELEGRAM_BOT_TOKEN\s*=\s*[0-9]+:[A-Za-z0-9_-]{35}'

        # Private keys
        '-----BEGIN (RSA|EC|DSA|OPENSSH|PGP) PRIVATE KEY'
        '-----BEGIN PRIVATE KEY-----'

        # Database URLs
        'postgresql://[^:]+:[^@]+@'
        'mysql://[^:]+:[^@]+@'
        'mongodb\+srv://[^:]+:[^@]+@'
        'redis://[^:]+:[^@]+'
    )

    local found_secrets=()

    while IFS= read -r file; do
        [[ -f "$file" ]] || continue
        # Skip binary files and encrypted files
        if file "$file" 2>/dev/null | grep -q "binary"; then continue; fi
        if [[ "$file" == *.enc ]] || [[ "$file" == *.gpg ]] || \
           [[ "$file" == *.asc ]]; then continue; fi
        # Skip test fixtures — they may contain fake credentials
        if [[ "$file" == *test/fixtures/* ]]; then continue; fi

        for pattern in "${secret_patterns[@]}"; do
            local match
            match="$(grep -niP "$pattern" "$file" 2>/dev/null | head -1 || true)"
            if [[ -n "$match" ]]; then
                # Check if it's a false positive (template variable, example)
                if echo "$match" | grep -qiE \
                    '(example|sample|placeholder|your[-_]|<[A-Z_]+>|REPLACE|TODO|FIXME|test|dummy|fake|\$\{|\{\{)'; then
                    continue
                fi
                local line_num; line_num="$(echo "$match" | cut -d: -f1)"
                found_secrets+=("${file}:${line_num} — potential secret detected")
                break
            fi
        done
    done <<< "$STAGED_FILES"

    if [[ ${#found_secrets[@]} -gt 0 ]]; then
        printf "⚠️  Potential secrets detected:\n"
        printf "  • %s\n" "${found_secrets[@]}"
        printf "\nIf these are false positives, use:\n"
        printf "  git commit --no-verify   (bypass this hook)\n"
        printf "  # ash-secret-ignore      (add to end of line)\n"
        return 1
    fi
}

# ── CHECK: No debug artifacts ─────────────────────────────────────────────────
check_no_debug_artifacts() {
    local debug_patterns=(
        'console\.log('
        'print("DEBUG'
        'print(f"DEBUG'
        'debugger;'
        'var_dump('
        'dd('
        'die('
        'binding\.pry'
        'byebug'
        'puts "DEBUG'
        '# TODO: remove'
        '# HACK:'
        'TEMP_DEBUG'
        'echo "DEBUG'
        'printf "DEBUG'
    )

    local found=()

    while IFS= read -r file; do
        [[ -f "$file" ]] || continue
        if file "$file" 2>/dev/null | grep -q "binary"; then continue; fi

        for pattern in "${debug_patterns[@]}"; do
            local match
            match="$(grep -n "$pattern" "$file" 2>/dev/null | head -1 || true)"
            if [[ -n "$match" ]]; then
                local line_num; line_num="$(echo "$match" | cut -d: -f1)"
                found+=("${file}:${line_num} — $(echo "$match" | cut -d: -f2- | xargs)")
            fi
        done
    done <<< "$STAGED_FILES"

    if [[ ${#found[@]} -gt 0 ]]; then
        printf "Debug artifacts found:\n"
        printf "  • %s\n" "${found[@]}"
        return 2  # Warning only — not blocking
    fi
}

# ── CHECK: ShellCheck ─────────────────────────────────────────────────────────
check_shellcheck() {
    if ! command -v shellcheck &>/dev/null; then
        echo "shellcheck not installed — skipping"
        return 3
    fi

    local sh_files
    sh_files="$(get_staged_by_ext sh)"

    if [[ -z "$sh_files" ]]; then
        return 3  # No shell files staged
    fi

    local failed=()
    local shellcheck_opts=(
        "--severity=warning"
        "--format=tty"
        "--shell=bash"
        "--exclude=SC1091"   # Not following sourced files
        "--exclude=SC2034"   # Unused variables (too many false positives)
    )

    # Add REPO_ROOT's .shellcheckrc if exists
    if [[ -f "${REPO_ROOT}/.shellcheckrc" ]]; then
        shellcheck_opts+=("--rcfile=${REPO_ROOT}/.shellcheckrc")
    fi

    while IFS= read -r file; do
        [[ -f "$file" ]] || continue
        local output
        if ! output="$(shellcheck "${shellcheck_opts[@]}" "$file" 2>&1)"; then
            failed+=("$file")
            printf "%s\n" "$output"
        fi
    done <<< "$sh_files"

    if [[ ${#failed[@]} -gt 0 ]]; then
        printf "\nShellCheck failed on: %s\n" "${failed[*]}"
        return 1
    fi
}

# ── CHECK: Luacheck ───────────────────────────────────────────────────────────
check_luacheck() {
    if ! command -v luacheck &>/dev/null; then
        echo "luacheck not installed — skipping"
        return 3
    fi

    local lua_files
    lua_files="$(get_staged_by_ext lua)"

    if [[ -z "$lua_files" ]]; then
        return 3
    fi

    local luacheck_opts=(
        "--no-color"
        "--max-line-length=120"
        "--ignore=212"    # Unused argument
        "--ignore=213"    # Unused loop variable
    )

    if [[ -f "${REPO_ROOT}/.luacheckrc" ]]; then
        luacheck_opts+=("--config=${REPO_ROOT}/.luacheckrc")
    fi

    local output
    # shellcheck disable=SC2086
    if ! output="$(luacheck "${luacheck_opts[@]}" $lua_files 2>&1)"; then
        printf "%s\n" "$output"
        return 1
    fi
}

# ── CHECK: Fish syntax ────────────────────────────────────────────────────────
check_fish_syntax() {
    if ! command -v fish &>/dev/null; then
        echo "fish not installed — skipping"
        return 3
    fi

    local fish_files
    fish_files="$(get_staged_by_ext fish)"

    if [[ -z "$fish_files" ]]; then
        return 3
    fi

    local failed=()
    while IFS= read -r file; do
        [[ -f "$file" ]] || continue
        local output
        if ! output="$(fish --no-execute "$file" 2>&1)"; then
            failed+=("$file: $output")
        fi
    done <<< "$fish_files"

    if [[ ${#failed[@]} -gt 0 ]]; then
        printf "Fish syntax errors:\n"
        printf "  • %s\n" "${failed[@]}"
        return 1
    fi
}

# ── CHECK: Python syntax & linting ───────────────────────────────────────────
check_python() {
    local py_files
    py_files="$(get_staged_by_ext py)"

    if [[ -z "$py_files" ]]; then
        return 3
    fi

    local failed=()

    # Syntax check with python3
    if command -v python3 &>/dev/null; then
        while IFS= read -r file; do
            [[ -f "$file" ]] || continue
            local output
            if ! output="$(python3 -m py_compile "$file" 2>&1)"; then
                failed+=("Syntax: $file — $output")
            fi
        done <<< "$py_files"
    fi

    # Ruff lint (fast Python linter)
    if command -v ruff &>/dev/null; then
        local ruff_output
        # shellcheck disable=SC2086
        if ! ruff_output="$(ruff check --no-cache $py_files 2>&1)"; then
            failed+=("$ruff_output")
        fi
    fi

    if [[ ${#failed[@]} -gt 0 ]]; then
        printf "Python issues:\n"
        printf "  • %s\n" "${failed[@]}"
        return 1
    fi
}

# ── CHECK: TypeScript / ESLint ────────────────────────────────────────────────
check_typescript() {
    local ts_files
    ts_files="$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx)$' 2>/dev/null || true)"

    if [[ -z "$ts_files" ]]; then
        return 3
    fi

    if ! command -v eslint &>/dev/null; then
        echo "eslint not found — skipping"
        return 3
    fi

    local output
    # shellcheck disable=SC2086
    if ! output="$(eslint --no-error-on-unmatched-pattern \
        --format=compact \
        $ts_files 2>&1)"; then
        printf "%s\n" "$output"
        return 1
    fi
}

# ── CHECK: JSON validity ──────────────────────────────────────────────────────
check_json() {
    local json_files
    json_files="$(echo "$STAGED_FILES" | grep -E '\.(json|jsonc)$' 2>/dev/null || true)"

    if [[ -z "$json_files" ]]; then
        return 3
    fi

    local failed=()

    while IFS= read -r file; do
        [[ -f "$file" ]] || continue

        # For .jsonc files, strip comments before validating
        local content="$file"
        if [[ "$file" == *.jsonc ]]; then
            content="$(sed 's|//[^"]*$||g; s|/\*.*\*/||g' "$file" 2>/dev/null)"
        fi

        local output
        if command -v jq &>/dev/null; then
            if ! output="$(jq empty < "$file" 2>&1)"; then
                failed+=("${file}: ${output}")
            fi
        elif command -v python3 &>/dev/null; then
            if ! output="$(python3 -m json.tool "$file" > /dev/null 2>&1)"; then
                failed+=("${file}: invalid JSON")
            fi
        fi
    done <<< "$json_files"

    if [[ ${#failed[@]} -gt 0 ]]; then
        printf "Invalid JSON/JSONC:\n"
