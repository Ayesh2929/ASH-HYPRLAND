# ── CHECK: No large binary files ──────────────────────────────────────────────
check_no_large_binaries() {
    local large_bins=()

    while IFS= read -r file; do
        [[ -f "$file" ]] || continue

        # Check if binary
        if file "$file" 2>/dev/null | grep -q "binary\|image\|audio\|video"; then
            local size_kb
            size_kb="$(du -k "$file" 2>/dev/null | cut -f1 || echo 0)"
            if [[ $size_kb -gt 1024 ]]; then  # 1MB
                large_bins+=("${file} (${size_kb}KB)")
            fi
        fi
    done <<< "$STAGED_FILES"

    if [[ ${#large_bins[@]} -gt 0 ]]; then
        printf "Large binary files staged (consider git-lfs):\n"
        printf "  • %s\n" "${large_bins[@]}"
        return 2  # Warning
    fi
