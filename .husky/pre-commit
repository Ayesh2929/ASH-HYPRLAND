# ── CHECK: No trailing whitespace ─────────────────────────────────────────────
check_trailing_whitespace() {
    local found=()

    while IFS= read -r file; do
        [[ -f "$file" ]] || continue
        if file "$file" 2>/dev/null | grep -q "binary"; then continue; fi

        local output
        output="$(grep -nP '\s+$' "$file" 2>/dev/null | head -3 || true)"
        if [[ -n "$output" ]]; then
            found+=("$file")
        fi
    done <<< "$STAGED_FILES"

    if [[ ${#found[@]} -gt 0 ]]; then
        printf "Trailing whitespace in:\n"
        printf "  • %s\n" "${found[@]}"
        printf "\nAuto-fix with: sed -i 's/[[:space:]]*$//' <file>\n"
        return 1
    fi
}

# ── CHECK: No mixed line endings ──────────────────────────────────────────────
check_line_endings() {
    local found=()

    while IFS= read -r file; do
        [[ -f "$file" ]] || continue
        if file "$file" 2>/dev/null | grep -q "binary\|CRLF"; then
            if [[ "$file" != *.bat ]] && [[ "$file" != *.cmd ]] && \
               [[ "$file" != *.ps1 ]]; then
                found+=("$file (CRLF line endings)")
            fi
        fi
    done <<< "$STAGED_FILES"

    if [[ ${#found[@]} -gt 0 ]]; then
        printf "CRLF line endings found:\n"
        printf "  • %s\n" "${found[@]}"
        printf "\nFix with: sed -i 's/\\r//' <file>\n"
        return 1
    fi
}

