# ── FINAL SUMMARY ─────────────────────────────────────────────────────────────
print_summary() {
    local total_elapsed; total_elapsed="$(format_ms "$(elapsed_ms "$START_TIME_MS")")"
    local exit_code="${1:-0}"

    printf "\n" >&2
    hr "═" "$TERM_WIDTH" "${D}" >&2

    # Status determination
    local status_icon status_color status_text status_bg
    if [[ $CHECKS_FAILED -gt 0 ]]; then
        status_icon="✗"
        status_color="${RED}${B}"
        status_text="COMMIT BLOCKED"
        status_bg="${BG_RED}"
    elif [[ $CHECKS_WARNED -gt 0 ]]; then
        status_icon="⚠"
        status_color="${YELLOW}${B}"
        status_text="COMMIT ALLOWED (WITH WARNINGS)"
        status_bg="${BG_DARK}"
    else
        status_icon="✓"
        status_color="${GREEN}${B}"
        status_text="ALL CHECKS PASSED"
        status_bg="${BG_DARK}"
    fi

    # Summary box
    printf "%s%s" "$BG_MIDNIGHT" "$GOLD" >&2
    printf "  ╔" >&2
    printf '%*s' $(( TERM_WIDTH - 4 )) '' | tr ' ' '═' >&2
    printf "╗  \n" >&2

    printf "  ║  %s %s  %-*s  ║  \n" \
        "${status_color}${status_icon}${R}${BG_MIDNIGHT}${GOLD}" \
        "${status_color}${status_text}${R}${BG_MIDNIGHT}${GOLD}" \
        $(( TERM_WIDTH - 14 - ${#status_text} )) "" >&2

    printf "  ╠" >&2
    printf '%*s' $(( TERM_WIDTH - 4 )) '' | tr ' ' '─' >&2
    printf "╣  \n" >&2

    # Metrics grid
    printf "  ║  " >&2
    printf "%s%s%-8s%s%s%-6s%s" \
        "${GREEN}${B}" "✓ " "$CHECKS_PASSED" "$R$BG_MIDNIGHT" \
        "${D}" "passed" "$R$BG_MIDNIGHT" >&2
    printf "  " >&2
    printf "%s%s%-8s%s%s%-6s%s" \
        "${RED}${B}" "✗ " "$CHECKS_FAILED" "$R$BG_MIDNIGHT" \
        "${D}" "failed" "$R$BG_MIDNIGHT" >&2
    printf "  " >&2
    printf "%s%s%-8s%s%s%-6s%s" \
        "${YELLOW}${B}" "⚠ " "$CHECKS_WARNED" "$R$BG_MIDNIGHT" \
        "${D}" "warned" "$R$BG_MIDNIGHT" >&2
    printf "  " >&2
    printf "%s%s%-8s%s%s%-6s%s" \
        "${D}${WHITE}" "↷ " "$CHECKS_SKIPPED" "$R$BG_MIDNIGHT" \
        "${D}" "skipped" "$R$BG_MIDNIGHT" >&2
    printf "  " >&2
    printf "%s%s%-8s%s%s%-6s%s" \
        "${CYAN}${B}" "⏱ " "$total_elapsed" "$R$BG_MIDNIGHT" \
        "${D}" "total" "$R$BG_MIDNIGHT" >&2
    local metrics_len=$(( 8+8+8+8+8 + 6+6+6+6+6 + 4+4+4+4 + 10 ))
    printf "%*s  ║  \n" $(( TERM_WIDTH - 4 - metrics_len - 4 )) "" >&2

    # Error details
    if [[ ${#ERRORS[@]} -gt 0 ]]; then
        printf "  ╠" >&2
        printf '%*s' $(( TERM_WIDTH - 4 )) '' | tr ' ' '─' >&2
        printf "╣  \n" >&2
        printf "  ║  %s%s%s\n" "${RED}${B}" "BLOCKING ERRORS:" "${R}${BG_MIDNIGHT}${GOLD}" >&2
        for err in "${ERRORS[@]}"; do
            local err_short; err_short="${err:0:$(( TERM_WIDTH - 12 ))}"
            printf "  ║    %s• %s%s%*s  ║  \n" \
                "${RED}" "$err_short" "$R$BG_MIDNIGHT$GOLD" \
                $(( TERM_WIDTH - 4 - 6 - ${#err_short} )) "" >&2
        done
    fi

    # Warning details
    if [[ ${#WARNINGS[@]} -gt 0 ]]; then
        printf "  ╠" >&2
        printf '%*s' $(( TERM_WIDTH - 4 )) '' | tr ' ' '─' >&2
        printf "╣  \n" >&2
        printf "  ║  %s%s%s\n" \
            "${YELLOW}${B}" "WARNINGS (non-blocking):" "${R}${BG_MIDNIGHT}${GOLD}" >&2
        for warn in "${WARNINGS[@]}"; do
            local warn_short; warn_short="${warn:0:$(( TERM_WIDTH - 12 ))}"
            printf "  ║    %s• %s%s%*s  ║  \n" \
                "${YELLOW}" "$warn_short" "$R$BG_MIDNIGHT$GOLD" \
                $(( TERM_WIDTH - 4 - 6 - ${#warn_short} )) "" >&2
        done
    fi

    # Footer
    printf "  ╠" >&2
    printf '%*s' $(( TERM_WIDTH - 4 )) '' | tr ' ' '─' >&2
    printf "╣  \n" >&2

    if [[ $CHECKS_FAILED -gt 0 ]]; then
        printf "  ║  %s  Fix errors above, then re-stage and commit%s%*s  ║  \n" \
            "${D}" "$R$BG_MIDNIGHT$GOLD" \
            $(( TERM_WIDTH - 4 - 48 )) "" >&2
        printf "  ║  %s  Skip hooks (emergency): git commit --no-verify%s%*s  ║  \n" \
            "${D}" "$R$BG_MIDNIGHT$GOLD" \
            $(( TERM_WIDTH - 4 - 52 )) "" >&2
    else
        printf "  ║  %s  All checks passed! Proceeding to commit...%s%*s  ║  \n" \
            "${LIME}" "$R$BG_MIDNIGHT$GOLD" \
            $(( TERM_WIDTH - 4 - 49 )) "" >&2
    fi

    printf "  ╚" >&2
    printf '%*s' $(( TERM_WIDTH - 4 )) '' | tr ' ' '═' >&2
    printf "╝  \n" >&2
    printf "%s\n\n" "$R" >&2
}

# ── SKIP CONDITION ────────────────────────────────────────────────────────────
should_skip() {
    # Skip in CI environments (hooks don't run in CI anyway, but just in case)
    if [[ "${CI:-}" == "true" ]] || [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
        return 0
    fi

    # Skip if ASH_SKIP_HOOKS is set
    if [[ "${ASH_SKIP_HOOKS:-}" == "true" ]]; then
        printf "%s⚡ ASH_SKIP_HOOKS=true — skipping all checks%s\n" \
            "$YELLOW" "$R" >&2
        return 0
    fi

    return 1
}

# ══════════════════════════════════════════════════════════════════════════════
#  MAIN EXECUTION
# ══════════════════════════════════════════════════════════════════════════════
main() {
    if should_skip; then
        exit 0
    fi

    print_banner

    # ── SECTION 1: PRE-FLIGHT ────────────────────────────────────────────────
    print_section "🛫" "Pre-flight Checks" "$CYAN"
    run_check "staged_files"   "Staged Files"          "📂" check_has_staged_files   "false"
    [[ $CHECKS_SKIPPED -eq 1 ]] && {
        printf "\n  %sNothing staged — nothing to check.%s\n\n" "$D" "$R" >&2
        exit 0
    }
    run_check "env_files"      "No .env Files"         "🔐" check_no_env_files       "true"
    run_check "file_sizes"     "File Size Limits"      "📏" check_file_sizes         "true"
    run_check "large_binaries" "No Large Binaries"     "🗜️" check_no_large_binaries  "false"
    run_check "line_endings"   "Line Endings (LF)"     "↩️" check_line_endings       "true"
    run_check "whitespace"     "No Trailing Whitespace" "🔍" check_trailing_whitespace "true"
    run_check "conflicts"      "No Conflict Markers"   "⚔️" check_no_conflict_markers "true"

    # ── SECTION 2: SECURITY ──────────────────────────────────────────────────
    print_section "🔒" "Security Checks" "$RED"
    run_check "secrets"        "No Secrets Exposed"    "🔑" check_no_secrets          "true"
    run_check "encrypted"      "Secrets Encrypted"     "🛡️" check_encrypted_secrets   "true"
    run_check "permissions"    "File Permissions"      "🔏" check_script_permissions   "false"

    # ── SECTION 3: SYNTAX & LINT ─────────────────────────────────────────────
    print_section "🔬" "Syntax & Lint Checks" "$YELLOW"
    run_check "shellcheck"     "ShellCheck"            "🐚" check_shellcheck           "true"
    run_check "luacheck"       "LuaCheck"              "🌙" check_luacheck             "true"
    run_check "stylua"         "StyLua Format"         "🎨" check_stylua               "true"
    run_check "fish_syntax"    "Fish Syntax"           "🐟" check_fish_syntax          "true"
    run_check "python"         "Python Lint"           "🐍" check_python               "true"
    run_check "typescript"     "TypeScript/ESLint"     "⚡" check_typescript           "true"
    run_check "dart_format"    "Dart Format"           "🎯" check_dart_format          "true"
    run_check "shebangs"       "Shebang Lines"         "📜" check_shebangs             "false"

    # ── SECTION 4: DATA FORMAT VALIDATION ────────────────────────────────────
    print_section "📋" "Data Format Validation" "$BLUE"
    run_check "json"           "JSON/JSONC Valid"      "📄" check_json                 "true"
    run_check "yaml"           "YAML Valid"            "📝" check_yaml                 "true"
    run_check "toml"           "TOML Valid"            "⚙️" check_toml                 "true"
    run_check "markdown"       "Markdown Lint"         "📖" check_markdown             "false"
    run_check "nix_format"     "Nix Format"            "❄️" check_nix_format           "false"

    # ── SECTION 5: ASH-SPECIFIC ───────────────────────────────────────────────
    print_section "🌊" "ASH-Specific Validation" "$PURPLE"
    run_check "theme_schema"   "Theme Schema"          "🎨" check_theme_schema         "true"
    run_check "plugin_schema"  "Plugin Schema"         "🔌" check_plugin_schema        "true"
    run_check "hypr_syntax"    "Hyprland Syntax"       "🖥️" check_hyprland_syntax      "true"
    run_check "version_sync"   "Version Consistency"   "🏷️" check_version_consistency   "true"

    # ── SECTION 6: CODE QUALITY ────────────────────────────────────────────────
    print_section "✨" "Code Quality" "$MINT"
    run_check "debug_artifacts" "No Debug Artifacts"  "🐛" check_no_debug_artifacts    "false"
    run_check "todos_critical"  "TODOs in Critical"   "📌" check_no_todos_in_critical   "false"
    run_check "editorconfig"    "EditorConfig"        "⚙️" check_editorconfig           "false"

    # ── PRINT SUMMARY ────────────────────────────────────────────────────────
    print_summary "$CHECKS_FAILED"

    # ── EXIT CODE ─────────────────────────────────────────────────────────────
    if [[ $CHECKS_FAILED -gt 0 ]]; then
        exit 1
    fi

    exit 0
}

main "$@"