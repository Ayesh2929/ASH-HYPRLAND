# ── CHECK: No TODO/FIXME in critical files ─────────────────────────────────────
check_no_todos_in_critical() {
    local critical_patterns=(
        "^ash-cli/lib/"
        "^ash-cli/engines/"
        "^ash-cli/api/"
        "^scripts/install/"
        "^scripts/security/"
        "^api/"
    )

    local found=()
    while IFS= read -r file; do
        [[ -f "$file" ]] || continue

        # Check if file matches critical pattern
        local is_critical=false
        for pattern in "${critical_patterns[@]}"; do
            if echo "$file" | grep -qE "$pattern"; then
                is_critical=true
                break
            fi
        done
        [[ "$is_critical" == "true" ]] || continue

        local output
        output="$(grep -nE '(TODO|FIXME|HACK|XXX|BUG):' "$file" 2>/dev/null | \
            head -3 || true)"
        if [[ -n "$output" ]]; then
            while IFS= read -r line; do
                found+=("${file}: $line")
            done <<< "$output"
        fi
    done <<< "$STAGED_FILES"

    if [[ ${#found[@]} -gt 0 ]]; then
        printf "TODO/FIXME in critical files:\n"
        printf "  • %s\n" "${found[@]}"
        return 2  # Warning
    fi
}

# ── CHECK: ASH CLI version consistency ────────────────────────────────────────
check_version_consistency() {
    local version_file="${REPO_ROOT}/version.json"
    local cli_version_file="${REPO_ROOT}/ash-cli/data/version.json"

    if [[ ! -f "$version_file" ]] || [[ ! -f "$cli_version_file" ]]; then
        return 3
    fi

    # Check if either version file is staged
    if ! echo "$STAGED_FILES" | grep -qE "version\.json$"; then
        return 3
    fi

    if ! command -v jq &>/dev/null; then
        return 3
    fi

    local root_ver cli_ver
    root_ver="$(jq -r '.version // empty' "$version_file" 2>/dev/null || true)"
    cli_ver="$(jq -r '.version // empty' "$cli_version_file" 2>/dev/null || true)"

    if [[ -n "$root_ver" ]] && [[ -n "$cli_ver" ]] && \
       [[ "$root_ver" != "$cli_ver" ]]; then
        printf "Version mismatch:\n"
        printf "  root version.json: %s\n" "$root_ver"
        printf "  cli version.json:  %s\n" "$cli_ver"
        return 1
    fi
}

