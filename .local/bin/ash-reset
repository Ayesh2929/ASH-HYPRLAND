#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║           ASH DOTFILES v3.0 — ASH-RESET                                    ║
# ║           Reset dotfiles to known-good state                               ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

set -euo pipefail

readonly ASH_DOTFILES="${HOME}/.dotfiles"
readonly ASH_CONFIG="${HOME}/.config"
readonly ASH_CACHE="${HOME}/.cache/ash-dots"

readonly RESET='\033[0m'
readonly RED='\033[91m'
readonly GREEN='\033[92m'
readonly YELLOW='\033[93m'
readonly CYAN='\033[96m'
readonly BOLD='\033[1m'

info()  { echo -e "  ${CYAN}→${RESET} $*"; }
ok()    { echo -e "  ${GREEN}✓${RESET} $*"; }
warn()  { echo -e "  ${YELLOW}⚠${RESET} $*"; }
err()   { echo -e "  ${RED}✗${RESET} $*" >&2; }

show_help() {
    echo -e "${BOLD}ash-reset${RESET} — Reset ASH dotfiles"
    echo ""
    echo "USAGE: ash-reset [MODE]"
    echo ""
    echo "MODES:"
    echo "  soft         Reload all configs (non-destructive)"
    echo "  theme        Reset to default theme only"
    echo "  cache        Clear all caches"
    echo "  hard         Full reset (⚠️  destructive!)"
    echo "  interactive  Choose what to reset (default)"
}

reset_soft() {
    info "Soft reset — reloading all configs..."
    ash reload all 2>/dev/null && ok "All configs reloaded"
}

reset_theme() {
    info "Resetting theme to defaults..."
    rm -f "${ASH_CACHE}/colors/current.json" 2>/dev/null || true
    rm -f "${ASH_CACHE}/colors/current.sh"   2>/dev/null || true
    rm -f "${ASH_CACHE}/wallpaper/last"       2>/dev/null || true

    # Apply fallback theme
    "${ASH_CONFIG}/hypr/scripts/theme/theme-engine.sh" "" boot
    ok "Theme reset to defaults"
}

reset_cache() {
    info "Clearing all caches..."
    rm -rf "${ASH_CACHE}/thumbnails/"  2>/dev/null || true
    rm -f  "${ASH_CACHE}/"*.json       2>/dev/null || true
    rm -f  "${ASH_CACHE}/"*.txt        2>/dev/null || true
    ok "Caches cleared"
}

reset_hard() {
    echo -e "  ${RED}${BOLD}⚠️  HARD RESET WARNING${RESET}"
    echo ""
    echo "  This will:"
    echo "  • Remove all generated theme files"
    echo "  • Clear all caches"
    echo "  • Reset UserOverrides to template"
    echo "  • Reload all configurations"
    echo ""
    read -rp "  Type 'RESET' to confirm: " confirm

    if [[ "${confirm}" != "RESET" ]]; then
        info "Reset cancelled"
        return 0
    fi

    reset_cache
    reset_theme

    # Reset user overrides to template
    local user_conf="${ASH_CONFIG}/hypr/UserOverrides/user.conf"
    if [[ -f "${user_conf}" ]]; then
        cp "${user_conf}" "${user_conf}.bak.$(date +%s)"
        warn "Backed up: ${user_conf}.bak.*"
    fi

    cat > "${user_conf}" << 'EOF'
# ASH DOTFILES v3.0 — User Overrides (Reset to Template)
# Add your personal customizations here

# Monitor configuration
# monitor = ,preferred,auto,auto
EOF

    ok "UserOverrides reset to template"

    reset_soft
    ok "Hard reset complete"
}

reset_interactive() {
    echo -e "  ${BOLD}🔄 ASH Reset Tool${RESET}"
    echo ""
    echo "  Choose reset mode:"
    echo "  1) Soft reset    — Reload all configs"
    echo "  2) Theme reset   — Reset colors to default"
    echo "  3) Cache clear   — Clear all caches"
    echo "  4) Hard reset    — Full reset (destructive)"
    echo "  5) Cancel"
    echo ""
    read -rp "  Choice [1-5]: " choice

    case "${choice}" in
        1) reset_soft ;;
        2) reset_theme ;;
        3) reset_cache ;;
        4) reset_hard ;;
        5) info "Cancelled" ;;
        *) warn "Invalid choice" ;;
    esac
}

main() {
    local mode="${1:-interactive}"

    case "${mode}" in
        soft)        reset_soft ;;
        theme)       reset_theme ;;
        cache)       reset_cache ;;
        hard)        reset_hard ;;
        interactive) reset_interactive ;;
        help | -h | --help) show_help ;;
        *)
            err "Unknown mode: ${mode}"
            show_help
            exit 1
            ;;
    esac
}

main "$@"