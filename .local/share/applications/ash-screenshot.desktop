[Desktop Entry]
Version=1.0
Type=Application
Name=ASH Screenshot
GenericName=Screenshot Tool
Comment=Take screenshots with multiple modes
Exec=ash shot area
Icon=applets-screenshooter
Terminal=false
Categories=Graphics;Photography;
Keywords=screenshot;capture;screen;ash;
StartupNotify=false
NoDisplay=false

Actions=Full;Area;Window;Edit;OCR;

[Desktop Action Full]
Name=Full Screen
Exec=ash shot full
Icon=camera-photo

[Desktop Action Area]
Name=Area Selection
Exec=ash shot area
Icon=camera-photo

[Desktop Action Window]
Name=Active Window
Exec=ash shot window
Icon=camera-photo

[Desktop Action Edit]
Name=Area → Edit
Exec=ash shot edit
Icon=image-x-generic

[Desktop Action OCR]
Name=OCR (Text Extract)
Exec=ash shot ocr
Icon=edit-find