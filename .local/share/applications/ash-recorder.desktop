[Desktop Entry]
Version=1.0
Type=Application
Name=ASH Screen Recorder
GenericName=Screen Recording Tool
Comment=Record screen with audio support
Exec=ash shot area
Icon=media-record
Terminal=false
Categories=AudioVideo;Video;
Keywords=record;screen;video;capture;ash;
StartupNotify=false
NoDisplay=false

Actions=Toggle;Area;Audio;Stop;

[Desktop Action Toggle]
Name=Toggle Recording
Exec=bash -c '~/.config/hypr/scripts/media/recorder.sh toggle'
Icon=media-record

[Desktop Action Area]
Name=Record Area
Exec=bash -c '~/.config/hypr/scripts/media/recorder.sh area'
Icon=media-record

[Desktop Action Audio]
Name=Record with Audio
Exec=bash -c '~/.config/hypr/scripts/media/recorder.sh audio'
Icon=audio-volume-high

[Desktop Action Stop]
Name=Stop Recording
Exec=bash -c '~/.config/hypr/scripts/media/recorder.sh stop'
Icon=media-playback-stop