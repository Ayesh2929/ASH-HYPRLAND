[Desktop Entry]
Version=1.0
Type=Application
Name=ASH Settings
GenericName=Dotfiles Manager
Comment=Manage ASH dotfiles and system settings
Exec=kitty --class=ash-settings -e ash help
Icon=preferences-system
Terminal=false
Categories=Settings;System;
Keywords=settings;config;dotfiles;ash;hyprland;
StartupNotify=false
NoDisplay=false

Actions=Doctor;Update;Reload;Backup;

[Desktop Action Doctor]
Name=Health Check
Exec=kitty --class=ash-doctor -e ash doctor
Icon=dialog-information

[Desktop Action Update]
Name=Update Dotfiles
Exec=kitty --class=ash-update -e ash update
Icon=system-software-update

[Desktop Action Reload]
Name=Reload Configs
Exec=ash reload all
Icon=view-refresh

[Desktop Action Backup]
Name=Backup Configuration
Exec=ash backup
Icon=document-save