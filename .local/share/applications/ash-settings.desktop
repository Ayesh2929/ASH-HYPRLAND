[Desktop Entry]
Version=1.0
Type=Application
Name=ASH Settings
GenericName=Dotfiles Manager
Comment=Manage ASH Hyprland dotfiles and system configuration
Exec=kitty --class=ash-settings --title="ASH Settings" -e ash help
Icon=preferences-system
Terminal=false
Categories=Settings;System;
Keywords=settings;hyprland;wayland;dotfiles;ash;config;
StartupNotify=false
NoDisplay=false
X-ASH-Version=3.0.0

Actions=Doctor;Update;Reload;Backup;Theme;

[Desktop Action Doctor]
Name=Run Health Check
Exec=kitty --class=ash-doctor --title="ASH Doctor" -e ash doctor
Icon=dialog-information

[Desktop Action Update]
Name=Update Everything
Exec=kitty --class=ash-update --title="ASH Update" -e ash update
Icon=system-software-update

[Desktop Action Reload]
Name=Reload All Configs
Exec=ash reload all
Icon=view-refresh

[Desktop Action Backup]
Name=Backup Configuration
Exec=ash backup
Icon=document-save

[Desktop Action Theme]
Name=Pick Wallpaper & Theme
Exec=ash theme pick
Icon=preferences-desktop-wallpaper