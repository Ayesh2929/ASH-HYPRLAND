# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔷 COMMAND DISPATCHER
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_ash_dispatch() {
    local command="${1:-}"
    shift || true
    local -a args=("$@")

    # ── Handle empty invocation ──────────────────────────────────────────
    if [[ -z "$command" ]]; then
        _ash_print_help
        return 0
    fi

    # ── Built-in commands ────────────────────────────────────────────────
    case "$command" in
        help|-h|--help)
            _ash_print_help
            return 0
            ;;
        version|-V|--version)
            _ash_print_version
            return 0
            ;;
        --completions|completions|completion)
            local shell="${args[0]:-bash}"
            case "$shell" in
                ""|--help|-h|help)
                    printf '\nUsage: ash completion <shell>\n\n'
                    printf 'Print the shell completion script for bash, zsh, fish or powershell.\n\n'
                    printf 'Examples:\n'
                    printf '  ash completion bash > ~/.local/share/bash-completion/completions/ash\n'
                    printf '  ash completion fish > ~/.config/fish/completions/ash.fish\n\n'
                    return 0
                    ;;
            esac
            local comp_file="${ASH_CMD_DIR}/completion/ash.${shell}"
            if [[ -f "$comp_file" ]]; then
                cat "$comp_file"
            else
                ash_log_error "No completions available for shell: ${shell}"
                printf 'Available: bash, zsh, fish, ps1\n' >&2
                return 1
            fi
            return 0
            ;;
    esac

    # ── Lookup command in registry ───────────────────────────────────────
    local registry_entry="${ASH_COMMANDS[$command]:-}"

    if [[ -z "$registry_entry" ]]; then
        _ash_handle_unknown_command "$command"
        return 1
    fi

    # ── Parse registry entry ─────────────────────────────────────────────
    local cmd_file desc category
    IFS='|' read -r cmd_file desc category <<< "$registry_entry"

    local full_cmd_path="${ASH_CLI_DIR}/${cmd_file}"

    if [[ ! -f "$full_cmd_path" ]]; then
        ash_log_error "Command file not found: ${full_cmd_path}"
        ash_log_error "This is a bug — please report at: ${ASH_REPO}/issues"
        return 127
    fi

    if [[ ! -x "$full_cmd_path" ]]; then
        chmod +x "$full_cmd_path" 2>/dev/null || {
            ash_log_error "Cannot execute: ${full_cmd_path}"
            return 126
        }
    fi

    # ── Pre-execution hooks ──────────────────────────────────────────────
    if [[ $ASH_FLAG_NO_HOOKS -eq 0 ]]; then
        ash_hook_run "pre_command" \
            --command="$command" \
            --args="${args[*]:-}" 2>/dev/null || true
    fi

    # ── Telemetry (anonymous, opt-in) ────────────────────────────────────
    ash_telemetry_record_command "$command" 2>/dev/null || true

    # ── Execute command ──────────────────────────────────────────────────
    local exit_code=0

    if [[ $ASH_FLAG_DRY_RUN_EARLY -eq 1 ]]; then
        ash_log_info "[DRY RUN] Would execute: ${cmd_file} ${args[*]:-}"
    else
        ASH_CURRENT_COMMAND="$command"
        local cmd_func="ash_cmd_${category//-/_}"

        # Run the command in a SUBSHELL.
        #
        # Nearly every command file opens with `set -euo pipefail`. Sourcing one
        # into this shell therefore rewrites the dispatcher's own error handling
        # for the rest of the invocation — and a command that calls `exit` takes
        # the dispatcher with it, skipping the post-execution hooks below.
        #
        # A subshell gives each command the strict mode it wants for its own body
        # while leaving this shell's options untouched. The exit status is
        # propagated through `exit_code` as before.
        (
            # shellcheck source=/dev/null
            source "$full_cmd_path"

            if declare -f "$cmd_func" &>/dev/null; then
                "$cmd_func" "${args[@]:-}"
            else
                ash_log_error "Command function not found: ${cmd_func}"
                exit 1
            fi
        ) || exit_code=$?
    fi

    # ── Post-execution hooks ─────────────────────────────────────────────
    if [[ $ASH_FLAG_NO_HOOKS -eq 0 ]]; then
        ash_hook_run "post_command" \
            --command="$command" \
            --exit_code="$exit_code" 2>/dev/null || true
    fi

    return $exit_code
}

_ash_handle_unknown_command() {
    local cmd="$1"

    # Fuzzy match — find similar commands
    local -a suggestions=()
    local cmd_lower="${cmd,,}"

    for registered_cmd in "${!ASH_COMMANDS[@]}"; do
        # Simple prefix match or substring match
        if [[ "$registered_cmd" == "${cmd_lower}"* ]] || \
           [[ "$registered_cmd" == *"${cmd_lower}"* ]]; then
            suggestions+=("$registered_cmd")
        fi
    done

    if [[ $ASH_FLAG_NO_COLOR -eq 0 ]]; then
        printf '\n\033[1;31m✗\033[0m Unknown command: \033[1m%s\033[0m\n\n' "$cmd" >&2
    else
        printf '\nUnknown command: %s\n\n' "$cmd" >&2
    fi

    if [[ ${#suggestions[@]} -gt 0 ]]; then
        printf 'Did you mean:\n' >&2
        for sug in "${suggestions[@]}"; do
            local entry="${ASH_COMMANDS[$sug]}"
            local sug_desc
            IFS='|' read -r _ sug_desc _ <<< "$entry"
            if [[ $ASH_FLAG_NO_COLOR -eq 0 ]]; then
                printf '   \033[38;2;137;180;250m%-15s\033[0m %s\n' "$sug" "$sug_desc" >&2
            else
                printf '   %-15s %s\n' "$sug" "$sug_desc" >&2
            fi
        done
        printf '\n' >&2
    fi

    printf "Run 'ash help' to see all available commands.\n" >&2
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔷 SIGNAL & TRAP HANDLING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_ash_cleanup() {
    local exit_code="${1:-0}"

    # Remove PID file
    [[ -f "$ASH_PID_FILE" ]] && rm -f "$ASH_PID_FILE" 2>/dev/null || true

    # Release locks
    [[ -f "$ASH_LOCK_FILE" ]] && rm -f "$ASH_LOCK_FILE" 2>/dev/null || true

    # Clear temp runtime files
    find "${ASH_RUNTIME_DIR}" -maxdepth 1 -name "ash-tmp-*" \
        -delete 2>/dev/null || true

    exit "$exit_code"
}

_ash_setup_traps() {
    trap '_ash_cleanup $?' EXIT
    trap '_ash_cleanup 130' INT
    trap '_ash_cleanup 143' TERM
    trap '_ash_cleanup 1'   HUP

    # Error trap with context
    trap '_ash_error_handler $LINENO "$BASH_COMMAND" $?' ERR
}

_ash_error_handler() {
    local line="$1"
    local cmd="$2"
    local code="${3:-1}"

    # Don't report on intentional exits
    [[ $code -eq 0 ]] && return 0

    if [[ $ASH_FLAG_DEBUG -eq 1 ]]; then
        ash_log_debug "Error at line ${line}: '${cmd}' (exit ${code})"
    fi
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔷 PID MANAGEMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

_ash_write_pid() {
    mkdir -p "$(dirname "$ASH_PID_FILE")" 2>/dev/null || true
    printf '%d\n' "$$" > "$ASH_PID_FILE" 2>/dev/null || true
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔷 MAIN ENTRY POINT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

main() {
    # ── Phase 1: Terminal detection ──────────────────────────────────────
    _ash_detect_terminal

    # ── Phase 2: Parse global flags (before bootstrap) ───────────────────
    _ash_parse_global_flags "$@"
    set -- "${ASH_REMAINING_ARGS[@]:-}"

    # ── Phase 3: Apply no-color / no-unicode overrides ───────────────────
    [[ "${NO_COLOR:-}" != "" ]] && ASH_FLAG_NO_COLOR=1
    [[ $ASH_TERM_COLORS -eq 0 ]] && ASH_FLAG_NO_COLOR=1
    [[ $ASH_TERM_UNICODE -eq 0 ]] && ASH_FLAG_NO_UNICODE=1

    # ── Phase 4: Setup runtime environment ───────────────────────────────
    _ash_setup_runtime_dirs
    _ash_setup_default_config
    _ash_setup_traps
    _ash_write_pid

    # ── Phase 5: Bootstrap core libraries ────────────────────────────────
    _ash_bootstrap

    # ── Phase 6: Load user configuration ─────────────────────────────────
    local config_file="${ASH_FLAG_CONFIG_OVERRIDE:-$ASH_USER_CONFIG}"
    if [[ -f "$config_file" ]]; then
        ash_config_load "$config_file" 2>/dev/null || true
    fi

    # ── Phase 7: Load active profile ─────────────────────────────────────
    local active_profile="${ASH_FLAG_PROFILE:-$(ash_config_get general.profile 2>/dev/null || echo default)}"
    local profile_config="${ASH_PROFILES_DIR}/${active_profile}/settings.conf"
    if [[ -f "$profile_config" ]]; then
        ash_config_load "$profile_config" 2>/dev/null || true
    fi

    # ── Phase 8: Dispatch command ─────────────────────────────────────────
    _ash_dispatch "$@"
}

# ── Invoke main with all arguments ──────────────────────────────────────────
main "$@"
