declare -ga ASH_LOADED_LIBS=()

_ash_require_lib() {
    local lib_name="$1"
    local lib_file="${ASH_LIB_DIR}/${lib_name}.sh"

    # Prevent double-loading
    for loaded in "${ASH_LOADED_LIBS[@]:-}"; do
        [[ "$loaded" == "$lib_name" ]] && return 0
    done

    if [[ ! -f "$lib_file" ]]; then
        printf '\033[0;31m[ASH FATAL]\033[0m Library not found: %s\n' "$lib_file" >&2
        exit 127
    fi

    # shellcheck source=/dev/null
    source "$lib_file"
    ASH_LOADED_LIBS+=("$lib_name")
}

_ash_bootstrap() {
