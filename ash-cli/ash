_ash_detect_terminal() {
    # Color support
    if [[ -t 1 ]]; then
        local ncolors
        ncolors=$(tput colors 2>/dev/null || echo 0)
        [[ $ncolors -ge 256 ]] && ASH_TERM_COLORS=256
        [[ $ncolors -ge 8   ]] && [[ $ASH_TERM_COLORS -eq 0 ]] && ASH_TERM_COLORS=8
    fi

    # True color support
    if [[ "${COLORTERM:-}" =~ ^(truecolor|24bit)$ ]]; then
        ASH_TERM_TRUECOLOR=1
        ASH_TERM_COLORS=16777216
    fi

    # Unicode support
    if [[ "${LANG:-}${LC_ALL:-}" =~ [Uu][Tt][Ff]-?8 ]]; then
        ASH_TERM_UNICODE=1
    fi

    # Terminal dimensions
    if command -v tput &>/dev/null && [[ -t 1 ]]; then
        ASH_TERM_WIDTH=$(tput cols  2>/dev/null || echo 80)
        ASH_TERM_HEIGHT=$(tput lines 2>/dev/null || echo 24)
    fi
}

