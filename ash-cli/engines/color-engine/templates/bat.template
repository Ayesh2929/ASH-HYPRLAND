#
# bat/syntect theme. syntect requires a full TextMate scope list; a partial one
# silently falls back to the default theme for unmatched scopes.
#
# Rendered by `ash theme apply`, which substitutes the 13 palette slots plus
# {theme_name} and {variant}. Filters available: upper, lower, strip_hash,
# add_hash, hex2rgb, hex2rgbns, contrast_fg, lightenNN, darkenNN, alphaNN.

# Generated from the {{theme_name}} theme. Place in
# $XDG_CONFIG_HOME/bat/themes/ and run `bat cache --build`.
{
  "name": "ash-{{theme_name|lower|trim}}",
  "author": "ASH Dotfiles",
  "colors": {
    "foreground": "{{text}}",
    "background": "{{base}}",
    "caret": "{{accent}}",
    "selection": "{{surface}}",
    "line_highlight": "{{mantle}}",
    "gutter": "{{mantle}}",
    "gutter_foreground": "{{overlay}}",
    "find_highlight": "{{gold}}",
    "find_highlight_foreground": "{{base}}"
  },
  "settings": [
    { "settings": { "foreground": "{{text}}", "background": "{{base}}" } },
    { "name": "Comment", "scope": "comment, punctuation.definition.comment",
      "settings": { "foreground": "{{overlay}}", "fontStyle": "italic" } },
    { "name": "String", "scope": "string, punctuation.definition.string",
      "settings": { "foreground": "{{mint}}" } },
    { "name": "Number", "scope": "constant.numeric",
      "settings": { "foreground": "{{gold}}" } },
    { "name": "Constant", "scope": "constant, support.constant, variable.other.constant",
      "settings": { "foreground": "{{gold}}" } },
    { "name": "Keyword", "scope": "keyword, storage, storage.type",
      "settings": { "foreground": "{{violet}}" } },
    { "name": "Operator", "scope": "keyword.operator",
      "settings": { "foreground": "{{sky}}" } },
    { "name": "Function", "scope": "entity.name.function, support.function, meta.function-call",
      "settings": { "foreground": "{{accent}}" } },
    { "name": "Variable", "scope": "variable, variable.parameter",
      "settings": { "foreground": "{{text}}" } },
    { "name": "Type", "scope": "entity.name.type, entity.name.class, support.type, support.class",
      "settings": { "foreground": "{{gold}}" } },
    { "name": "Tag", "scope": "entity.name.tag",
      "settings": { "foreground": "{{rose}}" } },
    { "name": "Attribute", "scope": "entity.other.attribute-name",
      "settings": { "foreground": "{{sky}}" } },
    { "name": "Invalid", "scope": "invalid, invalid.illegal",
      "settings": { "foreground": "{{base}}", "background": "{{rose}}" } },
    { "name": "Markdown heading", "scope": "markup.heading",
      "settings": { "foreground": "{{accent}}", "fontStyle": "bold" } },
    { "name": "Markdown insert", "scope": "markup.inserted",
      "settings": { "foreground": "{{mint}}" } },
    { "name": "Markdown delete", "scope": "markup.deleted",
      "settings": { "foreground": "{{rose}}" } },
    { "name": "Markdown change", "scope": "markup.changed",
      "settings": { "foreground": "{{gold}}" } },
    { "name": "Diff insert", "scope": "diff.inserted",
      "settings": { "foreground": "{{mint}}", "background": "{{mint|alpha0.13}}" } },
    { "name": "Diff delete", "scope": "diff.deleted",
      "settings": { "foreground": "{{rose}}", "background": "{{rose|alpha0.13}}" } }
  ]
}
