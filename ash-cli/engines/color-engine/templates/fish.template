#
# Fish shell colours. Fish wants raw hex with no '#', and its syntax-highlighting
# slots are what makes a themed shell feel finished rather than half-done.
#
# Rendered by `ash theme apply`, which substitutes the 13 palette slots plus
# {theme_name} and {variant}. Filters available: upper, lower, strip_hash,
# add_hash, hex2rgb, hex2rgbns, contrast_fg, lightenNN, darkenNN, alphaNN.

# Syntax highlighting
set -g fish_color_normal            {{text|strip_hash}}
set -g fish_color_command           {{accent|strip_hash}}
set -g fish_color_keyword           {{violet|strip_hash}}
set -g fish_color_quote             {{gold|strip_hash}}
set -g fish_color_redirection       {{sky|strip_hash}}
set -g fish_color_end               {{mint|strip_hash}}
set -g fish_color_error             {{rose|strip_hash}}
set -g fish_color_param             {{subtext|strip_hash}}
set -g fish_color_comment           {{overlay|strip_hash}}
set -g fish_color_selection         --background={{surface|strip_hash}} --bold
set -g fish_color_search_match      --background={{gold|strip_hash}}
set -g fish_color_operator          {{sky|strip_hash}}
set -g fish_color_escape            {{rose|strip_hash}}
set -g fish_color_autosuggestion    {{overlay|strip_hash}}
set -g fish_color_valid_path        --underline

# Pager
set -g fish_pager_color_prefix          {{accent|strip_hash}} --bold --underline
set -g fish_pager_color_completion      {{text|strip_hash}}
set -g fish_pager_color_description     {{overlay|strip_hash}}
set -g fish_pager_color_selected_background --background={{surface|strip_hash}}
set -g fish_pager_color_selected_completion {{accent|strip_hash}}
