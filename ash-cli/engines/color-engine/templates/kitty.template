#
# A full 16-colour terminal palette derived from the theme, so TUIs that use
# ANSI colours (htop, neovim, fzf) match the desktop instead of clashing.
#
# Rendered by `ash theme apply`, which substitutes the 13 palette slots plus
# {theme_name} and {variant}. Filters available: upper, lower, strip_hash,
# add_hash, hex2rgb, hex2rgbns, contrast_fg, lightenNN, darkenNN, alphaNN.

# 16-colour ANSI palette. The six semantic accents cover the colourful slots;
# the greys come from the surface ramp so the terminal keeps the theme's depth.
foreground            {{text}}
background            {{base}}
selection_foreground  {{base}}
selection_background  {{accent}}
cursor                {{accent}}
cursor_text_color     {{base}}
url_color             {{sky}}

# normal
color0  {{crust}}
color1  {{rose}}
color2  {{mint}}
color3  {{gold}}
color4  {{sky}}
color5  {{accent}}
color6  {{violet}}
color7  {{subtext}}

# bright
color8  {{overlay}}
color9  {{rose|lighten12}}
color10 {{mint|lighten12}}
color11 {{gold|lighten12}}
color12 {{sky|lighten12}}
color13 {{accent|lighten12}}
color14 {{violet|lighten12}}
color15 {{text}}

# Window chrome
active_tab_background      {{surface}}
active_tab_foreground      {{text}}
active_tab_font_style      bold
inactive_tab_background    {{mantle}}
inactive_tab_foreground    {{subtext}}
tab_bar_background         {{crust}}

window_border_color        {{accent}}
active_border_color        {{accent}}
inactive_border_color      {{surface}}
