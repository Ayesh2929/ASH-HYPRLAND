#
# Spicetify colour.ini. Colours are bare hex with no '#', and the key names
# are fixed by Spicetify's schema.
#
# Rendered by `ash theme apply`, which substitutes the 13 palette slots plus
# {theme_name} and {variant}. Filters available: upper, lower, strip_hash,
# add_hash, hex2rgb, hex2rgbns, contrast_fg, lightenNN, darkenNN, alphaNN.

[Base]
name            = ASH {{theme_name}}
author          = ASH Dotfiles
description     = Generated from the ASH v5.0 palette in {{theme_name}}.
version         = 5.0.0
scheme          = Base
dark            = {{variant_is_dark:-true}}

[Custom]
text            = {{text|strip_hash}}
subtext         = {{subtext|strip_hash}}
main            = {{base|strip_hash}}
main-elevated   = {{mantle|strip_hash}}
highlight       = {{accent|strip_hash}}
highlight-elevated = {{violet|strip_hash}}
sidebar         = {{crust|strip_hash}}
player          = {{mantle|strip_hash}}
card            = {{surface|strip_hash}}
shadow          = {{crust|strip_hash}}
selected-row    = {{accent|strip_hash}}
button          = {{accent|strip_hash}}
button-active   = {{accent|strip_hash}}
button-disabled = {{overlay|strip_hash}}
tab-active      = {{surface|strip_hash}}
notification    = {{sky|strip_hash}}
notification-error = {{rose|strip_hash}}
misc            = {{overlay|strip_hash}}
