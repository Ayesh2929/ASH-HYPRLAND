# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║  ⚡ ASH DOTFILES v5.0 OMEGA — zed.template
# ╚═══════════════════════════════════════════════════════════════════════════════╝
#
# Zed editor. Zed's theme schema requires players, style and syntax blocks, and
# it validates the JSON strictly, so keys are emitted in the order it expects.
#
# Rendered by `ash theme apply`, which substitutes the 13 palette slots plus
# {theme_name} and {variant}. Filters available: upper, lower, strip_hash,
# add_hash, hex2rgb, hex2rgbns, contrast_fg, lightenNN, darkenNN, alphaNN.

{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "ASH {{theme_name}}",
  "author": "ASH Dotfiles",
  "themes": [
    {
      "name": "ASH {{theme_name}}",
      "appearance": "{{variant}}",
      "style": {
        "background": "{{base}}",
        "foreground": "{{text}}",
        "border": "{{surface}}",
        "text": "{{text}}",
        "text.muted": "{{subtext}}",
        "text.placeholder": "{{overlay}}",
        "elevated_surface.background": "{{mantle}}",
        "surface.background": "{{base}}",
        "element.background": "{{surface}}",
        "element.hover": "{{overlay}}",
        "element.active": "{{overlay}}",
        "element.selected": "{{surface}}",
        "element.disabled": "{{surface}}",
        "drop_target.background": "{{surface}}",
        "ghost_element.background": "{{mantle}}",
        "ghost_element.hover": "{{surface}}",
        "ghost_element.active": "{{overlay}}",
        "ghost_element.selected": "{{surface}}",
        "ghost_element.disabled": "{{mantle}}",
        "scrollbar.thumb.background": "{{overlay|alpha0.27}}",
        "scrollbar.thumb.hover_background": "{{overlay|alpha0.47}}",
        "scrollbar.thumb.border": "transparent",
        "scrollbar.track.background": "transparent",
        "scrollbar.track.border": "transparent",
        "editor.background": "{{base}}",
        "editor.foreground": "{{text}}",
        "editor.gutter.background": "{{base}}",
        "editor.line_number": "{{overlay}}",
        "editor.active_line_number": "{{accent}}",
        "editor.highlighted_line.background": "{{mantle}}",
        "editor.document_highlight.read_background": "{{surface}}",
        "editor.document_highlight.write_background": "{{overlay}}",
        "terminal.background": "{{base}}",
        "terminal.foreground": "{{text}}",
        "terminal.ansi.black": "{{crust}}",
        "terminal.ansi.red": "{{rose}}",
        "terminal.ansi.green": "{{mint}}",
        "terminal.ansi.yellow": "{{gold}}",
        "terminal.ansi.blue": "{{sky}}",
        "terminal.ansi.magenta": "{{accent}}",
        "terminal.ansi.cyan": "{{violet}}",
        "terminal.ansi.white": "{{subtext}}",
        "terminal.ansi.bright_black": "{{overlay}}",
        "terminal.ansi.bright_red": "{{rose|lighten12}}",
        "terminal.ansi.bright_green": "{{mint|lighten12}}",
        "terminal.ansi.bright_yellow": "{{gold|lighten12}}",
        "terminal.ansi.bright_blue": "{{sky|lighten12}}",
        "terminal.ansi.bright_magenta": "{{accent|lighten12}}",
        "terminal.ansi.bright_cyan": "{{violet|lighten12}}",
        "terminal.ansi.bright_white": "{{text}}",
        "border.focused": "{{accent}}",
        "border.selected": "{{accent}}",
        "border.transparent": "transparent",
        "border.disabled": "{{surface}}",
        "conflict": "{{gold}}",
        "conflict.background": "{{gold|alpha0.13}}",
        "conflict.border": "{{gold}}",
        "created": "{{mint}}",
        "created.background": "{{mint|alpha0.13}}",
        "created.border": "{{mint}}",
        "deleted": "{{rose}}",
        "deleted.background": "{{rose|alpha0.13}}",
        "deleted.border": "{{rose}}",
        "error": "{{rose}}",
        "error.background": "{{rose|alpha0.13}}",
        "error.border": "{{rose}}",
        "hidden": "{{overlay}}",
        "hidden.background": "{{mantle}}",
        "hidden.border": "{{overlay}}",
        "hint": "{{sky}}",
        "hint.background": "{{sky|alpha0.13}}",
        "hint.border": "{{sky}}",
        "ignored": "{{overlay}}",
        "ignored.background": "{{mantle}}",
        "ignored.border": "{{overlay}}",
        "info": "{{sky}}",
        "info.background": "{{sky|alpha0.13}}",
        "info.border": "{{sky}}",
        "modified": "{{gold}}",
        "modified.background": "{{gold|alpha0.13}}",
        "modified.border": "{{gold}}",
        "predictive": "{{overlay}}",
        "predictive.background": "{{surface}}",
        "predictive.border": "{{overlay}}",
        "renamed": "{{sky}}",
        "renamed.background": "{{sky|alpha0.13}}",
        "renamed.border": "{{sky}}",
        "success": "{{mint}}",
        "success.background": "{{mint|alpha0.13}}",
        "success.border": "{{mint}}",
        "unreachable": "{{overlay}}",
        "unreachable.background": "{{mantle}}",
        "unreachable.border": "{{overlay}}",
        "warning": "{{gold}}",
        "warning.background": "{{gold|alpha0.13}}",
        "warning.border": "{{gold}}",
        "players": [
          { "cursor": "{{accent}}", "background": "{{surface}}", "selection": "{{surface}}" },
          { "cursor": "{{sky}}", "background": "{{mantle}}", "selection": "{{mantle}}" },
          { "cursor": "{{mint}}", "background": "{{surface}}", "selection": "{{surface}}" },
          { "cursor": "{{gold}}", "background": "{{mantle}}", "selection": "{{mantle}}" }
        ]
      },
      "syntax": {
        "comment": { "color": "{{overlay}}", "font_style": "italic" },
        "comment.doc": { "color": "{{overlay}}", "font_style": "italic" },
        "constant": { "color": "{{gold}}" },
        "string": { "color": "{{mint}}" },
        "string.escape": { "color": "{{rose}}" },
        "string.regex": { "color": "{{gold}}" },
        "number": { "color": "{{gold}}" },
        "variable": { "color": "{{text}}" },
        "variable.special": { "color": "{{rose}}" },
        "property": { "color": "{{sky}}" },
        "function": { "color": "{{accent}}" },
        "function.method": { "color": "{{accent}}" },
        "constructor": { "color": "{{gold}}" },
        "type": { "color": "{{gold}}" },
        "class": { "color": "{{gold}}" },
        "keyword": { "color": "{{violet}}" },
        "operator": { "color": "{{sky}}" },
        "punctuation": { "color": "{{subtext}}" },
        "punctuation.bracket": { "color": "{{overlay}}" },
        "punctuation.delimiter": { "color": "{{overlay}}" },
        "tag": { "color": "{{rose}}" },
        "attribute": { "color": "{{sky}}" },
        "label": { "color": "{{violet}}" },
        "embedded": { "color": "{{text}}" },
        "emphasis": { "font_style": "italic" },
        "emphasis.strong": { "font_style": "bold", "font_weight": 700 },
        "link_uri": { "color": "{{sky}}" },
        "link_text": { "color": "{{accent}}" }
      }
    }
  ]
}
