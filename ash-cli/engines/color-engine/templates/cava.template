# ║  ⚡ ASH DOTFILES v5.0 OMEGA — cava.template
# ╚═══════════════════════════════════════════════════════════════════════════════╝
#
# Audio visualiser. Gradient mode is used so the bars shift colour with
# amplitude, which reads much better than a single flat colour.
#
# Rendered by `ash theme apply`, which substitutes the 13 palette slots plus
# {theme_name} and {variant}. Filters available: upper, lower, strip_hash,
# add_hash, hex2rgb, hex2rgbns, contrast_fg, lightenNN, darkenNN, alphaNN.

[general]
framerate = 60
autosens = 1
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = mono
mono_option = average

[color]
background = '{{base}}'
foreground = '{{accent}}'
gradient = 1
gradient_color_1 = '{{mint}}'
gradient_color_2 = '{{sky}}'
gradient_color_3 = '{{accent}}'
gradient_color_4 = '{{violet}}'
gradient_color_5 = '{{rose}}'
gradient_color_6 = '{{gold}}'
gradient_color_7 = '{{subtext}}'
gradient_color_8 = '{{text}}'
