#
# Resource monitor. btop wants bare hex without the leading '#', and its graph
# symbols are configured here so the sparkline uses the theme's accent.
#
# Rendered by `ash theme apply`, which substitutes the 13 palette slots plus
# {theme_name} and {variant}. Filters available: upper, lower, strip_hash,
# add_hash, hex2rgb, hex2rgbns, contrast_fg, lightenNN, darkenNN, alphaNN.

theme[main_bg]="{{base|strip_hash}}"
theme[main_fg]="{{text|strip_hash}}"
theme[title]="{{accent|strip_hash}}"
theme[hi_fg]="{{sky|strip_hash}}"
theme[selected_bg]="{{surface|strip_hash}}"
theme[selected_fg]="{{text|strip_hash}}"
theme[inactive_fg]="{{overlay|strip_hash}}"
theme[graph_text]="{{subtext|strip_hash}}"
theme[meter_bg]="{{surface|strip_hash}}"
theme[proc_misc]="{{violet|strip_hash}}"
theme[cpu_box]="{{accent|strip_hash}}"
theme[mem_box]="{{mint|strip_hash}}"
theme[net_box]="{{sky|strip_hash}}"
theme[proc_box]="{{gold|strip_hash}}"
theme[div_line]="{{overlay|strip_hash}}"

theme[temp_start]="{{mint|strip_hash}}"
theme[temp_mid]="{{gold|strip_hash}}"
theme[temp_end]="{{rose|strip_hash}}"

theme[cpu_start]="{{sky|strip_hash}}"
theme[cpu_mid]="{{violet|strip_hash}}"
theme[cpu_end]="{{rose|strip_hash}}"

theme[free_start]="{{mint|strip_hash}}"
theme[free_mid]="{{gold|strip_hash}}"
theme[free_end]="{{rose|strip_hash}}"

theme[cached_start]="{{sky|strip_hash}}"
theme[cached_mid]="{{accent|strip_hash}}"
theme[cached_end]="{{violet|strip_hash}}"

theme[available_start]="{{gold|strip_hash}}"
theme[available_mid]="{{mint|strip_hash}}"
theme[available_end]="{{sky|strip_hash}}"

theme[used_start]="{{rose|strip_hash}}"
theme[used_mid]="{{gold|strip_hash}}"
theme[used_end]="{{mint|strip_hash}}"
