# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║  ⚡ ASH DOTFILES v5.0 OMEGA — vscode.template
# ╚═══════════════════════════════════════════════════════════════════════════════╝
#
# VS Code / VSCodium. The workbench.colors keys must be exactly right or the
# setting is ignored silently, so each is spelled out with its role.
#
# Rendered by `ash theme apply`, which substitutes the 13 palette slots plus
# {theme_name} and {variant}. Filters available: upper, lower, strip_hash,
# add_hash, hex2rgb, hex2rgbns, contrast_fg, lightenNN, darkenNN, alphaNN.

{
  "$schema": "vscode://schemas/color-theme",
  "name": "ASH {{theme_name}}",
  "type": "{{variant}}",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "{{text}}",
    "descriptionForeground": "{{subtext}}",
    "errorForeground": "{{rose}}",
    "focusBorder": "{{accent}}",

    "editor.background": "{{base}}",
    "editor.foreground": "{{text}}",
    "editorLineNumber.foreground": "{{overlay}}",
    "editorLineNumber.activeForeground": "{{accent}}",
    "editorCursor.foreground": "{{accent}}",
    "editor.selectionBackground": "{{surface}}",
    "editor.selectionHighlightBackground": "{{surface}}",
    "editor.lineHighlightBackground": "{{mantle}}",
    "editorWhitespace.foreground": "{{surface}}",
    "editorIndentGuide.background1": "{{surface}}",
    "editorIndentGuide.activeBackground1": "{{overlay}}",
    "editorBracketMatch.background": "{{accent}}",
    "editorBracketMatch.border": "{{accent}}",
    "editorGutter.background": "{{base}}",
    "editorWidget.background": "{{mantle}}",
    "editorWidget.border": "{{surface}}",
    "editorHoverWidget.background": "{{mantle}}",
    "editorHoverWidget.border": "{{surface}}",
    "editorSuggestWidget.background": "{{mantle}}",
    "editorSuggestWidget.selectedBackground": "{{surface}}",

    "activityBar.background": "{{mantle}}",
    "activityBar.foreground": "{{text}}",
    "activityBar.inactiveForeground": "{{overlay}}",
    "activityBarBadge.background": "{{accent}}",
    "activityBarBadge.foreground": "{{base}}",

    "sideBar.background": "{{mantle}}",
    "sideBar.foreground": "{{text}}",
    "sideBar.border": "{{surface}}",
    "sideBarSectionHeader.background": "{{crust}}",
    "sideBarSectionHeader.foreground": "{{subtext}}",

    "statusBar.background": "{{crust}}",
    "statusBar.foreground": "{{text}}",
    "statusBar.border": "{{surface}}",
    "statusBarItem.hoverBackground": "{{surface}}",

    "titleBar.activeBackground": "{{mantle}}",
    "titleBar.activeForeground": "{{text}}",
    "titleBar.inactiveBackground": "{{crust}}",
    "titleBar.inactiveForeground": "{{overlay}}",

    "tab.activeBackground": "{{base}}",
    "tab.activeForeground": "{{text}}",
    "tab.inactiveBackground": "{{mantle}}",
    "tab.inactiveForeground": "{{overlay}}",
    "tab.activeBorderTop": "{{accent}}",
    "tab.border": "{{surface}}",

    "panel.background": "{{mantle}}",
    "panel.border": "{{surface}}",
    "panelTitle.activeBorder": "{{accent}}",
    "panelTitle.activeForeground": "{{text}}",
    "panelTitle.inactiveForeground": "{{overlay}}",

    "terminal.background": "{{base}}",
    "terminal.foreground": "{{text}}",
    "terminal.ansiBlack": "{{crust}}",
    "terminal.ansiRed": "{{rose}}",
    "terminal.ansiGreen": "{{mint}}",
    "terminal.ansiYellow": "{{gold}}",
    "terminal.ansiBlue": "{{sky}}",
    "terminal.ansiMagenta": "{{accent}}",
    "terminal.ansiCyan": "{{violet}}",
    "terminal.ansiWhite": "{{subtext}}",
    "terminal.ansiBrightBlack": "{{overlay}}",
    "terminal.ansiBrightRed": "{{rose|lighten12}}",
    "terminal.ansiBrightGreen": "{{mint|lighten12}}",
    "terminal.ansiBrightYellow": "{{gold|lighten12}}",
    "terminal.ansiBrightBlue": "{{sky|lighten12}}",
    "terminal.ansiBrightMagenta": "{{accent|lighten12}}",
    "terminal.ansiBrightCyan": "{{violet|lighten12}}",
    "terminal.ansiBrightWhite": "{{text}}",

    "gitDecoration.addedResourceForeground": "{{mint}}",
    "gitDecoration.modifiedResourceForeground": "{{gold}}",
    "gitDecoration.deletedResourceForeground": "{{rose}}",
    "gitDecoration.untrackedResourceForeground": "{{sky}}",
    "gitDecoration.conflictingResourceForeground": "{{violet}}",

    "input.background": "{{surface}}",
    "input.foreground": "{{text}}",
    "input.border": "{{overlay}}",
    "inputOption.activeBorder": "{{accent}}",
    "dropdown.background": "{{mantle}}",
    "dropdown.border": "{{surface}}",
    "button.background": "{{accent}}",
    "button.foreground": "{{base}}",
    "badge.background": "{{accent}}",
    "badge.foreground": "{{base}}",
    "list.hoverBackground": "{{surface}}",
    "list.activeSelectionBackground": "{{surface}}",
    "list.activeSelectionForeground": "{{accent}}",
    "scrollbarSlider.background": "{{overlay|alpha0.27}}",
    "scrollbarSlider.hoverBackground": "{{overlay|alpha0.40}}",
    "scrollbarSlider.activeBackground": "{{accent|alpha0.53}}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "{{overlay}}", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "{{mint}}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "{{gold}}" } },
    { "scope": ["keyword", "storage", "storage.type"],
      "settings": { "foreground": "{{violet}}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "{{accent}}" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "{{text}}" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "{{subtext}}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "{{gold}}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "{{rose}}" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "{{sky}}" } },
    { "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "{{base}}", "background": "{{rose}}" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "{{accent}}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline"], "settings": { "fontStyle": "underline" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "{{mint}}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "{{rose}}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "{{gold}}" } }
  ]
}
