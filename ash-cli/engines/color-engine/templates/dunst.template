#
# Notification daemon. Urgency levels map onto the theme's semantic accents so a
# critical notification is the same red the rest of the desktop uses for danger.
#
# Rendered by `ash theme apply`, which substitutes the 13 palette slots plus
# {theme_name} and {variant}. Filters available: upper, lower, strip_hash,
# add_hash, hex2rgb, hex2rgbns, contrast_fg, lightenNN, darkenNN, alphaNN.

[global]
    frame_color = "{{accent}}"
    frame_width = 2
    corner_radius = 12
    font = "JetBrainsMono Nerd Font 10"
    format = "<b>%s</b>\n%b"
    sort = yes
    idle_threshold = 120
    offset = 12x12
    width = 340
    height = 110
    gap_size = 8

[urgency_low]
    background = "{{mantle}}"
    foreground = "{{text}}"
    frame_color = "{{sky}}"
    timeout = 6

[urgency_normal]
    background = "{{base}}"
    foreground = "{{text}}"
    frame_color = "{{accent}}"
    timeout = 10

[urgency_critical]
    background = "{{crust}}"
    foreground = "{{text}}"
    frame_color = "{{rose}}"
    timeout = 0
