#
# Sourced by hyprland.conf. Hyprland reads colours as 6-digit hex with no '#',
# which is what strip_hash produces.
#
# Rendered by `ash theme apply`, which substitutes the 13 palette slots plus
# {theme_name} and {variant}. Filters available: upper, lower, strip_hash,
# add_hash, hex2rgb, hex2rgbns, contrast_fg, lightenNN, darkenNN, alphaNN.

general {
    col.active_border = rgb({{accent|strip_hash}}) rgb({{violet|strip_hash}}) 45deg
    col.inactive_border = rgb({{surface|strip_hash}})
}

group {
    col.border_active = rgb({{accent|strip_hash}}) rgb({{sky|strip_hash}}) 45deg
    col.border_inactive = rgb({{overlay|strip_hash}})
    col.border_locked_active = rgb({{rose|strip_hash}}) rgb({{gold|strip_hash}}) 45deg
    col.border_locked_inactive = rgb({{overlay|strip_hash}})
    groupbar {
        col.active = rgb({{accent|strip_hash}})
        col.inactive = rgb({{surface|strip_hash}})
        text_color = rgb({{text|strip_hash}})
        text_color_inactive = rgb({{subtext|strip_hash}})
    }
}

misc {
    background_color = rgb({{base|strip_hash}})
}

decoration {
    shadow {
        color = rgb({{crust|strip_hash}})ee
    }
}

# Semantic colours, for status indicators in the bar and notifications.
# Keeping them here means one source of truth per theme.
$ash-mint  = rgb({{mint|strip_hash}})
$ash-sky   = rgb({{sky|strip_hash}})
$ash-gold  = rgb({{gold|strip_hash}})
$ash-rose  = rgb({{rose|strip_hash}})
$ash-violet = rgb({{violet|strip_hash}})
$ash-text  = rgb({{text|strip_hash}})
