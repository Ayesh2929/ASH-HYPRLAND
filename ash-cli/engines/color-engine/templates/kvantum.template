#
# Qt style. Kvantum's colour keys are fixed names and it requires the full set;
# omitting one makes Kvantum fall back to its own defaults for that element.
#
# Rendered by `ash theme apply`, which substitutes the 13 palette slots plus
# {theme_name} and {variant}. Filters available: upper, lower, strip_hash,
# add_hash, hex2rgb, hex2rgbns, contrast_fg, lightenNN, darkenNN, alphaNN.

[General]
author = ASH Dotfiles
comment = Generated from the {{theme_name}} theme
theme_name = ash-{{theme_name|lower|trim}}

[Colors:Window]
# Foreground and background are listed as "R, G, B" triples, not hex.
foreground_normal = {{text|hex2rgbns}}
background_normal = {{base|hex2rgbns}}
foreground_inactive = {{subtext|hex2rgbns}}
background_inactive = {{mantle|hex2rgbns}}

[Colors:View]
foreground_normal = {{text|hex2rgbns}}
background_normal = {{base|hex2rgbns}}
foreground_inactive = {{subtext|hex2rgbns}}
background_inactive = {{mantle|hex2rgbns}}

[Colors:Button]
foreground_normal = {{text|hex2rgbns}}
background_normal = {{surface|hex2rgbns}}
foreground_focus = {{base|hex2rgbns}}
background_focus = {{accent|hex2rgbns}}

[Colors:Selection]
foreground_normal = {{base|hex2rgbns}}
background_normal = {{accent|hex2rgbns}}
foreground_inactive = {{base|hex2rgbns}}
background_inactive = {{overlay|hex2rgbns}}

[Colors:Tooltip]
foreground_normal = {{text|hex2rgbns}}
background_normal = {{mantle|hex2rgbns}}

[Colors:Complementary]
foreground_normal = {{text|hex2rgbns}}
background_normal = {{crust|hex2rgbns}}

[General]
# These are numeric, not colours.
shadowless = false
translucent_windows = false
blurring = true
popup_blurring = false
reduce_window_opacity = 0
combo_box_width = 90
scroll_width = 10
