#
# Helix editor. Its palette table is flat TOML, and the `default` key must be
# present or Helix refuses to load the theme.
#
# Rendered by `ash theme apply`, which substitutes the 13 palette slots plus
# {theme_name} and {variant}. Filters available: upper, lower, strip_hash,
# add_hash, hex2rgb, hex2rgbns, contrast_fg, lightenNN, darkenNN, alphaNN.

"ui.background" = { bg = "base" }
"ui.text" = { fg = "text" }
"ui.text.focus" = { fg = "text", modifiers = ["bold"] }
"ui.cursor" = { fg = "base", bg = "accent" }
"ui.cursor.primary" = { fg = "base", bg = "accent" }
"ui.cursor.match" = { fg = "gold", modifiers = ["bold"] }
"ui.cursorline.primary" = { bg = "surface" }
"ui.selection" = { bg = "surface" }
"ui.selection.primary" = { bg = "overlay" }
"ui.linenr" = { fg = "overlay" }
"ui.linenr.selected" = { fg = "accent", modifiers = ["bold"] }
"ui.statusline" = { fg = "text", bg = "mantle" }
"ui.statusline.inactive" = { fg = "overlay", bg = "crust" }
"ui.statusline.normal" = { fg = "base", bg = "accent", modifiers = ["bold"] }
"ui.popup" = { fg = "text", bg = "mantle" }
"ui.window" = { fg = "surface" }
"ui.help" = { fg = "text", bg = "mantle" }
"ui.menu" = { fg = "text", bg = "mantle" }
"ui.menu.selected" = { fg = "base", bg = "accent" }
"ui.virtual.whitespace" = { fg = "overlay" }
"ui.virtual.ruler" = { bg = "surface" }
"ui.virtual.indent-guide" = { fg = "surface" }
"ui.gutter" = { bg = "base" }
"ui.bufferline" = { fg = "overlay", bg = "mantle" }
"ui.bufferline.active" = { fg = "accent", bg = "base" }

"comment" = { fg = "overlay", modifiers = ["italic"] }
"keyword" = "violet"
"keyword.control" = { fg = "violet", modifiers = ["italic"] }
"keyword.operator" = "sky"
"function" = "accent"
"function.macro" = "rose"
"variable" = "text"
"variable.parameter" = "subtext"
"variable.builtin" = "rose"
"constant" = "gold"
"constant.numeric" = "gold"
"constant.character.escape" = "rose"
"string" = "mint"
"string.regexp" = "gold"
"type" = "gold"
"type.builtin" = "sky"
"namespace" = "sky"
"label" = "violet"
"punctuation" = "subtext"
"punctuation.delimiter" = "overlay"
"operator" = "sky"
"attribute" = "gold"
"tag" = "rose"
"special" = "sky"
"markup.heading" = { fg = "accent", modifiers = ["bold"] }
"markup.link.url" = { fg = "sky", modifiers = ["underline"] }
"markup.raw" = "mint"
"diff.plus" = "mint"
"diff.delta" = "gold"
"diff.minus" = "rose"
"diagnostic.error" = { underline = { color = "rose", style = "curl" } }
"diagnostic.warning" = { underline = { color = "gold", style = "curl" } }
"diagnostic.info" = { underline = { color = "sky", style = "curl" } }
"diagnostic.hint" = { underline = { color = "mint", style = "curl" } }
