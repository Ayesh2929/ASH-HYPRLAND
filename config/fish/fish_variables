# ── Night Light plugin ────────────────────────────────────────────────────────
set -U ASH_PLUGIN_NIGHTLIGHT_TEMP      "4500"  # Color temperature in Kelvin
set -U ASH_PLUGIN_NIGHTLIGHT_START     "20"    # Hour (24h) to enable
set -U ASH_PLUGIN_NIGHTLIGHT_END       "07"    # Hour (24h) to disable
set -U ASH_PLUGIN_NIGHTLIGHT_AUTO      "1"     # 1=auto schedule

# ── Analytics plugin ─────────────────────────────────────────────────────────
set -U ASH_PLUGIN_ANALYTICS_RETENTION  "30"   # Days to keep local data

# ── Auto Wallpaper plugin ─────────────────────────────────────────────────────
set -U ASH_PLUGIN_AUTOWP_INTERVAL      "30"   # Minutes between changes
set -U ASH_PLUGIN_AUTOWP_MATCH_THEME   "1"    # Match wallpaper mood to theme

# ── Discord RPC plugin ────────────────────────────────────────────────────────
set -U ASH_PLUGIN_DISCORD_SHOW_THEME   "1"    # Show current theme in status
set -U ASH_PLUGIN_DISCORD_SHOW_MODE    "1"    # Show current mode in status


