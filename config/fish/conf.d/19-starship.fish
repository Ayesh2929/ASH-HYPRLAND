# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  🐟 ASH DOTFILES v5.0 — Starship Ultra Configuration                       ║
# ║  Dynamic prompt theming with ASH color sync & performance optimization     ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Guard: Only load in interactive sessions ─────────────────────────────────
status is-interactive || exit 0

# ── Guard: Require starship ───────────────────────────────────────────────────
command -q starship || exit 0

# ── Guard: Prevent double-loading ────────────────────────────────────────────
set --query _ash_starship_loaded && exit 0
set --global _ash_starship_loaded 1

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  ⚙️  STARSHIP CONFIG PATH — Dynamic ASH theme sync                          ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# Base config directory
set -l _ash_starship_dir "$HOME/.config/starship"
set -l _ash_starship_presets_dir "$HOME/.config/starship/presets"
set -l _ash_starship_dynamic "$HOME/.config/ash/cache/starship-dynamic.toml"

# ── Determine active config ───────────────────────────────────────────────────
function __ash_starship_get_config --description "Resolve active starship config path"
    # 1. Check for ASH-dynamic config (generated by theme engine)
    if test -f $_ash_starship_dynamic
        echo $_ash_starship_dynamic
        return
    end

    # 2. Check for user config
    if test -f "$_ash_starship_dir/starship.toml"
        echo "$_ash_starship_dir/starship.toml"
        return
    end

    # 3. Use XDG default
    if test -f "$HOME/.config/starship.toml"
        echo "$HOME/.config/starship.toml"
        return
    end

    # 4. Fallback — no config (starship will use its built-in defaults)
    echo ""
end

set -l _starship_config (__ash_starship_get_config)

if test -n "$_starship_config"
    set --export STARSHIP_CONFIG $_starship_config
end

# Cache file for faster subsequent shell starts
set --export STARSHIP_CACHE "$HOME/.cache/starship"
mkdir -p $STARSHIP_CACHE 2>/dev/null

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  🎨 DYNAMIC THEME GENERATION                                                ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

function __ash_starship_generate_theme --description "Generate starship TOML from ASH theme colors"
    set -l state_file "$HOME/.local/share/ash/state/current-theme.json"
    set -l output $_ash_starship_dynamic

    # Default Catppuccin Mocha palette
    set -l c_base    "#1e1e2e"
    set -l c_surface "#313244"
    set -l c_text    "#cdd6f4"
    set -l c_subtext "#a6adc8"
    set -l c_rosewater "#f5e0dc"
    set -l c_flamingo  "#f2cdcd"
    set -l c_pink      "#f5c2e7"
    set -l c_mauve     "#cba6f7"
    set -l c_red       "#f38ba8"
    set -l c_maroon    "#eba0ac"
    set -l c_peach     "#fab387"
    set -l c_yellow    "#f9e2af"
    set -l c_green     "#a6e3a1"
    set -l c_teal      "#94e2d5"
    set -l c_sky       "#89dceb"
    set -l c_blue      "#89b4fa"
    set -l c_lavender  "#b4befe"

    # Override with current ASH theme if available
    if test -f $state_file && command -q jq
        set -l parsed (jq -r '
            .colors |
            "c_base=\(.base // "#1e1e2e")\n"
            + "c_surface=\(.surface0 // "#313244")\n"
            + "c_text=\(.text // "#cdd6f4")\n"
            + "c_subtext=\(.subtext1 // "#a6adc8")\n"
            + "c_mauve=\(.mauve // "#cba6f7")\n"
            + "c_red=\(.red // "#f38ba8")\n"
            + "c_peach=\(.peach // "#fab387")\n"
            + "c_yellow=\(.yellow // "#f9e2af")\n"
            + "c_green=\(.green // "#a6e3a1")\n"
            + "c_sky=\(.sky // "#89dceb")\n"
            + "c_blue=\(.blue // "#89b4fa")\n"
            + "c_lavender=\(.lavender // "#b4befe")"
        ' $state_file 2>/dev/null)

        for pair in $parsed
            set -l key (string split --max 1 = $pair)[1]
            set -l val (string split --max 1 = $pair)[2]
            set $key $val
        end
    end

    # ── Write TOML ────────────────────────────────────────────────────────────
    mkdir -p (dirname $output) 2>/dev/null

    printf '%s\n' \
        '# ╔══════════════════════════════════════════════════╗' \
        '# ║  Auto-generated by ASH Theme Engine v5.0         ║' \
        '# ║  Do not edit — changes will be overwritten       ║' \
        '# ╚══════════════════════════════════════════════════╝' \
        '' \
        'format = """' \
        '\$username\$hostname\$localip\$shlvl\$singularity\$kubernetes\$directory\$vcsh\$fossil_branch\$git_branch\$git_commit\$git_state\$git_metrics\$git_status\$hg_branch\$pijul_channel\$docker_context\$package\$c\$cmake\$cobol\$daml\$dart\$deno\$dotnet\$elixir\$elm\$erlang\$fennel\$golang\$guix_shell\$haskell\$haxe\$helm\$java\$julia\$kotlin\$gradle\$lua\$nim\$nodejs\$ocaml\$opa\$perl\$php\$pulumi\$purescript\$python\$raku\$rlang\$red\$ruby\$rust\$scala\$swift\$terraform\$vlang\$vagrant\$zig\$buf\$nix_shell\$conda\$meson\$spack\$memory_usage\$aws\$gcloud\$openstack\$azure\$env_var\$crystal\$custom\$sudo\$cmd_duration\$line_break\$jobs\$battery\$time\$status\$os\$container\$shell\$character"""' \
        '' \
        "palette = 'ash_dynamic'" \
        '' \
        '[palettes.ash_dynamic]' \
        "base     = '$c_base'" \
        "surface  = '$c_surface'" \
        "text     = '$c_text'" \
        "subtext  = '$c_subtext'" \
        "mauve    = '$c_mauve'" \
        "red      = '$c_red'" \
        "peach    = '$c_peach'" \
        "yellow   = '$c_yellow'" \
        "green    = '$c_green'" \
        "sky      = '$c_sky'" \
        "blue     = '$c_blue'" \
        "lavender = '$c_lavender'" \
        '' \
        '[character]' \
        'success_symbol = "[❯](bold green)"' \
        'error_symbol   = "[❯](bold red)"' \
        'vimcmd_symbol  = "[❮](bold mauve)"' \
        '' \
        '[directory]' \
        'style                     = "bold blue"' \
        'read_only                 = " 󰌾"' \
        'truncation_length         = 4' \
        'truncate_to_repo          = true' \
        'fish_style_pwd_dir_length = 1' \
        'home_symbol               = "~"' \
        '' \
        '[git_branch]' \
