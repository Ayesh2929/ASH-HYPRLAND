# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  🔃 THEME SYNC EVENT HANDLER                                                ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

function __ash_starship_on_theme_change --on-event ash_theme_changed \
    --description "Regenerate starship config on ASH theme change"

    # Regenerate dynamic config
    set -l new_config (__ash_starship_generate_theme)

    # Update STARSHIP_CONFIG live
    set --global --export STARSHIP_CONFIG $new_config

    # Force starship to reload (it respects env changes on next prompt)
    set --erase _ash_starship_loaded
end

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  🚀 INITIALIZATION                                                          ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# Generate dynamic config if it doesn't exist or is older than the theme state
set -l _state "$HOME/.local/share/ash/state/current-theme.json"
set -l _need_gen 0

if not test -f $_ash_starship_dynamic
    set _need_gen 1
else if test -f $_state
    # Regenerate if theme is newer than current starship config
    set -l theme_mtime (stat -c %Y $_state 2>/dev/null; or echo 0)
    set -l conf_mtime  (stat -c %Y $_ash_starship_dynamic 2>/dev/null; or echo 0)
    test $theme_mtime -gt $conf_mtime && set _need_gen 1
end

if test $_need_gen -eq 1
    set -l generated (__ash_starship_generate_theme 2>/dev/null)
    test -n "$generated" && set --export STARSHIP_CONFIG $generated
end

# ── Initialize starship prompt ────────────────────────────────────────────────
starship init fish | source

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  🔧 PRESET SWITCHER                                                         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

function starship_preset --description "Switch starship preset"
    set -l preset $argv[1]
    set -l presets_dir "$HOME/.config/starship/presets"

    if test -z "$preset"
        # List available presets
        echo ""
        echo "  Available starship presets:"
        echo ""

        set -l presets default minimal powerline nerdfont-symbols bracketed \
            tokyo-night gruvbox catppuccin ash-dynamic

        for p in $presets
            set -l active ""
            test "$STARSHIP_CONFIG" = "$presets_dir/$p.toml" && set active " ← active"
            echo "    • $p$active"
        end

        echo ""
        echo "  Usage: starship_preset <name>"
        echo ""
        return
    end

    switch $preset
        case ash ash-dynamic dynamic
            # Use ASH dynamic theme
            set -l new (__ash_starship_generate_theme)
            set --global --export STARSHIP_CONFIG $new
            echo "  ✓ Switched to ASH dynamic theme"

        case '*'
            # Load from presets directory
            set -l preset_file "$presets_dir/$preset.toml"
            if test -f $preset_file
                set --global --export STARSHIP_CONFIG $preset_file
                echo "  ✓ Switched to preset: $preset"
            else
                # Try starship's built-in presets
                set -l tmp (mktemp /tmp/starship-preset-XXXXXX.toml)
                if starship preset $preset -o $tmp 2>/dev/null
                    set --global --export STARSHIP_CONFIG $tmp
                    echo "  ✓ Applied built-in preset: $preset"
                else
                    echo "  ✗ Preset not found: $preset" >&2
                    return 1
                end
            end
    end
end

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  📊 STARSHIP UTILITIES                                                      ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

function starship_bench --description "Benchmark starship prompt render time"
    echo ""
    echo "  ⏱️  Benchmarking starship prompt..."
    echo ""
    starship timings
    echo ""
end

function starship_debug --description "Show starship debug info"
    echo ""
    echo "  🔍 Starship debug info:"
    echo ""
    echo "  Config:  $STARSHIP_CONFIG"
    echo "  Cache:   $STARSHIP_CACHE"
    echo "  Version: "(starship --version)
    echo ""
    echo "  Module status:"
    starship explain
end

