# ║  ⌨️  ABBREVIATIONS                                                           ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

abbr --add ssp    'starship_preset'
abbr --add ssb    'starship_bench'
abbr --add ssd    'starship_debug'
abbr --add ssgen  '__ash_starship_generate_theme'
abbr --add ssconf 'echo $STARSHIP_CONFIG'
abbr --add ssedit 'nvim $STARSHIP_CONFIG'