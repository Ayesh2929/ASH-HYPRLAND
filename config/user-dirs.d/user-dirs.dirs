# ║  🔥 ASH DOTFILES v5.0 OMEGA — XDG USER DIRECTORIES ULTRA                   ║
# ║  📁 Organized home layout • Clean naming • Development-optimized            ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
#
# XDG User Directories Specification
# https://www.freedesktop.org/wiki/Software/xdg-user-dirs/
#
# ── Format ────────────────────────────────────────────────────────────────────
# XDG_*_DIR="$HOME/path"       — relative to home
# XDG_*_DIR="/absolute/path"   — absolute path
# XDG_*_DIR="$HOME"            — use home itself
#
# ── Apply changes ─────────────────────────────────────────────────────────────
# After editing, run:   xdg-user-dirs-update
# Or for immediate use: source ~/.config/user-dirs.dirs
#
# ── Auto-update ───────────────────────────────────────────────────────────────
# Prevent xdg-user-dirs from recreating default dirs:
# Edit /etc/xdg/user-dirs.conf: enabled=False

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🗂️  STANDARD XDG DIRECTORIES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 🖥️  Desktop (files shown on desktop, if compositor supports it)
XDG_DESKTOP_DIR="$HOME/Desktop"

# 📥  Downloads — primary download location
XDG_DOWNLOAD_DIR="$HOME/Downloads"

# 📄  Templates — new file templates
XDG_TEMPLATES_DIR="$HOME/Templates"

# 🌐  Public share — network-shared files
XDG_PUBLICSHARE_DIR="$HOME/Public"

# 📚  Documents — personal documents
XDG_DOCUMENTS_DIR="$HOME/Documents"

# 🎵  Music — local music library (MPD scans this)
XDG_MUSIC_DIR="$HOME/Music"

# 🖼️  Pictures — photos, screenshots, artwork
XDG_PICTURES_DIR="$HOME/Pictures"

# 🎬  Videos — recordings, movies, clips
XDG_VIDEOS_DIR="$HOME/Videos"