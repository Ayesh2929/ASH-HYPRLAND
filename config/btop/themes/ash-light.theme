# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  ASH DOTFILES v5.0 — BTOP++ THEME: ASH LIGHT                              ║
# ║                                                                            ║
# ║  Base     : Catppuccin Latte                                               ║
# ║  Accent   : Mauve (#8839ef) — Rich purple on warm cream                   ║
# ║  Style    : Crisp daylight — warm paper whites with vivid accents          ║
# ║  Graph    : Braille + vibrant color on light background                   ║
# ║                                                                            ║
# ║  Color Reference (Catppuccin Latte):                                      ║
# ║  ┌─────────────────┬───────────┬────────────────────────────────┐         ║
# ║  │ Role            │ Hex       │ Usage                          │         ║
# ║  ├─────────────────┼───────────┼────────────────────────────────┤         ║
# ║  │ Rosewater       │ #dc8a78   │ Lightest accent                │         ║
# ║  │ Flamingo        │ #dd7878   │ Soft red                       │         ║
# ║  │ Pink            │ #ea76cb   │ Pink accent                    │         ║
# ║  │ Mauve           │ #8839ef   │ PRIMARY ACCENT                 │         ║
# ║  │ Red             │ #d20f39   │ Critical / Error               │         ║
# ║  │ Maroon          │ #e64553   │ Danger                         │         ║
# ║  │ Peach           │ #fe640b   │ Warning accent                 │         ║
# ║  │ Yellow          │ #df8e1d   │ Warning                        │         ║
# ║  │ Green           │ #40a02b   │ OK / Success                   │         ║
# ║  │ Teal            │ #179299   │ Cool success                   │         ║
# ║  │ Sky             │ #04a5e5   │ Info light                     │         ║
# ║  │ Sapphire        │ #209fb5   │ Cool info                      │         ║
# ║  │ Blue            │ #1e66f5   │ Primary info                   │         ║
# ║  │ Lavender        │ #7287fd   │ Soft accent                    │         ║
# ║  │ Text            │ #4c4f69   │ Primary text                   │         ║
# ║  │ Subtext 1       │ #5c5f77   │ Secondary text                 │         ║
# ║  │ Subtext 0       │ #6c6f85   │ Muted text                     │         ║
# ║  │ Overlay 2       │ #7c7f93   │ Disabled text                  │         ║
# ║  │ Overlay 1       │ #8c8fa1   │ Placeholder                    │         ║
# ║  │ Overlay 0       │ #9ca0b0   │ Subtle                         │         ║
# ║  │ Surface 2       │ #acb0be   │ Border                         │         ║
# ║  │ Surface 1       │ #bcc0cc   │ Divider                        │         ║
# ║  │ Surface 0       │ #ccd0da   │ Elevated surface               │         ║
# ║  │ Base            │ #eff1f5   │ Primary background             │         ║
# ║  │ Mantle          │ #e6e9ef   │ Background variant             │         ║
# ║  │ Crust           │ #dce0e8   │ Deepest background             │         ║
# ║  └─────────────────┴───────────┴────────────────────────────────┘         ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🎨  CORE COLORS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

#  Main background — Catppuccin Latte Base (warm paper white)
main_bg = "#eff1f5"

#  Main foreground — Deep charcoal text for high contrast
main_fg = "#4c4f69"

#  Title text — Vivid Mauve for premium header visibility
title = "#8839ef"

#  Highlighted / selected text — Lavender accent
hi_fg = "#7287fd"

#  Selected background — Slightly deeper surface
selected_bg = "#ccd0da"

#  Selected foreground — Deep text remains readable
selected_fg = "#4c4f69"

#  Inactive / dimmed text — Soft overlay
inactive_fg = "#9ca0b0"

#  ── Graph Colors ─────────────────────────────────────────────────────────────

#  Base graph gradient for light theme
#  Muted → Vivid (all graphs read from this base)
graph_color = "#bcc0cc #9ca0b0 #7c7f93 #7287fd #8839ef #1e66f5 #209fb5 #179299 #40a02b"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📦  BOX SPECIFIC COLORS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

#  Borders and frames — subtle border on light backgrounds
proc_misc = "#acb0be"

#  CPU box title / accent
cpu_box = "#8839ef"

#  ── CPU Box ──────────────────────────────────────────────────────────────────

#  CPU low-usage graph color — Lavender (calm, cool)
cpu_start = "#7287fd"

#  CPU high-usage graph color — Rich Mauve (intense)
cpu_end = "#8839ef"

#  CPU decimal / secondary number color
cpu_dec_color = "#209fb5"

#  ── Memory Box ───────────────────────────────────────────────────────────────

#  Memory box accent
mem_box = "#179299"

#  Memory used — Teal to Green (fresh, healthy)
mem_start = "#04a5e5"
mem_end = "#40a02b"

#  Swap colors — Warm warning palette
swap_start = "#df8e1d"
swap_end = "#fe640b"

#  Disk usage — Blue gradient
disk_start = "#1e66f5"
disk_end = "#7287fd"

#  ── Network Box ──────────────────────────────────────────────────────────────

#  Download — Sky to Sapphire (cool inbound)
download_start = "#04a5e5"
download_end = "#209fb5"

#  Upload — Pink to Mauve (warm outbound)
upload_start = "#ea76cb"
upload_end = "#8839ef"

#  ── Process Box ──────────────────────────────────────────────────────────────

#  Process CPU — Neutral to Red (danger on high)
proc_start = "#acb0be"
proc_end = "#d20f39"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🌡️   TEMPERATURE GRADIENT (Light)
#  Teal (cool) → Yellow (warm) → Red (critical)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

temp_start = "#179299"
temp_end = "#d20f39"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📊  GRAPH GRADIENTS — Light Theme Palette
#  On light backgrounds, use vivid saturated colors that pop
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

#  CPU Graph: Surface → Lavender → Mauve
cpu_graph = "#ccd0da #acb0be #7287fd #8839ef"

#  Memory Graph: Surface → Sky → Green
mem_graph = "#ccd0da #acb0be #04a5e5 #40a02b"

#  Network Down: Surface → Sky → Blue
net_d_graph = "#ccd0da #9ca0b0 #04a5e5 #1e66f5"

#  Network Up: Surface → Pink → Mauve
net_u_graph = "#ccd0da #9ca0b0 #ea76cb #8839ef"

#  Process: Surface → Peach → Red
proc_graph = "#ccd0da #acb0be #fe640b #d20f39"