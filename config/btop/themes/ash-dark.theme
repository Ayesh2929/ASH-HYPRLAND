# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  ASH DOTFILES v5.0 — BTOP++ THEME: ASH DARK                               ║
# ║                                                                            ║
# ║  Base     : Catppuccin Mocha                                               ║
# ║  Accent   : Mauve (#cba6f7) — Lavender highlights                         ║
# ║  Style    : Deep glass-dark with purple-blue gradient accents              ║
# ║  Graph    : Braille + smooth color transitions                             ║
# ║                                                                            ║
# ║  Color Reference (Catppuccin Mocha):                                      ║
# ║  ┌─────────────────┬───────────┬────────────────────────────────┐         ║
# ║  │ Role            │ Hex       │ Usage                          │         ║
# ║  ├─────────────────┼───────────┼────────────────────────────────┤         ║
# ║  │ Crust           │ #11111b   │ Deepest background             │         ║
# ║  │ Mantle          │ #181825   │ Background variant             │         ║
# ║  │ Base            │ #1e1e2e   │ Primary background             │         ║
# ║  │ Surface 0       │ #313244   │ Elevated surface               │         ║
# ║  │ Surface 1       │ #45475a   │ Higher surface                 │         ║
# ║  │ Surface 2       │ #585b70   │ Highest surface                │         ║
# ║  │ Overlay 0       │ #6c7086   │ Disabled / muted               │         ║
# ║  │ Overlay 1       │ #7f849c   │ Subtle text                    │         ║
# ║  │ Overlay 2       │ #9399b2   │ Subdued text                   │         ║
# ║  │ Subtext 0       │ #a6adc8   │ Secondary text                 │         ║
# ║  │ Subtext 1       │ #bac2de   │ Primary muted text             │         ║
# ║  │ Text            │ #cdd6f4   │ Primary text                   │         ║
# ║  │ Lavender        │ #b4befe   │ Soft accent                    │         ║
# ║  │ Blue            │ #89b4fa   │ Network / Info                 │         ║
# ║  │ Sapphire        │ #74c7ec   │ Cool accent                    │         ║
# ║  │ Sky             │ #89dceb   │ Light cool                     │         ║
# ║  │ Teal            │ #94e2d5   │ Success variant                │         ║
# ║  │ Green           │ #a6e3a1   │ OK / Success                   │         ║
# ║  │ Yellow          │ #f9e2af   │ Warning                        │         ║
# ║  │ Peach           │ #fab387   │ Warm accent                    │         ║
# ║  │ Maroon          │ #eba0ac   │ Soft danger                    │         ║
# ║  │ Red             │ #f38ba8   │ Critical / Error               │         ║
# ║  │ Mauve           │ #cba6f7   │ PRIMARY ACCENT                 │         ║
# ║  │ Pink            │ #f5c2e7   │ Secondary accent               │         ║
# ║  │ Flamingo        │ #f2cdcd   │ Soft pink                      │         ║
# ║  │ Rosewater       │ #f5e0dc   │ Lightest accent                │         ║
# ║  └─────────────────┴───────────┴────────────────────────────────┘         ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🎨  CORE COLORS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

#  Main background — Catppuccin Base
#  Deep dark background matching Hyprland/Waybar glass surfaces
main_bg = "#1e1e2e"

#  Main foreground — Primary text color
main_fg = "#cdd6f4"

#  Title text color — Bright Lavender for premium header look
title = "#b4befe"

#  Color of highlighted/selected text
hi_fg = "#cba6f7"

#  Selected box / line background
selected_bg = "#313244"

#  Selected item foreground
selected_fg = "#cdd6f4"

#  Inactive / dimmed text
inactive_fg = "#6c7086"

#  ── Graph Colors ─────────────────────────────────────────────────────────────

#  CPU graph gradient — Mauve → Lavender → Blue (cool performance palette)
#  Format: "color1 color2 color3 ..." (up to 10 gradient stops)
#  Applied from low% to high% usage — aesthetic matches ASH dark theme
graph_color = "#45475a #6c7086 #9399b2 #b4befe #cba6f7 #89b4fa #74c7ec #94e2d5 #a6e3a1"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📦  BOX BORDERS & FRAMES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

#  Box border color — subtle surface border for glass effect
proc_misc = "#45475a"

#  CPU box specific colors
#  Line indicator color for CPU frequency / temp header values
cpu_box = "#cba6f7"

#  ── CPU Box ──────────────────────────────────────────────────────────────────

#  CPU percentage text color
cpu_start = "#89b4fa"

#  CPU graph end color (high usage)
cpu_end = "#cba6f7"

#  CPU percentage numbers
cpu_dec_color = "#74c7ec"

#  ── Memory Box ───────────────────────────────────────────────────────────────

#  Memory used bar color — Teal/Green for "healthy" feel
mem_box = "#94e2d5"

#  Memory used start gradient
mem_start = "#94e2d5"

#  Memory used end gradient  
mem_end = "#a6e3a1"

#  Swap used colors
swap_start = "#f9e2af"
swap_end = "#fab387"

#  Disk usage bar color
disk_start = "#89b4fa"
disk_end = "#b4befe"

#  ── Network Box ──────────────────────────────────────────────────────────────

#  Network download bar (blue — data coming in)
download_start = "#89b4fa"
download_end = "#74c7ec"

#  Network upload bar (pink/mauve — data going out)
upload_start = "#f5c2e7"
upload_end = "#cba6f7"

#  ── Process Box ──────────────────────────────────────────────────────────────

#  Process CPU usage gradient — matches CPU box theme
proc_start = "#45475a"
proc_end = "#cba6f7"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🌡️   TEMPERATURE GRADIENT
#  Cold (OK) → Warm (Warning) → Hot (Critical)
#  Teal → Yellow → Orange → Red
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

temp_start = "#94e2d5"
temp_end = "#f38ba8"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📊  GRAPH GRADIENT — Full Spectrum
#  The definitive ASH dark graph palette
#  Applied across all graphs for a cohesive premium aesthetic
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

#  CPU Graph: Surface → Lavender → Mauve
#  Low usage = deep surface, High usage = bright mauve glow
cpu_graph = "#313244 #585b70 #9399b2 #b4befe #cba6f7"

#  Memory Graph: Dark → Teal → Green
#  Memory pressure shown through cool-to-warm progression
mem_graph = "#313244 #45475a #74c7ec #94e2d5 #a6e3a1"

#  Network Down: Dark → Blue → Sapphire
#  Download speed shown in cool blues
net_d_graph = "#313244 #45475a #89b4fa #74c7ec"

#  Network Up: Dark → Pink → Mauve
#  Upload speed shown in warm pinks
net_u_graph = "#313244 #45475a #f5c2e7 #cba6f7"

#  Process Graph: Dark → Peach → Red (high CPU proc = danger)
proc_graph = "#313244 #585b70 #fab387 #f38ba8"