{
    "$schema": "../schema/widget-schema.json",
    "_meta": {
      "name": "ASH Ultra Volume Slider",
      "version": "5.0.0",
      "description": "Premium multi-channel volume control widget with per-app mixer, visualizer, and device switcher",
      "author": "ash-dotfiles",
      "icon": "󰕾",
      "category": "audio",
      "tags": ["volume", "audio", "pipewire", "pulseaudio", "mixer", "osd"]
    },
  
    "widget": {
      "type": "volume-slider",
      "id": "ash-volume-widget",
      "class": "ash-widget ash-widget--volume ash-widget--glass",
      "aria-label": "Volume Control Panel",
      "aria-role": "group"
    },
  
    "layout": {
      "orientation": "vertical",
      "spacing": 0,
      "padding": {
        "top": 16,
        "right": 16,
        "bottom": 16,
        "left": 16
      }
    },
  
    "header": {
      "enabled": true,
      "layout": "space-between",
      "left": {
        "icon": {
          "type": "dynamic",
          "states": {
            "muted":   { "icon": "󰝟", "class": "icon--muted",  "color": "var(--cc-red)",    "tooltip": "Muted"    },
            "low":     { "icon": "󰕿", "class": "icon--low",    "color": "var(--cc-accent)",  "tooltip": "Low"      },
            "medium":  { "icon": "󰖀", "class": "icon--medium", "color": "var(--cc-accent)",  "tooltip": "Medium"   },
            "high":    { "icon": "󰕾", "class": "icon--high",   "color": "var(--cc-accent)",  "tooltip": "High"     },
            "boost":   { "icon": "󱄠", "class": "icon--boost",  "color": "var(--cc-yellow)",  "tooltip": "Boosted"  }
          },
          "thresholds": {
            "muted":  0,
            "low":    1,
            "medium": 33,
            "high":   66,
            "boost":  101
          },
          "font-size": "20px",
          "animation": "icon-bounce",
          "animation-on": "state-change"
        },
        "label": {
          "text": "Volume",
          "class": "widget-section-label",
          "font-weight": 700,
          "font-size": "13px"
        }
      },
      "right": {
        "percentage-label": {
          "enabled": true,
          "class": "volume-percentage",
          "format": "{value}%",
          "font-size": "13px",
          "font-weight": 700,
          "font-family": "JetBrainsMono Nerd Font",
          "color": "var(--cc-accent)",
          "animation": "number-roll",
          "animation-duration": "200ms"
        },
        "mute-button": {
          "enabled": true,
          "class": "btn-mute btn-icon",
          "icon-on":  "󰝟",
          "icon-off": "󰕾",
          "tooltip-on":  "Unmute",
          "tooltip-off": "Mute",
          "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
          "keybind": "m",
          "animation": "btn-ripple",
          "haptic": true
        }
      }
    },
  
    "master-slider": {
      "enabled": true,
      "class": "slider slider--master slider--volume",
      "aria-label": "Master Volume",
  
      "range": {
        "min": 0,
        "max": 150,
        "step": 1,
        "scroll-step": 5,
        "fine-step": 1,
        "boost-threshold": 100,
        "safe-max": 100
      },
  
      "command": {
        "set":    "pactl set-sink-volume @DEFAULT_SINK@ {value}%",
        "get":    "pactl get-sink-volume @DEFAULT_SINK@",
        "mute":   "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "poll":   "pactl subscribe",
        "poll-interval": 0
      },
  
      "track": {
        "class": "slider__track",
        "height": 8,
        "border-radius": 100,
        "background": "var(--cc-progress-track)",
        "overflow": "visible"
      },
  
      "fill": {
        "class": "slider__fill",
        "border-radius": 100,
        "gradient": {
          "type": "linear",
          "direction": "90deg",
          "stops": [
            { "at":   "0%", "color": "var(--cc-accent)",        "opacity": 0.85 },
            { "at":  "66%", "color": "var(--cc-accent-bright)", "opacity": 1.00 },
            { "at": "100%", "color": "var(--cc-accent)",        "opacity": 1.00 },
            { "at": "101%", "color": "var(--cc-yellow)",        "opacity": 1.00 },
            { "at": "150%", "color": "var(--cc-red)",           "opacity": 1.00 }
          ]
        },
        "transition": {
          "property": "all",
          "duration": "120ms",
          "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
        },
        "glow": {
          "enabled": true,
          "color": "var(--cc-accent-glow)",
          "blur": "8px",
          "spread": "0px",
          "opacity": 0.6,
          "boost-color": "var(--cc-yellow-glow)"
        }
      },
  
      "thumb": {
        "class": "slider__thumb",
        "size": 18,
        "border-radius": "50%",
        "background": "var(--cc-accent-bright)",
        "border": "2.5px solid var(--cc-panel-bg)",
        "box-shadow": [
          "0 2px 8px var(--cc-shadow)",
          "0 0 8px var(--cc-accent-glow)"
        ],
        "hover": {
          "scale": 1.20,
          "box-shadow": [
            "0 4px 16px var(--cc-shadow)",
            "0 0 14px var(--cc-accent-glow)"
          ]
        },
        "active": {
          "scale": 0.92
        },
        "animation": {
          "appear": "slider-thumb-appear",
          "duration": "200ms",
          "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)"
        },
        "hide-when-idle": false
      },
  
      "boost-zone": {
        "enabled": true,
        "start": 100,
        "class": "slider__boost-zone",
        "background": "var(--cc-yellow-dim)",
        "border-left": "2px dashed var(--cc-yellow)",
        "label": {
          "text": "BOOST",
          "class": "boost-label",
          "font-size": "9px",
          "font-weight": 800,
          "color": "var(--cc-yellow)",
          "letter-spacing": "0.1em"
        },
        "warning": {
          "enabled": true,
          "threshold": 120,
          "icon": "󰀦",
          "message": "Volume above 100% may damage audio hardware",
          "class": "boost-warning"
        }
      },
  
      "visualizer": {
        "enabled": true,
        "type": "bar-behind-track",
        "source": "pipewire",
        "bars": 32,
        "height": 24,
        "color": "var(--cc-accent)",
        "opacity": 0.20,
        "animation": "smooth",
        "fps": 30,
        "falloff": 0.85
      },
  
      "feedback": {
        "osd": {
          "enabled": true,
          "position": "bottom-center",
          "duration": 1500,
          "icon": "dynamic",
          "bar-style": "rounded",
          "class": "volume-osd"
        },
        "sound": {
          "enabled": false,
          "file": "~/.config/swaync/../sounds/volume-change.ogg",
          "volume": 0.3
        },
        "haptic": false
      }
    },
  
    "channel-sliders": {
      "enabled": true,
      "collapsible": true,
      "collapsed-by-default": true,
      "toggle-button": {
        "class": "btn-expand btn-icon",
        "icon-collapsed": "󰒓",
        "icon-expanded":  "󰒓",
        "label-collapsed": "Channels",
        "label-expanded":  "Channels",
        "animation": "rotate-180"
      },
      "channels": [
        {
          "id": "front-left",
          "label": "L",
          "icon": "󰓃",
          "command-set": "pactl set-sink-volume @DEFAULT_SINK@ {left}% {right}%",
          "color": "var(--cc-blue)",
          "class": "slider--channel slider--left"
        },
        {
          "id": "front-right",
          "label": "R",
          "icon": "󰓃",
          "color": "var(--cc-mauve)",
          "class": "slider--channel slider--right"
        }
      ],
      "link-channels": {
        "enabled": true,
        "default": true,
        "icon-linked":   "󰌾",
        "icon-unlinked": "󱥸",
        "tooltip-linked": "Linked — click to separate L/R",
        "tooltip-unlinked": "Unlinked — click to sync L/R",
        "class": "btn-link-channels"
      }
    },
  
    "device-switcher": {
      "enabled": true,
      "class": "device-switcher",
      "label": "Output Device",
      "label-icon": "󰓃",
      "collapsible": true,
      "collapsed-by-default": true,
      "max-devices": 6,
      "show-icons": true,
      "show-descriptions": true,
      "command-list":   "pactl list sinks short",
      "command-set":    "pactl set-default-sink {device}",
      "command-get":    "pactl get-default-sink",
      "auto-refresh":   true,
      "refresh-event":  "pactl subscribe",
      "device-icons": {
        "hdmi":        "󰡁",
        "bluetooth":   "󰂰",
        "usb":         "󱡊",
        "headphones":  "󰋋",
        "headset":     "󰋎",
        "speaker":     "󰓃",
        "builtin":     "󰓃",
        "virtual":     "󰝸",
        "default":     "󰓃"
      },
      "item-class": "device-item",
      "item-active-class": "device-item--active",
      "animation": {
        "enter": "widget-enter",
        "duration": "200ms"
      }
    },
  
    "per-app-mixer": {
      "enabled": true,
      "class": "per-app-mixer",
      "label": "App Mixer",
      "label-icon": "󰍽",
      "collapsible": true,
      "collapsed-by-default": true,
      "max-apps": 8,
      "show-icons": true,
      "show-app-names": true,
      "command-list":  "pactl list sink-inputs short",
      "command-set":   "pactl set-sink-input-volume {id} {value}%",
      "command-mute":  "pactl set-sink-input-mute {id} toggle",
      "auto-refresh":  true,
  
      "app-slider": {
        "range":  { "min": 0, "max": 100, "step": 1 },
        "height": 4,
        "color":  "var(--cc-accent)",
        "thumb-size": 12,
        "class": "slider--app"
      },
  
      "app-icon-size": 20,
      "app-name-max-length": 18,
      "empty-state": {
        "icon":    "󰂚",
        "message": "No apps playing audio",
        "class":   "per-app-empty"
      },
  
      "ignored-apps": ["pavucontrol", "pactl", "pw-cat"],
  
      "animation": {
        "item-enter": "notif-fade-in",
        "item-exit":  "notif-slide-out",
        "duration":   "180ms"
      }
    },
  
    "microphone-section": {
      "enabled": true,
      "class": "mic-section",
      "collapsible": true,
      "collapsed-by-default": true,
  
      "header": {
        "icon": {
          "type": "dynamic",
          "states": {
            "muted": { "icon": "󰍭", "color": "var(--cc-red)"    },
            "active": { "icon": "󰍬", "color": "var(--cc-green)" }
          }
        },
        "label": "Microphone",
        "mute-button": {
          "icon-on":  "󰍭",
          "icon-off": "󰍬",
          "command":  "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
          "class":    "btn-mic-mute btn-icon"
        }
      },
  
      "slider": {
        "command-set": "pactl set-source-volume @DEFAULT_SOURCE@ {value}%",
        "command-get": "pactl get-source-volume @DEFAULT_SOURCE@",
        "range": { "min": 0, "max": 150, "step": 1 },
        "color": "var(--cc-green)",
        "glow-color": "var(--cc-green-glow)",
        "class": "slider--mic"
      },
  
      "input-level-meter": {
        "enabled": true,
        "source": "pipewire",
        "bars": 24,
        "color": "var(--cc-green)",
        "peak-color": "var(--cc-red)",
        "peak-hold": 1500,
        "class": "input-level-meter"
      }
    },
  
    "presets": {
      "enabled": true,
      "class": "volume-presets",
      "label": "Quick Levels",
      "show-label": false,
      "items": [
        {
          "label": "󰸃",
          "value": 0,
          "tooltip": "Mute",
          "command": "pactl set-sink-mute @DEFAULT_SINK@ 1",
          "class": "preset-btn preset-btn--mute"
        },
        {
          "label": "25%",
          "value": 25,
          "tooltip": "Quarter volume",
          "command": "pactl set-sink-volume @DEFAULT_SINK@ 25%",
          "class": "preset-btn"
        },
        {
          "label": "50%",
          "value": 50,
          "tooltip": "Half volume",
          "command": "pactl set-sink-volume @DEFAULT_SINK@ 50%",
          "class": "preset-btn"
        },
        {
          "label": "75%",
          "value": 75,
          "tooltip": "Three quarter volume",
          "command": "pactl set-sink-volume @DEFAULT_SINK@ 75%",
          "class": "preset-btn"
        },
        {
          "label": "100%",
          "value": 100,
          "tooltip": "Full volume",
          "command": "pactl set-sink-volume @DEFAULT_SINK@ 100%",
          "class": "preset-btn preset-btn--full"
        }
      ]
    },
  
    "equalizer": {
      "enabled": false,
      "class": "eq-section",
      "label": "Equalizer",
      "label-icon": "󱡒",
      "collapsible": true,
      "backend": "easyeffects",
      "command-apply-preset": "easyeffects --load-preset {name}",
      "presets": [
        { "name": "flat",        "label": "Flat",        "icon": "󱡒" },
        { "name": "bass-boost",  "label": "Bass",        "icon": "󱟛" },
        { "name": "treble",      "label": "Treble",      "icon": "󱡡" },
        { "name": "gaming",      "label": "Gaming",      "icon": "󰎃" },
        { "name": "voice",       "label": "Voice",       "icon": "󰗋" },
        { "name": "movie",       "label": "Movie",       "icon": "󰿎" }
      ]
    },
  
    "keyboard-shortcuts": {
      "enabled": true,
      "bindings": {
        "volume-up":        "super+equal",
        "volume-down":      "super+minus",
        "mute-toggle":      "super+m",
        "next-device":      "super+shift+period",
        "prev-device":      "super+shift+comma",
        "reset":            "super+0"
      }
    },
  
    "scroll-behavior": {
      "enabled": true,
      "direction": "vertical",
      "step": 5,
      "smooth": true,
      "invert": false,
      "command-up":   "pactl set-sink-volume @DEFAULT_SINK@ +5%",
      "command-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    },
  
    "styling": {
      "theme-integration": true,
      "glassmorphism": {
        "enabled": true,
        "blur": "24px",
        "saturate": "180%",
        "background": "var(--cc-widget-bg)"
      },
      "border-radius": "16px",
      "border": "1px solid var(--cc-widget-border)",
      "box-shadow": [
        "0 4px 24px var(--cc-shadow)",
        "inset 0 1px 0 var(--cc-highlight)"
      ],
      "animation": {
        "enter":    "widget-enter",
        "duration": "280ms",
        "delay":    "120ms",
        "easing":   "cubic-bezier(0.19, 1, 0.22, 1)"
      }
    },
  
    "accessibility": {
      "keyboard-navigable": true,
      "screen-reader": true,
      "aria-live": "polite",
      "high-contrast-support": true,
      "reduced-motion-support": true,
      "focus-visible": {
        "outline": "2px solid var(--cc-accent)",
        "outline-offset": "2px"
      }
    }
  }