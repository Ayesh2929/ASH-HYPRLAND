{
    "ASH TODO": {
      "prefix": ["atodo", "ash_todo"],
      "description": "🔥 ASH TODO annotation",
      "body": ["${1:// }ASH: TODO(${2:ash}): ${3:description}"]
    },
  
    "ASH FIXME": {
      "prefix": ["afixme", "ash_fixme"],
      "description": "🔥 ASH FIXME annotation",
      "body": ["${1:// }ASH: FIXME(${2:ash}): ${3:description}"]
    },
  
    "ASH NOTE": {
      "prefix": ["anote", "ash_note"],
      "description": "🔥 ASH NOTE annotation",
      "body": ["${1:// }ASH: NOTE(${2:ash}): ${3:description}"]
    },
  
    "ASH PERF": {
      "prefix": ["aperf", "ash_perf"],
      "description": "🔥 ASH PERF annotation",
      "body": ["${1:// }ASH: PERF(${2:ash}): ${3:description}"]
    },
  
    "ASH HACK": {
      "prefix": ["ahack", "ash_hack"],
      "description": "🔥 ASH HACK annotation",
      "body": ["${1:// }ASH: HACK(${2:ash}): ${3:description}"]
    },
  
    "ASH WARN": {
      "prefix": ["awarn", "ash_warn"],
      "description": "🔥 ASH WARN annotation",
      "body": ["${1:// }ASH: WARN(${2:ash}): ${3:description}"]
    },
  
    "ASH DOCS": {
      "prefix": ["adocs", "ash_docs"],
      "description": "🔥 ASH DOCS annotation",
      "body": ["${1:// }ASH: DOCS(${2:ash}): ${3:description}"]
    },
  
    "ASH OMEGA": {
      "prefix": ["aomega", "omega"],
      "description": "🔥 ASH OMEGA v5.0 header",
      "body": [
        "${1:# }╔══════════════════════════════════════════════════════╗",
        "${1:# }║  🔥 ${2:Section Title} — ASH OMEGA v5.0              ║",
        "${1:# }╚══════════════════════════════════════════════════════╝"
      ]
    },
  
    "Section Divider": {
      "prefix": ["div", "divider", "section"],
      "description": "🌐 Section divider comment",
      "body": ["${1:# }── ${2:Section Name} ──────────────────────────────────────"]
    },
  
    "TODO Comment": {
      "prefix": ["todo", "TODO"],
      "description": "🌐 TODO comment",
      "body": ["${1:// }TODO(${2:${TM_USERNAME:ash}}): ${3:description}"]
    },
  
    "FIXME Comment": {
      "prefix": ["fixme", "FIXME"],
      "description": "🌐 FIXME comment",
      "body": ["${1:// }FIXME(${2:${TM_USERNAME:ash}}): ${3:description}"]
    },
  
    "NOTE Comment": {
      "prefix": ["note", "NOTE"],
      "description": "🌐 NOTE comment",
      "body": ["${1:// }NOTE: ${2:description}"]
    },
  
    "HACK Comment": {
      "prefix": ["hack", "HACK"],
      "description": "🌐 HACK comment",
      "body": ["${1:// }HACK: ${2:description}"]
    },
  
    "PERF Comment": {
      "prefix": ["perf", "PERF"],
      "description": "🌐 PERF comment",
      "body": ["${1:// }PERF: ${2:description}"]
    },
  
    "WARN Comment": {
      "prefix": ["warn", "WARN"],
      "description": "🌐 WARN comment",
      "body": ["${1:// }WARN: ${2:description}"]
    },
  
    "SAFETY Comment": {
      "prefix": ["safety", "SAFETY"],
      "description": "🌐 SAFETY justification comment",
      "body": ["${1:// }SAFETY: ${2:invariant justification}"]
    },
  
    "INVARIANT Comment": {
      "prefix": ["invariant", "INV"],
      "description": "🌐 INVARIANT comment",
      "body": ["${1:// }INVARIANT: ${2:invariant description}"]
    },
  
    "ISO Timestamp": {
      "prefix": ["ts", "timestamp", "iso_date"],
      "description": "🌐 ISO-8601 timestamp",
      "body": ["${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}T${CURRENT_HOUR}:${CURRENT_MINUTE}:${CURRENT_SECOND}Z"]
    },
  
    "Date": {
      "prefix": ["date", "today"],
      "description": "🌐 Current date",
      "body": ["${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}"]
    },
  
    "Filename": {
      "prefix": ["filename", "fname"],
      "description": "🌐 Current filename",
      "body": ["${TM_FILENAME}"]
    },
  
    "Filename No Extension": {
      "prefix": ["filestem", "stem"],
      "description": "🌐 Filename without extension",
      "body": ["${TM_FILENAME_BASE}"]
    },
  
    "Directory": {
      "prefix": ["dir", "dirname"],
      "description": "🌐 Current directory",
      "body": ["${TM_DIRECTORY}"]
    },
  
    "UUID": {
      "prefix": ["uuid", "guid"],
      "description": "🌐 Random UUID v4",
      "body": ["${RANDOM_HEX}${RANDOM_HEX}-${RANDOM_HEX}-4${RANDOM_HEX}-${RANDOM_HEX}-${RANDOM_HEX}${RANDOM_HEX}${RANDOM_HEX}"]
    },
  
    "Random": {
      "prefix": ["rand", "random"],
      "description": "🌐 Random number",
      "body": ["${RANDOM}"]
    },
  
    "Random Hex": {
      "prefix": ["randhex", "hex"],
      "description": "🌐 Random hex",
      "body": ["${RANDOM_HEX}"]
    },
  
    "MIT License": {
      "prefix": ["mit", "license"],
      "description": "🌐 MIT License header",
      "body": [
        "MIT License",
        "",
        "Copyright (c) ${CURRENT_YEAR} ${1:${TM_USERNAME:ash}}",
        "",
        "Permission is hereby granted, free of charge, to any person obtaining a copy",
        "of this software and associated documentation files (the \"Software\"), to deal",
        "in the Software without restriction, including without limitation the rights",
        "to use, copy, modify, merge, publish, distribute, sublicense, and/or sell",
        "copies of the Software, and to permit persons to whom the Software is",
        "furnished to do so, subject to the following conditions:",
        "",
        "The above copyright notice and this permission notice shall be included in all",
        "copies or substantial portions of the Software.",
        "",
        "THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR",
        "IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,",
        "FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE",
        "AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER",
        "LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,",
        "OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE",
        "SOFTWARE."
      ]
    },
  
    "Copyright Header": {
      "prefix": ["copyright", "cr"],
      "description": "🌐 Copyright file header",
      "body": [
        "${1:// }Copyright (c) ${CURRENT_YEAR} ${2:${TM_USERNAME:ash}}. All rights reserved.",
        "${1:// }SPDX-License-Identifier: ${3:MIT}"
      ]
    },
  
    "Shebang Bash": {
      "prefix": ["shbash", "#!/"],
      "description": "🌐 Bash shebang",
      "body": ["#!/usr/bin/env bash"]
    },
  
    "Shebang Fish": {
      "prefix": ["shfish"],
      "description": "🌐 Fish shebang",
      "body": ["#!/usr/bin/env fish"]
    },
  
    "Shebang Python": {
      "prefix": ["shpython", "shpy"],
      "description": "🌐 Python shebang",
      "body": ["#!/usr/bin/env python3"]
    },
  
    "Shebang Node": {
      "prefix": ["shnode"],
      "description": "🌐 Node.js shebang",
      "body": ["#!/usr/bin/env node"]
    },
  
    "Email": {
      "prefix": ["email", "mail"],
      "description": "🌐 Email placeholder",
      "body": ["${1:user}@${2:example.com}"]
    },
  
    "URL": {
      "prefix": ["url", "http"],
      "description": "🌐 URL placeholder",
      "body": ["https://${1:example.com}/${2:path}"]
    },
  
    "Semver": {
      "prefix": ["semver", "version"],
      "description": "🌐 Semantic version",
      "body": ["${1:1}.${2:0}.${3:0}"]
    },
  
    "Loopback IP": {
      "prefix": ["localhost", "loopback"],
      "description": "🌐 Localhost address",
      "body": ["127.0.0.1"]
    },
  
    "IPv4": {
      "prefix": ["ipv4", "ip"],
      "description": "🌐 IPv4 address",
      "body": ["${1:192}.${2:168}.${3:1}.${4:1}"]
    },
  
    "CIDR": {
      "prefix": ["cidr", "subnet"],
      "description": "🌐 CIDR notation",
      "body": ["${1:10}.${2:0}.${3:0}.${4:0}/${5:24}"]
    },
  
    "Hex Colour": {
      "prefix": ["colour", "hex_color", "#"],
      "description": "🌐 Hex colour code",
      "body": ["#${1:7aa2f7}"]
    },
  
    "RGB Colour": {
      "prefix": ["rgb", "rgb_color"],
      "description": "🌐 RGB colour",
      "body": ["rgb(${1:122}, ${2:162}, ${3:247})"]
    },
  
    "RGBA Colour": {
      "prefix": ["rgba", "rgba_color"],
      "description": "🌐 RGBA colour",
      "body": ["rgba(${1:122}, ${2:162}, ${3:247}, ${4:0.8})"]
    },
  
    "Base64": {
      "prefix": ["b64", "base64"],
      "description": "🌐 Base64 placeholder comment",
      "body": ["${1:# base64-encoded:} ${2:value}"]
    },
  
    "Lorem Short": {
      "prefix": ["lorem", "lipsum"],
      "description": "🌐 Short lorem ipsum",
      "body": ["Lorem ipsum dolor sit amet, consectetur adipiscing elit."]
    },
  
    "Lorem Long": {
      "prefix": ["loremlong", "lipsuml"],
      "description": "🌐 Long lorem ipsum paragraph",
      "body": [
        "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor",
        "incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud",
        "exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure",
        "dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.",
        "Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt",
        "mollit anim id est laborum."
      ]
    },
  
    "Separator Thin": {
      "prefix": ["sep", "thin_sep"],
      "description": "🌐 Thin separator line",
      "body": ["${1:# }──────────────────────────────────────────────────────────────────"]
    },
  
    "Separator Thick": {
      "prefix": ["SEP", "thick_sep"],
      "description": "🌐 Thick separator line",
      "body": ["${1:# }══════════════════════════════════════════════════════════════════"]
    },
  
    "Box Comment": {
      "prefix": ["box", "box_comment"],
      "description": "🌐 Box comment",
      "body": [
        "${1:# }╔══════════════════════════════════════════════════════╗",
        "${1:# }║  ${2:Title}                                           ║",
        "${1:# }╚══════════════════════════════════════════════════════╝"
      ]
    },
  
    "Arrow Right": {
      "prefix": ["arr", "arrow"],
      "description": "🌐 Arrow symbols",
      "body": ["${1|→,←,↑,↓,⇒,⇐,⟹,⟸,➜,➡|}"]
    },
  
    "Emoji Status": {
      "prefix": ["emoji", "status_emoji"],
      "description": "🌐 Common status emojis",
      "body": ["${1|✅,❌,⚠️,ℹ️,🔥,🚀,🐛,💡,📝,🔒,🔓,⚡,🎯,🌟,💎,🔮,🏆|}"]
    }
  }