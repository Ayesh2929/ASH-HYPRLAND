{
    "Terraform Module": {
      "prefix": ["module", "tfmod"],
      "description": "🏗️ Terraform module structure",
      "body": [
        "# ╔══════════════════════════════════════════════════════╗",
        "# ║  🏗️  ${1:module-name} Terraform Module               ║",
        "# ╚══════════════════════════════════════════════════════╝",
        "",
        "terraform {",
        "  required_version = \">= ${2:1.7.0}\"",
        "",
        "  required_providers {",
        "    ${3:aws} = {",
        "      source  = \"hashicorp/${3:aws}\"",
        "      version = \"~> ${4:5.0}\"",
        "    }",
        "  }",
        "}",
        "",
        "# ── Variables ─────────────────────────────────────────",
        "variable \"${5:name}\" {",
        "  description = \"${6:Variable description}\"",
        "  type        = ${7:string}",
        "  ${8:default     = \"${9:default}\"}",
        "",
        "  validation {",
        "    condition     = ${10:length(var.${5:name}) > 0}",
        "    error_message = \"${11:Value must not be empty.}\"",
        "  }",
        "}",
        "",
        "# ── Locals ────────────────────────────────────────────",
        "locals {",
        "  name_prefix = \"${12:\\${var.${5:name}}-\\${var.environment}}\"",
        "  common_tags = {",
        "    Name        = local.name_prefix",
        "    Environment = var.environment",
        "    ManagedBy   = \"terraform\"",
        "    Module      = \"${1:module-name}\"",
        "  }",
        "}",
        "",
        "# ── Resources ─────────────────────────────────────────",
        "${0}",
        "",
        "# ── Outputs ───────────────────────────────────────────",
        "output \"${13:id}\" {",
        "  description = \"${14:The resource ID}\"",
        "  value       = ${15:aws_instance.this.id}",
        "}"
      ]
    },
  
    "Terraform Variable": {
      "prefix": ["var", "variable"],
      "description": "🏗️ Terraform variable block",
      "body": [
        "variable \"${1:name}\" {",
        "  description = \"${2:Variable description}\"",
        "  type        = ${3|string,number,bool,list(string),map(string),object({})|}",
        "  ${4:default     = \"${5:value}\"}",
        "  ${6:sensitive   = ${7:false}}",
        "",
        "  ${8:validation {",
        "    condition     = ${9:var.${1:name} != \"\"}",
        "    error_message = \"${10:Validation error message.}\"",
        "  }}",
        "}"
      ]
    },
  
    "Terraform Output": {
      "prefix": ["out", "output"],
      "description": "🏗️ Terraform output block",
      "body": [
        "output \"${1:name}\" {",
        "  description = \"${2:Output description}\"",
        "  value       = ${3:resource.name.attribute}",
        "  ${4:sensitive   = ${5:false}}",
        "}"
      ]
    },
  
    "Terraform Local": {
      "prefix": ["local", "locals"],
      "description": "🏗️ Terraform locals block",
      "body": [
        "locals {",
        "  ${1:name}     = \"${2:value}\"",
        "  ${3:common_tags} = {",
        "    Name        = \"${4:app}\"",
        "    Environment = var.environment",
        "    ManagedBy   = \"terraform\"",
        "  }",
        "}"
      ]
    },
  
    "Terraform Data Source": {
      "prefix": ["data", "datasource"],
      "description": "🏗️ Terraform data source",
      "body": [
        "data \"${1:aws_ami}\" \"${2:name}\" {",
        "  most_recent = true",
        "  owners      = [\"${3:amazon}\"]",
        "",
        "  filter {",
        "    name   = \"${4:name}\"",
        "    values = [\"${5:amzn2-ami-hvm-*-x86_64-gp2}\"]",
        "  }",
        "}"
      ]
    },
  
    "Terraform Provider": {
      "prefix": ["provider"],
      "description": "🏗️ Terraform provider block",
      "body": [
        "provider \"${1|aws,google,azurerm,kubernetes,helm|}\" {",
        "  ${2:region  = var.region}",
        "  ${3:profile = var.aws_profile}",
        "",
        "  default_tags {",
        "    tags = local.common_tags",
        "  }",
        "}"
      ]
    },
  
    "Terraform Backend S3": {
      "prefix": ["backend", "s3_backend"],
      "description": "🏗️ Terraform S3 backend",
      "body": [
        "terraform {",
        "  backend \"s3\" {",
        "    bucket         = \"${1:terraform-state-bucket}\"",
        "    key            = \"${2:app/terraform.tfstate}\"",
        "    region         = \"${3:us-east-1}\"",
        "    encrypt        = true",
        "    dynamodb_table = \"${4:terraform-lock}\"",
        "  }",
        "}"
      ]
    },
  
    "Terraform AWS EC2": {
      "prefix": ["ec2", "aws_instance"],
      "description": "🏗️ AWS EC2 instance resource",
      "body": [
        "resource \"aws_instance\" \"${1:this}\" {",
        "  ami                         = data.aws_ami.${2:amazon_linux}.id",
        "  instance_type               = var.instance_type",
        "  subnet_id                   = var.subnet_id",
        "  vpc_security_group_ids      = var.security_group_ids",
        "  iam_instance_profile        = aws_iam_instance_profile.${1:this}.name",
        "  associate_public_ip_address = ${3:false}",
        "",
        "  root_block_device {",
        "    volume_type           = \"${4:gp3}\"",
        "    volume_size           = ${5:20}",
        "    encrypted             = true",
        "    delete_on_termination = true",
        "  }",
        "",
        "  metadata_options {",
        "    http_endpoint               = \"enabled\"",
        "    http_tokens                 = \"required\"  # IMDSv2",
        "    http_put_response_hop_limit = 1",
        "  }",
        "",
        "  user_data = base64encode(templatefile(\"${6:\\${path.module}/userdata.sh.tftpl}\", {",
        "    ${7:region} = var.region",
        "  }))",
        "",
        "  tags = merge(local.common_tags, {",
        "    Name = \"\\${local.name_prefix}-${8:instance}\"",
        "  })",
        "",
        "  lifecycle {",
        "    create_before_destroy = true",
        "    ignore_changes        = [ami]",
        "  }",
        "}"
      ]
    },
  
    "Terraform AWS VPC": {
      "prefix": ["vpc", "aws_vpc"],
      "description": "🏗️ AWS VPC resource",
      "body": [
        "resource \"aws_vpc\" \"${1:main}\" {",
        "  cidr_block           = var.vpc_cidr",
        "  enable_dns_hostnames = true",
        "  enable_dns_support   = true",
        "",
        "  tags = merge(local.common_tags, {",
        "    Name = \"\\${local.name_prefix}-vpc\"",
        "  })",
        "}",
        "",
        "resource \"aws_subnet\" \"${2:public}\" {",
        "  count             = length(var.${2:public}_subnets)",
        "  vpc_id            = aws_vpc.${1:main}.id",
        "  cidr_block        = var.${2:public}_subnets[count.index]",
        "  availability_zone = data.aws_availability_zones.available.names[count.index]",
        "",
        "  map_public_ip_on_launch = ${3:true}",
        "",
        "  tags = merge(local.common_tags, {",
        "    Name = \"\\${local.name_prefix}-${2:public}-\\${count.index + 1}\"",
        "    Type = \"${2:public}\"",
        "  })",
        "}"
      ]
    },
  
    "Terraform AWS IAM": {
      "prefix": ["iam", "aws_iam"],
      "description": "🏗️ AWS IAM role and policy",
      "body": [
        "resource \"aws_iam_role\" \"${1:this}\" {",
        "  name = \"\\${local.name_prefix}-${2:role}\"",
        "",
        "  assume_role_policy = jsonencode({",
        "    Version = \"2012-10-17\"",
        "    Statement = [{",
        "      Action    = \"sts:AssumeRole\"",
        "      Effect    = \"Allow\"",
        "      Principal = {",
        "        Service = \"${3:ec2.amazonaws.com}\"",
        "      }",
        "    }]",
        "  })",
        "",
        "  tags = local.common_tags",
        "}",
        "",
        "resource \"aws_iam_role_policy\" \"${1:this}\" {",
        "  name   = \"\\${local.name_prefix}-${4:policy}\"",
        "  role   = aws_iam_role.${1:this}.id",
        "",
        "  policy = jsonencode({",
        "    Version = \"2012-10-17\"",
        "    Statement = [{",
        "      Effect   = \"Allow\"",
        "      Action   = [\"${5:s3:GetObject}\", \"${6:s3:PutObject}\"]",
        "      Resource = \"${7:arn:aws:s3:::bucket/*}\"",
        "    }]",
        "  })",
        "}"
      ]
    },
  
    "Terraform For Each": {
      "prefix": ["foreach", "for_each"],
      "description": "🏗️ for_each meta-argument",
      "body": [
        "resource \"${1:resource_type}\" \"${2:name}\" {",
        "  for_each = ${3:{ for item in var.items : item.name => item }}",
        "",
        "  ${4:name}  = each.key",
        "  ${5:value} = each.value.${6:attribute}",
        "",
        "  tags = merge(local.common_tags, {",
        "    Name = each.key",
        "  })",
        "}"
      ]
    },
  
    "Terraform Dynamic Block": {
      "prefix": ["dynamic", "dblock"],
      "description": "🏗️ Terraform dynamic block",
      "body": [
        "dynamic \"${1:ingress}\" {",
        "  for_each = var.${2:ingress_rules}",
        "",
        "  content {",
        "    from_port   = ${1:ingress}.value[\"from_port\"]",
        "    to_port     = ${1:ingress}.value[\"to_port\"]",
        "    protocol    = ${1:ingress}.value[\"protocol\"]",
        "    cidr_blocks = ${1:ingress}.value[\"cidr_blocks\"]",
        "  }",
        "}"
      ]
    },
  
    "Terraform Lifecycle": {
      "prefix": ["lifecycle"],
      "description": "🏗️ Terraform lifecycle block",
      "body": [
        "lifecycle {",
        "  create_before_destroy = ${1:false}",
        "  prevent_destroy       = ${2:false}",
        "  ignore_changes        = [${3:tags, user_data}]",
        "  replace_triggered_by  = [${4:aws_instance.other}]",
        "",
        "  precondition {",
        "    condition     = ${5:var.environment != \"production\" || var.instance_type != \"t2.micro\"}",
        "    error_message = \"${6:Production requires a larger instance type.}\"",
        "  }",
        "",
        "  postcondition {",
        "    condition     = ${7:self.public_ip != \"\"}",
        "    error_message = \"${8:Instance must have a public IP.}\"",
        "  }",
        "}"
      ]
    }
  }