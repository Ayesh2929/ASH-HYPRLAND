{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "🌙 ASH Lua Ultra Snippets v5.0",
  
    "ASH Module Pattern": {
      "prefix": ["mod", "module"],
      "description": "🌙 Full Lua module with constructor & methods",
      "body": [
        "-- ╔══════════════════════════════════════════════════╗",
        "-- ║  🌙 ${1:ModuleName} — ${2:description}          ║",
        "-- ╚══════════════════════════════════════════════════╝",
        "",
        "local ${1:ModuleName} = {}",
        "${1:ModuleName}.__index = ${1:ModuleName}",
        "",
        "--- Creates a new ${1:ModuleName} instance",
        "---@param opts? table Configuration options",
        "---@return ${1:ModuleName}",
        "function ${1:ModuleName}.new(opts)",
        "  opts = opts or {}",
        "  local self = setmetatable({}, ${1:ModuleName})",
        "  self.${3:field} = opts.${3:field} or ${4:default}",
        "  return self",
        "end",
        "",
        "--- ${5:Method description}",
        "---@param self ${1:ModuleName}",
        "---@return ${6:nil}",
        "function ${1:ModuleName}:${7:method}()",
        "  ${8:-- body}",
        "end",
        "",
        "return ${1:ModuleName}"
      ]
    },
  
    "ASH Protected Require": {
      "prefix": ["preq", "safe_require"],
      "description": "🌙 Protected require with error handling",
      "body": [
        "local ok_${1:name}, ${1:name} = pcall(require, \"${2:module.path}\")",
        "if not ok_${1:name} then",
        "  vim.notify(",
        "    \"Failed to load ${2:module.path}: \" .. tostring(${1:name}),",
        "    vim.log.levels.WARN,",
        "    { title = \"${3:ASH}\" }",
        "  )",
        "  return",
        "end",
        "$0"
      ]
    },
  
    "ASH Keymap Set": {
      "prefix": ["kmap", "keymap"],
      "description": "🌙 vim.keymap.set with full options",
      "body": [
        "vim.keymap.set(${1|\"n\",\"i\",\"v\",\"x\",\"o\",\"s\",\"t\",{ \"n\", \"v\" },{ \"i\", \"s\" }|}, \"${2:<leader>x}\", ${3:function() end}, {",
        "  desc    = \"${4:Description}\",",
        "  silent  = ${5:true},",
        "  noremap = ${6:true},",
        "  buffer  = ${7:nil},",
        "})"
      ]
    },
  
    "ASH Autocmd": {
      "prefix": ["au", "autocmd"],
      "description": "🌙 vim.api.nvim_create_autocmd",
      "body": [
        "vim.api.nvim_create_autocmd(\"${1:BufReadPre}\", {",
        "  group    = ${2:aug},",
        "  pattern  = ${3:\"*\"},",
        "  callback = function(ev)",
        "    ${4:-- body}",
        "  end,",
        "})"
      ]
    },
  
    "ASH Augroup": {
      "prefix": ["aug", "augroup"],
      "description": "🌙 Create autocmd group",
      "body": [
        "local ${1:aug} = vim.api.nvim_create_augroup(\"${2:AshGroup}\", { clear = true })"
      ]
    },
  
    "ASH Notify": {
      "prefix": ["notif", "notify"],
      "description": "🌙 vim.notify with all options",
      "body": [
        "vim.notify(",
        "  \"${1:message}\",",
        "  vim.log.levels.${2|INFO,WARN,ERROR,DEBUG,TRACE|},",
        "  {",
        "    title   = \"${3:ASH}\",",
        "    timeout = ${4:2000},",
        "  }",
        ")"
      ]
    },
  
    "ASH Highlight Set": {
      "prefix": ["hl", "highlight"],
      "description": "🌙 vim.api.nvim_set_hl",
      "body": [
        "vim.api.nvim_set_hl(0, \"${1:GroupName}\", {",
        "  bold      = ${2:false},",
        "  italic    = ${3:false},",
        "  underline = ${4:false},",
        "  fg        = \"${5:#7aa2f7}\",",
        "  bg        = \"${6:NONE}\",",
        "})"
      ]
    },
  
    "ASH Function with Docs": {
      "prefix": ["fn", "func"],
      "description": "🌙 Documented Lua function",
      "body": [
        "--- ${1:Function description}",
        "---@param ${2:param} ${3:type} ${4:Param description}",
        "---@return ${5:nil}",
        "local function ${6:name}(${2:param})",
        "  ${7:-- body}",
        "end"
      ]
    },
  
    "ASH Class Method": {
      "prefix": ["meth", "method"],
      "description": "🌙 OOP method with self",
      "body": [
        "--- ${1:Method description}",
        "---@param self ${2:ClassName}",
        "---@return ${3:nil}",
        "function ${2:ClassName}:${4:methodName}(${5:args})",
        "  ${6:-- body}",
        "end"
      ]
    },
  
    "ASH Lazy Plugin Spec": {
      "prefix": ["lazy", "plugin"],
      "description": "🌙 Lazy.nvim plugin spec",
      "body": [
        "return {",
        "  {",
        "    \"${1:author/plugin-name}\",",
        "    event        = { \"${2:BufReadPre}\" },",
        "    dependencies = {",
        "      \"${3:dep/plugin}\",",
        "    },",
        "    keys = {",
        "      { \"${4:<leader>x}\", \"${5:<cmd>PluginCmd<cr>}\", desc = \"${6:description}\" },",
        "    },",
        "    opts = {",
        "      ${7:-- options}",
        "    },",
        "    config = function(_, opts)",
        "      require(\"${8:plugin}\").setup(opts)",
        "      ${9:-- extra setup}",
        "    end,",
        "  },",
        "}"
      ]
    },
  
    "ASH Async Coroutine": {
      "prefix": ["async", "coroutine"],
      "description": "🌙 Async/await pattern via coroutines",
      "body": [
        "local co = coroutine.wrap(function()",
        "  ${1:-- async body}",
        "  local result = coroutine.yield()",
        "  return result",
        "end)",
        "",
        "vim.schedule(function()",
        "  co(${2:initial_value})",
        "end)"
      ]
    },
  
    "ASH Error Handler": {
      "prefix": ["errh", "error_handler"],
      "description": "🌙 xpcall with traceback",
      "body": [
        "local ok, err = xpcall(function()",
        "  ${1:-- risky code}",
        "end, function(e)",
        "  return debug.traceback(e, 2)",
        "end)",
        "",
        "if not ok then",
        "  vim.notify(",
        "    \"Error: \" .. tostring(err),",
        "    vim.log.levels.ERROR,",
        "    { title = \"${2:ASH}\" }",
        "  )",
        "end"
      ]
    },
  
    "ASH Iterator Pattern": {
      "prefix": ["iter", "iterator"],
      "description": "🌙 vim.iter chain",
      "body": [
        "local result = vim.iter(${1:table})",
        "  :filter(function(${2:item})",
        "    return ${3:condition}",
        "  end)",
        "  :map(function(${2:item})",
        "    return ${4:transform}",
        "  end)",
        "  :totable()"
      ]
    },
  
    "ASH User Command": {
      "prefix": ["cmd", "usercmd"],
      "description": "🌙 vim.api.nvim_create_user_command",
      "body": [
        "vim.api.nvim_create_user_command(\"${1:CommandName}\", function(args)",
        "  ${2:-- body}",
        "end, {",
        "  desc  = \"${3:Description}\",",
        "  nargs = \"${4:0}\",",
        "  bang  = ${5:false},",
        "  range = ${6:false},",
        "})"
      ]
    },
  
    "ASH Buffer Local Option": {
      "prefix": ["bopt", "buf_opt"],
      "description": "🌙 Set buffer-local option",
      "body": [
        "vim.bo[${1:bufnr}].${2:filetype} = \"${3:lua}\""
      ]
    },
  
    "ASH Which-Key Group": {
      "prefix": ["wkg", "whichkey"],
      "description": "🌙 which-key group registration",
      "body": [
        "local ok_wk, wk = pcall(require, \"which-key\")",
        "if ok_wk then",
        "  wk.add({",
        "    { \"${1:<leader>a}\", group = \"${2:🔥 ASH}\" },",
        "    { \"${1:<leader>a}${3:x}\", \"${4:<cmd>Cmd<cr>}\", desc = \"${5:description}\" },",
        "  })",
        "end"
      ]
    },
  
    "ASH Highlight Link": {
      "prefix": ["hll", "hl_link"],
      "description": "🌙 Link one highlight to another",
      "body": [
        "vim.api.nvim_set_hl(0, \"${1:NewGroup}\", { link = \"${2:ExistingGroup}\" })"
      ]
    },
  
    "ASH Floating Window": {
      "prefix": ["float", "floatwin"],
      "description": "🌙 Create floating window",
      "body": [
        "local buf = vim.api.nvim_create_buf(false, true)",
        "vim.api.nvim_buf_set_lines(buf, 0, -1, false, {",
        "  \"${1:content line 1}\",",
        "  \"${2:content line 2}\",",
        "})",
        "",
        "local width  = ${3:60}",
        "local height = ${4:10}",
        "local win = vim.api.nvim_open_win(buf, true, {",
        "  relative = \"editor\",",
        "  width    = width,",
        "  height   = height,",
        "  col      = math.floor((vim.o.columns - width) / 2),",
        "  row      = math.floor((vim.o.lines - height) / 2),",
        "  style    = \"minimal\",",
        "  border   = \"rounded\",",
        "  title    = \" ${5:Window Title} \",",
        "  title_pos = \"center\",",
        "})"
      ]
    },
  
    "ASH LuaSnip Snippet": {
      "prefix": ["snip", "luasnip"],
      "description": "🌙 LuaSnip snippet definition",
      "body": [
        "s(\"${1:trigger}\", fmt(",
        "  \"${2:template with {} placeholders}\",",
        "  {",
        "    i(1, \"${3:placeholder}\"),",
        "    i(2, \"${4:placeholder2}\"),",
        "  }",
        "))"
      ]
    },
  
    "ASH Table Deep Extend": {
      "prefix": ["tde", "deep_extend"],
      "description": "🌙 vim.tbl_deep_extend merge",
      "body": [
        "local merged = vim.tbl_deep_extend(\"force\", ${1:base}, ${2:override})"
      ]
    },
  
    "ASH Defer Function": {
      "prefix": ["defer", "deferred"],
      "description": "🌙 vim.defer_fn deferred call",
      "body": [
        "vim.defer_fn(function()",
        "  ${1:-- deferred body}",
        "end, ${2:100})"
      ]
    },
  
    "ASH Schedule Function": {
      "prefix": ["sched", "schedule"],
      "description": "🌙 vim.schedule safe callback",
      "body": [
        "vim.schedule(function()",
        "  ${1:-- scheduled body}",
        "end)"
      ]
    }
  }