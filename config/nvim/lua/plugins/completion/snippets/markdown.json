{
    "ASH Document": {
      "prefix": ["doc", "document", "readme"],
      "description": "📝 Full markdown document with ASH pattern",
      "body": [
        "# ${1:Title}",
        "",
        "> ${2:Brief one-line description of the project}",
        "",
        "[![License](https://img.shields.io/badge/license-MIT-blue.svg)](LICENSE)",
        "[![Version](https://img.shields.io/badge/version-${3:1.0.0}-green.svg)](CHANGELOG.md)",
        "[![Build](https://img.shields.io/github/actions/workflow/status/${4:user}/${5:repo}/ci.yml)](https://github.com/${4:user}/${5:repo}/actions)",
        "",
        "## ✨ Features",
        "",
        "- ${6:Feature one}",
        "- ${7:Feature two}",
        "- ${8:Feature three}",
        "",
        "## 🚀 Quick Start",
        "",
        "```${9:bash}",
        "${10:# installation command}",
        "```",
        "",
        "## 📖 Usage",
        "",
        "${11:Usage description}",
        "",
        "## ⚙️ Configuration",
        "",
        "| Option | Type | Default | Description |",
        "| ------ | ---- | ------- | ----------- |",
        "| `${12:option}` | `${13:string}` | `${14:default}` | ${15:description} |",
        "",
        "## 🤝 Contributing",
        "",
        "See [CONTRIBUTING.md](CONTRIBUTING.md).",
        "",
        "## 📄 License",
        "",
        "MIT © [${16:ash}](https://github.com/${4:user})",
        "",
        "${0}"
      ]
    },
  
    "Frontmatter": {
      "prefix": ["fm", "frontmatter", "meta"],
      "description": "📝 YAML frontmatter block",
      "body": [
        "---",
        "title:       \"${1:Title}\"",
        "description: \"${2:Description}\"",
        "date:        ${3:2024-01-01}",
        "updated:     ${4:2024-01-01}",
        "author:      ${5:ash}",
        "tags:        [${6:tag1, tag2}]",
        "categories:  [${7:category}]",
        "draft:       ${8:false}",
        "toc:         ${9:true}",
        "math:        ${10:false}",
        "---",
        "",
        "${0}"
      ]
    },
  
    "Heading H1": {
      "prefix": ["h1", "heading1"],
      "description": "📝 H1 heading",
      "body": ["# ${1:Heading}"]
    },
  
    "Heading H2": {
      "prefix": ["h2", "heading2"],
      "description": "📝 H2 heading",
      "body": ["## ${1:Heading}"]
    },
  
    "Heading H3": {
      "prefix": ["h3", "heading3"],
      "description": "📝 H3 heading",
      "body": ["### ${1:Heading}"]
    },
  
    "Code Block": {
      "prefix": ["cb", "code", "fence"],
      "description": "📝 Fenced code block",
      "body": [
        "```${1|bash,python,rust,go,typescript,javascript,lua,c,cpp,java,sql,yaml,json,toml,nix,fish,html,css|}",
        "${2:code}",
        "```"
      ]
    },
  
    "Inline Code": {
      "prefix": ["ic", "inline_code"],
      "description": "📝 Inline code",
      "body": ["`${1:code}`"]
    },
  
    "Bold": {
      "prefix": ["bold", "**"],
      "description": "📝 Bold text",
      "body": ["**${1:text}**"]
    },
  
    "Italic": {
      "prefix": ["italic", "_"],
      "description": "📝 Italic text",
      "body": ["_${1:text}_"]
    },
  
    "Bold Italic": {
      "prefix": ["bi", "bold_italic"],
      "description": "📝 Bold italic text",
      "body": ["**_${1:text}_**"]
    },
  
    "Strikethrough": {
      "prefix": ["strike", "~~"],
      "description": "📝 Strikethrough text",
      "body": ["~~${1:text}~~"]
    },
  
    "Highlight": {
      "prefix": ["mark", "highlight", "=="],
      "description": "📝 Highlighted text",
      "body": ["==${1:text}=="]
    },
  
    "Link": {
      "prefix": ["link", "url", "a"],
      "description": "📝 Markdown link",
      "body": ["[${1:text}](${2:url}${3: \"${4:title}\"})"]
    },
  
    "Image": {
      "prefix": ["img", "image"],
      "description": "📝 Markdown image",
      "body": ["![${1:alt text}](${2:url}${3: \"${4:title}\"})"]
    },
  
    "Image with Link": {
      "prefix": ["imglink", "linked_image"],
      "description": "📝 Linked image",
      "body": ["[![${1:alt}](${2:image-url})](${3:link-url})"]
    },
  
    "Table": {
      "prefix": ["table", "tbl"],
      "description": "📝 Markdown table",
      "body": [
        "| ${1:Column 1} | ${2:Column 2} | ${3:Column 3} |",
        "| ${4|:------,------:,:------:,---------|} | ${5|:------,------:,:------:,---------|} | ${6|:------,------:,:------:,---------|} |",
        "| ${7:Cell 1}   | ${8:Cell 2}   | ${9:Cell 3}   |",
        "| ${10:Cell 4}  | ${11:Cell 5}  | ${12:Cell 6}  |"
      ]
    },
  
    "Callout Note": {
      "prefix": ["note", "callout_note"],
      "description": "📝 Note callout (GitHub/Obsidian)",
      "body": ["> [!NOTE]", "> ${1:Note content}"]
    },
  
    "Callout Tip": {
      "prefix": ["tip", "callout_tip"],
      "description": "📝 Tip callout",
      "body": ["> [!TIP]", "> ${1:Tip content}"]
    },
  
    "Callout Warning": {
      "prefix": ["warn", "callout_warn"],
      "description": "📝 Warning callout",
      "body": ["> [!WARNING]", "> ${1:Warning content}"]
    },
  
    "Callout Important": {
      "prefix": ["important", "callout_imp"],
      "description": "📝 Important callout",
      "body": ["> [!IMPORTANT]", "> ${1:Important content}"]
    },
  
    "Callout Caution": {
      "prefix": ["caution", "callout_caut"],
      "description": "📝 Caution callout",
      "body": ["> [!CAUTION]", "> ${1:Caution content}"]
    },
  
    "Blockquote": {
      "prefix": ["bq", "blockquote", ">"],
      "description": "📝 Blockquote",
      "body": ["> ${1:Quoted text}"]
    },
  
    "Task List": {
      "prefix": ["tasks", "checklist", "todo"],
      "description": "📝 Task list",
      "body": [
        "- [x] ${1:Completed task}",
        "- [ ] ${2:Pending task}",
        "- [ ] ${3:Another task}"
      ]
    },
  
    "Details": {
      "prefix": ["details", "summary", "spoiler"],
      "description": "📝 HTML details/summary",
      "body": [
        "<details>",
        "<summary>${1:Summary Title}</summary>",
        "",
        "${2:Hidden content here}",
        "",
        "</details>"
      ]
    },
  
    "Badge": {
      "prefix": ["badge", "shield"],
      "description": "📝 Shields.io badge",
      "body": [
        "[![${1:label}](https://img.shields.io/badge/${2:label}-${3:value}-${4|blue,green,red,yellow,orange,purple,grey|})](${5:url})"
      ]
    },
  
    "Keyboard Key": {
      "prefix": ["kbd", "key"],
      "description": "📝 Keyboard key",
      "body": ["<kbd>${1:Ctrl}</kbd>+<kbd>${2:C}</kbd>"]
    },
  
    "Footnote": {
      "prefix": ["fn", "footnote"],
      "description": "📝 Markdown footnote",
      "body": ["${1:text}[^${2:1}]", "", "[^${2:1}]: ${3:Footnote content}"]
    },
  
    "Definition List": {
      "prefix": ["dl", "definition"],
      "description": "📝 Definition list",
      "body": [
        "${1:Term}",
        ":   ${2:Definition}"
      ]
    },
  
    "Horizontal Rule": {
      "prefix": ["hr", "rule", "---"],
      "description": "📝 Horizontal rule",
      "body": ["---"]
    },
  
    "TOC": {
      "prefix": ["toc", "contents"],
      "description": "📝 Table of contents placeholder",
      "body": [
        "## 📋 Table of Contents",
        "",
        "- [${1:Section 1}](#${2:section-1})",
        "- [${3:Section 2}](#${4:section-2})",
        "- [${5:Section 3}](#${6:section-3})"
      ]
    },
  
    "Mermaid Diagram": {
      "prefix": ["mermaid", "diagram"],
      "description": "📝 Mermaid diagram block",
      "body": [
        "```mermaid",
        "${1|graph TD,sequenceDiagram,classDiagram,gantt,flowchart LR,erDiagram|}",
        "    ${2:A}[\"${3:Label}\"] --> ${4:B}[\"${5:Label}\"]",
        "```"
      ]
    },
  
    "Math Block": {
      "prefix": ["math", "latex", "$$"],
      "description": "📝 LaTeX math block",
      "body": ["$$", "${1:equation}", "$$"]
    },
  
    "Inline Math": {
      "prefix": ["imath", "$"],
      "description": "📝 Inline LaTeX math",
      "body": ["$${1:equation}$"]
    },
  
    "API Endpoint": {
      "prefix": ["api", "endpoint_doc"],
      "description": "📝 API endpoint documentation",
      "body": [
        "### `${1|GET,POST,PUT,PATCH,DELETE|}` `/${2:path}`",
        "",
        "${3:Endpoint description}.",
        "",
        "**Request**",
        "",
        "```json",
        "{",
        "  \"${4:field}\": \"${5:value}\"",
        "}",
        "```",
        "",
        "**Response** `${6:200 OK}`",
        "",
        "```json",
        "{",
        "  \"${7:field}\": \"${8:value}\"",
        "}",
        "```",
        "",
        "| Code | Description |",
        "| ---- | ----------- |",
        "| `${9:200}` | ${10:Success} |",
        "| `${11:400}` | ${12:Bad Request} |",
        "| `${13:404}` | ${14:Not Found} |"
      ]
    }
  }