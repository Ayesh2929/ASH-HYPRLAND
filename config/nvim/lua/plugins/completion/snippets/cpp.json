        "",
        "// Shared ownership",
        "auto ${4:shared} = std::make_shared<${2:Type}>(${3:args});",
        "std::weak_ptr<${2:Type}> ${5:weak} = ${4:shared};",
        "",
        "// Check and use weak_ptr",
        "if (auto locked = ${5:weak}.lock()) {",
        "  ${6:locked->method();}",
        "}"
      ]
    },
  
