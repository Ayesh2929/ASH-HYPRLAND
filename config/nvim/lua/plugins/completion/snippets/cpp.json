{
    "ASH C++ Module": {
      "prefix": ["module", "hpp", "header"],
      "description": "⚙️  C++ header with ASH pattern",
      "body": [
        "#pragma once",
        "// ╔══════════════════════════════════════════════════════╗",
        "// ║  ⚙️  ${1:ClassName} — ${2:description}               ║",
        "// ║  Author:  ${3:ash}                                   ║",
        "// ╚══════════════════════════════════════════════════════╝",
        "",
        "#include <${4:string}>",
        "#include <${5:memory}>",
        "#include <${6:stdexcept}>",
        "",
        "namespace ${7:ash} {",
        "",
        "/// @brief ${2:description}",
        "/// @tparam T Value type",
        "class ${1:ClassName} {",
        "public:",
        "  // ── Constructors ──────────────────────────────────────",
        "  explicit ${1:ClassName}(${8:std::string} ${9:param});",
        "  ~${1:ClassName}() = default;",
        "",
        "  ${1:ClassName}(const ${1:ClassName}&)            = ${10|default,delete|};",
        "  ${1:ClassName}& operator=(const ${1:ClassName}&) = ${10|default,delete|};",
        "  ${1:ClassName}(${1:ClassName}&&)            noexcept = default;",
        "  ${1:ClassName}& operator=(${1:ClassName}&&) noexcept = default;",
        "",
        "  // ── Public API ────────────────────────────────────────",
        "  [[nodiscard]] ${11:std::string} ${12:method}() const;",
        "  void ${13:mutate}(${14:std::string} value);",
        "",
        "private:",
        "  // ── Fields ────────────────────────────────────────────",
        "  ${8:std::string} ${15:m_param};",
        "};",
        "",
        "} // namespace ${7:ash}"
      ]
    },
  
    "C++ Class": {
      "prefix": ["class", "cls"],
      "description": "⚙️  C++ class definition",
      "body": [
        "class ${1:ClassName} ${2:: public ${3:BaseClass} }{",
        "public:",
        "  explicit ${1:ClassName}(${4:int value}) noexcept",
        "    : ${5:m_value}(${4:value}) {}",
        "",
        "  ~${1:ClassName}() ${6:= default};",
        "",
        "  ${1:ClassName}(const ${1:ClassName}&)                = ${7|default,delete|};",
        "  ${1:ClassName}& operator=(const ${1:ClassName}&)     = ${7|default,delete|};",
        "  ${1:ClassName}(${1:ClassName}&&) noexcept            = default;",
        "  ${1:ClassName}& operator=(${1:ClassName}&&) noexcept = default;",
        "",
        "  [[nodiscard]] ${8:int} ${9:value}() const noexcept { return ${5:m_value}; }",
        "  void set_${9:value}(${8:int} v) noexcept { ${5:m_value} = v; }",
        "",
        "private:",
        "  ${8:int} ${5:m_value};",
        "};"
      ]
    },
  
    "C++ Template Class": {
      "prefix": ["template", "tclass"],
      "description": "⚙️  C++ template class",
      "body": [
        "template<typename T${1:, typename Alloc = std::allocator<T>}>",
        "class ${2:Container} {",
        "public:",
        "  using value_type    = T;",
        "  using size_type     = std::size_t;",
        "  using iterator      = T*;",
        "  using const_iterator= const T*;",
        "",
        "  ${2:Container}() = default;",
        "  explicit ${2:Container}(size_type n)",
        "    : m_data(std::make_unique<T[]>(n)), m_size(n) {}",
        "",
        "  [[nodiscard]] T& operator[](size_type i) noexcept {",
        "    return m_data[i];",
        "  }",
        "",
        "  [[nodiscard]] const T& operator[](size_type i) const noexcept {",
        "    return m_data[i];",
        "  }",
        "",
        "  [[nodiscard]] size_type size() const noexcept { return m_size; }",
        "  [[nodiscard]] bool      empty() const noexcept { return m_size == 0; }",
        "",
        "  iterator       begin()  noexcept { return m_data.get(); }",
        "  iterator       end()    noexcept { return m_data.get() + m_size; }",
        "  const_iterator cbegin() const noexcept { return m_data.get(); }",
        "  const_iterator cend()   const noexcept { return m_data.get() + m_size; }",
        "",
        "private:",
        "  std::unique_ptr<T[]> m_data;",
        "  size_type            m_size{0};",
        "};"
      ]
    },
  
    "C++ Struct": {
      "prefix": ["struct", "st"],
      "description": "⚙️  C++ struct with comparison",
      "body": [
        "struct ${1:Point} {",
        "  ${2:double} ${3:x}{};",
        "  ${2:double} ${4:y}{};",
        "",
        "  // Three-way comparison (C++20)",
        "  auto operator<=>(const ${1:Point}&) const = default;",
        "",
        "  friend std::ostream& operator<<(std::ostream& os, const ${1:Point}& p) {",
        "    return os << '(' << p.${3:x} << \", \" << p.${4:y} << ')';",
        "  }",
        "};"
      ]
    },
  
    "C++ Enum Class": {
      "prefix": ["enum", "enum_class"],
      "description": "⚙️  Scoped enum class",
      "body": [
        "enum class ${1:Status} : ${2:uint8_t} {",
        "  ${3:Pending} = 0,",
        "  ${4:Active}  = 1,",
        "  ${5:Done}    = 2,",
        "  ${6:Error}   = 3,",
        "};",
        "",
        "[[nodiscard]] constexpr std::string_view to_string(${1:Status} s) noexcept {",
        "  switch (s) {",
        "    case ${1:Status}::${3:Pending}: return \"${3:Pending}\";",
        "    case ${1:Status}::${4:Active}:  return \"${4:Active}\";",
        "    case ${1:Status}::${5:Done}:    return \"${5:Done}\";",
        "    case ${1:Status}::${6:Error}:   return \"${6:Error}\";",
        "  }",
        "  return \"Unknown\";",
        "}"
      ]
    },
  
