        "  ${6:double} operator()(const ${3:Square}& s)   { return ${8:s.area()}; }",
        "  ${6:double} operator()(const ${4:Triangle}& t) { return ${9:t.area()}; }",
        "};",
        "",
        "${1:Shape} shape = ${2:Circle}{${10:5.0}};",
        "auto result = std::visit(${5:Visitor}{}, shape);"
