    "C++ Benchmark": {
      "prefix": ["bench", "benchmark"],
      "description": "⚙️  Google Benchmark",
      "body": [
        "#include <benchmark/benchmark.h>",
        "",
        "static void BM_${1:FunctionName}(benchmark::State& state) {",
        "  ${2:// setup}",
        "  for (auto _ : state) {",
        "    ${3:// code to benchmark}",
        "    benchmark::DoNotOptimize(${4:result});",
        "    benchmark::ClobberMemory();",
        "  }",
        "  state.SetBytesProcessed(state.iterations() * ${5:sizeof(Type)});",
        "}",
        "",
        "BENCHMARK(BM_${1:FunctionName})",
        "  ->RangeMultiplier(2)",
        "  ->Range(1 << 8, 1 << 16)",
        "  ->Unit(benchmark::kMicrosecond);",
        "",
        "BENCHMARK_MAIN();"
      ]
    },
  
