    },
  
    "C++ RAII": {
      "prefix": ["raii", "resource"],
      "description": "⚙️  RAII resource wrapper",
      "body": [
        "class ${1:Resource} {",
        "public:",
        "  explicit ${1:Resource}(${2:Handle} handle) : m_handle(handle) {",
        "    if (!m_handle) throw std::runtime_error(\"Invalid handle\");",
        "  }",
        "",
        "  ~${1:Resource}() noexcept {",
        "    if (m_handle) ${3:close}(m_handle);",
        "  }",
        "",
        "  // Non-copyable",
        "  ${1:Resource}(const ${1:Resource}&)            = delete;",
        "  ${1:Resource}& operator=(const ${1:Resource}&) = delete;",
        "",
        "  // Movable",
        "  ${1:Resource}(${1:Resource}&& other) noexcept",
        "    : m_handle(std::exchange(other.m_handle, nullptr)) {}",
        "",
        "  ${1:Resource}& operator=(${1:Resource}&& other) noexcept {",
        "    if (this != &other) {",
        "      if (m_handle) ${3:close}(m_handle);",
        "      m_handle = std::exchange(other.m_handle, nullptr);",
        "    }",
        "    return *this;",
        "  }",
        "",
        "  [[nodiscard]] ${2:Handle} get() const noexcept { return m_handle; }",
        "  [[nodiscard]] explicit operator bool() const noexcept { return m_handle != nullptr; }",
        "",
        "private:",
        "  ${2:Handle} m_handle;",
        "};"
      ]
    },
  
    "C++ Singleton": {
      "prefix": ["singleton"],
      "description": "⚙️  Thread-safe singleton (Meyers)",
      "body": [
        "class ${1:Singleton} {",
        "public:",
        "  [[nodiscard]] static ${1:Singleton}& instance() {",
        "    static ${1:Singleton} inst;",
        "    return inst;",
        "  }",
        "",
        "  ${1:Singleton}(const ${1:Singleton}&)            = delete;",
        "  ${1:Singleton}& operator=(const ${1:Singleton}&) = delete;",
        "",
        "  void ${2:method}() {",
        "    ${3:// body}",
        "  }",
        "",
        "private:",
        "  ${1:Singleton}() = default;",
        "  ~${1:Singleton}() = default;",
        "};"
      ]
    },
  
    "C++ Smart Pointers": {
