        "    return ${3:field}.isEmpty();",
        "  }",
        "",
        "  public static ${7:RecordName} ${11:of}(${8:String} ${3:field}) {",
        "    return new ${7:RecordName}(${3:field}, ${12:0});",
        "  }",
        "}"
      ]
    },
  
    "Java Interface": {
      "prefix": ["interface", "iface"],
      "description": "☕ Java interface with default methods",
      "body": [
        "package ${1:com.ash};",
        "",
        "import java.util.Optional;",
        "",
        "/**",
        " * ${2:Interface description}.",
        " *",
        " * @param <T> the type parameter",
        " */",
        "public sealed interface ${3:InterfaceName}<T>${4: extends ${5:Comparable<T>}} {",
        "",
        "  // ── Abstract methods ──────────────────────────────────",
        "  /**",
        "   * ${6:Method description}.",
        "   *",
        "   * @param ${7:param} ${8:description}",
        "   * @return ${9:result description}",
        "   */",
        "  ${10:String} ${11:method}(${12:T} ${7:param});",
        "",
        "  /**",
        "   * Returns the value, if present.",
        "   *",
        "   * @return an {@link Optional} of the value",
        "   */",
        "  Optional<T> ${13:find}();",
        "",
        "  // ── Default methods ───────────────────────────────────",
        "  default boolean ${14:isEmpty}() {",
        "    return ${13:find}().isEmpty();",
        "  }",
        "",
        "  // ── Static factory ────────────────────────────────────",
        "  static <T> ${3:InterfaceName}<T> ${15:of}(T value) {",
        "    return new ${16:DefaultImpl}<>(value);",
        "  }",
        "",
        "  // ── Permitted implementations ─────────────────────────",
        "  record ${16:DefaultImpl}<T>(T value) implements ${3:InterfaceName}<T> {",
        "    @Override",
        "    public ${10:String} ${11:method}(T ${7:param}) {",
        "      return ${17:String.valueOf(${7:param})};",
        "    }",
        "",
        "    @Override",
        "    public Optional<T> ${13:find}() {",
        "      return Optional.ofNullable(value);",
        "    }",
        "  }",
        "}"
      ]
    },
  
    "Java Enum": {
      "prefix": ["enum", "jenum"],
      "description": "☕ Java enum with fields and methods",
      "body": [
        "/**",
        " * ${1:Enum description}.",
        " */",
        "public enum ${2:Status} {",
        "",
        "  ${3:PENDING}(\"${4:pending}\", ${5:0}),",
        "  ${6:ACTIVE}(\"${7:active}\",  ${8:1}),",
        "  ${9:DONE}(\"${10:done}\",      ${11:2}),",
        "  ${12:ERROR}(\"${13:error}\",    ${14:-1});",
        "",
        "  private final String  code;",
        "  private final int     value;",
        "",
        "  ${2:Status}(String code, int value) {",
        "    this.code  = code;",
        "    this.value = value;",
        "  }",
        "",
        "  public String getCode()  { return code; }",
        "  public int    getValue() { return value; }",
        "",
        "  public static ${2:Status} fromCode(String code) {",
        "    for (var s : values()) {",
        "      if (s.code.equalsIgnoreCase(code)) return s;",
        "    }",
        "    throw new IllegalArgumentException(\"Unknown ${2:Status} code: \" + code);",
        "  }",
        "",
        "  public boolean isTerminal() {",
        "    return this == ${9:DONE} || this == ${12:ERROR};",
        "  }",
        "}"
      ]
    },
  
    "Java Spring Service": {
      "prefix": ["service", "spring_svc"],
      "description": "☕ Spring Boot service class",
      "body": [
        "package ${1:com.ash.service};",
        "",
        "import lombok.RequiredArgsConstructor;",
        "import lombok.extern.slf4j.Slf4j;",
        "import org.springframework.stereotype.Service;",
        "import org.springframework.transaction.annotation.Transactional;",
        "",
        "import java.util.List;",
        "import java.util.Optional;",
        "",
        "/**",
        " * Service for ${2:entity} operations.",
        " */",
        "@Slf4j",
        "@Service",
        "@RequiredArgsConstructor",
        "public class ${3:EntityService} {",
        "",
        "  private final ${4:EntityRepository} ${5:repository};",
        "",
        "  @Transactional(readOnly = true)",
        "  public List<${6:Entity}> findAll() {",
        "    log.debug(\"Fetching all ${2:entity} records\");",
        "    return ${5:repository}.findAll();",
        "  }",
        "",
        "  @Transactional(readOnly = true)",
        "  public Optional<${6:Entity}> findById(${7:Long} id) {",
        "    log.debug(\"Fetching ${2:entity} by id: {}\", id);",
        "    return ${5:repository}.findById(id);",
        "  }",
        "",
        "  @Transactional",
        "  public ${6:Entity} save(${6:Entity} entity) {",
        "    log.info(\"Saving ${2:entity}: {}\", entity);",
        "    return ${5:repository}.save(entity);",
        "  }",
        "",
        "  @Transactional",
        "  public void deleteById(${7:Long} id) {",
        "    log.info(\"Deleting ${2:entity} with id: {}\", id);",
        "    ${5:repository}.deleteById(id);",
        "  }",
        "}"
      ]
    },
  
    "Java Spring Controller": {
      "prefix": ["controller", "rest", "spring_ctrl"],
      "description": "☕ Spring Boot REST controller",
      "body": [
        "package ${1:com.ash.controller};",
        "",
        "import lombok.RequiredArgsConstructor;",
        "import lombok.extern.slf4j.Slf4j;",
        "import org.springframework.http.ResponseEntity;",
        "import org.springframework.web.bind.annotation.*;",
        "import jakarta.validation.Valid;",
        "import java.util.List;",
        "",
        "@Slf4j",
        "@RestController",
        "@RequestMapping(\"/api/v1/${2:entities}\")",
        "@RequiredArgsConstructor",
        "public class ${3:EntityController} {",
        "",
        "  private final ${4:EntityService} ${5:service};",
        "",
        "  @GetMapping",
        "  public ResponseEntity<List<${6:Entity}>> findAll() {",
        "    return ResponseEntity.ok(${5:service}.findAll());",
        "  }",
        "",
        "  @GetMapping(\"/{id}\")",
        "  public ResponseEntity<${6:Entity}> findById(@PathVariable ${7:Long} id) {",
        "    return ${5:service}.findById(id)",
        "        .map(ResponseEntity::ok)",
        "        .orElse(ResponseEntity.notFound().build());",
        "  }",
        "",
        "  @PostMapping",
        "  public ResponseEntity<${6:Entity}> create(",
        "      @Valid @RequestBody ${8:CreateEntityRequest} request) {",
        "    var entity = ${5:service}.save(request.toEntity());",
        "    return ResponseEntity.status(201).body(entity);",
        "  }",
        "",
        "  @PutMapping(\"/{id}\")",
        "  public ResponseEntity<${6:Entity}> update(",
        "      @PathVariable ${7:Long} id,",
        "      @Valid @RequestBody ${9:UpdateEntityRequest} request) {",
        "    return ${5:service}.findById(id)",
        "        .map(e -> ResponseEntity.ok(${5:service}.save(request.apply(e))))",
        "        .orElse(ResponseEntity.notFound().build());",
        "  }",
        "",
        "  @DeleteMapping(\"/{id}\")",
        "  public ResponseEntity<Void> delete(@PathVariable ${7:Long} id) {",
        "    ${5:service}.deleteById(id);",
        "    return ResponseEntity.noContent().build();",
        "  }",
        "}"
      ]
    },
  
    "Java JPA Entity": {
      "prefix": ["entity", "jpa", "orm"],
      "description": "☕ JPA entity with Lombok",
      "body": [
        "package ${1:com.ash.entity};",
        "",
        "import jakarta.persistence.*;",
        "import lombok.*;",
        "import org.hibernate.annotations.CreationTimestamp;",
        "import org.hibernate.annotations.UpdateTimestamp;",
        "",
        "import java.time.Instant;",
        "",
        "@Entity",
        "@Table(name = \"${2:table_name}\")",
        "@Getter",
        "@Setter",
        "@Builder",
        "@NoArgsConstructor",
        "@AllArgsConstructor",
        "@ToString(exclude = {\"${3:relation}\"})",
        "@EqualsAndHashCode(onlyExplicitlyIncluded = true)",
        "public class ${4:EntityName} {",
        "",
        "  @Id",
        "  @GeneratedValue(strategy = GenerationType.SEQUENCE,",
        "                  generator = \"${2:table_name}_seq\")",
        "  @SequenceGenerator(name = \"${2:table_name}_seq\",",
        "                     sequenceName = \"${2:table_name}_seq\",",
        "                     allocationSize = 50)",
        "  @EqualsAndHashCode.Include",
        "  private Long id;",
        "",
        "  @Column(name = \"${5:name}\", nullable = false, length = ${6:255})",
        "  private String ${5:name};",
        "",
        "  @Column(name = \"${7:status}\", nullable = false)",
        "  @Enumerated(EnumType.STRING)",
        "  private ${8:Status} ${7:status};",
        "",
        "  @Column(name = \"created_at\", updatable = false)",
        "  @CreationTimestamp",
        "  private Instant createdAt;",
        "",
        "  @Column(name = \"updated_at\")",
        "  @UpdateTimestamp",
        "  private Instant updatedAt;",
        "",
        "  @Version",
        "  private Long version;",
        "}"
      ]
    },
  
