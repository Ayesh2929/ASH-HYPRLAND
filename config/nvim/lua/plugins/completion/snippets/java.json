    "Java Builder Pattern": {
      "prefix": ["builder", "build"],
      "description": "☕ Builder pattern (Lombok-free)",
      "body": [
        "public final class ${1:Config} {",
        "",
        "  private final ${2:String}  ${3:host};",
        "  private final ${4:int}     ${5:port};",
        "  private final ${6:boolean} ${7:ssl};",
        "",
        "  private ${1:Config}(Builder builder) {",
        "    this.${3:host} = builder.${3:host};",
        "    this.${5:port} = builder.${5:port};",
        "    this.${7:ssl}  = builder.${7:ssl};",
        "  }",
        "",
        "  public ${2:String}  get${8:Host}() { return ${3:host}; }",
        "  public ${4:int}     get${9:Port}() { return ${5:port}; }",
        "  public ${6:boolean} is${10:Ssl}()  { return ${7:ssl};  }",
        "",
        "  public static Builder builder() { return new Builder(); }",
        "",
        "  public static final class Builder {",
        "    private ${2:String}  ${3:host} = \"${11:localhost}\";",
        "    private ${4:int}     ${5:port} = ${12:8080};",
        "    private ${6:boolean} ${7:ssl}  = false;",
        "",
        "    public Builder ${3:host}(${2:String} val)  { ${3:host} = val;  return this; }",
        "    public Builder ${5:port}(${4:int}    val)  { ${5:port} = val;  return this; }",
        "    public Builder ${7:ssl}(${6:boolean} val)  { ${7:ssl}  = val;  return this; }",
        "",
        "    public ${1:Config} build() {",
        "      return new ${1:Config}(this);",
        "    }",
        "  }",
        "}"
      ]
    },
  
    "Java Functional Interface": {
      "prefix": ["functional", "finterface"],
      "description": "☕ Custom functional interface",
      "body": [
        "@FunctionalInterface",
        "public interface ${1:Transformer}<T, R> {",
        "",
        "  /**",
        "   * Applies this transformation.",
        "   *",
        "   * @param input the input value",
        "   * @return the transformed value",
        "   * @throws ${2:Exception} if transformation fails",
        "   */",
        "  R transform(T input) throws ${2:Exception};",
        "",
        "  default <V> ${1:Transformer}<T, V> andThen(${1:Transformer}<? super R, V> after) {",
        "    return input -> after.transform(this.transform(input));",
        "  }",
        "}"
      ]
    },
  
    "Java Completable Future": {
      "prefix": ["cf", "completable", "async"],
      "description": "☕ CompletableFuture chain",
      "body": [
        "CompletableFuture<${1:Result}>",
        "    .supplyAsync(() -> ${2:fetchData()}, ${3:executor})",
        "    .thenApply(${4:data} -> ${5:transform(data)})",
        "    .thenCompose(${6:val} -> ${7:asyncCall(val)})",
        "    .exceptionally(ex -> {",
        "      LOG.warning(\"Operation failed: \" + ex.getMessage());",
        "      return ${8:fallback};",
        "    })",
        "    .whenComplete((${9:result}, ${10:error}) -> {",
        "      if (${10:error} != null) {",
        "        ${11:handleError(error);}",
        "      } else {",
        "        ${12:handleResult(result);}",
        "      }",
        "    });"
      ]
    },
  
    "Java Test JUnit 5": {
      "prefix": ["test", "junit"],
      "description": "☕ JUnit 5 test class",
      "body": [
        "package ${1:com.ash};",
        "",
        "import org.junit.jupiter.api.*;",
        "import org.junit.jupiter.params.ParameterizedTest;",
        "import org.junit.jupiter.params.provider.CsvSource;",
        "import org.mockito.Mock;",
        "import org.mockito.junit.jupiter.MockitoExtension;",
        "import org.junit.jupiter.api.extension.ExtendWith;",
        "",
        "import static org.assertj.core.api.Assertions.*;",
        "import static org.mockito.Mockito.*;",
        "",
        "@ExtendWith(MockitoExtension.class)",
        "@DisplayName(\"${2:ClassName} tests\")",
        "class ${3:ClassNameTest} {",
        "",
        "  @Mock",
        "  private ${4:Dependency} ${5:dependency};",
        "",
        "  private ${2:ClassName} ${6:subject};",
        "",
        "  @BeforeEach",
        "  void setUp() {",
        "    ${6:subject} = new ${2:ClassName}(${5:dependency});",
        "  }",
        "",
        "  @Test",
        "  @DisplayName(\"should ${7:expected behaviour}\")",
        "  void ${8:shouldDoSomething}() {",
        "    // Arrange",
        "    when(${5:dependency}.${9:method}()).thenReturn(${10:value});",
        "",
        "    // Act",
        "    var result = ${6:subject}.${11:operation}();",
        "",
        "    // Assert",
        "    assertThat(result).${12:isNotNull()};",
        "    verify(${5:dependency}).${9:method}();",
        "  }",
        "",
        "  @ParameterizedTest(name = \"input={0}, expected={1}\")",
        "  @CsvSource({ \"${13:input1}, ${14:expected1}\", \"${15:input2}, ${16:expected2}\" })",
        "  void ${17:shouldHandleMultipleCases}(${18:String} input, ${19:String} expected) {",
        "    var result = ${6:subject}.${20:process}(input);",
        "    assertThat(result).isEqualTo(expected);",
        "  }",
        "}"
      ]
    },
  
