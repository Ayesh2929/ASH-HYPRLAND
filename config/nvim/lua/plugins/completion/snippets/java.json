    "ASH Java Class": {
      "prefix": ["class", "jclass", "cls"],
      "description": "☕ Full Java class with ASH pattern",
      "body": [
        "package ${1:com.ash.${2:module}};",
        "",
        "import java.util.Objects;",
        "import java.util.Optional;",
        "import java.util.logging.Logger;",
        "",
        "/**",
        " * ${3:Class description}.",
        " *",
        " * @author ${4:ash}",
        " * @version ${5:1.0.0}",
        " * @since ${6:2024-01-01}",
        " */",
        "public ${7|final,abstract,sealed|} class ${8:ClassName}${9: extends ${10:Base}}${11: implements ${12:Interface}} {",
        "",
        "  private static final Logger LOG = Logger.getLogger(${8:ClassName}.class.getName());",
        "",
        "  // ── Fields ────────────────────────────────────────────",
        "  private final ${13:String} ${14:field};",
        "",
        "  // ── Constructors ──────────────────────────────────────",
        "  /**",
        "   * Creates a new {@link ${8:ClassName}}.",
        "   *",
        "   * @param ${14:field} ${15:field description}",
        "   * @throws NullPointerException if {@code ${14:field}} is {@code null}",
        "   */",
        "  public ${8:ClassName}(${13:String} ${14:field}) {",
        "    this.${14:field} = Objects.requireNonNull(${14:field}, \"${14:field} must not be null\");",
        "  }",
        "",
        "  // ── Accessors ─────────────────────────────────────────",
        "  public ${13:String} get${16:Field}() {",
        "    return ${14:field};",
        "  }",
        "",
        "  // ── Object ────────────────────────────────────────────",
        "  @Override",
        "  public boolean equals(Object o) {",
        "    if (this == o) return true;",
        "    if (!(o instanceof ${8:ClassName} other)) return false;",
        "    return Objects.equals(${14:field}, other.${14:field});",
        "  }",
        "",
        "  @Override",
        "  public int hashCode() {",
        "    return Objects.hash(${14:field});",
        "  }",
        "",
        "  @Override",
        "  public String toString() {",
        "    return \"${8:ClassName}[${14:field}=\" + ${14:field} + ']';",
        "  }",
        "}"
      ]
    },
  
    "Java Record": {
