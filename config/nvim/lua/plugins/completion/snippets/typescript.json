{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "📘 ASH TypeScript Ultra Snippets v5.0",
  
    "ASH React FC with Hooks": {
      "prefix": ["rfc", "react_fc", "component"],
      "description": "📘 React functional component with TypeScript",
      "body": [
        "import { type FC, useState, useCallback, useEffect } from 'react'",
        "",
        "interface ${1:ComponentName}Props {",
        "  ${2:propName}: ${3:string}",
        "  className?: string",
        "  children?: React.ReactNode",
        "}",
        "",
        "/**",
        " * ${4:Component description}",
        " * @param props - Component props",
        " */",
        "const ${1:ComponentName}: FC<${1:ComponentName}Props> = ({",
        "  ${2:propName},",
        "  className,",
        "  children,",
        "}) => {",
        "  const [${5:state}, set${6:State}] = useState<${7:string}>('${8:}')",
        "",
        "  const handle${9:Action} = useCallback(() => {",
        "    ${10:// handler}",
        "  }, [])",
        "",
        "  useEffect(() => {",
        "    ${11:// effect}",
        "    return () => {",
        "      ${12:// cleanup}",
        "    }",
        "  }, [${13:deps}])",
        "",
        "  return (",
        "    <div className={className}>",
        "      {children}",
        "      ${0}",
        "    </div>",
        "  )",
        "}",
        "",
        "${1:ComponentName}.displayName = '${1:ComponentName}'",
        "",
        "export default ${1:ComponentName}",
        "export type { ${1:ComponentName}Props }"
      ]
    },
  
    "ASH Zod Schema": {
      "prefix": ["zod", "schema"],
      "description": "📘 Zod schema with inferred type",
      "body": [
        "import { z } from 'zod'",
        "",
        "export const ${1:name}Schema = z.object({",
        "  ${2:field}: z.string().min(${3:1}).max(${4:255}),",
        "  ${5:email}: z.string().email(),",
        "  ${6:count}: z.number().int().nonnegative().default(${7:0}),",
        "  ${8:tags}: z.array(z.string()).default([]),",
        "  ${9:metadata}: z.record(z.string(), z.unknown()).optional(),",
        "})",
        "",
        "export type ${10:Name} = z.infer<typeof ${1:name}Schema>",
        "",
        "// Partial schema for updates",
        "export const update${10:Name}Schema = ${1:name}Schema.partial()",
        "export type Update${10:Name} = z.infer<typeof update${10:Name}Schema>"
      ]
    },
  
    "ASH Custom Hook": {
      "prefix": ["hook", "use_hook"],
      "description": "📘 React custom hook with TypeScript",
      "body": [
        "import { useState, useCallback, useEffect, useRef } from 'react'",
        "",
        "interface Use${1:HookName}Options {",
        "  ${2:option}?: ${3:string}",
        "  onSuccess?: (data: ${4:DataType}) => void",
        "  onError?: (error: Error) => void",
        "}",
        "",
        "interface Use${1:HookName}Return {",
        "  ${5:data}: ${4:DataType} | null",
        "  isLoading: boolean",
        "  error: Error | null",
        "  ${6:execute}: () => Promise<void>",
        "  reset: () => void",
        "}",
        "",
        "/**",
        " * ${7:Hook description}",
        " */",
        "export function use${1:HookName}(",
        "  options: Use${1:HookName}Options = {},",
        "): Use${1:HookName}Return {",
        "  const { ${2:option}, onSuccess, onError } = options",
        "  const [${5:data}, set${8:Data}] = useState<${4:DataType} | null>(null)",
        "  const [isLoading, setIsLoading] = useState(false)",
        "  const [error, setError] = useState<Error | null>(null)",
        "  const abortRef = useRef<AbortController | null>(null)",
        "",
        "  const ${6:execute} = useCallback(async () => {",
        "    abortRef.current?.abort()",
        "    abortRef.current = new AbortController()",
        "    setIsLoading(true)",
        "    setError(null)",
        "    try {",
        "      const result = await ${9:fetchData}(abortRef.current.signal)",
        "      set${8:Data}(result)",
        "      onSuccess?.(result)",
        "    } catch (err) {",
        "      if (err instanceof Error && err.name !== 'AbortError') {",
        "        setError(err)",
        "        onError?.(err)",
        "      }",
        "    } finally {",
        "      setIsLoading(false)",
        "    }",
        "  }, [${2:option}, onSuccess, onError])",
        "",
        "  const reset = useCallback(() => {",
        "    set${8:Data}(null)",
        "    setError(null)",
        "  }, [])",
        "",
        "  useEffect(() => {",
        "    return () => { abortRef.current?.abort() }",
        "  }, [])",
        "",
        "  return { ${5:data}, isLoading, error, ${6:execute}, reset }",
        "}"
      ]
    },
  
    "ASH Typed API Client": {
      "prefix": ["api", "client", "fetch"],
      "description": "📘 Type-safe API client function",
      "body": [
        "interface ${1:Resource}API {",
        "  getAll(params?: { page?: number; limit?: number }): Promise<PaginatedResponse<${1:Resource}>>",
        "  getById(id: string): Promise<${1:Resource}>",
        "  create(data: Create${1:Resource}Input): Promise<${1:Resource}>",
        "  update(id: string, data: Update${1:Resource}Input): Promise<${1:Resource}>",
        "  delete(id: string): Promise<void>",
        "}",
        "",
        "export const ${2:resource}Api: ${1:Resource}API = {",
        "  async getAll(params = {}) {",
        "    const searchParams = new URLSearchParams()",
        "    if (params.page) searchParams.set('page', String(params.page))",
        "    if (params.limit) searchParams.set('limit', String(params.limit))",
        "    const res = await fetch(`/api/${3:resources}?${searchParams}`)",
        "    if (!res.ok) throw new APIError(res.status, await res.text())",
        "    return res.json() as Promise<PaginatedResponse<${1:Resource}>>",
        "  },",
        "",
        "  async getById(id) {",
        "    const res = await fetch(`/api/${3:resources}/${id}`)",
        "    if (!res.ok) throw new APIError(res.status, await res.text())",
        "    return res.json() as Promise<${1:Resource}>",
        "  },",
        "",
        "  async create(data) {",
        "    const res = await fetch('/api/${3:resources}', {",
        "      method: 'POST',",
        "      headers: { 'Content-Type': 'application/json' },",
        "      body: JSON.stringify(data),",
        "    })",
        "    if (!res.ok) throw new APIError(res.status, await res.text())",
        "    return res.json() as Promise<${1:Resource}>",
        "  },",
        "",
        "  async update(id, data) {",
        "    const res = await fetch(`/api/${3:resources}/${id}`, {",
        "      method: 'PATCH',",
        "      headers: { 'Content-Type': 'application/json' },",
        "      body: JSON.stringify(data),",
        "    })",
        "    if (!res.ok) throw new APIError(res.status, await res.text())",
        "    return res.json() as Promise<${1:Resource}>",
        "  },",
        "",
        "  async delete(id) {",
        "    const res = await fetch(`/api/${3:resources}/${id}`, { method: 'DELETE' })",
        "    if (!res.ok) throw new APIError(res.status, await res.text())",
        "  },",
        "}"
      ]
    },
  
    "ASH Zustand Store": {
      "prefix": ["store", "zustand"],
      "description": "📘 Zustand store with TypeScript",
      "body": [
        "import { create } from 'zustand'",
        "import { devtools, persist } from 'zustand/middleware'",
        "import { immer } from 'zustand/middleware/immer'",
        "",
        "interface ${1:StoreName}State {",
        "  ${2:items}: ${3:Item}[]",
        "  isLoading: boolean",
        "  error: string | null",
        "}",
        "",
        "interface ${1:StoreName}Actions {",
        "  ${4:addItem}: (item: ${3:Item}) => void",
        "  ${5:removeItem}: (id: string) => void",
        "  setLoading: (isLoading: boolean) => void",
        "  setError: (error: string | null) => void",
        "  reset: () => void",
        "}",
        "",
        "type ${1:StoreName}Store = ${1:StoreName}State & ${1:StoreName}Actions",
        "",
        "const initialState: ${1:StoreName}State = {",
        "  ${2:items}: [],",
        "  isLoading: false,",
        "  error: null,",
        "}",
        "",
        "export const use${1:StoreName}Store = create<${1:StoreName}Store>()(",
        "  devtools(",
        "    persist(",
        "      immer((set) => ({",
        "        ...initialState,",
        "",
        "        ${4:addItem}: (item) => set((state) => {",
        "          state.${2:items}.push(item)",
        "        }),",
        "",
        "        ${5:removeItem}: (id) => set((state) => {",
        "          state.${2:items} = state.${2:items}.filter((i) => i.id !== id)",
        "        }),",
        "",
        "        setLoading: (isLoading) => set({ isLoading }),",
        "        setError: (error) => set({ error }),",
        "        reset: () => set(initialState),",
        "      })),",
        "      { name: '${6:store-name}' },",
        "    ),",
        "    { name: '${1:StoreName}Store' },",
        "  ),",
        ")"
      ]
    },
  
    "ASH Generic Type Utility": {
      "prefix": ["util", "utility_type"],
      "description": "📘 Utility types and type helpers",
      "body": [
        "/** Makes specific keys required */",
        "type RequireFields<T, K extends keyof T> = T & Required<Pick<T, K>>",
        "",
        "/** Makes specific keys optional */",
        "type PartialFields<T, K extends keyof T> = Omit<T, K> & Partial<Pick<T, K>>",
        "",
        "/** Recursively makes all fields required */",
        "type DeepRequired<T> = Required<{",
        "  [K in keyof T]: T[K] extends object ? DeepRequired<T[K]> : T[K]",
        "}>",
        "",
        "/** Recursively makes all fields readonly */",
        "type DeepReadonly<T> = Readonly<{",
        "  [K in keyof T]: T[K] extends object ? DeepReadonly<T[K]> : T[K]",
        "}>",
        "",
        "/** Extract value type from Promise */",
        "type Awaited<T> = T extends Promise<infer U> ? U : T",
        "",
        "/** Discriminated union helper */",
        "type ${1:Result}<T, E = Error> =",
        "  | { success: true; data: T }",
        "  | { success: false; error: E }"
      ]
    },
  
    "ASH vitest Test": {
      "prefix": ["test", "vitest"],
      "description": "📘 vitest test with describe/it blocks",
      "body": [
        "import { describe, it, expect, vi, beforeEach } from 'vitest'",
        "import { ${1:functionUnderTest} } from './${2:module}'",
        "",
        "describe('${1:functionUnderTest}', () => {",
        "  beforeEach(() => {",
        "    vi.clearAllMocks()",
        "  })",
        "",
        "  it('should ${3:expected behaviour}', async () => {",
        "    // ── Arrange ─────────────────────────────────────────",
        "    const ${4:input} = ${5:'test value'}",
        "    const expected = ${6:'expected result'}",
        "",
        "    // ── Act ─────────────────────────────────────────────",
        "    const result = await ${1:functionUnderTest}(${4:input})",
        "",
        "    // ── Assert ──────────────────────────────────────────",
        "    expect(result).toEqual(expected)",
        "  })",
        "",
        "  it('should throw when ${7:invalid condition}', async () => {",
        "    await expect(",
        "      ${1:functionUnderTest}(${8:invalidInput}),",
        "    ).rejects.toThrow('${9:expected error message}')",
        "  })",
        "})"
      ]
    },
  
    "ASH Server Action": {
      "prefix": ["action", "server_action"],
      "description": "📘 Next.js server action with Zod validation",
      "body": [
        "'use server'",
        "",
        "import { z } from 'zod'",
        "import { revalidatePath } from 'next/cache'",
        "",
        "const ${1:action}Schema = z.object({",
        "  ${2:field}: z.string().min(1),",
        "})",
        "",
        "type ${3:ActionState} =",
        "  | { status: 'idle' }",
        "  | { status: 'success'; message: string }",
        "  | { status: 'error'; errors: Record<string, string[]> }",
        "",
        "export async function ${1:action}(",
        "  _prevState: ${3:ActionState},",
        "  formData: FormData,",
        "): Promise<${3:ActionState}> {",
        "  const parsed = ${1:action}Schema.safeParse(",
        "    Object.fromEntries(formData),",
        "  )",
        "",
        "  if (!parsed.success) {",
        "    return {",
        "      status: 'error',",
        "      errors: parsed.error.flatten().fieldErrors,",
        "    }",
        "  }",
        "",
        "  try {",
        "    await ${4:performAction}(parsed.data)",
        "    revalidatePath('/${5:path}')",
        "    return { status: 'success', message: '${6:Success message}' }",
        "  } catch (err) {",
        "    console.error('${1:action} failed:', err)",
        "    return {",
        "      status: 'error',",
        "      errors: { _form: ['${7:Something went wrong}'] },",
        "    }",
        "  }",
        "}"
      ]
    }
  }