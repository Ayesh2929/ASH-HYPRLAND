{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "💛 ASH JavaScript Ultra Snippets v5.0",
  
    "ASH Async Arrow Function": {
      "prefix": ["aaf", "async_arrow"],
      "description": "💛 Async arrow function with error handling",
      "body": [
        "const ${1:fn} = async (${2:params}) => {",
        "  try {",
        "    ${3:// body}",
        "    return ${4:result}",
        "  } catch (error) {",
        "    console.error('${1:fn} failed:', error)",
        "    throw error",
        "  }",
        "}"
      ]
    },
  
    "ASH Promise Chain": {
      "prefix": ["prom", "promise"],
      "description": "💛 Promise with full chain",
      "body": [
        "const ${1:promise} = new Promise((resolve, reject) => {",
        "  ${2:// async work}",
        "  if (${3:condition}) {",
        "    resolve(${4:value})",
        "  } else {",
        "    reject(new Error('${5:error message}'))",
        "  }",
        "})",
        "",
        "${1:promise}",
        "  .then((${6:result}) => {",
        "    ${7:// handle success}",
        "  })",
        "  .catch((${8:error}) => {",
        "    console.error('${9:operation} failed:', ${8:error})",
        "  })",
        "  .finally(() => {",
        "    ${10:// always runs}",
        "  })"
      ]
    },
  
    "ASH Class Pattern": {
      "prefix": ["cls", "class"],
      "description": "💛 Modern JS class with private fields",
      "body": [
        "/**",
        " * ${1:ClassName} - ${2:description}",
        " * @class",
        " */",
        "class ${1:ClassName} {",
        "  // Private fields",
        "  #${3:privateField}",
        "  #${4:listeners} = new Map()",
        "",
        "  /**",
        "   * @param {Object} options - Configuration",
        "   * @param {${5:string}} options.${6:name} - ${7:description}",
        "   */",
        "  constructor({ ${6:name} = '${8:default}' } = {}) {",
        "    this.#${3:privateField} = ${6:name}",
        "  }",
        "",
        "  /**",
        "   * Gets the ${3:privateField}",
        "   * @returns {${5:string}}",
        "   */",
        "  get ${3:privateField}() {",
        "    return this.#${3:privateField}",
        "  }",
        "",
        "  /**",
        "   * ${9:Method description}",
        "   * @param {${10:type}} ${11:param} - ${12:description}",
        "   * @returns {Promise<${13:void}>}",
        "   */",
        "  async ${14:method}(${11:param}) {",
        "    ${15:// implementation}",
        "  }",
        "",
        "  /**",
        "   * Subscribe to an event",
        "   * @param {string} event",
        "   * @param {Function} listener",
        "   */",
        "  on(event, listener) {",
        "    if (!this.#${4:listeners}.has(event)) {",
        "      this.#${4:listeners}.set(event, new Set())",
        "    }",
        "    this.#${4:listeners}.get(event).add(listener)",
        "    return () => this.off(event, listener)",
        "  }",
        "",
        "  emit(event, ...args) {",
        "    this.#${4:listeners}.get(event)?.forEach(fn => fn(...args))",
        "  }",
        "",
        "  off(event, listener) {",
        "    this.#${4:listeners}.get(event)?.delete(listener)",
        "  }",
        "",
        "  [Symbol.toStringTag]() { return '${1:ClassName}' }",
        "}"
      ]
    },
  
    "ASH Fetch Wrapper": {
      "prefix": ["fetch", "http_fetch"],
      "description": "💛 Fetch with retry and timeout",
      "body": [
        "/**",
        " * Fetch with retry and timeout",
        " * @param {string} url",
        " * @param {RequestInit} [options]",
        " * @param {{ retries?: number, timeout?: number }} [config]",
        " */",
        "async function fetchWithRetry(url, options = {}, config = {}) {",
        "  const { retries = ${1:3}, timeout = ${2:10000} } = config",
        "",
        "  for (let attempt = 0; attempt <= retries; attempt++) {",
        "    const controller = new AbortController()",
        "    const timeoutId = setTimeout(() => controller.abort(), timeout)",
        "",
        "    try {",
        "      const response = await fetch(url, {",
        "        ...options,",
        "        signal: controller.signal,",
        "      })",
        "",
        "      if (!response.ok) {",
        "        throw new Error(`HTTP ${response.status}: ${response.statusText}`)",
        "      }",
        "",
        "      return await response.json()",
        "    } catch (error) {",
        "      if (attempt === retries) throw error",
        "      const delay = Math.min(1000 * 2 ** attempt, 10000)",
        "      await new Promise(resolve => setTimeout(resolve, delay))",
        "    } finally {",
        "      clearTimeout(timeoutId)",
        "    }",
        "  }",
        "}"
      ]
    },
  
    "ASH Proxy Pattern": {
      "prefix": ["proxy", "observable"],
      "description": "💛 Proxy for observable/reactive state",
      "body": [
        "function createObservable(target, onChange) {",
        "  return new Proxy(target, {",
        "    set(obj, prop, value) {",
        "      const prev = obj[prop]",
        "      obj[prop] = value",
        "      if (prev !== value) {",
        "        onChange({ prop, prev, next: value, target: obj })",
        "      }",
        "      return true",
        "    },",
        "    deleteProperty(obj, prop) {",
        "      const prev = obj[prop]",
        "      delete obj[prop]",
        "      onChange({ prop, prev, next: undefined, target: obj, deleted: true })",
        "      return true",
        "    },",
        "  })",
        "}",
        "",
        "const ${1:state} = createObservable({ ${2:key}: ${3:value} }, (change) => {",
        "  console.log('State changed:', change)",
        "  ${4:// handle change}",
        "})"
      ]
    },
  
    "ASH Debounce / Throttle": {
      "prefix": ["debounce", "throttle"],
      "description": "💛 Debounce and throttle utilities",
      "body": [
        "/** Debounce: execute after delay since last call */",
        "function debounce(fn, delay = ${1:300}) {",
        "  let timeoutId",
        "  return function (...args) {",
        "    clearTimeout(timeoutId)",
        "    timeoutId = setTimeout(() => fn.apply(this, args), delay)",
        "  }",
        "}",
        "",
        "/** Throttle: execute at most once per interval */",
        "function throttle(fn, interval = ${2:300}) {",
        "  let lastTime = 0",
        "  return function (...args) {",
        "    const now = Date.now()",
        "    if (now - lastTime >= interval) {",
        "      lastTime = now",
        "      return fn.apply(this, args)",
        "    }",
        "  }",
        "}",
        "",
        "const debouncedFn = debounce(${3:handler})",
        "const throttledFn = throttle(${4:handler})"
      ]
    },
  
    "ASH Event Emitter": {
      "prefix": ["emit", "emitter"],
      "description": "💛 Typed event emitter class",
      "body": [
        "class EventEmitter {",
        "  #events = new Map()",
        "",
        "  on(event, listener, { once = false } = {}) {",
        "    if (!this.#events.has(event)) {",
        "      this.#events.set(event, new Set())",
        "    }",
        "    const wrapper = once",
        "      ? (...args) => { listener(...args); this.off(event, wrapper) }",
        "      : listener",
        "    this.#events.get(event).add(wrapper)",
        "    return () => this.off(event, wrapper)",
        "  }",
        "",
        "  once(event, listener) {",
        "    return this.on(event, listener, { once: true })",
        "  }",
        "",
        "  off(event, listener) {",
        "    this.#events.get(event)?.delete(listener)",
        "    return this",
        "  }",
        "",
        "  emit(event, ...args) {",
        "    this.#events.get(event)?.forEach(fn => fn(...args))",
        "    return this",
        "  }",
        "",
        "  removeAllListeners(event) {",
        "    if (event) this.#events.delete(event)",
        "    else this.#events.clear()",
        "    return this",
        "  }",
        "}"
      ]
    },
  
    "ASH Pipeline": {
      "prefix": ["pipe", "pipeline"],
      "description": "💛 Functional pipe composition",
      "body": [
        "/** Left-to-right function composition */",
        "const pipe = (...fns) => (x) => fns.reduce((v, f) => f(v), x)",
        "",
        "/** Right-to-left function composition */",
        "const compose = (...fns) => (x) => fns.reduceRight((v, f) => f(v), x)",
        "",
        "/** Async pipeline */",
        "const pipeAsync = (...fns) => (x) =>",
        "  fns.reduce((p, f) => p.then(f), Promise.resolve(x))",
        "",
        "// Usage:",
        "const process = pipe(",
        "  ${1:step1},",
        "  ${2:step2},",
        "  ${3:step3},",
        ")",
        "",
        "const result = await pipeAsync(",
        "  ${4:asyncStep1},",
        "  ${5:asyncStep2},",
        ")(${6:initialValue})"
      ]
    },
  
    "ASH Worker Thread": {
      "prefix": ["worker", "thread"],
      "description": "💛 Web Worker / Node.js Worker thread pattern",
      "body": [
        "// ── Main thread ───────────────────────────────────────────────────────",
        "const worker = new Worker(new URL('./${1:worker}.js', import.meta.url), {",
        "  type: 'module',",
        "})",
        "",
        "worker.addEventListener('message', ({ data }) => {",
        "  if (data.type === 'result') {",
        "    ${2:// handle result}",
        "  }",
        "})",
        "",
        "worker.addEventListener('error', (error) => {",
        "  console.error('Worker error:', error)",
        "})",
        "",
        "worker.postMessage({ type: 'start', payload: ${3:data} })",
        "",
        "// ── Worker thread (${1:worker}.js) ──────────────────────────────────────",
        "self.addEventListener('message', async ({ data }) => {",
        "  if (data.type === 'start') {",
        "    try {",
        "      const result = await ${4:heavyComputation}(data.payload)",
        "      self.postMessage({ type: 'result', result })",
        "    } catch (error) {",
        "      self.postMessage({ type: 'error', message: error.message })",
        "    }",
        "  }",
        "})"
      ]
    },
  
    "ASH Module Pattern": {
      "prefix": ["iife", "module_pattern"],
      "description": "💛 IIFE module with public API",
      "body": [
        "const ${1:moduleName} = (() => {",
        "  // ── Private ───────────────────────────────────────────",
        "  let _${2:state} = ${3:null}",
        "",
        "  function _${4:privateMethod}() {",
        "    ${5:// private implementation}",
        "  }",
        "",
        "  // ── Public API ────────────────────────────────────────",
        "  return Object.freeze({",
        "    get ${2:state}() { return _${2:state} },",
        "",
        "    ${6:init}(${7:config}) {",
        "      _${2:state} = ${7:config}",
        "      _${4:privateMethod}()",
        "      return this",
        "    },",
        "",
        "    ${8:destroy}() {",
        "      _${2:state} = ${3:null}",
        "    },",
        "  })",
        "})()",
        "",
        "export default ${1:moduleName}"
      ]
    },
  
    "ASH localStorage Helper": {
      "prefix": ["store", "localstorage"],
      "description": "💛 Type-safe localStorage helper",
      "body": [
        "const storage = {",
        "  get(key, fallback = null) {",
        "    try {",
        "      const item = localStorage.getItem(key)",
        "      return item ? JSON.parse(item) : fallback",
        "    } catch {",
        "      return fallback",
        "    }",
        "  },",
        "",
        "  set(key, value) {",
        "    try {",
        "      localStorage.setItem(key, JSON.stringify(value))",
        "      return true",
        "    } catch {",
        "      return false",
        "    }",
        "  },",
        "",
        "  remove(key) { localStorage.removeItem(key) },",
        "",
        "  clear() { localStorage.clear() },",
        "",
        "  has(key) { return localStorage.getItem(key) !== null },",
        "}",
        "",
        "export default storage"
      ]
    }
  }