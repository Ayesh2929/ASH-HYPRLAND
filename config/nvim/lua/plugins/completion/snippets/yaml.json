{
    "GitHub Actions Workflow": {
      "prefix": ["gha", "workflow", "ci"],
      "description": "📋 GitHub Actions workflow",
      "body": [
        "# ╔══════════════════════════════════════════════════════╗",
        "# ║  🔄 ${1:workflow-name} GitHub Actions                ║",
        "# ╚══════════════════════════════════════════════════════╝",
        "",
        "name: ${1:workflow-name}",
        "",
        "on:",
        "  push:",
        "    branches: [${2:main, develop}]",
        "    paths-ignore:",
        "      - '**.md'",
        "      - 'docs/**'",
        "  pull_request:",
        "    branches: [${2:main}]",
        "    types: [opened, synchronize, reopened]",
        "  workflow_dispatch:",
        "    inputs:",
        "      ${3:debug}:",
        "        description: '${4:Enable debug mode}'",
        "        required:    false",
        "        type:        boolean",
        "        default:     false",
        "",
        "concurrency:",
        "  group:              \\${{ github.workflow }}-\\${{ github.ref }}",
        "  cancel-in-progress: \\${{ github.ref != 'refs/heads/main' }}",
        "",
        "permissions:",
        "  contents: read",
        "  packages: write",
        "",
        "env:",
        "  REGISTRY: ghcr.io",
        "  IMAGE:    \\${{ github.repository }}",
        "",
        "jobs:",
        "  # ── Test ──────────────────────────────────────────────",
        "  test:",
        "    name:    🧪 Test",
        "    runs-on: ubuntu-latest",
        "    strategy:",
        "      fail-fast: false",
        "      matrix:",
        "        ${5:lang-version}: [${6:'20', '21', '22'}]",
        "    steps:",
        "      - name: 📦 Checkout",
        "        uses: actions/checkout@v4",
        "        with:",
        "          fetch-depth: 0",
        "",
        "      - name: ⚡ Setup ${7:Node}",
        "        uses: ${8:actions/setup-node}@v4",
        "        with:",
        "          ${5:node-version}: \\${{ matrix.${5:lang-version} }}",
        "          cache: '${9:pnpm}'",
        "",
        "      - name: 📥 Install",
        "        run: ${10:pnpm install --frozen-lockfile}",
        "",
        "      - name: 🧪 Test",
        "        run: ${11:pnpm test}",
        "        env:",
        "          ${12:ENV_VAR}: \\${{ secrets.${13:SECRET_NAME} }}",
        "",
        "  # ── Build ─────────────────────────────────────────────",
        "  build:",
        "    name:    🏗️ Build",
        "    runs-on: ubuntu-latest",
        "    needs:   [test]",
        "    outputs:",
        "      image: \\${{ steps.meta.outputs.tags }}",
        "    steps:",
        "      - uses: actions/checkout@v4",
        "",
        "      - name: 🐳 Docker meta",
        "        id:   meta",
        "        uses: docker/metadata-action@v5",
        "        with:",
        "          images: \\${{ env.REGISTRY }}/\\${{ env.IMAGE }}",
        "          tags: |",
        "            type=ref,event=branch",
        "            type=semver,pattern={{version}}",
        "            type=sha,prefix=sha-",
        "",
        "      - name: 🔐 Login to GHCR",
        "        uses: docker/login-action@v3",
        "        with:",
        "          registry: \\${{ env.REGISTRY }}",
        "          username: \\${{ github.actor }}",
        "          password: \\${{ secrets.GITHUB_TOKEN }}",
        "",
        "      - name: 🏗️ Build and push",
        "        uses: docker/build-push-action@v5",
        "        with:",
        "          context: .",
        "          push:    \\${{ github.event_name != 'pull_request' }}",
        "          tags:    \\${{ steps.meta.outputs.tags }}"
      ]
    },
  
    "GitHub Actions Job": {
      "prefix": ["job", "gha_job"],
      "description": "📋 GitHub Actions job",
      "body": [
        "${1:job-name}:",
        "  name:    ${2:Job Name}",
        "  runs-on: ${3|ubuntu-latest,ubuntu-22.04,macos-latest,windows-latest|}",
        "  needs:   [${4:previous-job}]",
        "  timeout-minutes: ${5:30}",
        "  strategy:",
        "    fail-fast: false",
        "    matrix:",
        "      ${6:version}: [${7:'3.11', '3.12'}]",
        "  steps:",
        "    - name: 📦 Checkout",
        "      uses: actions/checkout@v4",
        "",
        "    - name: ${8:Step name}",
        "      run: |",
        "        ${9:echo \"Running step\"}",
        "      env:",
        "        ${10:KEY}: \\${{ secrets.${11:SECRET} }}"
      ]
    },
  
    "Kubernetes Deployment": {
      "prefix": ["kd", "k8s_deploy", "deploy"],
      "description": "📋 Kubernetes Deployment",
      "body": [
        "apiVersion: apps/v1",
        "kind:       Deployment",
        "metadata:",
        "  name:      ${1:app-name}",
        "  namespace: ${2:default}",
        "  labels:",
        "    app:     ${1:app-name}",
        "    version: ${3:v1.0.0}",
        "    env:     ${4:production}",
        "spec:",
        "  replicas: ${5:3}",
        "  revisionHistoryLimit: 3",
        "  selector:",
        "    matchLabels:",
        "      app: ${1:app-name}",
        "  strategy:",
        "    type: RollingUpdate",
        "    rollingUpdate:",
        "      maxSurge:       1",
        "      maxUnavailable: 0",
        "  template:",
        "    metadata:",
        "      labels:",
        "        app:     ${1:app-name}",
        "        version: ${3:v1.0.0}",
        "      annotations:",
        "        prometheus.io/scrape: \"true\"",
        "        prometheus.io/port:   \"${6:8080}\"",
        "    spec:",
        "      serviceAccountName: ${7:${1:app-name}-sa}",
        "      securityContext:",
        "        runAsNonRoot: true",
        "        runAsUser:    1000",
        "        fsGroup:      1000",
        "      containers:",
        "        - name:  ${1:app-name}",
        "          image: ${8:ghcr.io/ash}/${1:app-name}:${3:v1.0.0}",
        "          imagePullPolicy: IfNotPresent",
        "          ports:",
        "            - name:          http",
        "              containerPort: ${6:8080}",
        "              protocol:      TCP",
        "          envFrom:",
        "            - configMapRef:",
        "                name: ${1:app-name}-config",
        "            - secretRef:",
        "                name: ${1:app-name}-secret",
        "          resources:",
        "            requests:",
        "              cpu:    ${9:50m}",
        "              memory: ${10:128Mi}",
        "            limits:",
        "              cpu:    ${11:500m}",
        "              memory: ${12:256Mi}",
        "          livenessProbe:",
        "            httpGet:",
        "              path: ${13:/health/live}",
        "              port: http",
        "            initialDelaySeconds: 10",
        "            periodSeconds:       15",
        "            timeoutSeconds:      5",
        "            failureThreshold:    3",
        "          readinessProbe:",
        "            httpGet:",
        "              path: ${14:/health/ready}",
        "              port: http",
        "            initialDelaySeconds: 5",
        "            periodSeconds:       10",
        "            timeoutSeconds:      3",
        "            failureThreshold:    3",
        "          securityContext:",
        "            allowPrivilegeEscalation: false",
        "            readOnlyRootFilesystem:   true",
        "            capabilities:",
        "              drop: [ALL]",
        "          volumeMounts:",
        "            - name:      tmp",
        "              mountPath: /tmp",
        "      volumes:",
        "        - name:     tmp",
        "          emptyDir: {}"
      ]
    },
  
    "Kubernetes Service": {
      "prefix": ["ks", "k8s_svc", "k8s_service"],
      "description": "📋 Kubernetes Service",
      "body": [
        "apiVersion: v1",
        "kind:       Service",
        "metadata:",
        "  name:      ${1:app-name}",
        "  namespace: ${2:default}",
        "  labels:",
        "    app: ${1:app-name}",
        "spec:",
        "  type:     ${3|ClusterIP,NodePort,LoadBalancer|}",
        "  selector:",
        "    app: ${1:app-name}",
        "  ports:",
        "    - name:       http",
        "      port:       ${4:80}",
        "      targetPort: ${5:8080}",
        "      protocol:   TCP"
      ]
    },
  
    "Kubernetes ConfigMap": {
      "prefix": ["kcm", "k8s_cm", "configmap"],
      "description": "📋 Kubernetes ConfigMap",
      "body": [
        "apiVersion: v1",
        "kind:       ConfigMap",
        "metadata:",
        "  name:      ${1:app-name}-config",
        "  namespace: ${2:default}",
        "data:",
        "  APP_ENV:   ${3:production}",
        "  LOG_LEVEL: ${4:info}",
        "  PORT:      \"${5:8080}\"",
        "  ${6:KEY}:    ${7:value}"
      ]
    },
  
    "Kubernetes Secret": {
      "prefix": ["ksec", "k8s_secret", "secret"],
      "description": "📋 Kubernetes Secret",
      "body": [
        "apiVersion: v1",
        "kind:       Secret",
        "metadata:",
        "  name:      ${1:app-name}-secret",
        "  namespace: ${2:default}",
        "type:        Opaque",
        "stringData:",
        "  ${3:DB_PASSWORD}:  ${4:changeme}",
        "  ${5:API_KEY}:      ${6:changeme}"
      ]
    },
  
    "Kubernetes Ingress": {
      "prefix": ["ki", "k8s_ing", "ingress"],
      "description": "📋 Kubernetes Ingress",
      "body": [
        "apiVersion: networking.k8s.io/v1",
        "kind:       Ingress",
        "metadata:",
        "  name:      ${1:app-name}",
        "  namespace: ${2:default}",
        "  annotations:",
        "    nginx.ingress.kubernetes.io/ssl-redirect:     \"true\"",
        "    cert-manager.io/cluster-issuer:               letsencrypt-prod",
        "spec:",
        "  ingressClassName: nginx",
        "  tls:",
        "    - hosts:",
        "        - ${3:app.example.com}",
        "      secretName: ${1:app-name}-tls",
        "  rules:",
        "    - host: ${3:app.example.com}",
        "      http:",
        "        paths:",
        "          - path:     /",
        "            pathType: Prefix",
        "            backend:",
        "              service:",
        "                name: ${1:app-name}",
        "                port:",
        "                  number: ${4:80}"
      ]
    },
  
    "YAML Mapping": {
      "prefix": ["map", "obj", "object"],
      "description": "📋 YAML mapping block",
      "body": [
        "${1:key}:",
        "  ${2:nested-key}: ${3:value}",
        "  ${4:another-key}: ${5:value}"
      ]
    },
  
    "YAML List": {
      "prefix": ["list", "arr", "seq"],
      "description": "📋 YAML list/sequence",
      "body": [
        "${1:key}:",
        "  - ${2:item1}",
        "  - ${3:item2}",
        "  - ${4:item3}"
      ]
    },
  
    "YAML Multiline": {
      "prefix": ["ml", "multiline"],
      "description": "📋 YAML multiline string",
      "body": [
        "${1:key}: |",
        "  ${2:line one}",
        "  ${3:line two}",
        "  ${4:line three}"
      ]
    },
  
    "YAML Folded": {
      "prefix": ["fold", "folded"],
      "description": "📋 YAML folded scalar",
      "body": [
        "${1:key}: >",
        "  ${2:This is a long string that will be",
        "  folded into a single line.}"
      ]
    },
  
    "YAML Anchor": {
      "prefix": ["anchor", "alias"],
      "description": "📋 YAML anchor and alias",
      "body": [
        "${1:defaults}: &${2:defaults}",
        "  ${3:key}:   ${4:value}",
        "  ${5:other}: ${6:value}",
        "",
        "${7:production}:",
        "  <<: *${2:defaults}",
        "  ${8:override}: ${9:value}"
      ]
    }
  }