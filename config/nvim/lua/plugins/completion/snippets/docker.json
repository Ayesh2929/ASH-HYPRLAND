{
    "Dockerfile": {
      "prefix": ["dockerfile", "dfile", "docker"],
      "description": "🐳 Full multi-stage Dockerfile",
      "body": [
        "# ╔══════════════════════════════════════════════════════╗",
        "# ║  🐳 ${1:app-name} Dockerfile                         ║",
        "# ╚══════════════════════════════════════════════════════╝",
        "",
        "# syntax=docker/dockerfile:1",
        "ARG  BASE_IMAGE=${2:debian:bookworm-slim}",
        "",
        "# ── Stage 1: Builder ──────────────────────────────────",
        "FROM ${3:rust:1.76-bookworm} AS builder",
        "LABEL stage=builder",
        "",
        "WORKDIR /build",
        "",
        "# Cache deps separately from source",
        "COPY ${4:Cargo.toml Cargo.lock} ./",
        "RUN ${5:cargo fetch --locked}",
        "",
        "COPY . .",
        "RUN ${6:cargo build --release --locked} \\",
        "    && strip ${7:target/release/app}",
        "",
        "# ── Stage 2: Runtime ──────────────────────────────────",
        "FROM $BASE_IMAGE AS runtime",
        "",
        "ARG  APP_USER=${8:app}",
        "ARG  APP_UID=1000",
        "ARG  APP_GID=1000",
        "",
        "# Security: non-root user",
        "RUN groupadd --gid $APP_GID $APP_USER \\",
        "    && useradd  --uid $APP_UID --gid $APP_GID \\",
        "                --no-create-home --shell /sbin/nologin \\",
        "                $APP_USER",
        "",
        "# Install runtime deps only",
        "RUN apt-get update \\",
        "    && apt-get install -y --no-install-recommends \\",
        "         ${9:ca-certificates} \\",
        "    && rm -rf /var/lib/apt/lists/*",
        "",
        "WORKDIR /app",
        "",
        "COPY --from=builder --chown=$APP_USER:$APP_USER \\",
        "     ${7:target/release/app} ./app",
        "",
        "USER $APP_USER",
        "",
        "EXPOSE ${10:8080}",
        "",
        "HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \\",
        "  CMD [\"${11:/usr/bin/curl}\", \"-f\", \"http://localhost:${10:8080}${12:/health}\"]",
        "",
        "ENTRYPOINT [\"./app\"]"
      ]
    },
  
    "Dockerfile Python": {
      "prefix": ["pyfile", "python_docker"],
      "description": "🐳 Python production Dockerfile",
      "body": [
        "# syntax=docker/dockerfile:1",
        "",
        "# ── Stage 1: Builder ──────────────────────────────────",
        "FROM python:${1:3.12}-slim AS builder",
        "",
        "WORKDIR /app",
        "",
        "ENV PYTHONUNBUFFERED=1 \\",
        "    PYTHONDONTWRITEBYTECODE=1 \\",
        "    PIP_NO_CACHE_DIR=1 \\",
        "    PIP_DISABLE_PIP_VERSION_CHECK=1",
        "",
        "RUN pip install uv",
        "",
        "COPY pyproject.toml uv.lock ./",
        "RUN uv sync --frozen --no-dev",
        "",
        "# ── Stage 2: Runtime ──────────────────────────────────",
        "FROM python:${1:3.12}-slim AS runtime",
        "",
        "ARG USER=${2:app}",
        "RUN useradd --system --create-home --shell /bin/bash $USER",
        "",
        "WORKDIR /app",
        "",
        "COPY --from=builder /app/.venv .venv",
        "COPY src/ src/",
        "",
        "ENV PATH=\"/app/.venv/bin:$PATH\"",
        "",
        "USER $USER",
        "",
        "EXPOSE ${3:8000}",
        "",
        "HEALTHCHECK --interval=30s --timeout=5s \\",
        "  CMD [\"python\", \"-c\", \"import urllib.request; urllib.request.urlopen('http://localhost:${3:8000}/health')\"]",
        "",
        "CMD [\"${4:uvicorn}\", \"${5:app.main:app}\", \"--host\", \"0.0.0.0\", \"--port\", \"${3:8000}\"]"
      ]
    },
  
    "Dockerfile Node": {
      "prefix": ["nodefile", "node_docker"],
      "description": "🐳 Node.js production Dockerfile",
      "body": [
        "# syntax=docker/dockerfile:1",
        "",
        "# ── Stage 1: Deps ─────────────────────────────────────",
        "FROM node:${1:20}-alpine AS deps",
        "WORKDIR /app",
        "COPY package.json pnpm-lock.yaml ./",
        "RUN corepack enable pnpm && pnpm install --frozen-lockfile",
        "",
        "# ── Stage 2: Builder ──────────────────────────────────",
        "FROM node:${1:20}-alpine AS builder",
        "WORKDIR /app",
        "COPY --from=deps /app/node_modules ./node_modules",
        "COPY . .",
        "RUN ${2:pnpm build}",
        "",
        "# ── Stage 3: Runtime ──────────────────────────────────",
        "FROM node:${1:20}-alpine AS runtime",
        "",
        "RUN addgroup -S app && adduser -S app -G app",
        "",
        "WORKDIR /app",
        "",
        "COPY --from=builder --chown=app:app /app/${3:dist} ./${3:dist}",
        "COPY --from=deps    --chown=app:app /app/node_modules ./node_modules",
        "COPY --chown=app:app package.json ./",
        "",
        "USER app",
        "",
        "ENV NODE_ENV=production \\",
        "    PORT=${4:3000}",
        "",
        "EXPOSE ${4:3000}",
        "",
        "CMD [\"node\", \"${3:dist}/index.js\"]"
      ]
    },
  
    "Docker Compose": {
      "prefix": ["compose", "dc", "docker_compose"],
      "description": "🐳 Docker Compose file",
      "body": [
        "# ╔══════════════════════════════════════════════════════╗",
        "# ║  🐳 ${1:project} Docker Compose                      ║",
        "# ╚══════════════════════════════════════════════════════╝",
        "",
        "name: ${1:project}",
        "",
        "x-common-env: &common-env",
        "  TZ:         ${2:UTC}",
        "  LOG_LEVEL:  ${3:info}",
        "",
        "services:",
        "",
        "  # ── Application ─────────────────────────────────────",
        "  ${4:app}:",
        "    build:",
        "      context: .",
        "      dockerfile: Dockerfile",
        "      target: ${5:runtime}",
        "      args:",
        "        APP_VERSION: \\${APP_VERSION:-dev}",
        "    image: ${6:ghcr.io/ash/${4:app}}:\\${APP_VERSION:-dev}",
        "    container_name: ${1:project}-${4:app}",
        "    restart: unless-stopped",
        "    environment:",
        "      <<: *common-env",
        "      DATABASE_URL: postgresql://${7:user}:\\${DB_PASS}@${8:db}:5432/${9:dbname}",
        "    ports:",
        "      - \"${10:8080}:${10:8080}\"",
        "    depends_on:",
        "      ${8:db}:",
        "        condition: service_healthy",
        "    volumes:",
        "      - ${11:data}:/app/data",
        "    healthcheck:",
        "      test: [\"CMD\", \"curl\", \"-f\", \"http://localhost:${10:8080}/health\"]",
        "      interval: 30s",
        "      timeout:  5s",
        "      retries:  3",
        "      start_period: 15s",
        "    networks:",
        "      - ${12:backend}",
        "    labels:",
        "      traefik.enable: \"true\"",
        "      traefik.http.routers.${4:app}.rule: \"Host(`${13:app.local}`)\"",
        "",
        "  # ── Database ────────────────────────────────────────",
        "  ${8:db}:",
        "    image: postgres:${14:16}-alpine",
        "    container_name: ${1:project}-${8:db}",
        "    restart: unless-stopped",
        "    environment:",
        "      POSTGRES_USER:     ${7:user}",
        "      POSTGRES_PASSWORD: \\${DB_PASS}",
        "      POSTGRES_DB:       ${9:dbname}",
        "    volumes:",
        "      - ${15:pgdata}:/var/lib/postgresql/data",
        "    healthcheck:",
        "      test: [\"CMD-SHELL\", \"pg_isready -U ${7:user} -d ${9:dbname}\"]",
        "      interval: 10s",
        "      timeout:  5s",
        "      retries:  5",
        "    networks:",
        "      - ${12:backend}",
        "",
        "  # ── Redis ───────────────────────────────────────────",
        "  cache:",
        "    image: redis:${16:7}-alpine",
        "    container_name: ${1:project}-cache",
        "    restart: unless-stopped",
        "    command: redis-server --requirepass \\${REDIS_PASS} --save 60 1 --loglevel warning",
        "    volumes:",
        "      - ${17:redis_data}:/data",
        "    networks:",
        "      - ${12:backend}",
        "",
        "volumes:",
        "  ${11:data}:",
        "  ${15:pgdata}:",
        "  ${17:redis_data}:",
        "",
        "networks:",
        "  ${12:backend}:",
        "    driver: bridge"
      ]
    },
  
    "Docker Service": {
      "prefix": ["service", "svc"],
      "description": "🐳 Single Docker Compose service",
      "body": [
        "${1:service-name}:",
        "  image: ${2:image:tag}",
        "  container_name: ${3:container}",
        "  restart: ${4|unless-stopped,always,no,on-failure|}",
        "  environment:",
        "    ${5:KEY}: ${6:value}",
        "  ports:",
        "    - \"${7:8080}:${7:8080}\"",
        "  volumes:",
        "    - ${8:./data}:/data",
        "  depends_on:",
        "    ${9:other-service}:",
        "      condition: ${10|service_healthy,service_started|}",
        "  networks:",
        "    - ${11:backend}",
        "  healthcheck:",
        "    test: [\"CMD\", \"${12:curl}\", \"-f\", \"http://localhost:${7:8080}${13:/health}\"]",
        "    interval: 30s",
        "    timeout:  5s",
        "    retries:  3"
      ]
    },
  
    "Dockerfile RUN": {
      "prefix": ["run", "layer"],
      "description": "🐳 Optimised RUN layer",
      "body": [
        "RUN apt-get update \\",
        "    && apt-get install -y --no-install-recommends \\",
        "         ${1:package1} \\",
        "         ${2:package2} \\",
        "    && rm -rf /var/lib/apt/lists/*"
      ]
    },
  
    "Dockerfile ARG ENV": {
      "prefix": ["argenv", "buildarg"],
      "description": "🐳 ARG and ENV pair",
      "body": [
        "ARG  ${1:VAR_NAME}=${2:default}",
        "ENV  ${1:VAR_NAME}=\\${${1:VAR_NAME}}"
      ]
    },
  
    "Dockerfile HEALTHCHECK": {
      "prefix": ["health", "healthcheck"],
      "description": "🐳 HEALTHCHECK instruction",
      "body": [
        "HEALTHCHECK \\",
        "    --interval=${1:30s} \\",
        "    --timeout=${2:5s} \\",
        "    --start-period=${3:10s} \\",
        "    --retries=${4:3} \\",
        "  CMD [\"${5:curl}\", \"-f\", \"http://localhost:${6:8080}${7:/health}\"]"
      ]
    },
  
    "Dockerfile Labels": {
      "prefix": ["labels", "label"],
      "description": "🐳 OCI/Docker image labels",
      "body": [
        "LABEL \\",
        "    org.opencontainers.image.title=\"${1:App Name}\" \\",
        "    org.opencontainers.image.description=\"${2:Description}\" \\",
        "    org.opencontainers.image.version=\"${3:\\${VERSION}}\" \\",
        "    org.opencontainers.image.created=\"${4:\\${BUILD_DATE}}\" \\",
        "    org.opencontainers.image.revision=\"${5:\\${GIT_SHA}}\" \\",
        "    org.opencontainers.image.source=\"${6:https://github.com/ash/app}\" \\",
        "    org.opencontainers.image.licenses=\"${7:MIT}\""
      ]
    },
  
    "Dockerfile Entrypoint": {
      "prefix": ["entrypoint", "ep"],
      "description": "🐳 ENTRYPOINT with CMD",
      "body": [
        "ENTRYPOINT [\"${1:/app/entrypoint.sh}\"]",
        "CMD        [\"${2:--help}\"]"
      ]
    },
  
    "Docker Ignore": {
      "prefix": ["dockerignore", ".dockerignore"],
      "description": "🐳 .dockerignore file content",
      "body": [
        "# VCS",
        ".git",
        ".gitignore",
        "",
        "# CI/CD",
        ".github",
        ".gitlab-ci.yml",
        "",
        "# Dev",
        ".env*",
        "!.env.example",
        "*.local",
        "",
        "# Build artifacts",
        "target/",
        "dist/",
        "build/",
        "node_modules/",
        "__pycache__/",
        "*.pyc",
        ".venv/",
        "",
        "# Docs",
        "docs/",
        "*.md",
        "",
        "# Test",
        "tests/",
        "*.test.*",
        "*.spec.*",
        "coverage/",
        "",
        "# Misc",
        "*.log",
        "*.tmp",
        "Dockerfile*",
        "docker-compose*.yml",
        ".dockerignore"
      ]
    }
  }