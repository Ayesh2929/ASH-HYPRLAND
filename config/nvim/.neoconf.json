{
    "$schema": "https://raw.githubusercontent.com/folke/neoconf.nvim/main/schemas/neoconf.json",
  
    "_comment": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "_note":    "  ASH DOTFILES v5.0 OMEGA — neoconf project configuration",
    "_doc":     "  https://github.com/folke/neoconf.nvim",
  
    "neoconf": {
      "import": {
        "vscode":  true,
        "coc":     false,
        "nlsp":    false
      },
      "live_reload":    true,
      "filetype_jsonc": true,
      "plugins": {
        "lspconfig":       { "enabled": true },
        "jsonls":          { "enabled": true },
        "lua_ls":          { "enabled": true }
      }
    },
  
    "lspconfig": {
      "lua_ls": {
        "Lua.workspace.checkThirdParty": false,
        "Lua.telemetry.enable":          false
      }
    },
  
    "plugins": {
      "lua_ls": {
        "enabled": true
      }
    }
  }