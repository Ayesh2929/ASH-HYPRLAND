// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — ZELLIJ ULTRA CONFIGURATION                    ║
// ║                                                                            ║
// ║  ░░░█████╗░░██████╗██╗░░██╗  ███████╗███████╗██╗░░░░░██╗░░░██╗          ║
// ║  ░░██╔══██╗██╔════╝██║░░██║  ╚════██║██╔════╝██║░░░░░██║░░░██║          ║
// ║  ░░███████║╚█████╗░███████║  ░░███╔═╝█████╗░░██║░░░░░██║░░░██║          ║
// ║  ░░██╔══██║░╚═══██╗██╔══██║  ██╔══╝░░██╔══╝░░██║░░░░░██║░░░██║          ║
// ║  ░░██║░░██║██████╔╝██║░░██║  ███████╗███████╗███████╗███████║          ║
// ║  ░░╚═╝░░╚═╝╚═════╝░╚═╝░░╚═╝  ╚══════╝╚══════╝╚══════╝╚══════╝          ║
// ║                                                                            ║
// ║  Premium Terminal Multiplexer — ASH Integration                           ║
// ║  Theme: Catppuccin Mocha • Vim navigation • Plugin ecosystem             ║
// ║  Features: Floating panes • Session management • Status bar              ║
// ╚══════════════════════════════════════════════════════════════════════════╝

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  🎨  THEME — ASH Dynamic
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Active color theme — ASH engine updates this on theme change
theme "ash-dynamic"

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  🖥️  DEFAULT LAYOUT
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Default layout on startup
// Options: "default" | "dev" | "monitoring" | path to .kdl file
default_layout "default"

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  🐚  SHELL
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Default shell for new panes
default_shell "fish"

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  ⚙️  BEHAVIOR
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Show pane frames (borders around each pane)
pane_frames true

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  📋  COPY — Clipboard integration
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Copy command (Wayland: wl-copy)
copy_command "wl-copy"

// Copy on idle (when selection is idle, copy to clipboard)
copy_on_select true

// Copy clipboard: "system" | "primary"
copy_clipboard "system"

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  🖱️  MOUSE
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Enable mouse support
mouse_mode true

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  📜  SCROLLBACK
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Scrollback buffer in edit mode
scroll_buffer_size 50000

// External pager for scrollback (bat for syntax highlighting)
scrollback_editor "nvim"

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  🔒  SESSION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Auto-detach on session loss
on_force_close "detach"

// Serialize pane scrollback on detach
serialize_pane_viewport true

// Restore layouts on attach
// "restore" | "new"
session_serialization true

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  🌐  UI SETTINGS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Simplified UI (hide extra chrome)
simplified_ui false

// Show startup tips
show_startup_tips false

// Support URLs in the terminal (clickable)
support_kitty_keyboard_protocol true

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  ⌨️  KEYBINDINGS — Vim-style with Ctrl+a leader
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

keybinds clear-defaults=true {

    // ── NORMAL MODE (default) ─────────────────────────────────────────────
    normal {

        // Unbind default Ctrl+g (too easy to trigger)
        unbind "Ctrl g"

        // ── Mode Switching ────────────────────────────────────────────────

        // Enter locked mode (pass all input to terminal)
        bind "Ctrl g"  { SwitchToMode "Locked"; }

        // Enter pane mode
        bind "Ctrl p"  { SwitchToMode "Pane"; }

        // Enter tab mode
        bind "Ctrl t"  { SwitchToMode "Tab"; }

        // Enter resize mode
        bind "Ctrl n"  { SwitchToMode "Resize"; }

        // Enter scroll mode
        bind "Ctrl s"  { SwitchToMode "Scroll"; }

        // Enter search mode
        bind "Ctrl f"  { SwitchToMode "Search"; }

        // Enter session mode
        bind "Ctrl o"  { SwitchToMode "Session"; }

        // Enter move mode
        bind "Ctrl h"  { SwitchToMode "Move"; }

        // ── Quick Actions ─────────────────────────────────────────────────

        // New pane (down)
        bind "Ctrl d"  { NewPane "Down"; SwitchToMode "Normal"; }

        // New pane (right)
        bind "Ctrl r"  { NewPane "Right"; SwitchToMode "Normal"; }

        // Toggle floating pane
        bind "Ctrl \\" { ToggleFloatingPanes; SwitchToMode "Normal"; }

        // New tab
        bind "Ctrl c"  { NewTab; SwitchToMode "Normal"; }

        // Go to next tab
        bind "Ctrl l"  { GoToNextTab; }

        // Go to previous tab
        bind "Ctrl k"  { GoToPreviousTab; }

        // Close current pane
        bind "Ctrl x"  { CloseFocus; SwitchToMode "Normal"; }

        // Toggle pane fullscreen
        bind "Ctrl z"  { ToggleFocusFullscreen; SwitchToMode "Normal"; }

        // Detach session
        bind "Ctrl q"  { Detach; }

        // Quit zellij completely
        bind "Ctrl Alt q" { Quit; }
    }

    // ── LOCKED MODE (pass-through) ────────────────────────────────────────
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    // ── PANE MODE ─────────────────────────────────────────────────────────
    pane {

        // Return to normal
        bind "Ctrl p" "Escape" "Enter" { SwitchToMode "Normal"; }

        // ── Navigation ────────────────────────────────────────────────────
        bind "h" "Left"  { MoveFocus "Left";  }
        bind "j" "Down"  { MoveFocus "Down";  }
        bind "k" "Up"    { MoveFocus "Up";    }
        bind "l" "Right" { MoveFocus "Right"; }

        // ── Creation ──────────────────────────────────────────────────────
        bind "n" { NewPane;          SwitchToMode "Normal"; }
        bind "d" { NewPane "Down";   SwitchToMode "Normal"; }
        bind "r" { NewPane "Right";  SwitchToMode "Normal"; }

        // ── Floating ──────────────────────────────────────────────────────
        bind "f"    { ToggleFocusFullscreen;  SwitchToMode "Normal"; }
        bind "w"    { ToggleFloatingPanes;    SwitchToMode "Normal"; }
        bind "e"    { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }

        // ── Close ─────────────────────────────────────────────────────────
        bind "x" { CloseFocus; SwitchToMode "Normal"; }

        // ── Rename ────────────────────────────────────────────────────────
        bind "c" {
            SwitchToMode "RenamePane";
            PaneNameInput 0;
        }

        // ── Swap layout ───────────────────────────────────────────────────
        bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "i" { MovePane "Left"; }
        bind "o" { MovePane "Right"; }
    }

    // ── TAB MODE ──────────────────────────────────────────────────────────
    tab {

        // Return to normal
        bind "Ctrl t" "Escape" "Enter" { SwitchToMode "Normal"; }

        // ── Navigation ────────────────────────────────────────────────────
        bind "h" "Left"  "p"  { GoToPreviousTab; }
        bind "l" "Right" "n"  { GoToNextTab;     }

        // Direct tab access
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }

        // ── Management ────────────────────────────────────────────────────
        bind "c" "t"  { NewTab; SwitchToMode "Normal"; }
        bind "x"      { CloseTab; SwitchToMode "Normal"; }

        // Move tab position
        bind "["  { MoveTab "Left";  }
        bind "]"  { MoveTab "Right"; }

        // Rename tab
        bind "r" {
            SwitchToMode "RenameTab";
            TabNameInput 0;
        }

        // Sync panes (send input to all panes in tab)
        bind "s"  { ToggleActiveSyncTab; SwitchToMode "Normal"; }
    }

    // ── RESIZE MODE ───────────────────────────────────────────────────────
    resize {

        // Return to normal
        bind "Ctrl n" "Escape" "Enter" { SwitchToMode "Normal"; }

        // Resize with hjkl (vim-style)
        bind "h" "Left"  { Resize "Increase Left";  }
        bind "j" "Down"  { Resize "Increase Down";  }
        bind "k" "Up"    { Resize "Increase Up";    }
        bind "l" "Right" { Resize "Increase Right"; }

        // Resize other direction with Shift
        bind "H" { Resize "Decrease Left";  }
        bind "J" { Resize "Decrease Down";  }
        bind "K" { Resize "Decrease Up";    }
        bind "L" { Resize "Decrease Right"; }

        // Equal distribution
        bind "=" "+" { Resize "Increase"; }
        bind "-"     { Resize "Decrease"; }
    }

    // ── MOVE MODE ─────────────────────────────────────────────────────────
    move {

        // Return to normal
        bind "Ctrl h" "Escape" "Enter" { SwitchToMode "Normal"; }

        // Move focused pane
        bind "h" "Left"  { MovePane "Left";  }
        bind "j" "Down"  { MovePane "Down";  }
        bind "k" "Up"    { MovePane "Up";    }
        bind "l" "Right" { MovePane "Right"; }

        // Swap with next/previous pane
        bind "n" { MovePane; }
        bind "p" { MovePaneBackwards; }
    }

    // ── SCROLL MODE ───────────────────────────────────────────────────────
    scroll {

        // Return to normal
        bind "Ctrl s" "Escape" "Enter" { SwitchToMode "Normal"; }

        // ── Navigation ────────────────────────────────────────────────────
        bind "j" "Down"  { ScrollDown; }
        bind "k" "Up"    { ScrollUp;   }

        // Half-page scroll
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp;   }

        // Full-page scroll
        bind "Ctrl f" "PageDown" "Space" { PageScrollDown; }
        bind "Ctrl b" "PageUp"           { PageScrollUp;   }

        // Jump to top/bottom
        bind "g" { ScrollToTop;    }
        bind "G" { ScrollToBottom; }

        // ── Edit ──────────────────────────────────────────────────────────
        // Open scrollback in editor (Neovim)
        bind "e" { EditScrollback; SwitchToMode "Normal"; }

        // ── Search ────────────────────────────────────────────────────────
        bind "/" { SwitchToMode "Search"; SearchInput 0; }
    }

    // ── SEARCH MODE ───────────────────────────────────────────────────────
    search {

        // Return to normal
        bind "Ctrl f" "Escape" { SwitchToMode "Normal"; }

        // ── Navigation ────────────────────────────────────────────────────
        bind "j" "Down"  { ScrollDown; }
        bind "k" "Up"    { ScrollUp;   }
        bind "Ctrl d"    { HalfPageScrollDown; }
        bind "Ctrl u"    { HalfPageScrollUp;   }

        // ── Search Navigation ─────────────────────────────────────────────
        bind "n" { Search "down"; }
        bind "N" { Search "up";   }

        // ── Search Options ────────────────────────────────────────────────
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "WholeWord";       }
        bind "r" { SearchToggleOption "Regex";           }

        // ── Return ────────────────────────────────────────────────────────
        bind "Enter" "Escape" { SwitchToMode "Normal"; }
    }

    // ── SESSION MODE ──────────────────────────────────────────────────────
    session {

        // Return to normal
        bind "Ctrl o" "Escape" "Enter" { SwitchToMode "Normal"; }

        // ── Session management ────────────────────────────────────────────
        bind "d" { Detach; }

        // Kill current session
        bind "q" { Quit; }

        // Open session manager UI
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true;
                move_to_focused_tab true;
            };
            SwitchToMode "Normal";
        }

        // Configuration manager
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true;
                move_to_focused_tab true;
            };
            SwitchToMode "Normal";
        }
    }

    // ── RENAME PANE MODE ──────────────────────────────────────────────────
    renamepane {
        bind "Ctrl c" "Escape" { UndoRenamePane; SwitchToMode "Pane"; }
        bind "Enter"           { SwitchToMode "Normal"; }
    }

    // ── RENAME TAB MODE ───────────────────────────────────────────────────
    renametab {
        bind "Ctrl c" "Escape" { UndoRenameTab; SwitchToMode "Tab"; }
        bind "Enter"           { SwitchToMode "Normal"; }
    }

    // ── SHARED — Available in all non-locked modes ────────────────────────
    shared_except "locked" {

        // Quick-switch tabs with Alt+number
        bind "Alt 1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "Alt 2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "Alt 3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "Alt 4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "Alt 5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "Alt 6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "Alt 7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "Alt 8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "Alt 9" { GoToTab 9; SwitchToMode "Normal"; }

        // Quick pane navigation without mode switch
        bind "Alt h" "Alt Left"  { MoveFocusOrTab "Left";  }
        bind "Alt j" "Alt Down"  { MoveFocus "Down";       }
        bind "Alt k" "Alt Up"    { MoveFocus "Up";         }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }

        // Quick new tab
        bind "Alt t" { NewTab; }

        // Quick new pane
        bind "Alt d" { NewPane "Down";  }
        bind "Alt r" { NewPane "Right"; }

        // Fullscreen toggle
        bind "Alt f" { ToggleFocusFullscreen; }

        // Quick float toggle
        bind "Alt w" { ToggleFloatingPanes; }
    }
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  🔌  PLUGINS — Built-in and custom plugin configuration
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plugins {

    // Built-in status bar
    tab-bar    location="zellij:tab-bar"
    status-bar location="zellij:status-bar"

    // Session manager popup
    session-manager location="zellij:session-manager"

    // Welcome screen
    welcome-screen location="zellij:welcome-screen"

    // Configuration manager
    configuration location="zellij:configuration"

    // Compact bar (alternative status bar)
    compact-bar location="zellij:compact-bar"
}

