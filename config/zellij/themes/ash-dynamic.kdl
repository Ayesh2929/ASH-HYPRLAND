// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 — ZELLIJ THEME: ASH DYNAMIC                           ║
// ║                                                                            ║
// ║  Base Palette: Catppuccin Mocha                                            ║
// ║  Auto-generated by: ash theme apply <name>                                ║
// ║  Reload: zellij action reload-config                                      ║
// ║                                                                            ║
// ║  Color mapping:                                                            ║
// ║  fg        → Text     #cdd6f4  Primary text                               ║
// ║  bg        → Base     #1e1e2e  Main background                            ║
// ║  black     → Crust    #11111b  Deepest surface                            ║
// ║  red       → Red      #f38ba8  Errors / destructive                       ║
// ║  green     → Green    #a6e3a1  Success / ok                               ║
// ║  yellow    → Yellow   #f9e2af  Warning / attention                        ║
// ║  blue      → Blue     #89b4fa  Info / navigation                          ║
// ║  magenta   → Mauve    #cba6f7  Primary accent                             ║
// ║  cyan      → Teal     #94e2d5  Secondary accent                           ║
// ║  white     → Subtext1 #bac2de  Secondary text                             ║
// ║  orange    → Peach    #fab387  Warm accent                                ║
// ║                                                                            ║
// ║  ASH_GENERATED=true                                                        ║
// ║  ASH_VERSION=5.0.0                                                         ║
// ║  ASH_THEME={{THEME_NAME}}                                                  ║
// ║  ASH_VARIANT={{THEME_VARIANT}}                                             ║
// ║  ASH_TIMESTAMP={{TIMESTAMP}}                                               ║
// ╚══════════════════════════════════════════════════════════════════════════╝

themes {
    ash-dynamic {

        // ── Base Colors ───────────────────────────────────────────────────

        // Primary text — Catppuccin Text #cdd6f4
        // ASH token: {{COLOR_TEXT}}
        fg "#cdd6f4"

        // Main background — Catppuccin Base #1e1e2e
        // ASH token: {{COLOR_BASE}}
        bg "#1e1e2e"

        // ── ANSI Color Mapping ────────────────────────────────────────────

        // Black → Catppuccin Crust (deepest bg, used for inactive areas)
        // ASH token: {{COLOR_CRUST}}
        black "#11111b"

        // Red → Catppuccin Red (errors, close buttons, danger)
        // ASH token: {{COLOR_RED}}
        red "#f38ba8"

        // Green → Catppuccin Green (success, active indicators)
        // ASH token: {{COLOR_GREEN}}
        green "#a6e3a1"

        // Yellow → Catppuccin Yellow (warnings, attention)
        // ASH token: {{COLOR_YELLOW}}
        yellow "#f9e2af"

        // Blue → Catppuccin Blue (navigation, info)
        // ASH token: {{COLOR_BLUE}}
        blue "#89b4fa"

        // Magenta → Catppuccin Mauve (PRIMARY ACCENT — active pane borders,
        //           active tab, mode indicators, focus highlights)
        // ASH token: {{COLOR_ACCENT}}
        magenta "#cba6f7"

        // Cyan → Catppuccin Teal (secondary accent, scroll indicators)
        // ASH token: {{COLOR_TEAL}}
        cyan "#94e2d5"

        // White → Catppuccin Subtext1 (secondary text, inactive labels)
        // ASH token: {{COLOR_SUBTEXT1}}
        white "#bac2de"

        // Orange → Catppuccin Peach (warm accent, session name)
        // ASH token: {{COLOR_PEACH}}
        orange "#fab387"

        // ── Bright Variants ───────────────────────────────────────────────

        // Gray → Catppuccin Surface1 (used for inactive pane borders,
        //        separators, and background accents)
        // ASH token: {{COLOR_SURFACE1}}
        gray "#45475a"
    }
}