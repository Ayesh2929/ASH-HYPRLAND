// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 — ZELLIJ LAYOUT: DEV                                  ║
// ║                                                                            ║
// ║  Premium Development Workspace Layout                                      ║
// ║                                                                            ║
// ║  Structure:                                                                ║
// ║  ┌────────────────────────────────────────────────────────────┐           ║
// ║  │  [tab-bar]                                                 │           ║
// ║  ├───────────────────────────────┬────────────────────────────┤           ║
// ║  │                               │                            │           ║
// ║  │         EDITOR (nvim)         │   TERMINAL (fish)          │           ║
// ║  │            70%                │       30%                  │           ║
// ║  │                               │                            │           ║
// ║  │                               ├────────────────────────────┤           ║
// ║  │                               │   GIT (lazygit)            │           ║
// ║  │                               │       (floating toggle)    │           ║
// ║  ├────────────────────────────────────────────────────────────┤           ║
// ║  │  [status-bar]                                              │           ║
// ║  └────────────────────────────────────────────────────────────┘           ║
// ║                                                                            ║
// ║  Tabs:                                                                     ║
// ║   1.   Editor     — Neovim + terminal split                               ║
// ║   2.  󰊢 Git        — Lazygit full screen                                  ║
// ║   3.  󰋊 Files      — Yazi file manager                                    ║
// ║   4.  󰨟 Monitor    — Btop system monitor                                  ║
// ║   5.   Scratch    — Free terminal                                         ║
// ╚══════════════════════════════════════════════════════════════════════════╝

layout {

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    //  UI CHROME
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    //  TAB 1:   EDITOR — Neovim + terminal split
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    tab name="  Editor" focus=true {

        // Main split: Editor (70%) | Right column (30%)
        pane split_direction="vertical" {

            // ── Left: Neovim editor ───────────────────────────────────────
            pane size="70%" name="Editor" focus=true {
                command "nvim"
            }

            // ── Right column: Terminal + outputs ──────────────────────────
            pane size="30%" split_direction="horizontal" {

                // Top-right: Shell
                pane size="60%" name="Terminal" {
                    command "fish"
                    args "-l"
                }

                // Bottom-right: Output / test runner
                pane size="40%" name="Output" {
                    command "fish"
                    args "-l"
                }
            }
        }

        // ── Floating pane: lazygit ────────────────────────────────────────
        floating_panes {
            pane name="Git" {
                command "lazygit"
                width    "80%"
                height   "85%"
                x        "10%"
                y        "7%"
            }
        }
    }

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    //  TAB 2: 󰊢 GIT — Lazygit full screen
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    tab name="󰊢  Git" {
        pane name="Lazygit" {
            command "lazygit"
        }
    }

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    //  TAB 3: 󰋊 FILES — Yazi file manager
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    tab name="󰋊  Files" {
        pane name="Yazi" {
            command "yazi"
        }
    }

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    //  TAB 4: 󰨟 MONITOR — System monitoring
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    tab name="󰨟  Monitor" {
        pane name="Btop" {
            command "btop"
        }
    }

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    //  TAB 5:   SCRATCH — Free terminal
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    tab name="  Scratch" {
        pane name="Shell" {
            command "fish"
            args "-l"
        }
    }
}