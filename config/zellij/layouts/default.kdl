// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 — ZELLIJ LAYOUT: DEFAULT                              ║
// ║                                                                            ║
// ║  Structure:                                                                ║
// ║  ┌──────────────────────────────────────────────────────────────┐         ║
// ║  │  [tab-bar]                                                   │         ║
// ║  ├──────────────────────────────────────────────────────────────┤         ║
// ║  │                                                              │         ║
// ║  │                    Main Terminal Pane                        │         ║
// ║  │                                                              │         ║
// ║  ├──────────────────────────────────────────────────────────────┤         ║
// ║  │  [status-bar]                                                │         ║
// ║  └──────────────────────────────────────────────────────────────┘         ║
// ╚══════════════════════════════════════════════════════════════════════════╝

layout {

    // ── UI Plugins ────────────────────────────────────────────────────────
    default_tab_template {

        // Tab bar at top
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }

        // Main content area
        children

        // Status bar at bottom
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // ── Default Tab: Single terminal ─────────────────────────────────────
    tab name="  Terminal" focus=true {
        pane command="fish" {
            args "-l"
        }
    }
}