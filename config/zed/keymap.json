[
    // ╔══════════════════════════════════════════════════════════════╗
    // ║  🔥 ASH DOTFILES v5.0 — ZED KEYMAP ULTRA                   ║
    // ╚══════════════════════════════════════════════════════════════╝
  
    // ─────────────────────────────────────────────
    //  🌐  GLOBAL BINDINGS
    // ─────────────────────────────────────────────
    {
      "context": "Workspace",
      "bindings": {
        // ── File operations ──────────────────────
        "ctrl-n":             "workspace::NewFile",
        "ctrl-shift-n":       "workspace::NewWindow",
        "ctrl-o":             "workspace::Open",
        "ctrl-s":             "workspace::Save",
        "ctrl-shift-s":       "workspace::SaveAs",
        "ctrl-shift-alt-s":   "workspace::SaveAll",
        "ctrl-w":             "pane::CloseActiveItem",
        "ctrl-shift-w":       "workspace::CloseWindow",
        "ctrl-shift-t":       "workspace::ReopenClosedItem",
  
        // ── Panels ───────────────────────────────
        "ctrl-b":             "workspace::ToggleLeftDock",
        "ctrl-shift-b":       "workspace::ToggleRightDock",
        "ctrl-j":             "workspace::ToggleBottomDock",
        "ctrl-shift-e":       "project_panel::ToggleFocus",
        "ctrl-shift-o":       "outline_panel::ToggleFocus",
        "ctrl-grave":         "terminal_panel::ToggleFocus",
        "ctrl-shift-m":       "diagnostics::Deploy",
        "ctrl-shift-p":       "command_palette::Toggle",
        "ctrl-shift-x":       "extensions::Toggle",
        "ctrl-shift-a":       "assistant::ToggleFocus",
  
        // ── Navigation ───────────────────────────
        "ctrl-p":             "file_finder::Toggle",
        "ctrl-shift-f":       "workspace::NewSearch",
        "ctrl-alt-left":      "workspace::GoBack",
        "ctrl-alt-right":     "workspace::GoForward",
        "alt-1":              "pane::ActivateItem 0",
        "alt-2":              "pane::ActivateItem 1",
        "alt-3":              "pane::ActivateItem 2",
        "alt-4":              "pane::ActivateItem 3",
        "alt-5":              "pane::ActivateItem 4",
        "alt-6":              "pane::ActivateItem 5",
        "alt-7":              "pane::ActivateItem 6",
        "alt-8":              "pane::ActivateItem 7",
        "alt-9":              "pane::ActivateItem 8",
        "ctrl-tab":           "pane::ActivateNextItem",
        "ctrl-shift-tab":     "pane::ActivatePrevItem",
        "ctrl-1":             "pane::ActivateItem 0",
  
        // ── Pane splits ──────────────────────────
        "ctrl-\\":            "pane::SplitRight",
        "ctrl-shift-\\":      "pane::SplitDown",
        "ctrl-alt-up":        "workspace::ActivatePaneInDirection Up",
        "ctrl-alt-down":      "workspace::ActivatePaneInDirection Down",
        "ctrl-alt-left":      "workspace::ActivatePaneInDirection Left",
        "ctrl-alt-right":     "workspace::ActivatePaneInDirection Right",
  
        // ── Zoom & layout ────────────────────────
        "ctrl-shift-z":       "workspace::ToggleZoom",
        "ctrl-k ctrl-z":      "workspace::ToggleCenteredLayout",
  
        // ── Theme picker ─────────────────────────
        "ctrl-k ctrl-t":      "theme_selector::Toggle"
      }
    },
  
    // ─────────────────────────────────────────────
    //  📝  EDITOR BINDINGS
    // ─────────────────────────────────────────────
    {
      "context": "Editor",
      "bindings": {
        // ── LSP actions ──────────────────────────
        "f12":                "editor::GoToDefinition",
        "alt-f12":            "editor::GoToDefinitionSplit",
        "shift-f12":          "editor::FindAllReferences",
        "ctrl-f12":           "editor::GoToImplementation",
        "ctrl-shift-i":       "editor::GoToImplementation",
        "f2":                 "editor::Rename",
        "ctrl-shift-r":       "editor::Rename",
        "ctrl-. ":            "editor::ToggleCodeActions",
        "alt-enter":          "editor::ToggleCodeActions",
        "ctrl-k ctrl-i":      "editor::Hover",
        "shift-k":            "editor::Hover",
        "ctrl-shift-space":   "editor::ShowSignatureHelp",
        "ctrl-k ctrl-d":      "editor::GoToTypeDefinition",
        "ctrl-k ctrl-r":      "editor::FindAllReferences",
  
        // ── Formatting ───────────────────────────
        "ctrl-shift-i":       "editor::Format",
        "ctrl-alt-f":         "editor::Format",
        "ctrl-k ctrl-f":      "editor::FormatSelections",
  
        // ── Folding ──────────────────────────────
        "ctrl-shift-[":       "editor::Fold",
        "ctrl-shift-]":       "editor::UnfoldLines",
        "ctrl-k ctrl-0":      "editor::FoldAll",
        "ctrl-k ctrl-j":      "editor::UnfoldAll",
        "ctrl-k ctrl-1":      "editor::FoldAtLevel 1",
        "ctrl-k ctrl-2":      "editor::FoldAtLevel 2",
        "ctrl-k ctrl-3":      "editor::FoldAtLevel 3",
  
        // ── Multi-cursor ─────────────────────────
        "ctrl-d":             "editor::SelectNextOccurrence",
        "ctrl-shift-l":       "editor::SelectAllMatches",
        "ctrl-k ctrl-k":      "editor::SelectNextOccurrence",
        "ctrl-u":             "editor::UndoSelection",
        "alt-shift-i":        "editor::AddSelectionsAbove",
        "alt-shift-down":     "editor::AddSelectionBelow",
        "alt-shift-up":       "editor::AddSelectionAbove",
        "ctrl-alt-down":      "editor::AddSelectionBelow",
        "ctrl-alt-up":        "editor::AddSelectionAbove",
        "shift-alt-mouse_down": "editor::AddSelectionBelow",
  
        // ── Line operations ──────────────────────
        "alt-up":             "editor::MoveLineUp",
        "alt-down":           "editor::MoveLineDown",
        "alt-shift-up":       "editor::DuplicateLineUp",
        "alt-shift-down":     "editor::DuplicateLineDown",
        "ctrl-shift-k":       "editor::DeleteLine",
        "ctrl-shift-enter":   "editor::NewlineAbove",
        "ctrl-enter":         "editor::NewlineBelow",
        "ctrl-l":             "editor::SelectLine",
        "ctrl-k ctrl-c":      "editor::ToggleComments",
        "ctrl-/":             "editor::ToggleComments",
        "ctrl-shift-/":       "editor::ToggleBlockComments",
  
        // ── Case transformation ──────────────────
        "ctrl-k ctrl-u":      "editor::ConvertToUpperCase",
        "ctrl-k ctrl-l":      "editor::ConvertToLowerCase",
        "ctrl-k ctrl-s":      "editor::ConvertToSnakeCase",
  
        // ── Indentation ──────────────────────────
        "tab":                "editor::Indent",
        "shift-tab":          "editor::Outdent",
        "ctrl-]":             "editor::Indent",
        "ctrl-[":             "editor::Outdent",
  
        // ── Navigation ───────────────────────────
        "ctrl-g":             "go_to_line::Toggle",
        "ctrl-home":          "editor::MoveToBeginning",
        "ctrl-end":           "editor::MoveToEnd",
        "ctrl-shift-home":    "editor::SelectToBeginning",
        "ctrl-shift-end":     "editor::SelectToEnd",
        "alt-right":          "editor::MoveToNextWordEnd",
        "alt-left":           "editor::MoveToPreviousWordStart",
        "ctrl-right":         "editor::MoveToNextWordEnd",
        "ctrl-left":          "editor::MoveToPreviousWordStart",
  
        // ── Search ───────────────────────────────
        "ctrl-f":             "buffer_search::Deploy",
        "ctrl-h":             "buffer_search::Deploy { \"replace_enabled\": true }",
        "ctrl-shift-h":       "project_search::SearchInNew",
        "f3":                 "search::SelectNextMatch",
        "shift-f3":           "search::SelectPrevMatch",
        "ctrl-k ctrl-h":      "editor::ToggleInlayHints",
  
        // ── Diagnostics ──────────────────────────
        "f8":                 "editor::GoToDiagnostic",
        "shift-f8":           "editor::GoToPrevDiagnostic",
        "ctrl-shift-m":       "diagnostics::Deploy",
  
        // ── Git ──────────────────────────────────
        "ctrl-shift-g":       "git::FocusPanel",
  
        // ── IntelliSense ─────────────────────────
        "ctrl-space":         "editor::ShowCompletions",
        "escape":             "editor::Cancel",
        "alt-z":              "editor::ToggleSoftWrap",
        "ctrl-alt-z":         "editor::ToggleSoftWrap",
  
        // ── Inline assists ───────────────────────
        "ctrl-alt-i":         "assistant::InlineAssist",
        "ctrl-alt-g":         "assistant::InlineAssist",
        "ctrl-i":             "editor::AcceptInlineCompletion",
        "alt-]":              "editor::NextInlineCompletion",
        "alt-[":              "editor::PrevInlineCompletion",
        "alt-backslash":      "editor::ToggleInlineCompletions"
      }
    },
  
    // ─────────────────────────────────────────────
    //  🔭  VIM NORMAL MODE
    // ─────────────────────────────────────────────
    {
      "context": "Editor && vim_mode == normal",
      "bindings": {
        // ── LSP with vim motions ─────────────────
        "g d":                "editor::GoToDefinition",
        "g D":                "editor::GoToDefinitionSplit",
        "g i":                "editor::GoToImplementation",
        "g I":                "editor::GoToImplementationSplit",
        "g t":                "editor::GoToTypeDefinition",
        "g y":                "editor::GoToTypeDefinition",
        "g r":                "editor::FindAllReferences",
        "g R":                "editor::Rename",
        "K":                  "editor::Hover",
        "ctrl-k":             "editor::Hover",
        "space c a":          "editor::ToggleCodeActions",
        "space c r":          "editor::Rename",
        "space c f":          "editor::Format",
        "space c d":          "editor::GoToDefinition",
        "space c i":          "editor::GoToImplementation",
  
        // ── Diagnostics ──────────────────────────
        "] d":                "editor::GoToDiagnostic",
        "[ d":                "editor::GoToPrevDiagnostic",
        "] e":                "editor::GoToDiagnostic",
        "[ e":                "editor::GoToPrevDiagnostic",
        "space x x":          "diagnostics::Deploy",
  
        // ── Navigation ───────────────────────────
        "space e":            "project_panel::ToggleFocus",
        "space o":            "outline_panel::ToggleFocus",
        "space f f":          "file_finder::Toggle",
        "space f r":          "workspace::OpenRecent",
        "space /":            "workspace::NewSearch",
        "space s g":          "workspace::NewSearch",
        "space s w":          "pane::DeploySearch",
        "space b d":          "pane::CloseActiveItem",
        "space b n":          "pane::ActivateNextItem",
        "space b p":          "pane::ActivatePrevItem",
        "space b o":          "pane::CloseOtherItems",
  
        // ── Window management ────────────────────
        "space w s":          "pane::SplitDown",
        "space w v":          "pane::SplitRight",
        "space w c":          "workspace::CloseActiveItem",
        "space w h":          "workspace::ActivatePaneInDirection Left",
        "space w l":          "workspace::ActivatePaneInDirection Right",
        "space w k":          "workspace::ActivatePaneInDirection Up",
        "space w j":          "workspace::ActivatePaneInDirection Down",
        "ctrl-h":             "workspace::ActivatePaneInDirection Left",
        "ctrl-l":             "workspace::ActivatePaneInDirection Right",
        "ctrl-k":             "workspace::ActivatePaneInDirection Up",
        "ctrl-j":             "workspace::ActivatePaneInDirection Down",
  
        // ── Git ──────────────────────────────────
        "] h":                "editor::GoToHunk",
        "[ h":                "editor::GoToPrevHunk",
        "space g b":          "editor::ToggleGitBlame",
        "space g s":          "git::FocusPanel",
        "space g h p":        "editor::ExpandAllHunkDiffs",
  
        // ── Folds ────────────────────────────────
        "z a":                "editor::ToggleFold",
        "z o":                "editor::UnfoldLines",
        "z c":                "editor::Fold",
        "z M":                "editor::FoldAll",
        "z R":                "editor::UnfoldAll",
        "z 1":                "editor::FoldAtLevel 1",
        "z 2":                "editor::FoldAtLevel 2",
        "z 3":                "editor::FoldAtLevel 3",
  
        // ── Misc ─────────────────────────────────
        "space z":            "workspace::ToggleZoom",
        "space t":            "terminal_panel::ToggleFocus",
        "space m":            "diagnostics::Deploy",
        "space p":            "command_palette::Toggle",
        "space u i":          "editor::ToggleInlayHints",
        "space u w":          "editor::ToggleSoftWrap",
        "space u b":          "editor::ToggleGitBlame",
        "g b":                "editor::ToggleComments",
  
        // ── AI ───────────────────────────────────
        "space a a":          "assistant::ToggleFocus",
        "space a i":          "assistant::InlineAssist"
      }
    },
  
    // ─────────────────────────────────────────────
    //  🔭  VIM VISUAL MODE
    // ─────────────────────────────────────────────
    {
      "context": "Editor && vim_mode == visual",
      "bindings": {
        "g c":                "editor::ToggleComments",
        "g b":                "editor::ToggleComments",
        "space c a":          "editor::ToggleCodeActions",
        "space c f":          "editor::FormatSelections",
        "ctrl-alt-i":         "assistant::InlineAssist"
      }
    },
  
    // ─────────────────────────────────────────────
    //  🔭  VIM INSERT MODE
    // ─────────────────────────────────────────────
    {
      "context": "Editor && vim_mode == insert",
      "bindings": {
        "j k":                "vim::NormalBefore",
        "j j":                "vim::NormalBefore",
        "ctrl-space":         "editor::ShowCompletions",
        "alt-]":              "editor::NextInlineCompletion",
        "alt-[":              "editor::PrevInlineCompletion",
        "ctrl-y":             "editor::AcceptInlineCompletion"
      }
    },
  
    // ─────────────────────────────────────────────
    //  📁  PROJECT PANEL
    // ─────────────────────────────────────────────
    {
      "context": "ProjectPanel",
      "bindings": {
        "a":                  "project_panel::NewFile",
        "shift-a":            "project_panel::NewDirectory",
        "d":                  "project_panel::Trash",
        "r":                  "project_panel::Rename",
        "x":                  "project_panel::Cut",
        "c":                  "project_panel::Copy",
        "p":                  "project_panel::Paste",
        "y":                  "project_panel::CopyPath",
        "Y":                  "project_panel::CopyRelativePath",
        "q":                  "workspace::ToggleLeftDock",
        "escape":             "workspace::ToggleLeftDock",
        "enter":              "project_panel::OpenPermanent",
        "space":              "project_panel::Open",
        "o":                  "project_panel::RevealInFileManager",
        "ctrl-r":             "project_panel::CollapseAllEntries",
        ".":                  "project_panel::ToggleIgnoredEntries"
      }
    },
  
    // ─────────────────────────────────────────────
    //  🔍  FILE FINDER
    // ─────────────────────────────────────────────
    {
      "context": "FileFinder",
      "bindings": {
        "escape":             "file_finder::Cancel",
        "ctrl-c":             "file_finder::Cancel",
        "enter":              "file_finder::Confirm",
        "ctrl-s":             "file_finder::ConfirmCompletion",
        "tab":                "file_finder::SelectNextHistory",
        "shift-tab":          "file_finder::SelectPrevHistory"
      }
    },
  
    // ─────────────────────────────────────────────
    //  🖥️  TERMINAL
    // ─────────────────────────────────────────────
    {
      "context": "Terminal",
      "bindings": {
        "ctrl-c":             "terminal::SendCtrlC",
        "ctrl-a":             "terminal::SendCtrlA",
        "ctrl-shift-c":       "terminal::Copy",
        "ctrl-shift-v":       "terminal::Paste",
        "ctrl-shift-f":       "buffer_search::Deploy",
        "ctrl-shift-t":       "workspace::NewTerminal",
        "ctrl-shift-up":      "terminal::ScrollLineUp",
        "ctrl-shift-down":    "terminal::ScrollLineDown",
        "ctrl-shift-page_up": "terminal::ScrollPageUp",
        "ctrl-shift-page_down": "terminal::ScrollPageDown",
        "ctrl-shift-home":    "terminal::ScrollToTop",
        "ctrl-shift-end":     "terminal::ScrollToBottom",
        "ctrl-shift-k":       "terminal::ClearScreen",
        "ctrl-up":            "terminal::ScrollLineUp",
        "ctrl-down":          "terminal::ScrollLineDown",
        "alt-up":             "terminal::ScrollLineUp",
        "alt-down":           "terminal::ScrollLineDown"
      }
    },
  
    // ─────────────────────────────────────────────
    //  🤖  ASSISTANT PANEL
    // ─────────────────────────────────────────────
    {
      "context": "AssistantEditor",
      "bindings": {
        "ctrl-enter":         "assistant::Confirm",
        "shift-enter":        "assistant::Confirm",
        "ctrl-shift-enter":   "assistant::ConfirmCommand",
        "ctrl-n":             "assistant::NewContext",
        "ctrl-shift-s":       "assistant::SaveContext",
        "ctrl-o":             "assistant::OpenContext",
        "escape":             "workspace::ToggleRightDock"
      }
    },
  
    // ─────────────────────────────────────────────
    //  🔭  PICKER / COMMAND PALETTE
    // ─────────────────────────────────────────────
    {
      "context": "Picker > Editor",
      "bindings": {
        "ctrl-j":             "menu::SelectNext",
        "ctrl-k":             "menu::SelectPrev",
        "ctrl-n":             "menu::SelectNext",
        "ctrl-p":             "menu::SelectPrev",
        "ctrl-d":             "picker::DeleteRecentlyOpenedProject",
        "ctrl-alt-enter":     "picker::ConfirmInputRaw"
      }
    }
  ]