{
    "//": "╔══════════════════════════════════════════════════════════════╗",
    "// ": "║  🔥 ASH DOTFILES v5.0 — ZED EDITOR ULTRA CONFIG             ║",
    "//  ": "╚══════════════════════════════════════════════════════════════╝",
  
    // ─────────────────────────────────────────────
    //  🎨  THEME & APPEARANCE
    // ─────────────────────────────────────────────
    "theme": {
      "mode": "system",
      "light": "Ash Dynamic Light",
      "dark": "Ash Dynamic Dark"
    },
  
    "icon_theme": "catppuccin-mocha",
  
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "buffer_font_size": 14.0,
    "buffer_font_weight": 400,
    "buffer_font_features": {
      "calt": true,
      "liga": true,
      "ss01": true,
      "ss02": true,
      "ss03": true,
      "ss04": true,
      "ss05": true,
      "ss06": true,
      "ss07": true,
      "ss08": true,
      "cv01": true,
      "cv02": true,
      "cv03": true,
      "cv04": true,
      "cv05": true,
      "cv06": true,
      "cv07": true,
      "cv08": true,
      "cv09": true,
      "cv10": true,
      "cv11": true,
      "cv12": true,
      "cv13": true,
      "cv14": true,
      "cv15": true,
      "cv16": true,
      "cv17": true,
      "cv18": true,
      "cv19": true,
      "cv20": true
    },
    "buffer_line_height": { "custom": 1.65 },
  
    "ui_font_family": "Inter",
    "ui_font_size": 14.0,
    "ui_font_weight": 400,
  
    // ─────────────────────────────────────────────
    //  🪟  WINDOW & LAYOUT
    // ─────────────────────────────────────────────
    "window_decorations": "client",
    "titlebar": {
      "show_project_items": true,
      "show_branch_icon": true,
      "show_onboarding_banner": false
    },
  
    "centered_layout": {
      "left_padding": 0.15,
      "right_padding": 0.15
    },
  
    "tab_bar": {
      "show": true,
      "show_nav_history_buttons": true
    },
  
    "tabs": {
      "close_position": "right",
      "file_icons": true,
      "git_status": true
    },
  
    "toolbar": {
      "breadcrumbs": true,
      "quick_actions": true,
      "selections_menu": true
    },
  
    "scrollbar": {
      "show": "auto",
      "cursors": true,
      "git_diff": true,
      "search_results": true,
      "selected_symbol": true,
      "diagnostics": true
    },
  
    "status_bar": {
      "show": true
    },
  
    "minimap": {
      "show": "always",
      "thumb": "always"
    },
  
    // ─────────────────────────────────────────────
    //  📝  EDITOR BEHAVIOUR
    // ─────────────────────────────────────────────
    "vim_mode": true,
    "default_dock_anchor": "bottom",
  
    "cursor_blink": true,
    "cursor_blink_rate": 500,
    "cursor_shape": "bar",
  
    "relative_line_numbers": true,
    "line_indicator_format": "long",
  
    "show_whitespaces": "selection",
    "render_whitespace": "selection",
  
    "soft_wrap": "editor_width",
    "preferred_line_length": 100,
  
    "show_wrap_guides": true,
    "wrap_guides": [80, 100, 120],
  
    "indent_guides": {
      "enabled": true,
      "line_width": 1,
      "active_line_width": 2,
      "coloring": "indent_aware",
      "background_coloring": "disabled"
    },
  
    "gutter": {
      "line_numbers": true,
      "code_actions": true,
      "folds": true,
      "runnables": true,
      "breakpoints": true
    },
  
    "inlay_hints": {
      "enabled": true,
      "show_type_hints": true,
      "show_parameter_hints": true,
      "show_other_hints": true,
      "show_background": false,
      "edit_debounce_ms": 700,
      "scroll_debounce_ms": 50,
      "max_length": 25
    },
  
    "inline_completions": {
      "disabled_globs": [
        ".env",
        "*.secret",
        "*.key",
        "*.pem",
        "*.cert",
        "*.p12",
        "secrets/**"
      ]
    },
  
    "code_actions_on_format": {
      "source.fixAll.eslint": true,
      "source.organizeImports": true
    },
  
    "format_on_save": "on",
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
  
    "autosave": {
      "after_delay": { "milliseconds": 2000 }
    },
  
    "restore_on_startup": "last_workspace",
  
    // ─────────────────────────────────────────────
    //  🔍  SEARCH & FIND
    // ─────────────────────────────────────────────
    "search": {
      "whole_word": false,
      "case_sensitive": false,
      "include_ignored": false,
      "regex": false
    },
  
    // ─────────────────────────────────────────────
    //  🧩  COMPLETION & AI
    // ─────────────────────────────────────────────
    "show_completions_on_input": true,
    "show_completion_documentation": true,
    "completion_documentation_secondary_query_debounce": 300,
  
    "features": {
      "inline_completion_provider": "copilot",
      "edit_prediction_provider": "zed"
    },
  
    "assistant": {
      "version": "2",
      "default_model": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-5"
      },
      "enable_experimental_live_diffs": true
    },
  
    // ─────────────────────────────────────────────
    //  🌿  GIT INTEGRATION
    // ─────────────────────────────────────────────
    "git": {
      "enabled": true,
      "autoFetch": true,
      "autoFetchInterval": 300,
      "git_status": true,
      "inline_blame": {
        "enabled": true,
        "delay_ms": 750,
        "min_column": 80,
        "show_commit_summary": true
      }
    },
  
    // ─────────────────────────────────────────────
    //  🔬  DIAGNOSTICS
    // ─────────────────────────────────────────────
    "diagnostics": {
      "include_warnings": true
    },
  
    "show_signature_help_after_edits": true,
  
    // ─────────────────────────────────────────────
    //  🗂️  FILE TREE (PROJECT PANEL)
    // ─────────────────────────────────────────────
    "project_panel": {
      "button": true,
      "default_width": 260,
      "dock": "left",
      "file_icons": true,
      "folder_icons": true,
      "git_status": true,
      "indent_size": 20,
      "auto_reveal_entries": true,
      "auto_fold_dirs": true,
      "scrollbar": { "show": "never" }
    },
  
    // ─────────────────────────────────────────────
    //  🔭  OUTLINE PANEL
    // ─────────────────────────────────────────────
    "outline_panel": {
      "button": true,
      "default_width": 240,
      "dock": "left",
      "file_icons": true,
      "folder_icons": true,
      "git_status": true,
      "indent_size": 20,
      "auto_reveal_entries": true,
      "auto_fold_dirs": true,
      "scrollbar": { "show": "never" }
    },
  
    // ─────────────────────────────────────────────
    //  💬  COLLABORATION
    // ─────────────────────────────────────────────
    "collaboration_panel": {
      "button": false,
      "dock": "left",
      "default_width": 240
    },
  
    "notification_panel": {
      "button": true,
      "dock": "right",
      "default_width": 380
    },
  
    "chat_panel": {
      "button": true,
      "dock": "right",
      "default_width": 380
    },
  
    // ─────────────────────────────────────────────
    //  🖥️  TERMINAL
    // ─────────────────────────────────────────────
    "terminal": {
      "dock": "bottom",
      "default_width": 640,
      "default_height": 280,
      "working_directory": "current_project_directory",
      "font_family": "JetBrainsMono Nerd Font",
      "font_size": 13.0,
      "font_weight": 400,
      "font_features": {
        "calt": true,
        "liga": true
      },
      "line_height": { "custom": 1.5 },
      "cursor_shape": "bar",
      "blinking": "terminal_controlled",
      "alternate_scroll": "on",
      "option_as_meta": false,
      "copy_on_select": false,
      "env": {
        "TERM": "xterm-256color",
        "COLORTERM": "truecolor",
        "ASH_DOTFILES": "1",
        "ASH_VERSION": "5.0"
      },
      "shell": {
        "program": "/usr/bin/fish"
      },
      "toolbar": {
        "breadcrumbs": false
      },
      "detect_venv": {
        "on": {
          "directories": [".venv", "venv", ".env", "env"],
          "activate_script": "default"
        }
      },
      "max_scroll_history_lines": 10000,
      "scrollbar": { "show": "never" }
    },
  
    // ─────────────────────────────────────────────
    //  🌍  LANGUAGES (per-language overrides)
    // ─────────────────────────────────────────────
    "languages": {
      "Rust": {
        "tab_size": 4,
        "hard_tabs": false,
        "format_on_save": "on",
        "formatter": "language_server",
        "code_actions_on_format": {
          "source.organizeImports": true
        },
        "show_inline_completions": true,
        "inlay_hints": {
          "enabled": true,
          "show_type_hints": true,
          "show_parameter_hints": true,
          "show_other_hints": true
        }
      },
      "Python": {
        "tab_size": 4,
        "hard_tabs": false,
        "format_on_save": "on",
        "formatter": [
          {
            "language_server": {
              "name": "ruff"
            }
          }
        ],
        "code_actions_on_format": {
          "source.fixAll.ruff": true,
          "source.organizeImports.ruff": true
        },
        "inlay_hints": { "enabled": true }
      },
      "Go": {
        "tab_size": 4,
        "hard_tabs": true,
        "format_on_save": "on",
        "formatter": "language_server",
        "code_actions_on_format": {
          "source.organizeImports": true
        },
        "inlay_hints": { "enabled": true }
      },
      "TypeScript": {
        "tab_size": 2,
        "hard_tabs": false,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"]
          }
        },
        "code_actions_on_format": {
          "source.fixAll.eslint": true,
          "source.organizeImports": true
        },
        "inlay_hints": { "enabled": true }
      },
      "TSX": {
        "tab_size": 2,
        "hard_tabs": false,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"]
          }
        },
        "code_actions_on_format": {
          "source.fixAll.eslint": true
        }
      },
      "JavaScript": {
        "tab_size": 2,
        "hard_tabs": false,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"]
          }
        },
        "code_actions_on_format": {
          "source.fixAll.eslint": true
        }
      },
      "JSON": {
        "tab_size": 2,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"]
          }
        }
      },
      "JSONC": {
        "tab_size": 2,
        "format_on_save": "on"
      },
      "YAML": {
        "tab_size": 2,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"]
          }
        }
      },
      "TOML": {
        "tab_size": 2,
        "format_on_save": "on",
        "formatter": "language_server"
      },
      "Markdown": {
        "tab_size": 2,
        "soft_wrap": "preferred_line_length",
        "preferred_line_length": 80,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"]
          }
        }
      },
      "Lua": {
        "tab_size": 2,
        "hard_tabs": false,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "stylua",
            "arguments": ["--indent-type", "Spaces", "--indent-width", "2", "-"]
          }
        }
      },
      "C": {
        "tab_size": 4,
        "hard_tabs": false,
        "format_on_save": "on",
        "formatter": "language_server"
      },
      "C++": {
        "tab_size": 4,
        "hard_tabs": false,
        "format_on_save": "on",
        "formatter": "language_server"
      },
      "Zig": {
        "tab_size": 4,
        "hard_tabs": false,
        "format_on_save": "on",
        "formatter": "language_server"
      },
      "Elixir": {
        "tab_size": 2,
        "format_on_save": "on",
        "formatter": "language_server"
      },
      "Haskell": {
        "tab_size": 2,
        "format_on_save": "on",
        "formatter": "language_server"
      },
      "Nix": {
        "tab_size": 2,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "nixfmt",
            "arguments": ["-"]
          }
        }
      },
      "SQL": {
        "tab_size": 2,
        "format_on_save": "on"
      },
      "Dockerfile": {
        "tab_size": 4,
        "format_on_save": "on"
      },
      "Bash": {
        "tab_size": 2,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "shfmt",
            "arguments": ["-i", "2", "-ci", "-bn", "-s", "-"]
          }
        }
      },
      "Fish": {
        "tab_size": 4,
        "format_on_save": "off"
      },
      "CSS": {
        "tab_size": 2,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"]
          }
        }
      },
      "SCSS": {
        "tab_size": 2,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"]
          }
        }
      },
      "HTML": {
        "tab_size": 2,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"]
          }
        }
      },
      "GraphQL": {
        "tab_size": 2,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "prettier",
            "arguments": ["--stdin-filepath", "{buffer_path}"]
          }
        }
      },
      "Terra": {
        "tab_size": 2,
        "format_on_save": "on"
      },
      "HCL": {
        "tab_size": 2,
        "format_on_save": "on",
        "formatter": {
          "external": {
            "command": "terraform",
            "arguments": ["fmt", "-"]
          }
        }
      }
    },
  
    // ─────────────────────────────────────────────
    //  🔬  LSP CONFIGURATION
    // ─────────────────────────────────────────────
    "lsp": {
      "rust-analyzer": {
        "initialization_options": {
          "check": {
            "command": "clippy",
            "features": "all",
            "extraArgs": ["--", "-W", "clippy::pedantic", "-W", "clippy::nursery"]
          },
          "cargo": {
            "features": "all",
            "autoreload": true,
            "buildScripts": { "enable": true }
          },
          "inlayHints": {
            "bindingModeHints": { "enable": true },
            "chainingHints": { "enable": true },
            "closingBraceHints": { "enable": true, "minLines": 10 },
            "closureCaptureHints": { "enable": true },
            "closureReturnTypeHints": { "render": "always" },
            "discriminantHints": { "enable": "always" },
            "expressionAdjustmentHints": { "enable": "always" },
            "implicitDrops": { "enable": true },
            "lifetimeElisionHints": { "enable": "always", "useParameterNames": true },
            "maxLength": 25,
            "parameterHints": { "enable": true },
            "rangeExclusiveHints": { "enable": true },
            "reborrowHints": { "enable": "always" },
            "renderColons": true,
            "typeHints": { "enable": true, "hideClosureInitialization": false, "hideNamedConstructor": false }
          },
          "procMacro": { "enable": true },
          "diagnostics": {
            "enable": true,
            "experimental": { "enable": true }
          },
          "lens": {
            "debug": { "enable": true },
            "enable": true,
            "implementations": { "enable": true },
            "references": {
              "adt": { "enable": true },
              "enumVariant": { "enable": true },
              "method": { "enable": true },
              "trait": { "enable": true }
            },
            "run": { "enable": true }
          },
          "completion": {
            "autoimport": { "enable": true },
            "autoself": { "enable": true },
            "callable": { "snippets": "fill_arguments" }
          },
          "hover": {
            "actions": {
              "enable": true,
              "debug": { "enable": true },
              "gotoTypeDef": { "enable": true },
              "implementations": { "enable": true },
              "references": { "enable": true },
              "run": { "enable": true }
            },
            "documentation": { "enable": true, "keywords": { "enable": true } },
            "links": { "enable": true }
          },
          "semanticHighlighting": {
            "operator": { "enable": true, "specialization": { "enable": true } },
            "punctuation": { "enable": true, "specialization": { "enable": true } },
            "strings": { "enable": true }
          }
        }
      },
      "pyright": {
        "settings": {
          "python.analysis": {
            "typeCheckingMode": "strict",
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true,
            "diagnosticMode": "workspace",
            "reportMissingImports": true,
            "reportMissingTypeStubs": false
          }
        }
      },
      "ruff": {
        "initialization_options": {
          "settings": {
            "lineLength": 100,
            "lint": {
              "select": ["E", "W", "F", "I", "N", "D", "UP", "ANN", "S", "B", "A", "C4", "PT", "SIM", "TCH"],
              "ignore": ["D100", "D101", "D102", "D103", "D104", "D105", "D107", "ANN101", "ANN102"]
            }
          }
        }
      },
      "gopls": {
        "initialization_options": {
          "analyses": {
            "asmdecl": true,
            "assign": true,
            "atomic": true,
            "bools": true,
            "buildtag": true,
            "cgocall": true,
            "composites": true,
            "copylocks": true,
            "deprecated": true,
            "directive": true,
            "errorsas": true,
            "framepointer": true,
            "httpresponse": true,
            "ifaceassert": true,
            "loopclosure": true,
            "lostcancel": true,
            "nilfunc": true,
            "printf": true,
            "shadow": true,
            "shift": true,
            "sigchanyzer": true,
            "slog": true,
            "stdmethods": true,
            "stringintconv": true,
            "structtag": true,
            "testinggoroutine": true,
            "tests": true,
            "timeformat": true,
            "unmarshal": true,
            "unreachable": true,
            "unsafeptr": true,
            "unusedresult": true,
            "unusedwrite": true,
            "useany": true,
            "fillreturns": true,
            "nonewvars": true,
            "noresultvalues": true,
            "undeclaredname": true
          },
          "hints": {
            "assignVariableTypes": true,
            "compositeLiteralFields": true,
            "compositeLiteralTypes": true,
            "constantValues": true,
            "functionTypeParameters": true,
            "parameterNames": true,
            "rangeVariableTypes": true
          },
          "staticcheck": true,
          "symbolMatcher": "Fuzzy",
          "symbolStyle": "Dynamic",
          "vulncheck": "Imports",
          "directoryFilters": [
            "-**/node_modules",
            "-**/.git",
            "-**/vendor"
          ]
        }
      },
      "typescript-language-server": {
        "initialization_options": {
          "preferences": {
            "includeInlayParameterNameHints": "all",
            "includeInlayParameterNameHintsWhenArgumentMatchesName": true,
            "includeInlayFunctionParameterTypeHints": true,
            "includeInlayVariableTypeHints": true,
            "includeInlayVariableTypeHintsWhenTypeMatchesName": true,
            "includeInlayPropertyDeclarationTypeHints": true,
            "includeInlayFunctionLikeReturnTypeHints": true,
            "includeInlayEnumMemberValueHints": true,
            "includeCompletionsForModuleExports": true,
            "includeCompletionsWithSnippetText": true,
            "importModuleSpecifierPreference": "shortest",
            "quotePreference": "double",
            "jsxAttributeCompletionStyle": "auto"
          }
        }
      },
      "clangd": {
        "initialization_options": {
          "clangdFileStatus": true,
          "usePlaceholders": true,
          "completeUnimported": true,
          "semanticHighlighting": true
        },
        "binary": {
          "path": "/usr/bin/clangd",
          "arguments": [
            "--all-scopes-completion",
            "--suggest-missing-includes",
            "--background-index",
            "--pch-storage=disk",
            "--clang-tidy",
            "--header-insertion=never",
            "--completion-style=bundled",
            "--ranking-model=heuristics",
            "--malloc-trim",
            "-j=4"
          ]
        }
      }
    },
  
    // ─────────────────────────────────────────────
    //  🔧  TASKS & RUNNERS
    // ─────────────────────────────────────────────
    "tasks": {
      "variables": {}
    },
  
    // ─────────────────────────────────────────────
    //  ♿  ACCESSIBILITY
    // ─────────────────────────────────────────────
    "use_system_path_prompts": true,
    "active_pane_modifiers": {
      "magnification": 1.0
    },
  
    // ─────────────────────────────────────────────
    //  🔒  PRIVACY & TELEMETRY
    // ─────────────────────────────────────────────
    "telemetry": {
      "diagnostics": false,
      "metrics": false
    },
  
    // ─────────────────────────────────────────────
    //  🧪  EXPERIMENTAL
    // ─────────────────────────────────────────────
    "preview_tabs": {
      "enabled": true,
      "enable_preview_from_file_finder": true,
      "enable_preview_from_code_navigation": true
    },
  
    "file_scan_exclusions": [
      "**/.git",
      "**/.svn",
      "**/.hg",
      "**/CVS",
      "**/.DS_Store",
      "**/Thumbs.db",
      "**/node_modules",
      "**/target",
      "**/.cargo/registry",
      "**/__pycache__",
      "**/.pytest_cache",
      "**/.mypy_cache",
      "**/.ruff_cache",
      "**/dist",
      "**/build",
      "**/.next",
      "**/.nuxt",
      "**/.output",
      "**/coverage",
      "**/.nyc_output",
      "**/.turbo",
      "**/vendor",
      "**/.venv",
      "**/venv",
      "**/.terraform",
      "**/.direnv"
    ],
  
    "file_types": {
      "Dockerfile": ["Dockerfile", "Dockerfile.*", "*.dockerfile"],
      "JSON": ["*.json", "*.jsonc", "*.json5"],
