/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Sidebar Launcher Style 2: Warm Accent           ║
   ║                                                                              ║
   ║  Sidebar with warm amber/peach accent color instead of mauve. Dark base   ║
   ║  with golden highlights, peach selection, teal active states.             ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    win-bg:                         rgba(20, 18, 14, 0.92);
    win-border:                     rgba(250, 179, 135, 0.30);
    win-border-width:               1px;
    win-radius:                     14px;

    sidebar-bg:                     rgba(16, 14, 10, 0.96);
    sidebar-border:                 rgba(88, 75, 56, 0.60);
    sidebar-border-width:           1px;

    sidebar-btn-bg:                 transparent;
    sidebar-btn-fg:                 #7f849c;
    sidebar-btn-selected-bg:        rgba(250, 179, 135, 0.18);
    sidebar-btn-selected-fg:        #fab387;
    sidebar-btn-selected-border:    rgba(250, 179, 135, 0.40);

    inputbar-bg:                    rgba(30, 26, 20, 0.70);
    inputbar-border:                rgba(88, 75, 56, 0.80);

    element-selected-bg:            rgba(250, 179, 135, 0.85);
    element-selected-fg:            #1e1a10;
    element-alt-bg:                 rgba(30, 26, 20, 0.25);
}

window {
    background-color:   rgba(20, 18, 14, 0.92);
    border-color:       rgba(250, 179, 135, 0.30);
    border:             1px;
    border-radius:      14px;
}

sidebar-column {
    background-color:   rgba(16, 14, 10, 0.96);
    border-color:       rgba(88, 75, 56, 0.60);
}

sidebar-logo { text-color: #fab387; }
sidebar-title { text-color: #cdd6f4; }
sidebar-sep { background-color: rgba(88, 75, 56, 0.60); }

button {
    background-color:   transparent;
    text-color:         #7f849c;
    border-radius:      8px;
}

button.selected {
    background-color:   rgba(250, 179, 135, 0.18);
    text-color:         #fab387;
    border:             1px;
    border-color:       rgba(250, 179, 135, 0.40);
}

sidebar-hint { text-color: rgba(127, 132, 156, 0.45); }

inputbar {
    background-color:   rgba(30, 26, 20, 0.70);
    border-color:       rgba(88, 75, 56, 0.80);
}

prompt   { text-color: #fab387; }
entry    { text-color: #cdd6f4; placeholder-color: rgba(127,132,156,0.55); }

element selected.normal {
    background-color:   rgba(250, 179, 135, 0.85);
    text-color:         #1e1a10;
}

element normal.active {
    background-color:   rgba(148, 226, 213, 0.10);
    text-color:         #94e2d5;
}

element selected.active {
    background-color:   #94e2d5;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(30, 26, 20, 0.25);
    text-color:         #9399b2;
}

element-text { highlight: bold #f9e2af; }