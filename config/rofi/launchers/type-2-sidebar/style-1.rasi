/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Sidebar Launcher Style 1: Deep Glass            ║
   ║                                                                              ║
   ║  Dark sidebar with frosted glass content panel. Left panel is deeper       ║
   ║  and more opaque, right panel lighter and glassy. Catppuccin Mauve accent. ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    /* ── Window ──────────────────────────────────────────────────────────────── */
    win-bg:                         rgba(17, 17, 27, 0.90);
    win-border:                     rgba(203, 164, 247, 0.22);
    win-border-width:               1px;
    win-radius:                     16px;

    /* ── Sidebar ─────────────────────────────────────────────────────────────── */
    sidebar-bg:                     rgba(14, 14, 22, 0.95);
    sidebar-border:                 rgba(49, 50, 68, 0.60);
    sidebar-border-width:           1px;

    /* ── Sidebar buttons ─────────────────────────────────────────────────────── */
    sidebar-btn-bg:                 transparent;
    sidebar-btn-fg:                 #6c7086;
    sidebar-btn-selected-bg:        rgba(203, 164, 247, 0.15);
    sidebar-btn-selected-fg:        #cba4f7;
    sidebar-btn-selected-border:    rgba(203, 164, 247, 0.35);

    /* ── Input bar ───────────────────────────────────────────────────────────── */
    inputbar-bg:                    rgba(30, 30, 46, 0.60);
    inputbar-border:                rgba(49, 50, 68, 0.80);

    /* ── Results ─────────────────────────────────────────────────────────────── */
    element-selected-bg:            rgba(203, 164, 247, 0.88);
    element-selected-fg:            #1e1e2e;
    element-alt-bg:                 rgba(30, 30, 46, 0.20);
}

/* Apply window */
window {
    background-color:   rgba(17, 17, 27, 0.90);
    border-color:       rgba(203, 164, 247, 0.22);
    border:             1px;
    border-radius:      16px;
}

/* Sidebar deep dark */
sidebar-column {
    background-color:   rgba(14, 14, 22, 0.95);
    border-color:       rgba(49, 50, 68, 0.60);
}

/* Sidebar header accent */
sidebar-logo {
    text-color:         #cba4f7;
}

sidebar-title {
    text-color:         #cdd6f4;
}

sidebar-sep {
    background-color:   rgba(69, 71, 90, 0.50);
}

/* Sidebar buttons */
button {
    background-color:   transparent;
    text-color:         #6c7086;
    border-radius:      8px;
    padding:            9px 14px;
}

button.selected {
    background-color:   rgba(203, 164, 247, 0.15);
    text-color:         #cba4f7;
    border-color:       rgba(203, 164, 247, 0.35);
    border:             1px;
}

/* Footer */
sidebar-hint { text-color: rgba(108, 112, 134, 0.50); }
num-filtered-rows { text-color: rgba(108, 112, 134, 0.50); }

/* Input */
inputbar { background-color: rgba(30, 30, 46, 0.60); border-color: rgba(49, 50, 68, 0.80); }
prompt   { text-color: #cba4f7; }
entry    { text-color: #cdd6f4; placeholder-color: rgba(108,112,134,0.60); }

/* Results: glass selected */
element selected.normal {
    background-color:   rgba(203, 164, 247, 0.88);
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.20);
    text-color:         #9399b2;
}

element-text { highlight: bold #fab387; }