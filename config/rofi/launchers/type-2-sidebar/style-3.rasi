/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Sidebar Launcher Style 3: Arctic Nord           ║
   ║                                                                              ║
   ║  Nord-inspired cool blue-grey palette. Icy dark sidebar, slightly          ║
   ║  lighter content panel, frost blue accents, clean and minimal lines.       ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    /* Nord-ish palette */
    nord-bg0:           #1a1f2e;
    nord-bg1:           #1f2640;
    nord-bg2:           #242c42;
    nord-surface:       #2e3752;
    nord-border:        #3b4771;
    nord-text:          #cdd6f4;
    nord-subtext:       #8899b4;
    nord-accent:        #81a1c1;
    nord-accent-2:      #5e81ac;
    nord-frost:         #88c0d0;
    nord-aurora-green:  #a3be8c;
    nord-aurora-yellow: #ebcb8b;

    win-bg:                         rgba(26, 31, 46, 0.94);
    win-border:                     rgba(129, 161, 193, 0.35);
    win-border-width:               1px;
    win-radius:                     14px;

    sidebar-bg:                     rgba(20, 24, 36, 0.97);
    sidebar-border:                 rgba(59, 71, 113, 0.70);
    sidebar-border-width:           1px;

    sidebar-btn-bg:                 transparent;
    sidebar-btn-fg:                 rgba(136, 153, 180, 0.70);
    sidebar-btn-selected-bg:        rgba(129, 161, 193, 0.18);
    sidebar-btn-selected-fg:        @nord-accent;
    sidebar-btn-selected-border:    rgba(129, 161, 193, 0.40);

    inputbar-bg:                    rgba(31, 38, 64, 0.65);
    inputbar-border:                rgba(59, 71, 113, 0.80);

    element-selected-bg:            rgba(129, 161, 193, 0.82);
    element-selected-fg:            #1a1f2e;
    element-alt-bg:                 rgba(31, 38, 64, 0.22);
}

window {
    background-color:   rgba(26, 31, 46, 0.94);
    border-color:       rgba(129, 161, 193, 0.35);
    border:             1px;
    border-radius:      14px;
}

sidebar-column {
    background-color:   rgba(20, 24, 36, 0.97);
    border-color:       rgba(59, 71, 113, 0.70);
}

sidebar-logo { text-color: #81a1c1; }
sidebar-title { text-color: #cdd6f4; }
sidebar-sep { background-color: rgba(59, 71, 113, 0.70); }

button {
    background-color:   transparent;
    text-color:         rgba(136, 153, 180, 0.70);
    border-radius:      8px;
}

button.selected {
    background-color:   rgba(129, 161, 193, 0.18);
    text-color:         #81a1c1;
    border:             1px;
    border-color:       rgba(129, 161, 193, 0.40);
}

sidebar-hint { text-color: rgba(136, 153, 180, 0.40); }
num-filtered-rows { text-color: rgba(136, 153, 180, 0.40); }

inputbar {
    background-color:   rgba(31, 38, 64, 0.65);
    border-color:       rgba(59, 71, 113, 0.80);
}

prompt   { text-color: #81a1c1; }
entry    { text-color: #cdd6f4; placeholder-color: rgba(136,153,180,0.50); }

element selected.normal {
    background-color:   rgba(129, 161, 193, 0.82);
    text-color:         #1a1f2e;
}

element normal.active {
    background-color:   rgba(163, 190, 140, 0.12);
    text-color:         #a3be8c;
}

element selected.active {
    background-color:   #a3be8c;
    text-color:         #1a1f2e;
}

element alternate.normal {
    background-color:   rgba(31, 38, 64, 0.22);
    text-color:         #8899b4;
}

element-text {
    font:               "JetBrainsMono Nerd Font 12";
    highlight:          bold #ebcb8b;
}