/* ─── VARIANT B: Top bar + dropdown results (ACTIVE) ────────────────────── */
* {
    /* ── Geometry ────────────────────────────────────────────────────────────── */
    dm-width:               100%;
    dm-x-offset:            0px;
    dm-y-offset:            0px;
    dm-location:            1;          /* 1 = top anchor */

    /* ── Window surface ──────────────────────────────────────────────────────── */
    dm-win-bg:              rgba(17, 17, 27, 0.96);
    dm-win-border:          rgba(203, 164, 247, 0.22);
    dm-win-border-width:    0px 0px 1px 0px;    /* Bottom border only */
    dm-win-radius:          0px;

    /* ── Layout ──────────────────────────────────────────────────────────────── */
    dm-mainbox-children:    [inputbar, listview, mode-switcher];

    /* ── Input bar ───────────────────────────────────────────────────────────── */
    dm-inputbar-bg:         rgba(24, 24, 37, 0.95);
    dm-inputbar-border:     rgba(49, 50, 68, 0.90);
    dm-inputbar-border-sides: 0px 0px 1px 0px;
    dm-inputbar-radius:     0px;
    dm-inputbar-padding-v:  10px;
    dm-inputbar-padding-h:  20px;
    dm-inputbar-expand:     true;

    /* ── Separator between prompt and entry ──────────────────────────────────── */
    dm-sep-char:            "›";
    dm-sep-color:           rgba(108, 112, 134, 0.50);

    /* ── Text ────────────────────────────────────────────────────────────────── */
    dm-text:                #cdd6f4;
    dm-subtext:             #a6adc8;
    dm-placeholder:         rgba(108, 112, 134, 0.55);
    dm-placeholder-text:    "Search applications, run commands…";
    dm-muted:               rgba(88, 91, 112, 0.60);
    dm-accent:              #cba4f7;
    dm-highlight:           #fab387;

    /* ── List view ────────────────────────────────────────────────────────────── */
    dm-listview-bg:         rgba(22, 22, 34, 0.92);
    dm-listview-border:     rgba(49, 50, 68, 0.80);
    dm-listview-border-sides: 0px 0px 1px 0px;
    dm-listview-radius:     0px;
    dm-list-padding-v:      6px;
    dm-list-padding-h:      8px;
    dm-list-spacing:        1px;

    /* Horizontal layout with many columns ─────────────────────────────────── */
    dm-list-layout:         vertical;
    dm-list-flow:           horizontal;
    dm-list-columns:        1;          /* Single column vertical dropdown */
    dm-list-lines:          8;

    /* ── Elements ────────────────────────────────────────────────────────────── */
    dm-element-radius:      6px;
    dm-element-padding-v:   7px;
    dm-element-padding-h:   14px;
    dm-element-fg:          #cdd6f4;
    dm-active-bg:           rgba(203, 164, 247, 0.10);
    dm-selected-bg:         rgba(203, 164, 247, 0.88);
    dm-selected-fg:         #1e1e2e;
    dm-alt-bg:              rgba(30, 30, 46, 0.40);
    dm-alt-fg:              #9399b2;

    /* ── Icon ────────────────────────────────────────────────────────────────── */
    dm-icon-size:           20px;
    dm-text-expand:         true;
    dm-text-align:          0.0;
    dm-show-icons:          true;

    /* ── Mode switcher ────────────────────────────────────────────────────────── */
    dm-mode-bg:             rgba(18, 18, 28, 0.92);
    dm-mode-border:         rgba(49, 50, 68, 0.80);
    dm-mode-border-sides:   1px 0px 0px 0px;
    dm-mode-radius:         0px;
    dm-mode-padding-v:      5px;
    dm-mode-padding-h:      16px;
    dm-btn-fg:              rgba(108, 112, 134, 0.70);
    dm-btn-selected-bg:     rgba(203, 164, 247, 0.85);
    dm-btn-selected-fg:     #1e1e2e;
    dm-btn-selected-border: rgba(203, 164, 247, 1.0);
}

/* ─── VARIANT C: Bottom strip ─────────────────────────────────────────────── */
