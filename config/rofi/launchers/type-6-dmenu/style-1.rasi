/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED STYLES FOR ACTIVE VARIANT (B)
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(17, 17, 27, 0.96);
    border-color:       rgba(203, 164, 247, 0.22);
    border:             0px 0px 1px 0px;
    border-radius:      0px;
}

inputbar {
    background-color:   rgba(24, 24, 37, 0.95);
    border-color:       rgba(49, 50, 68, 0.90);
}

prompt   { text-color: #cba4f7; font: "JetBrainsMono Nerd Font Bold 12"; }
textbox-prompt-sep { text-color: rgba(108, 112, 134, 0.45); str: "›"; }
entry    { text-color: #cdd6f4; placeholder-color: rgba(108, 112, 134, 0.55); }
num-filtered-rows { text-color: rgba(88, 91, 112, 0.55); }
case-indicator    { text-color: #cba4f7; }

listview {
    background-color:   rgba(22, 22, 34, 0.92);
    border-color:       rgba(49, 50, 68, 0.80);
    border:             0px 0px 1px 0px;
}

/* ── Element state styling ────────────────────────────────────────────────── */
element normal.normal {
    background-color:   transparent;
    text-color:         #cdd6f4;
}

element normal.active {
    background-color:   rgba(203, 164, 247, 0.10);
    text-color:         #cba4f7;
}

element normal.urgent {
    background-color:   rgba(243, 139, 168, 0.10);
    text-color:         #f38ba8;
}

element selected.normal {
    background-color:   rgba(203, 164, 247, 0.88);
    text-color:         #1e1e2e;
}

element selected.active {
    background-color:   #cba4f7;
    text-color:         #1e1e2e;
}

element selected.urgent {
    background-color:   #f38ba8;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.40);
    text-color:         #9399b2;
}

element alternate.active {
    background-color:   rgba(203, 164, 247, 0.06);
    text-color:         #cba4f7;
}

element-icon { background-color: transparent; }
element-text { highlight: bold #fab387; }

/* ── Mode switcher ────────────────────────────────────────────────────────── */
mode-switcher {
    background-color:   rgba(18, 18, 28, 0.92);
    border-color:       rgba(49, 50, 68, 0.80);
    border:             1px 0px 0px 0px;
}

button {
    background-color:   transparent;
    text-color:         rgba(108, 112, 134, 0.70);
    border:             0px;
}

button.selected {
    background-color:   rgba(203, 164, 247, 0.85);
    text-color:         #1e1e2e;
    border:             1px;
    border-color:       rgba(203, 164, 247, 1.0);
    border-radius:      4px;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §03  DMENU SCRIPT USAGE EXAMPLES
   ══════════════════════════════════════════════════════════════════════════════
   These commands pipe content into rofi-dmenu mode:

   # Basic list selection
   echo -e "Option A\nOption B\nOption C" | \
     rofi -dmenu -p "Select" -config PATH/launcher.rasi

   # Application launcher with custom filter
   rofi -show drun -config PATH/launcher.rasi

   # Run command with history
   rofi -show run -config PATH/launcher.rasi

   # Window switcher (compact bar form)
   rofi -show window -config PATH/launcher.rasi

   # Custom menu from bash
   CHOICE=$(printf '%s\n' "shut down" "reboot" "suspend" "logout" | \
     rofi -dmenu -i -p "Power" -config PATH/launcher.rasi)
   case "$CHOICE" in
     "shut down") systemctl poweroff ;;
     "reboot")    systemctl reboot   ;;
     "suspend")   systemctl suspend  ;;
     "logout")    loginctl terminate-user $USER ;;
   esac

   # File picker integration
   find ~/ -maxdepth 3 -name "*.pdf" | \
     rofi -dmenu -p "Open PDF" -config PATH/launcher.rasi | \
     xargs -r zathura

   # Clipboard history via cliphist
   cliphist list | \
     rofi -dmenu -p "Clipboard" -config PATH/launcher.rasi | \
     cliphist decode | wl-copy
   ══════════════════════════════════════════════════════════════════════════════ */

/* ══════════════════════════════════════════════════════════════════════════════
   §04  ACCESSIBILITY OVERRIDES
   Applied when high-contrast mode is detected (body.high-contrast):
   ══════════════════════════════════════════════════════════════════════════════ */

/* High contrast override (for motor/visual accessibility):
window {
    background-color:   #000000;
    border-color:       #ffffff;
    border:             2px;
}

inputbar { background-color: #111111; border-color: #ffffff; }
prompt   { text-color: #ffff00; }
entry    { text-color: #ffffff; }

element selected.normal {
    background-color:   #ffffff;
    text-color:         #000000;
}
*/

/* ══════════════════════════════════════════════════════════════════════════════
   §05  ANIMATION HINTS
   Rofi does not natively support CSS animations, but these comments
   document the intended animation behavior for GTK layer-shell implementations.

   Window appear:  fade-in 150ms ease-out + slide-down 8px
   Window exit:    fade-out 100ms ease-in
   Item select:    background fill 80ms ease
   Item hover:     background tint 60ms ease
   Mode switch:    cross-fade 120ms ease
   ══════════════════════════════════════════════════════════════════════════════ */