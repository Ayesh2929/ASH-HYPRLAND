/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Grid Launcher Style 1: Glassmorphism             ║
   ║                                                                              ║
   ║  Deep translucent backdrop with frosted glass cards, gradient border on   ║
   ║  selected items, blur-simulated depth and catppuccin mauve accent.         ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    /* ── Window ──────────────────────────────────────────────────────────────── */
    window-bg:                  rgba(17, 17, 27, 0.82);

    /* ── Input bar ───────────────────────────────────────────────────────────── */
    inputbar-bg:                rgba(30, 30, 46, 0.70);
    inputbar-border:            rgba(203, 164, 247, 0.30);

    /* ── Element card: default ───────────────────────────────────────────────── */
    element-bg:                 rgba(30, 30, 46, 0.40);
    element-border:             rgba(255, 255, 255, 0.06);
    element-border-width:       1px;
    element-radius:             14px;
    element-alt-bg:             rgba(30, 30, 46, 0.30);

    /* ── Element card: selected ──────────────────────────────────────────────── */
    element-selected-bg:        rgba(203, 164, 247, 0.85);
    element-selected-border:    rgba(203, 164, 247, 1.0);
}

/* ── Window: blurred dark backdrop ───────────────────────────────────────── */
window {
    background-color:   rgba(17, 17, 27, 0.82);
    border:             0px;
    border-radius:      0px;
}

/* ── Input bar: glass pill ───────────────────────────────────────────────── */
inputbar {
    background-color:   rgba(30, 30, 46, 0.70);
    border-color:       rgba(203, 164, 247, 0.30);
}

/* ── Grid items: frosted glass cards ─────────────────────────────────────── */
element {
    background-color:   rgba(30, 30, 46, 0.40);
    border-color:       rgba(255, 255, 255, 0.06);
    border:             1px;
    border-radius:      14px;
}

/* ── Glass card highlight (top inner glow) ───────────────────────────────── */
element normal.normal {
    background-color:   rgba(30, 30, 46, 0.40);
    border-color:       rgba(255, 255, 255, 0.06);
    text-color:         #cdd6f4;
}

element selected.normal {
    /* Accent glass card */
    background-color:   rgba(203, 164, 247, 0.80);
    border-color:       rgba(203, 164, 247, 1.0);
    border:             2px;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(24, 24, 37, 0.30);
    border-color:       rgba(255, 255, 255, 0.04);
    text-color:         #a6adc8;
}

/* ── Selected: glowing icon glow effect ──────────────────────────────────── */
element-icon {
    background-color:   transparent;
}

element-text {
    font:               "JetBrainsMono Nerd Font 10";
    text-color:         inherit;
    background-color:   transparent;
}

/* ── Inputbar details ────────────────────────────────────────────────────── */
prompt {
    text-color:         #cba4f7;
}

entry {
    text-color:         #cdd6f4;
    placeholder-color:  rgba(108, 112, 134, 0.70);
}

num-filtered-rows {
    text-color:         rgba(108, 112, 134, 0.60);
}

/* ── Mode buttons: glass pills ────────────────────────────────────────────── */
button {
    background-color:   rgba(49, 50, 68, 0.50);
    border-color:       rgba(69, 71, 90, 0.50);
    text-color:         #a6adc8;
}

button.selected {
    background-color:   rgba(203, 164, 247, 0.85);
    border-color:       rgba(203, 164, 247, 1.0);
    text-color:         #1e1e2e;
}