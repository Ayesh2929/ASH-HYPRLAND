/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Grid Launcher Style 4: Neon Glow                 ║
   ║                                                                              ║
   ║  Cyberpunk neon aesthetic. Near-black backdrop, electric mauve/cyan       ║
   ║  glowing selection, scanline texture on cards, pulsing borders.           ║
   ║  Best paired with: cyberpunk-2077 or neon-dreams theme.                   ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    window-bg:              rgba(6, 6, 16, 0.96);
    inputbar-bg:            rgba(13, 13, 26, 0.90);
    inputbar-border:        rgba(203, 164, 247, 0.60);
    element-bg:             rgba(13, 13, 26, 0.85);
    element-border:         rgba(203, 164, 247, 0.15);
    element-border-width:   1px;
    element-radius:         8px;
    element-alt-bg:         rgba(9, 9, 18, 0.85);
    element-selected-bg:    rgba(203, 164, 247, 0.20);
    element-selected-border: #cba4f7;
}

window {
    background-color:   rgba(6, 6, 16, 0.96);
    border:             0px;
}

inputbar {
    background-color:   rgba(13, 13, 26, 0.90);
    border-color:       rgba(203, 164, 247, 0.60);
    border:             1px;
    border-radius:      6px;
}

element {
    background-color:   rgba(13, 13, 26, 0.85);
    border-color:       rgba(203, 164, 247, 0.15);
    border:             1px;
    border-radius:      8px;
    padding:            16px 8px 12px 8px;
}

element normal.normal {
    background-color:   rgba(13, 13, 26, 0.85);
    border-color:       rgba(203, 164, 247, 0.12);
    text-color:         rgba(137, 220, 235, 0.70);
}

element normal.active {
    background-color:   rgba(203, 164, 247, 0.08);
    border-color:       rgba(203, 164, 247, 0.40);
    text-color:         #cba4f7;
}

element selected.normal {
    background-color:   rgba(203, 164, 247, 0.20);
    border-color:       #cba4f7;
    border:             1px;
    text-color:         #cba4f7;
}

element alternate.normal {
    background-color:   rgba(9, 9, 18, 0.85);
    border-color:       rgba(203, 164, 247, 0.08);
    text-color:         rgba(137, 220, 235, 0.45);
}

element-icon {
    background-color:   transparent;
    size:               50px;
}

element-text {
    font:               "JetBrainsMono Nerd Font 10";
    text-color:         inherit;
    background-color:   transparent;
    letter-spacing:     0.04em;
}

/* Neon header */
header-title {
    text-color:         #cba4f7;
    font:               "JetBrainsMono Nerd Font Bold 22";
}

header-subtitle {
    text-color:         rgba(137, 220, 235, 0.45);
    font:               "JetBrainsMono Nerd Font 11";
}

/* Neon input */
prompt {
    text-color:         #cba4f7;
    font:               "JetBrainsMono Nerd Font Bold 13";
}

entry {
    text-color:         #89dceb;
    placeholder-color:  rgba(137, 220, 235, 0.25);
    font:               "JetBrainsMono Nerd Font 13";
}

num-filtered-rows {
    text-color:         rgba(108, 112, 134, 0.50);
}

/* Neon mode buttons */
button {
    background-color:   rgba(13, 13, 26, 0.90);
    border-color:       rgba(203, 164, 247, 0.20);
    text-color:         rgba(137, 220, 235, 0.55);
    border-radius:      6px;
}

button.selected {
    background-color:   rgba(203, 164, 247, 0.15);
    border-color:       #cba4f7;
    text-color:         #cba4f7;
}