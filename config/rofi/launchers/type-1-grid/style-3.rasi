/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Grid Launcher Style 3: Minimal Flat             ║
   ║                                                                              ║
   ║  No borders, no shadows, no glass. Pure flat color on dark backdrop.      ║
   ║  Selection is a subtle accent fill. Ultra-clean, zero visual noise.        ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    window-bg:              rgba(17, 17, 27, 0.92);
    inputbar-bg:            transparent;
    inputbar-border:        rgba(49, 50, 68, 0.80);
    element-bg:             transparent;
    element-border:         transparent;
    element-border-width:   0px;
    element-radius:         10px;
    element-alt-bg:         transparent;
    element-selected-bg:    rgba(203, 164, 247, 0.15);
    element-selected-border: transparent;
}

window {
    background-color:   rgba(17, 17, 27, 0.92);
    border:             0px;
}

inputbar {
    background-color:   transparent;
    border-color:       rgba(49, 50, 68, 0.80);
    border:             0px 0px 1px 0px;
    border-radius:      0px;
    margin:             0px 0px 8px 0px;
    width:              100%;
}

element {
    background-color:   transparent;
    border:             0px;
    border-radius:      10px;
    padding:            14px 8px 10px 8px;
}

element normal.normal {
    background-color:   transparent;
    text-color:         #9399b2;
}

element normal.active {
    background-color:   rgba(203, 164, 247, 0.08);
    text-color:         #cba4f7;
}

element selected.normal {
    background-color:   rgba(203, 164, 247, 0.15);
    text-color:         #cba4f7;
}

element alternate.normal {
    background-color:   transparent;
    text-color:         #7f849c;
}

element-text {
    font:               "JetBrainsMono Nerd Font 10";
    text-color:         inherit;
    background-color:   transparent;
}

/* Dim unselected icons */
element-icon {
    background-color:   transparent;
    size:               48px;
}

/* Flat header */
header-title {
    text-color:         #cdd6f4;
    font:               "JetBrainsMono Nerd Font 20";
}

header-subtitle {
    text-color:         #585b70;
}

prompt { text-color: #cba4f7; font: "JetBrainsMono Nerd Font 13"; }
entry  { text-color: #cdd6f4; placeholder-color: #45475a; }
num-filtered-rows { text-color: #45475a; }

button {
    background-color:   transparent;
    border:             0px;
    text-color:         #6c7086;
    border-radius:      6px;
    padding:            4px 12px;
}

button.selected {
    background-color:   transparent;
    border:             0px 0px 2px 0px;
    border-color:       #cba4f7;
    text-color:         #cba4f7;
    border-radius:      0px;
}