/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Grid Launcher Style 2: Dark Cards                ║
   ║                                                                              ║
   ║  Opaque dark card grid. Solid surface0 cards with accent border on        ║
   ║  selection. Richer shadows, less transparency, better readability.         ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    window-bg:              #11111b;
    inputbar-bg:            #181825;
    inputbar-border:        #313244;
    element-bg:             #1e1e2e;
    element-border:         #313244;
    element-border-width:   1px;
    element-radius:         12px;
    element-alt-bg:         #181825;
    element-selected-bg:    #cba4f7;
    element-selected-border: #cba4f7;
}

window {
    background-color:   #11111b;
    border:             0px;
    border-radius:      0px;
}

inputbar {
    background-color:   #181825;
    border-color:       #313244;
    border:             2px;
    border-radius:      12px;
}

element {
    background-color:   #1e1e2e;
    border-color:       #313244;
    border:             1px;
    border-radius:      12px;
}

element normal.normal {
    background-color:   #1e1e2e;
    border-color:       #313244;
    text-color:         #cdd6f4;
}

element normal.active {
    background-color:   rgba(203, 164, 247, 0.10);
    border-color:       rgba(203, 164, 247, 0.25);
    text-color:         #cba4f7;
}

element selected.normal {
    background-color:   #cba4f7;
    border-color:       #b4befe;
    border:             2px;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   #181825;
    border-color:       #313244;
    text-color:         #a6adc8;
}

element-text {
    font:               "JetBrainsMono Nerd Font 10";
    text-color:         inherit;
    background-color:   transparent;
}

prompt { text-color: #cba4f7; }
entry  { text-color: #cdd6f4; placeholder-color: #6c7086; }
num-filtered-rows { text-color: #6c7086; }

button {
    background-color:   #1e1e2e;
    border-color:       #313244;
    text-color:         #9399b2;
}

button.selected {
    background-color:   #cba4f7;
    border-color:       #cba4f7;
    text-color:         #1e1e2e;
}