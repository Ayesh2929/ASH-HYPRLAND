/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Center Launcher Style 2: Solid Dark             ║
   ║                                                                              ║
   ║  Fully opaque solid dark surface. Strong contrast, zero transparency.     ║
   ║  Bold accent colors, clean dividers, readable at all brightness levels.   ║
   ║  Best for: bright rooms, accessibility, pure readability focus.            ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    /* ── Window ──────────────────────────────────────────────────────────────── */
    win-width:              640px;
    win-y-offset:           -60px;
    win-bg:                 #1e1e2e;
    win-border:             #cba4f7;
    win-border-width:       2px;
    win-radius:             12px;

    /* ── Input bar ───────────────────────────────────────────────────────────── */
    inputbar-bg:            #181825;
    inputbar-border:        #313244;
    inputbar-border-bottom-width: 2px;
    inputbar-padding-v:     15px;
    inputbar-padding-h:     20px;

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    prompt-fg:              #cba4f7;
    entry-fg:               #cdd6f4;
    muted:                  #6c7086;
    search-placeholder:     "Search applications…";
    accent:                 #cba4f7;
    highlight-match:        #f9e2af;

    /* ── List ────────────────────────────────────────────────────────────────── */
    listview-bg:            transparent;
    list-padding-v:         6px;
    list-item-spacing:      1px;
    list-lines:             10;

    /* ── Elements ────────────────────────────────────────────────────────────── */
    element-radius:         4px;
    element-padding-v:      9px;
    element-padding-h:      16px;
    element-margin-h:       4px;
    element-fg:             #cdd6f4;
    element-alt-bg:         #181825;
    element-alt-fg:         #9399b2;

    /* ── Selected ────────────────────────────────────────────────────────────── */
    element-selected-bg:    #cba4f7;
    element-selected-fg:    #1e1e2e;

    /* ── Icon ────────────────────────────────────────────────────────────────── */
    icon-size:              26px;
    font-element-text:      "JetBrainsMono Nerd Font 12";

    /* ── Mode switcher ───────────────────────────────────────────────────────── */
    mode-bg:                #181825;
    mode-border:            #313244;
    mode-border-width:      2px;
    mode-padding-v:         8px;
    mode-padding-h:         8px;
    mode-spacing:           4px;

    /* ── Buttons ─────────────────────────────────────────────────────────────── */
    btn-bg:                 transparent;
    btn-fg:                 #6c7086;
    btn-border:             transparent;
    btn-border-width:       0px;
    btn-padding-v:          4px;
    btn-padding-h:          14px;
    btn-selected-bg:        #cba4f7;
    btn-selected-fg:        #1e1e2e;
    btn-selected-border:    #cba4f7;
    font-btn:               "JetBrainsMono Nerd Font 11";
    font-prompt:            "JetBrainsMono Nerd Font Bold 14";
    font-input:             "JetBrainsMono Nerd Font 13";
}

window {
    background-color:   #1e1e2e;
    border-color:       #cba4f7;
    border:             2px;
    border-radius:      12px;
}

inputbar {
    background-color:   #181825;
    border-color:       #313244;
}

prompt   { text-color: #cba4f7; }
entry    { text-color: #cdd6f4; placeholder-color: #6c7086; }

element selected.normal {
    background-color:   #cba4f7;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   #181825;
    text-color:         #9399b2;
}

element normal.active {
    background-color:   rgba(203, 164, 247, 0.10);
    text-color:         #cba4f7;
}

element selected.active { background-color: #b4befe; text-color: #1e1e2e; }
element selected.urgent { background-color: #f38ba8; text-color: #1e1e2e; }
element normal.urgent   { background-color: rgba(243,139,168,0.10); text-color: #f38ba8; }

mode-switcher { background-color: #181825; border-color: #313244; }
button { background-color: transparent; text-color: #6c7086; border: 0px; }
button.selected { background-color: #cba4f7; text-color: #1e1e2e; border: 1px; border-color: #cba4f7; }

element-text { highlight: bold #f9e2af; }