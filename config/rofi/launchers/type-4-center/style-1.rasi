/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Center Launcher Style 1: Glassmorphism          ║
   ║                                                                              ║
   ║  Premium frosted glass centered dialog. Semi-transparent mantle            ║
   ║  background with accent-colored border, blur-depth shadow and              ║
   ║  catppuccin mauve selection highlight.                                     ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

/* ══════════════════════════════════════════════════════════════════════════════
   §01  WINDOW GEOMETRY TOKENS
   ══════════════════════════════════════════════════════════════════════════════ */

* {
    /* ── Window ──────────────────────────────────────────────────────────────── */
    win-width:              620px;
    win-y-offset:           -80px;         /* Slightly above center */
    win-bg:                 rgba(24, 24, 37, 0.88);
    win-border:             rgba(203, 164, 247, 0.30);
    win-border-width:       1px;
    win-radius:             16px;

    /* ── Input bar ───────────────────────────────────────────────────────────── */
    inputbar-bg:            rgba(30, 30, 46, 0.55);
    inputbar-border:        rgba(49, 50, 68, 0.80);
    inputbar-border-bottom-width: 1px;
    inputbar-padding-v:     14px;
    inputbar-padding-h:     18px;

    /* ── Prompt & entry colors ────────────────────────────────────────────────── */
    prompt-fg:              @mauve;
    entry-fg:               @text;
    muted:                  rgba(108, 112, 134, 0.65);
    search-placeholder:     "Search applications…";
    accent:                 @mauve;
    highlight-match:        @peach;

    /* ── List view ────────────────────────────────────────────────────────────── */
    listview-bg:            transparent;
    list-padding-v:         8px;
    list-item-spacing:      2px;
    list-lines:             9;

    /* ── Elements ────────────────────────────────────────────────────────────── */
    element-radius:         @radius-sm;
    element-padding-v:      8px;
    element-padding-h:      16px;
    element-margin-h:       6px;
    element-fg:             @text;
    element-alt-bg:         rgba(30, 30, 46, 0.25);
    element-alt-fg:         @subtext0;

    /* ── Selected ────────────────────────────────────────────────────────────── */
    element-selected-bg:    rgba(203, 164, 247, 0.88);
    element-selected-fg:    #1e1e2e;

    /* ── Icon ────────────────────────────────────────────────────────────────── */
    icon-size:              26px;
    font-element-text:      "JetBrainsMono Nerd Font 12";

    /* ── Mode switcher ───────────────────────────────────────────────────────── */
    mode-bg:                rgba(20, 20, 30, 0.60);
    mode-border:            rgba(49, 50, 68, 0.70);
    mode-border-width:      1px;
    mode-padding-v:         7px;
    mode-padding-h:         8px;
    mode-spacing:           4px;

    /* ── Mode buttons ────────────────────────────────────────────────────────── */
    btn-bg:                 transparent;
    btn-fg:                 rgba(109, 112, 134, 0.80);
    btn-border:             transparent;
    btn-border-width:       0px;
    btn-padding-v:          4px;
    btn-padding-h:          14px;
    btn-selected-bg:        rgba(203, 164, 247, 0.85);
    btn-selected-fg:        #1e1e2e;
    btn-selected-border:    rgba(203, 164, 247, 1.0);
    font-btn:               "JetBrainsMono Nerd Font 11";
    font-prompt:            "JetBrainsMono Nerd Font Bold 14";
    font-input:             "JetBrainsMono Nerd Font 13";
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(24, 24, 37, 0.88);
    border-color:       rgba(203, 164, 247, 0.30);
    border:             1px;
    border-radius:      16px;
}

inputbar {
    background-color:   rgba(30, 30, 46, 0.55);
    border-color:       rgba(49, 50, 68, 0.80);
}

/* Selected: accent glass */
element selected.normal {
    background-color:   rgba(203, 164, 247, 0.88);
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.25);
    text-color:         #a6adc8;
}

element normal.active {
    background-color:   rgba(203, 164, 247, 0.10);
    text-color:         #cba4f7;
}

/* Mode switcher */
mode-switcher {
    background-color:   rgba(20, 20, 30, 0.60);
    border-color:       rgba(49, 50, 68, 0.70);
}

button {
    background-color:   transparent;
    text-color:         rgba(109, 112, 134, 0.80);
    border:             0px;
}

button.selected {
    background-color:   rgba(203, 164, 247, 0.85);
    text-color:         #1e1e2e;
    border-color:       rgba(203, 164, 247, 1.0);
    border:             1px;
}

/* Match highlight */
element-text { highlight: bold #fab387; }

/* Active accent */
element selected.active { background-color: #cba4f7; text-color: #1e1e2e; }
element selected.urgent { background-color: #f38ba8; text-color: #1e1e2e; }