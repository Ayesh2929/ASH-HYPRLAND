/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Center Launcher Style 3: Everforest Earth       ║
   ║                                                                              ║
   ║  Warm earthy palette inspired by Everforest. Deep forest green base,      ║
   ║  warm yellow accents, orange selection highlight, natural wood tones.      ║
   ║  Best paired with: everforest-dark theme.                                  ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    /* ── Everforest palette ───────────────────────────────────────────────────── */
    ef-bg0:             #272e33;
    ef-bg1:             #2e383c;
    ef-bg2:             #374145;
    ef-bg3:             #414b50;
    ef-bg4:             #495156;
    ef-bg5:             #4f5b58;
    ef-fg:              #d3c6aa;
    ef-grey0:           #7a8478;
    ef-grey1:           #859289;
    ef-grey2:           #9da9a0;
    ef-red:             #e67e80;
    ef-orange:          #e69875;
    ef-yellow:          #dbbc7f;
    ef-green:           #a7c080;
    ef-teal:            #83c092;
    ef-blue:            #7fbbb3;
    ef-purple:          #d699b6;

    /* ── Window ──────────────────────────────────────────────────────────────── */
    win-width:              630px;
    win-y-offset:           -60px;
    win-bg:                 rgba(39, 46, 51, 0.92);
    win-border:             rgba(167, 192, 128, 0.40);
    win-border-width:       1px;
    win-radius:             14px;

    /* ── Input bar ───────────────────────────────────────────────────────────── */
    inputbar-bg:            rgba(46, 56, 60, 0.70);
    inputbar-border:        rgba(65, 75, 80, 0.80);
    inputbar-border-bottom-width: 1px;
    inputbar-padding-v:     14px;
    inputbar-padding-h:     18px;

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    prompt-fg:              #a7c080;
    entry-fg:               #d3c6aa;
    muted:                  rgba(122, 132, 120, 0.70);
    search-placeholder:     "Search applications…";
    accent:                 #a7c080;
    highlight-match:        #dbbc7f;

    /* ── List ────────────────────────────────────────────────────────────────── */
    listview-bg:            transparent;
    list-padding-v:         8px;
    list-item-spacing:      2px;
    list-lines:             9;

    /* ── Elements ────────────────────────────────────────────────────────────── */
    element-radius:         8px;
    element-padding-v:      8px;
    element-padding-h:      16px;
    element-margin-h:       6px;
    element-fg:             #d3c6aa;
    element-alt-bg:         rgba(46, 56, 60, 0.35);
    element-alt-fg:         #9da9a0;

    /* ── Selected ────────────────────────────────────────────────────────────── */
    element-selected-bg:    rgba(167, 192, 128, 0.85);
    element-selected-fg:    #272e33;

    /* ── Icon ────────────────────────────────────────────────────────────────── */
    icon-size:              26px;
    font-element-text:      "JetBrainsMono Nerd Font 12";

    /* ── Mode switcher ───────────────────────────────────────────────────────── */
    mode-bg:                rgba(39, 46, 51, 0.80);
    mode-border:            rgba(65, 75, 80, 0.70);
    mode-border-width:      1px;
    mode-padding-v:         7px;
    mode-padding-h:         8px;
    mode-spacing:           4px;

    /* ── Buttons ─────────────────────────────────────────────────────────────── */
    btn-bg:                 transparent;
    btn-fg:                 rgba(122, 132, 120, 0.75);
    btn-border:             transparent;
    btn-border-width:       0px;
    btn-padding-v:          4px;
    btn-padding-h:          14px;
    btn-selected-bg:        rgba(167, 192, 128, 0.85);
    btn-selected-fg:        #272e33;
    btn-selected-border:    #a7c080;
    font-btn:               "JetBrainsMono Nerd Font 11";
    font-prompt:            "JetBrainsMono Nerd Font Bold 14";
    font-input:             "JetBrainsMono Nerd Font 13";
}

/* ── Applied styles ───────────────────────────────────────────────────────── */
window {
    background-color:   rgba(39, 46, 51, 0.92);
    border-color:       rgba(167, 192, 128, 0.40);
    border:             1px;
    border-radius:      14px;
}

inputbar {
    background-color:   rgba(46, 56, 60, 0.70);
    border-color:       rgba(65, 75, 80, 0.80);
}

prompt   { text-color: #a7c080; }
textbox-prompt-colon { text-color: rgba(122, 132, 120, 0.55); }
entry    { text-color: #d3c6aa; placeholder-color: rgba(122,132,120,0.60); }
num-filtered-rows { text-color: rgba(122, 132, 120, 0.50); }
case-indicator { text-color: #a7c080; }

element selected.normal {
    background-color:   rgba(167, 192, 128, 0.85);
    text-color:         #272e33;
}

element selected.active {
    background-color:   #83c092;
    text-color:         #272e33;
}

element selected.urgent {
    background-color:   #e67e80;
    text-color:         #272e33;
}

element normal.normal { text-color: #d3c6aa; }
element normal.active { background-color: rgba(167,192,128,0.10); text-color: #a7c080; }
element normal.urgent { background-color: rgba(230,126,128,0.10); text-color: #e67e80; }

element alternate.normal {
    background-color:   rgba(46, 56, 60, 0.35);
    text-color:         #9da9a0;
}

mode-switcher { background-color: rgba(39, 46, 51, 0.80); border-color: rgba(65, 75, 80, 0.70); }
button { background-color: transparent; text-color: rgba(122, 132, 120, 0.75); border: 0px; }
button.selected { background-color: rgba(167,192,128,0.85); text-color: #272e33; border: 1px; border-color: #a7c080; }

/* Everforest warm gold match highlight */
element-text { highlight: bold #dbbc7f; }