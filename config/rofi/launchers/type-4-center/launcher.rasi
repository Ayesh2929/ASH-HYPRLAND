/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Launcher Type-4: Center (Spotlight Style)        ║
   ║                                                                              ║
   ║  Compact centered dialog. Single-column result list below a prominent     ║
   ║  search bar. Clean, distraction-free, keyboard-optimized workflow.        ║
   ║  Inspired by: macOS Spotlight, Alfred, Raycast, KRunner.                  ║
   ║                                                                              ║
   ║  Layout:                                                                     ║
   ║         ╔══════════════════════════════════════════╗                        ║
   ║         ║  󰍜 › Search applications…         12/∞  ║  ← inputbar            ║
   ║         ╠══════════════════════════════════════════╣                        ║
   ║         ║  󰨞  Visual Studio Code             Dev  ║  ← element             ║
   ║         ║ ▶ 󰈹  Firefox                      Web  ║  ← selected            ║
   ║         ║  󰆍  Kitty                      Terminal  ║                        ║
   ║         ║  󱁉  Thunar                        Files  ║                        ║
   ║         ║  󰝚  Spotify                       Media  ║                        ║
   ║         ╠══════════════════════════════════════════╣                        ║
   ║         ║  Apps │ Run │ Windows │ SSH               ║  ← mode-switcher      ║
   ║         ╚══════════════════════════════════════════╝                        ║
   ║                                                                              ║
   ║  Usage:                                                                      ║
   ║    rofi -show drun -config ~/.config/rofi/launchers/type-4-center/launcher.rasi ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

@import "../../colors.rasi"
@import "../../fonts.rasi"

/* ── Active style ────────────────────────────────────────────────────────────── */
@import "style-1.rasi"

/* ══════════════════════════════════════════════════════════════════════════════
   §01  CONFIGURATION
   ══════════════════════════════════════════════════════════════════════════════ */

configuration {
    modes:                          "drun,run,window,ssh,filebrowser";
    show-icons:                     true;
    icon-theme:                     "Papirus-Dark";
    font:                           "JetBrainsMono Nerd Font 12";

    drun-match-fields:              "name,generic,exec,categories,keywords";
    drun-display-format:            "{name}";
    drun-show-actions:              false;
    drun-url-launcher:              "xdg-open";

    case-sensitive:                 false;
    matching:                       "fuzzy";
    sort:                           true;
    sorting-method:                 "fzf";
    normalize-match:                true;
    tokenize:                       true;

    disable-history:                false;
    max-history-size:               20;

    click-to-exit:                  true;
    steal-focus:                    false;
    auto-select:                    false;

    scroll-method:                  0;

    display-drun:                   " Apps";
    display-run:                    "󰨡 Run";
    display-window:                 "󰖯 Windows";
    display-ssh:                    "󰢹 SSH";
    display-filebrowser:            "󱁉 Files";
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  WINDOW — COMPACT CENTERED DIALOG
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    width:              @win-width;
    height:             0px;        /* Auto-size based on content */
    x-offset:           0px;
    y-offset:           @win-y-offset;
    location:           center;
    anchor:             center;
    fullscreen:         false;

    background-color:   @win-bg;
    border-color:       @win-border;
    border:             @win-border-width;
    border-radius:      @win-radius;

    padding:            0px;
    cursor:             "default";
}

/* ══════════════════════════════════════════════════════════════════════════════
   §03  MAIN BOX
   ══════════════════════════════════════════════════════════════════════════════ */

mainbox {
    background-color:   transparent;
    border:             0px;
    padding:            0px;
    spacing:            0px;
    orientation:        vertical;
    children:           [inputbar, listview, message, mode-switcher];
}

/* ══════════════════════════════════════════════════════════════════════════════
   §04  INPUT BAR — PRIMARY SEARCH ENTRY
   ══════════════════════════════════════════════════════════════════════════════ */

inputbar {
    background-color:   @inputbar-bg;
    border-color:       @inputbar-border;
    border:             0px 0px @inputbar-border-bottom-width 0px;
    border-radius:      @win-radius @win-radius 0px 0px;
    padding:            @inputbar-padding-v @inputbar-padding-h;
    spacing:            10px;
    expand:             false;
    children:           [prompt, textbox-prompt-colon, entry, num-filtered-rows, case-indicator];
}

prompt {
    background-color:   transparent;
    text-color:         @prompt-fg;
    font:               @font-prompt;
    expand:             false;
}

textbox-prompt-colon {
    background-color:   transparent;
    text-color:         @muted;
    str:                "›";
    expand:             false;
    font:               "JetBrainsMono Nerd Font Bold 14";
}

entry {
    background-color:   transparent;
    text-color:         @entry-fg;
    placeholder-color:  @placeholder-fg;
    placeholder:        @search-placeholder;
    font:               @font-input;
    cursor:             text;
    expand:             true;
    blink:              true;
}

num-filtered-rows {
    background-color:   transparent;
    text-color:         @muted;
    font:               "JetBrainsMono Nerd Font 10";
    expand:             false;
}

case-indicator {
    background-color:   transparent;
    text-color:         @accent;
    font:               "JetBrainsMono Nerd Font 10";
    expand:             false;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §05  LIST VIEW — SINGLE COLUMN RESULTS
   ══════════════════════════════════════════════════════════════════════════════ */

listview {
    background-color:   @listview-bg;
    border:             0px;
    padding:            @list-padding-v 0px;
    margin:             0px;
    spacing:            @list-item-spacing;
    columns:            1;
    lines:              @list-lines;
    fixed-height:       false;
    dynamic:            true;
    layout:             vertical;
    flow:               vertical;
    cycle:              true;
    scrollbar:          false;
    expand:             false;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §06  LIST ELEMENTS
   ══════════════════════════════════════════════════════════════════════════════ */

element {
    background-color:   transparent;
    border:             0px;
    border-radius:      @element-radius;
    padding:            @element-padding-v @element-padding-h;
    margin:             0px @element-margin-h;
    spacing:            12px;
    orientation:        horizontal;
    cursor:             pointer;
}

/* ── Normal states ────────────────────────────────────────────────────────── */
element normal.normal {
    background-color:   transparent;
    text-color:         @element-fg;
}

element normal.active {
    background-color:   @active-bg;
    text-color:         @active-fg;
}

element normal.urgent {
    background-color:   rgba(243, 139, 168, 0.10);
    text-color:         @red;
}

/* ── Selected states ─────────────────────────────────────────────────────── */
element selected.normal {
    background-color:   @element-selected-bg;
    text-color:         @element-selected-fg;
}

element selected.active {
    background-color:   @accent;
    text-color:         @base;
}

element selected.urgent {
    background-color:   @red;
    text-color:         @base;
}

/* ── Alternate rows ───────────────────────────────────────────────────────── */
element alternate.normal {
    background-color:   @element-alt-bg;
    text-color:         @element-alt-fg;
}

element alternate.active {
    background-color:   rgba(203, 164, 247, 0.06);
    text-color:         @accent;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §07  ELEMENT ICON & TEXT
   ══════════════════════════════════════════════════════════════════════════════ */

element-icon {
    background-color:   transparent;
    size:               @icon-size;
    padding:            0px;
    cursor:             inherit;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    font:               @font-element-text;
    cursor:             inherit;
    expand:             true;
    vertical-align:     0.5;
    highlight:          bold @highlight-match;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §08  MODE SWITCHER — BOTTOM TAB BAR
   ══════════════════════════════════════════════════════════════════════════════ */

mode-switcher {
    background-color:   @mode-bg;
    border-color:       @mode-border;
    border:             @mode-border-width 0px 0px 0px;
    border-radius:      0px 0px @win-radius @win-radius;
    padding:            @mode-padding-v @mode-padding-h;
    spacing:            @mode-spacing;
    orientation:        horizontal;
    expand:             false;
}

button {
    background-color:   @btn-bg;
    text-color:         @btn-fg;
    border:             @btn-border-width;
    border-color:       @btn-border;
    border-radius:      @radius-pill;
    padding:            @btn-padding-v @btn-padding-h;
    font:               @font-btn;
    cursor:             pointer;
    expand:             false;
}

button.selected {
    background-color:   @btn-selected-bg;
    text-color:         @btn-selected-fg;
    border-color:       @btn-selected-border;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §09  MESSAGE BAR
   ══════════════════════════════════════════════════════════════════════════════ */

message {
    background-color:   @message-bg;
    border:             @border-thin;
    border-color:       @surface1;
    border-radius:      @radius-sm;
    padding:            6px 16px;
    margin:             0px @element-margin-h @list-padding-v @element-margin-h;
    expand:             false;
}

textbox {
    background-color:   transparent;
    text-color:         @subtext0;
    font:               "JetBrainsMono Nerd Font 11";
    highlight:          none;
    markup:             true;
}

error-message {
    background-color:   rgba(243, 139, 168, 0.10);
    border:             @border-thin;
    border-color:       @red;
    border-radius:      @radius-sm;
    padding:            6px 16px;
    margin:             0px @element-margin-h @list-padding-v @element-margin-h;
}