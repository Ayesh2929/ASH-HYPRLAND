/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Runner Launcher Style 1: Prismatic               ║
   ║                                                                              ║
   ║  Three sub-themes via token configuration:                                  ║
   ║                                                                              ║
   ║  Theme A — Mauve Glass (Catppuccin Mocha — default)                        ║
   ║  Theme B — Sapphire Depth (cool blue premium)                              ║
   ║  Theme C — Emerald Forest (everforest-inspired)                            ║
   ║                                                                              ║
   ║  Active: Theme A — Mauve Glass                                             ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

/* ══════════════════════════════════════════════════════════════════════════════
   §01  THEME A — MAUVE GLASS (ACTIVE)
   ══════════════════════════════════════════════════════════════════════════════ */

* {
    /* ── Window geometry ──────────────────────────────────────────────────────── */
    rn-width:                   660px;
    rn-y-offset:                -60px;

    /* ── Window surface ───────────────────────────────────────────────────────── */
    rn-win-bg:                  rgba(17, 17, 27, 0.94);
    rn-win-border:              rgba(203, 164, 247, 0.32);
    rn-win-border-width:        1px;
    rn-win-radius:              18px;

    /* ── Hero bar ─────────────────────────────────────────────────────────────── */
    rn-hero-bg:                 rgba(20, 20, 32, 0.70);
    rn-hero-border:             rgba(49, 50, 68, 0.80);
    rn-hero-border-width:       1px;

    /* ── Input bar ────────────────────────────────────────────────────────────── */
    rn-inputbar-bg:             rgba(30, 30, 46, 0.60);
    rn-inputbar-border:         rgba(49, 50, 68, 0.90);
    rn-inputbar-border-width:   1px;

    /* ── Prompt style ─────────────────────────────────────────────────────────── */
    rn-prompt-fg:               #cba4f7;
    rn-sep-color:               rgba(108, 112, 134, 0.45);

    /* ── Entry / text ─────────────────────────────────────────────────────────── */
    rn-entry-fg:                #cdd6f4;
    rn-placeholder:             rgba(108, 112, 134, 0.55);
    rn-text:                    #cdd6f4;
    rn-subtext:                 #a6adc8;
    rn-muted:                   rgba(108, 112, 134, 0.55);
    rn-accent:                  #cba4f7;
    rn-highlight:               #fab387;

    /* ── Count badge ──────────────────────────────────────────────────────────── */
    rn-count-bg:                rgba(203, 164, 247, 0.12);
    rn-count-fg:                #cba4f7;
    rn-count-border:            rgba(203, 164, 247, 0.25);

    /* ── Category bar ─────────────────────────────────────────────────────────── */
    rn-category-bg:             rgba(22, 22, 34, 0.55);
    rn-category-border:         rgba(49, 50, 68, 0.80);
    rn-category-border-width:   1px;

    /* ── Mode buttons ─────────────────────────────────────────────────────────── */
    rn-btn-bg:                  transparent;
    rn-btn-fg:                  rgba(108, 112, 134, 0.75);
    rn-btn-border:              transparent;
    rn-btn-border-width:        0px;
    rn-btn-radius:              @radius-sm;
    rn-btn-selected-bg:         rgba(203, 164, 247, 0.85);
    rn-btn-selected-fg:         #1e1e2e;
    rn-btn-selected-border:     rgba(203, 164, 247, 1.0);

    /* ── List view ────────────────────────────────────────────────────────────── */
    rn-listview-bg:             transparent;
    rn-list-lines:              9;

    /* ── Elements ─────────────────────────────────────────────────────────────── */
    rn-element-radius:          @radius-sm;
    rn-element-padding-v:       8px;
    rn-element-padding-h:       16px;
    rn-element-margin-h:        6px;
    rn-element-fg:              #cdd6f4;
    rn-active-bg:               rgba(203, 164, 247, 0.10);
    rn-selected-bg:             rgba(203, 164, 247, 0.88);
    rn-selected-fg:             #1e1e2e;
    rn-alt-bg:                  rgba(30, 30, 46, 0.28);
    rn-alt-fg:                  #9399b2;

    /* ── Icon ─────────────────────────────────────────────────────────────────── */
    rn-icon-size:               24px;

    /* ── Action bar ───────────────────────────────────────────────────────────── */
    rn-action-bg:               rgba(18, 18, 28, 0.65);
    rn-action-border:           rgba(49, 50, 68, 0.75);
    rn-action-border-width:     1px;
    rn-action-fg:               rgba(108, 112, 134, 0.65);
    rn-action-accent:           rgba(203, 164, 247, 0.50);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED WINDOW & SECTION STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(17, 17, 27, 0.94);
    border-color:       rgba(203, 164, 247, 0.32);
    border:             1px;
    border-radius:      18px;
}

/* ── Hero section ─────────────────────────────────────────────────────────── */
hero-section {
    background-color:   rgba(20, 20, 32, 0.70);
    border-color:       rgba(49, 50, 68, 0.80);
}

hero-icon   { text-color: #cba4f7; }
hero-label  { text-color: #cdd6f4; }
hero-shortcuts { text-color: rgba(88, 91, 112, 0.55); }

/* ── Input bar ────────────────────────────────────────────────────────────── */
inputbar {
    background-color:   rgba(30, 30, 46, 0.60);
    border-color:       rgba(49, 50, 68, 0.90);
}

prompt          { text-color: #cba4f7; }
textbox-prompt-sep { text-color: rgba(108, 112, 134, 0.40); }
entry           { text-color: #cdd6f4; placeholder-color: rgba(108, 112, 134, 0.55); }
num-filtered-rows {
    background-color:   rgba(203, 164, 247, 0.12);
    text-color:         #cba4f7;
    border-color:       rgba(203, 164, 247, 0.25);
}
case-indicator  { text-color: #cba4f7; }

/* ── Category bar ─────────────────────────────────────────────────────────── */
category-bar {
    background-color:   rgba(22, 22, 34, 0.55);
    border-color:       rgba(49, 50, 68, 0.80);
}

category-hint { text-color: rgba(88, 91, 112, 0.50); }

/* Mode buttons */
button {
    background-color:   transparent;
    text-color:         rgba(108, 112, 134, 0.75);
    border:             0px;
}

button.selected {
    background-color:   rgba(203, 164, 247, 0.85);
    text-color:         #1e1e2e;
    border:             1px;
    border-color:       rgba(203, 164, 247, 1.0);
    border-radius:      6px;
}

/* ── List elements ────────────────────────────────────────────────────────── */
element normal.normal  { background-color: transparent; text-color: #cdd6f4; }
element normal.active  { background-color: rgba(203,164,247,0.10); text-color: #cba4f7; }
element normal.urgent  { background-color: rgba(243,139,168,0.10); text-color: #f38ba8; }

element selected.normal {
    background-color:   rgba(203, 164, 247, 0.88);
    text-color:         #1e1e2e;
}

element selected.active {
    background-color:   #cba4f7;
    text-color:         #1e1e2e;
}

element selected.urgent {
    background-color:   #f38ba8;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.28);
    text-color:         #9399b2;
}

element-text { highlight: bold #fab387; }

/* ── Action bar ───────────────────────────────────────────────────────────── */
action-bar {
    background-color:   rgba(18, 18, 28, 0.65);
    border-color:       rgba(49, 50, 68, 0.75);
}

action-launch,
action-terminal,
action-copy   { text-color: rgba(108, 112, 134, 0.60); }

action-result-count { text-color: rgba(203, 164, 247, 0.45); }

