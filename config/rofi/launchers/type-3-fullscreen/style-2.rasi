/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Fullscreen Launcher Style 2: Neon Cyberpunk      ║
   ║                                                                              ║
   ║  Near-void black backdrop. Electric neon mauve/cyan glowing accents.      ║
   ║  Card borders pulse with neon light. Selected state has full neon glow.   ║
   ║  Best paired with: cyberpunk-2077, neon-dreams or matrix-green themes.    ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

/* ══════════════════════════════════════════════════════════════════════════════
   §01  DESIGN TOKENS — STYLE 2 NEON
   ══════════════════════════════════════════════════════════════════════════════ */

* {
    /* ── Neon palette ──────────────────────────────────────────────────────────── */
    neon-purple:        #cba4f7;
    neon-cyan:          #89dceb;
    neon-green:         #a6e3a1;
    neon-pink:          #f5c2e7;
    neon-yellow:        #f9e2af;
    neon-red:           #f38ba8;
    void-black:         rgba(4, 4, 10, 0.97);
    card-black:         rgba(10, 10, 20, 0.90);
    card-black-alt:     rgba(7, 7, 15, 0.88);

    /* ── Window ───────────────────────────────────────────────────────────────── */
    fs-window-bg:               rgba(4, 4, 10, 0.97);

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    fs-text:                    rgba(137, 220, 235, 0.85);
    fs-subtext:                 rgba(137, 220, 235, 0.50);
    fs-muted:                   rgba(137, 220, 235, 0.30);
    fs-hint:                    rgba(108, 112, 134, 0.45);
    fs-alt-text:                rgba(108, 116, 134, 0.55);

    /* ── Accent ───────────────────────────────────────────────────────────────── */
    fs-accent:                  #cba4f7;

    /* ── Input bar ────────────────────────────────────────────────────────────── */
    fs-inputbar-bg:             rgba(10, 10, 20, 0.80);
    fs-inputbar-border:         rgba(203, 164, 247, 0.70);
    fs-inputbar-border-width:   1px;

    /* ── Category buttons ─────────────────────────────────────────────────────── */
    fs-btn-bg:                  rgba(10, 10, 20, 0.85);
    fs-btn-fg:                  rgba(137, 220, 235, 0.50);
    fs-btn-border:              rgba(203, 164, 247, 0.20);
    fs-btn-border-width:        1px;
    fs-btn-selected-bg:         rgba(203, 164, 247, 0.18);
    fs-btn-selected-fg:         #cba4f7;
    fs-btn-selected-border:     #cba4f7;

    /* ── Divider ──────────────────────────────────────────────────────────────── */
    fs-divider:                 rgba(203, 164, 247, 0.15);

    /* ── Element card ─────────────────────────────────────────────────────────── */
    fs-element-bg:              rgba(10, 10, 20, 0.88);
    fs-element-border:          rgba(203, 164, 247, 0.12);
    fs-element-border-width:    1px;
    fs-element-radius:          8px;

    /* ── Element active ───────────────────────────────────────────────────────── */
    fs-element-active-bg:       rgba(203, 164, 247, 0.08);
    fs-element-active-border:   rgba(203, 164, 247, 0.45);

    /* ── Element alternate ────────────────────────────────────────────────────── */
    fs-element-alt-bg:          rgba(7, 7, 14, 0.88);

    /* ── Element selected ─────────────────────────────────────────────────────── */
    fs-element-selected-bg:     rgba(203, 164, 247, 0.20);
    fs-element-selected-fg:     #cba4f7;
    fs-element-selected-border: #cba4f7;
    fs-element-selected-border-width: 1px;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  WINDOW — VOID BACKDROP
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(4, 4, 10, 0.97);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §03  HERO — NEON BRANDING
   ══════════════════════════════════════════════════════════════════════════════ */

hero-icon {
    text-color:         #cba4f7;
    font:               "JetBrainsMono Nerd Font 56";
}

hero-title {
    text-color:         #cba4f7;
    font:               "JetBrainsMono Nerd Font Bold 26";
}

hero-subtitle {
    text-color:         rgba(137, 220, 235, 0.45);
    font:               "JetBrainsMono Nerd Font 13";
    letter-spacing:     0.06em;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §04  INPUT BAR — NEON BORDERED
   ══════════════════════════════════════════════════════════════════════════════ */

inputbar {
    background-color:   rgba(10, 10, 20, 0.80);
    border-color:       rgba(203, 164, 247, 0.70);
    border:             1px;
    border-radius:      8px;
}

prompt {
    text-color:         #cba4f7;
    font:               "JetBrainsMono Nerd Font Bold 14";
}

textbox-prompt-colon {
    text-color:         rgba(203, 164, 247, 0.35);
}

entry {
    text-color:         #89dceb;
    placeholder-color:  rgba(137, 220, 235, 0.25);
    font:               "JetBrainsMono Nerd Font 14";
    letter-spacing:     0.03em;
}

num-filtered-rows {
    text-color:         rgba(88, 91, 112, 0.50);
}

case-indicator { text-color: #cba4f7; }

/* ══════════════════════════════════════════════════════════════════════════════
   §05  CATEGORY STRIP — NEON PILLS
   ══════════════════════════════════════════════════════════════════════════════ */

button {
    background-color:   rgba(10, 10, 20, 0.85);
    text-color:         rgba(137, 220, 235, 0.50);
    border-color:       rgba(203, 164, 247, 0.20);
    border:             1px;
    border-radius:      6px;
    letter-spacing:     0.04em;
}

button.selected {
    background-color:   rgba(203, 164, 247, 0.18);
    text-color:         #cba4f7;
    border-color:       #cba4f7;
    border:             1px;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §06  DIVIDER — NEON LINE
   ══════════════════════════════════════════════════════════════════════════════ */

divider {
    background-color:   rgba(203, 164, 247, 0.15);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §07  ELEMENT CARDS — NEON DARK
   ══════════════════════════════════════════════════════════════════════════════ */

element {
    background-color:   rgba(10, 10, 20, 0.88);
    border-color:       rgba(203, 164, 247, 0.12);
    border:             1px;
    border-radius:      8px;
    padding:            16px 8px 12px 8px;
}

element normal.normal {
    background-color:   rgba(10, 10, 20, 0.88);
    text-color:         rgba(137, 220, 235, 0.70);
    border-color:       rgba(203, 164, 247, 0.12);
}

element normal.active {
    background-color:   rgba(203, 164, 247, 0.08);
    text-color:         #cba4f7;
    border-color:       rgba(203, 164, 247, 0.45);
}

element normal.urgent {
    background-color:   rgba(243, 139, 168, 0.08);
    text-color:         #f38ba8;
    border-color:       rgba(243, 139, 168, 0.40);
}

element selected.normal {
    /* Neon selection: glowing card */
    background-color:   rgba(203, 164, 247, 0.20);
    text-color:         #cba4f7;
    border-color:       #cba4f7;
    border:             1px;
}

element selected.active {
    background-color:   rgba(203, 164, 247, 0.30);
    text-color:         #cba4f7;
    border-color:       #cba4f7;
    border:             2px;
}

element selected.urgent {
    background-color:   rgba(243, 139, 168, 0.20);
    text-color:         #f38ba8;
    border-color:       #f38ba8;
    border:             1px;
}

element alternate.normal {
    background-color:   rgba(7, 7, 14, 0.88);
    text-color:         rgba(108, 116, 134, 0.55);
    border-color:       rgba(203, 164, 247, 0.06);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §08  ELEMENT INTERNALS — NEON GLOW TEXT
   ══════════════════════════════════════════════════════════════════════════════ */

element-icon {
    size:               52px;
    background-color:   transparent;
}

element-text {
    font:               "JetBrainsMono Nerd Font 10";
    text-color:         inherit;
    highlight:          bold #f9e2af;
    letter-spacing:     0.03em;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §09  FOOTER HINTS — NEON SUBTLE
   ══════════════════════════════════════════════════════════════════════════════ */

hint-escape,
hint-enter,
hint-tab,
hint-mode {
    text-color:         rgba(203, 164, 247, 0.25);
    font:               "JetBrainsMono Nerd Font 11";
    letter-spacing:     0.04em;
}