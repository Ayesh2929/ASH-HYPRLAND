/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Fullscreen Launcher Style 1: Deep Glass          ║
   ║                                                                              ║
   ║  Deeply blurred near-black translucent backdrop. Frosted glass cards      ║
   ║  with subtle inner highlight, accent glow on selected item.               ║
   ║  The definitive glassmorphism fullscreen launcher.                         ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

/* ══════════════════════════════════════════════════════════════════════════════
   §01  DESIGN TOKENS — STYLE 1
   ══════════════════════════════════════════════════════════════════════════════ */

* {
    /* ── Window backdrop ──────────────────────────────────────────────────────── */
    fs-window-bg:               rgba(11, 11, 22, 0.88);

    /* ── Text hierarchy ───────────────────────────────────────────────────────── */
    fs-text:                    #cdd6f4;
    fs-subtext:                 rgba(163, 173, 200, 0.75);
    fs-muted:                   rgba(108, 112, 134, 0.65);
    fs-hint:                    rgba(88, 91, 112, 0.70);
    fs-alt-text:                rgba(147, 153, 178, 0.70);

    /* ── Accent ───────────────────────────────────────────────────────────────── */
    fs-accent:                  #cba4f7;

    /* ── Input bar ────────────────────────────────────────────────────────────── */
    fs-inputbar-bg:             rgba(30, 30, 46, 0.60);
    fs-inputbar-border:         rgba(203, 164, 247, 0.35);
    fs-inputbar-border-width:   2px;

    /* ── Category strip buttons ───────────────────────────────────────────────── */
    fs-btn-bg:                  rgba(49, 50, 68, 0.45);
    fs-btn-fg:                  rgba(147, 153, 178, 0.80);
    fs-btn-border:              rgba(69, 71, 90, 0.40);
    fs-btn-border-width:        1px;
    fs-btn-selected-bg:         rgba(203, 164, 247, 0.85);
    fs-btn-selected-fg:         #1e1e2e;
    fs-btn-selected-border:     rgba(203, 164, 247, 1.0);

    /* ── Divider ──────────────────────────────────────────────────────────────── */
    fs-divider:                 rgba(49, 50, 68, 0.60);

    /* ── Element card defaults ────────────────────────────────────────────────── */
    fs-element-bg:              rgba(30, 30, 46, 0.38);
    fs-element-border:          rgba(255, 255, 255, 0.06);
    fs-element-border-width:    1px;
    fs-element-radius:          16px;

    /* ── Element active (pinned/running) ─────────────────────────────────────── */
    fs-element-active-bg:       rgba(203, 164, 247, 0.10);
    fs-element-active-border:   rgba(203, 164, 247, 0.30);

    /* ── Element alternate rows ───────────────────────────────────────────────── */
    fs-element-alt-bg:          rgba(24, 24, 37, 0.28);

    /* ── Element selected ─────────────────────────────────────────────────────── */
    fs-element-selected-bg:     rgba(203, 164, 247, 0.85);
    fs-element-selected-fg:     #1e1e2e;
    fs-element-selected-border: rgba(203, 164, 247, 1.0);
    fs-element-selected-border-width: 2px;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  WINDOW — DEEP BLUR BACKDROP
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(11, 11, 22, 0.88);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §03  HERO — BRANDING
   ══════════════════════════════════════════════════════════════════════════════ */

hero-icon {
    text-color:         #cba4f7;
}

hero-title {
    text-color:         #cdd6f4;
    font:               "JetBrainsMono Nerd Font Bold 26";
}

hero-subtitle {
    text-color:         rgba(163, 173, 200, 0.65);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §04  INPUT BAR — GLASS PILL
   ══════════════════════════════════════════════════════════════════════════════ */

inputbar {
    background-color:   rgba(30, 30, 46, 0.60);
    border-color:       rgba(203, 164, 247, 0.35);
    border:             2px;
    /* Inner top highlight for glass depth */
}

prompt   { text-color: #cba4f7; }
entry    { text-color: #cdd6f4; placeholder-color: rgba(108, 112, 134, 0.55); }
num-filtered-rows { text-color: rgba(88, 91, 112, 0.60); }
case-indicator { text-color: #cba4f7; }

/* ══════════════════════════════════════════════════════════════════════════════
   §05  CATEGORY STRIP BUTTONS
   ══════════════════════════════════════════════════════════════════════════════ */

button {
    background-color:   rgba(49, 50, 68, 0.45);
    text-color:         rgba(147, 153, 178, 0.80);
    border-color:       rgba(69, 71, 90, 0.40);
    border:             1px;
}

button.selected {
    background-color:   rgba(203, 164, 247, 0.85);
    text-color:         #1e1e2e;
    border-color:       rgba(203, 164, 247, 1.0);
    border:             1px;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §06  DIVIDER
   ══════════════════════════════════════════════════════════════════════════════ */

divider {
    background-color:   rgba(49, 50, 68, 0.60);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §07  ELEMENT CARDS — FROSTED GLASS
   ══════════════════════════════════════════════════════════════════════════════ */

element {
    background-color:   rgba(30, 30, 46, 0.38);
    border-color:       rgba(255, 255, 255, 0.06);
    border:             1px;
    border-radius:      16px;
}

element normal.normal {
    background-color:   rgba(30, 30, 46, 0.38);
    text-color:         #cdd6f4;
    border-color:       rgba(255, 255, 255, 0.06);
}

element normal.active {
    background-color:   rgba(203, 164, 247, 0.10);
    text-color:         #cba4f7;
    border-color:       rgba(203, 164, 247, 0.30);
}

element normal.urgent {
    background-color:   rgba(243, 139, 168, 0.10);
    text-color:         #f38ba8;
    border-color:       rgba(243, 139, 168, 0.25);
}

element selected.normal {
    /* Selected: vivid accent glass with glow */
    background-color:   rgba(203, 164, 247, 0.85);
    text-color:         #1e1e2e;
    border-color:       rgba(203, 164, 247, 1.0);
    border:             2px;
}

element selected.active {
    background-color:   #cba4f7;
    text-color:         #1e1e2e;
    border-color:       #b4befe;
    border:             2px;
}

element selected.urgent {
    background-color:   #f38ba8;
    text-color:         #1e1e2e;
    border-color:       #eba0ac;
}

element alternate.normal {
    background-color:   rgba(24, 24, 37, 0.28);
    text-color:         rgba(147, 153, 178, 0.70);
    border-color:       rgba(255, 255, 255, 0.04);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §08  ELEMENT INTERNALS
   ══════════════════════════════════════════════════════════════════════════════ */

element-icon {
    size:               54px;
}

element-text {
    font:               "JetBrainsMono Nerd Font 10";
    text-color:         inherit;
    /* Fuzzy match highlighting */
    highlight:          bold #fab387;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §09  FOOTER HINTS
   ══════════════════════════════════════════════════════════════════════════════ */

hint-escape,
hint-enter,
hint-tab,
hint-mode {
    text-color:         rgba(88, 91, 112, 0.65);
}