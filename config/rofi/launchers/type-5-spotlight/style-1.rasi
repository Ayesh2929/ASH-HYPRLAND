/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Spotlight Launcher Style 1: Prismatic Glass      ║
   ║                                                                              ║
   ║  Ultra-premium dual-panel spotlight with deep frosted glass surfaces,      ║
   ║  gradient accent borders, multi-layer depth via opacity stacking,          ║
   ║  catppuccin mauve primary accent and sapphire preview panel accent.        ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

/* ══════════════════════════════════════════════════════════════════════════════
   §01  COMPLETE DESIGN TOKEN SYSTEM — STYLE 1
   ══════════════════════════════════════════════════════════════════════════════ */

* {

    /* ── Window geometry ──────────────────────────────────────────────────────── */
    sp-width:               860px;
    sp-height:              560px;
    sp-y-offset:            -60px;

    /* ── Window surface ───────────────────────────────────────────────────────── */
    sp-win-bg:              rgba(17, 17, 27, 0.92);
    sp-win-border:          rgba(203, 164, 247, 0.28);
    sp-win-border-width:    1px;
    sp-win-radius:          18px;

    /* ── Input bar ────────────────────────────────────────────────────────────── */
    sp-inputbar-bg:         rgba(30, 30, 46, 0.65);
    sp-inputbar-border:     rgba(49, 50, 68, 0.90);
    sp-inputbar-border-width: 1px;

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    sp-text:                #cdd6f4;
    sp-subtext:             #a6adc8;
    sp-placeholder:         rgba(108, 112, 134, 0.60);
    sp-muted:               rgba(108, 112, 134, 0.55);
    sp-accent:              #cba4f7;
    sp-highlight:           #fab387;
    sp-category-fg:         rgba(108, 112, 134, 0.70);

    /* ── Left panel ───────────────────────────────────────────────────────────── */
    sp-left-width:          320px;
    sp-left-bg:             transparent;
    sp-left-footer-bg:      rgba(20, 20, 30, 0.50);
    sp-left-footer-border:  1px;
    sp-left-footer-border-color: rgba(49, 50, 68, 0.70);

    /* ── List view ────────────────────────────────────────────────────────────── */
    sp-list-lines:          10;

    /* ── Elements ─────────────────────────────────────────────────────────────── */
    sp-element-radius:      8px;
    sp-element-padding-v:   8px;
    sp-element-padding-h:   14px;
    sp-element-fg:          #cdd6f4;
    sp-element-alt-bg:      rgba(30, 30, 46, 0.22);
    sp-element-alt-fg:      #9399b2;
    sp-element-active-bg:   rgba(203, 164, 247, 0.10);
    sp-element-selected-bg: rgba(203, 164, 247, 0.88);
    sp-element-selected-fg: #1e1e2e;

    /* ── Icon ─────────────────────────────────────────────────────────────────── */
    sp-icon-size:           26px;

    /* ── Panel divider ────────────────────────────────────────────────────────── */
    sp-divider:             rgba(49, 50, 68, 0.70);

    /* ── Right preview panel ──────────────────────────────────────────────────── */
    sp-right-bg:            rgba(24, 24, 37, 0.50);

    /* Preview text */
    sp-preview-title:       #cdd6f4;
    sp-preview-text:        #a6adc8;
    sp-preview-muted:       rgba(108, 112, 134, 0.60);

    /* Preview icon */
    sp-preview-icon-bg:     rgba(49, 50, 68, 0.45);
    sp-preview-icon-border: rgba(69, 71, 90, 0.50);

    /* Preview info box */
    sp-preview-info-bg:     rgba(30, 30, 46, 0.40);
    sp-preview-info-border: rgba(49, 50, 68, 0.60);

    /* ── Action buttons ───────────────────────────────────────────────────────── */
    sp-action-primary-bg:       rgba(203, 164, 247, 0.85);
    sp-action-primary-fg:       #1e1e2e;
    sp-action-primary-border:   rgba(203, 164, 247, 1.0);

    sp-action-secondary-bg:     rgba(49, 50, 68, 0.55);
    sp-action-secondary-fg:     #cdd6f4;
    sp-action-secondary-border: rgba(69, 71, 90, 0.60);

    /* ── Mode switcher buttons ────────────────────────────────────────────────── */
    sp-btn-bg:              transparent;
    sp-btn-fg:              rgba(108, 112, 134, 0.70);
    sp-btn-selected-bg:     rgba(203, 164, 247, 0.80);
    sp-btn-selected-fg:     #1e1e2e;
    sp-btn-selected-border: rgba(203, 164, 247, 1.0);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED WINDOW STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(17, 17, 27, 0.92);
    border-color:       rgba(203, 164, 247, 0.28);
    border:             1px;
    border-radius:      18px;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §03  INPUTBAR — FROSTED GLASS SEARCH
   ══════════════════════════════════════════════════════════════════════════════ */

inputbar {
    background-color:   rgba(30, 30, 46, 0.65);
    border-color:       rgba(49, 50, 68, 0.90);
}

prompt   { text-color: #cba4f7; }

textbox-prompt-colon {
    text-color:         rgba(108, 112, 134, 0.45);
}

entry {
    text-color:         #cdd6f4;
    placeholder-color:  rgba(108, 112, 134, 0.55);
}

num-filtered-rows { text-color: rgba(88, 91, 112, 0.55); }
case-indicator    { text-color: #cba4f7; }

search-icon {
    text-color:         rgba(108, 112, 134, 0.40);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §04  LEFT PANEL INTERIOR
   ══════════════════════════════════════════════════════════════════════════════ */

left-panel {
    background-color:   rgba(20, 20, 30, 0.30);
    border-radius:      0px 0px 0px 18px;
}

left-footer {
    background-color:   rgba(20, 20, 30, 0.50);
    border-color:       rgba(49, 50, 68, 0.70);
}

category-label {
    text-color:         rgba(108, 112, 134, 0.60);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §05  LIST ELEMENTS — GLASS SELECTION
   ══════════════════════════════════════════════════════════════════════════════ */

element normal.normal {
    background-color:   transparent;
    text-color:         #cdd6f4;
}

element normal.active {
    background-color:   rgba(203, 164, 247, 0.10);
    text-color:         #cba4f7;
}

element normal.urgent {
    background-color:   rgba(243, 139, 168, 0.10);
    text-color:         #f38ba8;
}

element selected.normal {
    /* Vivid accent glass */
    background-color:   rgba(203, 164, 247, 0.88);
    text-color:         #1e1e2e;
}

element selected.active {
    background-color:   #cba4f7;
    text-color:         #1e1e2e;
}

element selected.urgent {
    background-color:   #f38ba8;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.22);
    text-color:         #9399b2;
}

element-text { highlight: bold #fab387; }

/* ══════════════════════════════════════════════════════════════════════════════
   §06  DIVIDER — SUBTLE SEPARATOR
   ══════════════════════════════════════════════════════════════════════════════ */

panel-divider {
    background-color:   rgba(49, 50, 68, 0.70);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §07  RIGHT PREVIEW PANEL — FROSTED SIDEBAR
   ══════════════════════════════════════════════════════════════════════════════ */

right-panel {
    background-color:   rgba(24, 24, 37, 0.50);
    border-radius:      0px 0px 18px 0px;
}

preview-mode-label {
    text-color:         rgba(108, 112, 134, 0.50);
}

preview-app-icon {
    background-color:   rgba(49, 50, 68, 0.45);
    border-color:       rgba(69, 71, 90, 0.50);
    border-radius:      20px;
}

dummy-icon-placeholder {
    text-color:         rgba(108, 112, 134, 0.30);
}

preview-app-name {
    text-color:         #cdd6f4;
}

preview-app-category {
    text-color:         rgba(108, 112, 134, 0.55);
}

preview-info {
    background-color:   rgba(30, 30, 46, 0.40);
    border-color:       rgba(49, 50, 68, 0.60);
}

info-type-label,
info-exec-label,
info-ver-label {
    text-color:         rgba(108, 112, 134, 0.60);
}

info-type-value,
info-exec-value,
info-ver-value {
    text-color:         #a6adc8;
}

/* ── Action buttons — glass primary, muted secondary ─────────────────────── */
action-open {
    background-color:   rgba(203, 164, 247, 0.85);
    text-color:         #1e1e2e;
    border-color:       rgba(203, 164, 247, 1.0);
}

action-copy,
action-info {
    background-color:   rgba(49, 50, 68, 0.55);
    text-color:         #cdd6f4;
    border-color:       rgba(69, 71, 90, 0.60);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §08  MODE SWITCHER
   ══════════════════════════════════════════════════════════════════════════════ */

button {
    background-color:   transparent;
    text-color:         rgba(108, 112, 134, 0.70);
    border:             0px;
}

button.selected {
    background-color:   rgba(203, 164, 247, 0.80);
    text-color:         #1e1e2e;
    border:             1px;
    border-color:       rgba(203, 164, 247, 1.0);
}