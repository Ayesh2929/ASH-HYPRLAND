/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Spotlight Launcher Style 2: Tokyo Night          ║
   ║                                                                              ║
   ║  Tokyo Night color scheme: deep navy background, electric blue accents,   ║
   ║  violet highlights, warm magenta selection. High contrast, developer-     ║
   ║  focused aesthetic. Best paired with tokyo-night theme.                   ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

/* ══════════════════════════════════════════════════════════════════════════════
   §01  TOKYO NIGHT PALETTE
   ══════════════════════════════════════════════════════════════════════════════ */

* {
    /* ── Tokyo Night colors ───────────────────────────────────────────────────── */
    tn-bg:              #1a1b26;
    tn-bg-dark:         #16161e;
    tn-bg-highlight:    #292e42;
    tn-bg-popup:        #1f2335;
    tn-terminal-black:  #414868;
    tn-fg:              #c0caf5;
    tn-fg-dark:         #a9b1d6;
    tn-fg-gutter:       #3b4261;
    tn-comment:         #565f89;
    tn-dark3:           #545c7e;
    tn-blue0:           #3d59a1;
    tn-blue:            #7aa2f7;
    tn-cyan:            #7dcfff;
    tn-blue1:           #2ac3de;
    tn-blue2:           #0db9d7;
    tn-blue5:           #89ddff;
    tn-blue6:           #b4f9f8;
    tn-blue7:           #394b70;
    tn-magenta:         #bb9af7;
    tn-magenta2:        #ff007c;
    tn-purple:          #9d7cd8;
    tn-orange:          #ff9e64;
    tn-yellow:          #e0af68;
    tn-green:           #9ece6a;
    tn-green1:          #73daca;
    tn-green2:          #41a6b5;
    tn-teal:            #1abc9c;
    tn-red:             #f7768e;
    tn-red1:            #db4b4b;

    /* ── Window geometry ──────────────────────────────────────────────────────── */
    sp-width:               880px;
    sp-height:              560px;
    sp-y-offset:            -60px;

    /* ── Window ───────────────────────────────────────────────────────────────── */
    sp-win-bg:              rgba(26, 27, 38, 0.95);
    sp-win-border:          rgba(122, 162, 247, 0.35);
    sp-win-border-width:    1px;
    sp-win-radius:          14px;

    /* ── Input bar ────────────────────────────────────────────────────────────── */
    sp-inputbar-bg:         rgba(22, 22, 30, 0.85);
    sp-inputbar-border:     rgba(65, 72, 104, 0.80);
    sp-inputbar-border-width: 1px;

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    sp-text:                @tn-fg;
    sp-subtext:             @tn-fg-dark;
    sp-placeholder:         rgba(86, 95, 137, 0.65);
    sp-muted:               rgba(86, 95, 137, 0.65);
    sp-accent:              @tn-blue;
    sp-highlight:           @tn-orange;
    sp-category-fg:         rgba(86, 95, 137, 0.70);

    /* ── Left panel ───────────────────────────────────────────────────────────── */
    sp-left-width:          330px;
    sp-left-bg:             transparent;
    sp-left-footer-bg:      rgba(22, 22, 30, 0.70);
    sp-left-footer-border:  1px;
    sp-left-footer-border-color: rgba(65, 72, 104, 0.70);

    /* ── List ─────────────────────────────────────────────────────────────────── */
    sp-list-lines:          10;

    /* ── Elements ─────────────────────────────────────────────────────────────── */
    sp-element-radius:      6px;
    sp-element-padding-v:   8px;
    sp-element-padding-h:   14px;
    sp-element-fg:          @tn-fg;
    sp-element-alt-bg:      rgba(22, 22, 30, 0.35);
    sp-element-alt-fg:      @tn-fg-dark;
    sp-element-active-bg:   rgba(122, 162, 247, 0.12);
    sp-element-selected-bg: rgba(122, 162, 247, 0.88);
    sp-element-selected-fg: @tn-bg-dark;

    /* ── Icon ─────────────────────────────────────────────────────────────────── */
    sp-icon-size:           26px;

    /* ── Divider ──────────────────────────────────────────────────────────────── */
    sp-divider:             rgba(65, 72, 104, 0.70);

    /* ── Right panel ──────────────────────────────────────────────────────────── */
    sp-right-bg:            rgba(22, 22, 30, 0.55);

    /* Preview */
    sp-preview-title:       @tn-fg;
    sp-preview-text:        @tn-fg-dark;
    sp-preview-muted:       rgba(86, 95, 137, 0.65);

    sp-preview-icon-bg:     rgba(41, 46, 66, 0.60);
    sp-preview-icon-border: rgba(65, 72, 104, 0.60);

    sp-preview-info-bg:     rgba(26, 27, 38, 0.55);
    sp-preview-info-border: rgba(65, 72, 104, 0.55);

    /* ── Actions ──────────────────────────────────────────────────────────────── */
    sp-action-primary-bg:       rgba(122, 162, 247, 0.88);
    sp-action-primary-fg:       @tn-bg-dark;
    sp-action-primary-border:   @tn-blue;

    sp-action-secondary-bg:     rgba(41, 46, 66, 0.60);
    sp-action-secondary-fg:     @tn-fg-dark;
    sp-action-secondary-border: rgba(65, 72, 104, 0.60);

    /* ── Buttons ──────────────────────────────────────────────────────────────── */
    sp-btn-bg:              transparent;
    sp-btn-fg:              rgba(86, 95, 137, 0.70);
    sp-btn-selected-bg:     rgba(122, 162, 247, 0.85);
    sp-btn-selected-fg:     @tn-bg-dark;
    sp-btn-selected-border: @tn-blue;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(26, 27, 38, 0.95);
    border-color:       rgba(122, 162, 247, 0.35);
    border:             1px;
    border-radius:      14px;
}

inputbar {
    background-color:   rgba(22, 22, 30, 0.85);
    border-color:       rgba(65, 72, 104, 0.80);
}

prompt   { text-color: #7aa2f7; }
textbox-prompt-colon { text-color: rgba(86, 95, 137, 0.45); }
entry    { text-color: #c0caf5; placeholder-color: rgba(86, 95, 137, 0.60); }
num-filtered-rows { text-color: rgba(86, 95, 137, 0.50); }
case-indicator    { text-color: #7aa2f7; }
search-icon       { text-color: rgba(86, 95, 137, 0.35); }

left-panel { background-color: rgba(22, 22, 30, 0.30); }
left-footer { background-color: rgba(22, 22, 30, 0.70); border-color: rgba(65, 72, 104, 0.70); }
category-label { text-color: rgba(86, 95, 137, 0.60); }

element normal.normal  { background-color: transparent; text-color: #c0caf5; }
element normal.active  { background-color: rgba(122,162,247,0.12); text-color: #7aa2f7; }
element normal.urgent  { background-color: rgba(247,118,142,0.10); text-color: #f7768e; }

element selected.normal {
    background-color:   rgba(122, 162, 247, 0.88);
    text-color:         #16161e;
}

element selected.active { background-color: #7aa2f7; text-color: #16161e; }
element selected.urgent { background-color: #f7768e; text-color: #16161e; }

element alternate.normal {
    background-color:   rgba(22, 22, 30, 0.35);
    text-color:         #a9b1d6;
}

element-text { highlight: bold #ff9e64; }

panel-divider { background-color: rgba(65, 72, 104, 0.70); }

right-panel { background-color: rgba(22, 22, 30, 0.55); }

preview-mode-label { text-color: rgba(86, 95, 137, 0.50); }
preview-app-icon { background-color: rgba(41,46,66,0.60); border-color: rgba(65,72,104,0.60); }
dummy-icon-placeholder { text-color: rgba(86, 95, 137, 0.25); }
preview-app-name { text-color: #c0caf5; }
preview-app-category { text-color: rgba(86, 95, 137, 0.55); }
preview-info { background-color: rgba(26,27,38,0.55); border-color: rgba(65,72,104,0.55); }
info-type-label, info-exec-label, info-ver-label { text-color: rgba(86, 95, 137, 0.60); }
info-type-value, info-exec-value, info-ver-value { text-color: #a9b1d6; }

action-open { background-color: rgba(122,162,247,0.88); text-color: #16161e; border-color: #7aa2f7; }
action-copy, action-info { background-color: rgba(41,46,66,0.60); text-color: #a9b1d6; border-color: rgba(65,72,104,0.60); }

button { background-color: transparent; text-color: rgba(86, 95, 137, 0.70); border: 0px; }
button.selected { background-color: rgba(122,162,247,0.85); text-color: #16161e; border: 1px; border-color: #7aa2f7; }