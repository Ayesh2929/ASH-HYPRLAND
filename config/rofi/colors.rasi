/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Rofi Color System                                ║
   ║                                                                              ║
   ║  Catppuccin Mocha color tokens for all Rofi surfaces.                      ║
   ║  Updated automatically by ASH theme engine on theme change.                ║
   ║                                                                              ║
   ║  Includes:                                                                   ║
   ║  • Full Catppuccin Mocha palette (26 colors)                               ║
   ║  • Semantic tokens (bg, fg, accent, state)                                 ║
   ║  • RGBA transparency variants                                               ║
   ║  • Surface-specific color compositions                                      ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

/* ══════════════════════════════════════════════════════════════════════════════
   §01  CATPPUCCIN MOCHA — FULL PALETTE
   ══════════════════════════════════════════════════════════════════════════════ */

* {
    /* ── Background layers ───────────────────────────────────────────────────── */
    crust:              #11111b;
    mantle:             #181825;
    base:               #1e1e2e;
    surface0:           #313244;
    surface1:           #45475a;
    surface2:           #585b70;

    /* ── Overlays ────────────────────────────────────────────────────────────── */
    overlay0:           #6c7086;
    overlay1:           #7f849c;
    overlay2:           #9399b2;

    /* ── Text ────────────────────────────────────────────────────────────────── */
    subtext0:           #a6adc8;
    subtext1:           #bac2de;
    text:               #cdd6f4;

    /* ── Accent colors ───────────────────────────────────────────────────────── */
    rosewater:          #f5e0dc;
    flamingo:           #f2cdcd;
    pink:               #f5c2e7;
    mauve:              #cba4f7;
    red:                #f38ba8;
    maroon:             #eba0ac;
    peach:              #fab387;
    yellow:             #f9e2af;
    green:              #a6e3a1;
    teal:               #94e2d5;
    sky:                #89dceb;
    sapphire:           #74c7ec;
    blue:               #89b4fa;
    lavender:           #b4befe;

    /* ══════════════════════════════════════════════════════════════════════════
       §02  SEMANTIC TOKENS — ROFI SURFACE SYSTEM
       ══════════════════════════════════════════════════════════════════════════ */

    /* ── Primary accent ──────────────────────────────────────────────────────── */
    accent:             @mauve;
    accent-alt:         @blue;
    accent-tri:         @sapphire;

    /* ── Window surface ──────────────────────────────────────────────────────── */
    window-bg:          @base;
    window-border:      @mauve;
    window-separator:   @surface0;

    /* ── Main box ────────────────────────────────────────────────────────────── */
    mainbox-bg:         transparent;

    /* ── Input bar ────────────────────────────────────────────────────────────── */
    inputbar-bg:        @surface0;
    inputbar-fg:        @text;
    inputbar-border:    @surface1;

    /* ── Prompt (mode name) ──────────────────────────────────────────────────── */
    prompt-fg:          @accent;
    prompt-bg:          transparent;

    /* ── Entry / typing cursor ────────────────────────────────────────────────── */
    entry-fg:           @text;
    entry-bg:           transparent;
    cursor-color:       @accent;

    /* ── Placeholder text ────────────────────────────────────────────────────── */
    placeholder-fg:     @overlay0;

    /* ── Case indicator ──────────────────────────────────────────────────────── */
    case-fg:            @accent;
    case-bg:            transparent;

    /* ── List view ────────────────────────────────────────────────────────────── */
    listview-bg:        transparent;
    listview-scrollbar: transparent;

    /* ── Normal items (default state) ────────────────────────────────────────── */
    normal-fg:          @text;
    normal-bg:          transparent;

    /* ── Selected item ────────────────────────────────────────────────────────── */
    selected-fg:        @base;
    selected-bg:        @accent;
    selected-match-fg:  @base;
    selected-match-bg:  @accent;

    /* ── Alternate rows ───────────────────────────────────────────────────────── */
    alternate-fg:       @subtext0;
    alternate-bg:       rgba(49, 50, 68, 0.40);

    /* ── Active items (pinned apps etc.) ─────────────────────────────────────── */
    active-fg:          @accent;
    active-bg:          rgba(203, 164, 247, 0.10);
    active-match-fg:    @accent;
    active-match-bg:    rgba(203, 164, 247, 0.15);
    selected-active-fg: @base;
    selected-active-bg: @accent;

    /* ── Urgent items ────────────────────────────────────────────────────────── */
    urgent-fg:          @red;
    urgent-bg:          rgba(243, 139, 168, 0.10);
    urgent-match-fg:    @red;
    urgent-match-bg:    rgba(243, 139, 168, 0.15);
    selected-urgent-fg: @base;
    selected-urgent-bg: @red;

    /* ── Search match highlighting ───────────────────────────────────────────── */
    match-fg:           @peach;
    match-bg:           transparent;

    /* ── Mode button (sidebar) ───────────────────────────────────────────────── */
    mode-button-fg:         @subtext0;
    mode-button-bg:         transparent;
    mode-button-active-fg:  @accent;
    mode-button-active-bg:  rgba(203, 164, 247, 0.12);
    mode-button-border:     @surface1;

    /* ── Message / error bar ─────────────────────────────────────────────────── */
    message-bg:         @surface0;
    message-fg:         @text;
    message-border:     @surface1;

    /* ── Textbox ─────────────────────────────────────────────────────────────── */
    textbox-fg:         @text;
    textbox-bg:         transparent;

    /* ── Scrollbar ────────────────────────────────────────────────────────────── */
    scrollbar-fg:       @surface2;
    scrollbar-bg:       @surface0;
    handle-bg:          @accent;

    /* ── Button (for menus with buttons) ─────────────────────────────────────── */
    button-fg:          @text;
    button-bg:          @surface0;
    button-hover-fg:    @accent;
    button-hover-bg:    rgba(203, 164, 247, 0.12);

    /* ══════════════════════════════════════════════════════════════════════════
       §03  RGBA TRANSPARENCY VARIANTS
       ══════════════════════════════════════════════════════════════════════════ */

    /* Base transparencies (for glassmorphism) */
    base-90:            rgba(30,  30,  46,  0.90);
    base-85:            rgba(30,  30,  46,  0.85);
    base-80:            rgba(30,  30,  46,  0.80);
    base-70:            rgba(30,  30,  46,  0.70);
    base-60:            rgba(30,  30,  46,  0.60);

    /* Mantle transparencies */
    mantle-90:          rgba(24,  24,  37,  0.90);
    mantle-85:          rgba(24,  24,  37,  0.85);
    mantle-80:          rgba(24,  24,  37,  0.80);
    mantle-75:          rgba(24,  24,  37,  0.75);

    /* Accent transparencies */
    accent-20:          rgba(203, 164, 247, 0.20);
    accent-15:          rgba(203, 164, 247, 0.15);
    accent-12:          rgba(203, 164, 247, 0.12);
    accent-08:          rgba(203, 164, 247, 0.08);

    /* Surface transparencies */
    surface0-60:        rgba(49,  50,  68,  0.60);
    surface0-40:        rgba(49,  50,  68,  0.40);
    surface1-50:        rgba(69,  71,  90,  0.50);

    /* ══════════════════════════════════════════════════════════════════════════
       §04  SPECIAL CONTEXT COLORS
       ══════════════════════════════════════════════════════════════════════════ */

    /* Power menu */
    power-shutdown-fg:  @red;
    power-reboot-fg:    @peach;
    power-suspend-fg:   @yellow;
    power-logout-fg:    @maroon;
    power-lock-fg:      @blue;
    power-hibernate-fg: @sapphire;

    /* File browser */
    file-dir-fg:        @blue;
    file-exec-fg:       @green;
    file-link-fg:       @teal;
    file-broken-fg:     @red;

    /* App launcher categories */
    cat-internet-fg:    @blue;
    cat-games-fg:       @green;
    cat-media-fg:       @peach;
    cat-system-fg:      @red;
    cat-tools-fg:       @yellow;
    cat-office-fg:      @lavender;
}