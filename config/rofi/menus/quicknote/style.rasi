/* ══════════════════════════════════════════════════════════════════════════════
 * § 6  ANIMATION TOKENS (Rofi property extensions — future-proof)
 * ══════════════════════════════════════════════════════════════════════════════
 */
* {
    /* Standard easing curves (used by rofi-extensions if available) */
    _ease-out-cubic:   "cubic-bezier(0.33, 1, 0.68, 1)";
    _ease-in-out-quad: "cubic-bezier(0.45, 0, 0.55, 1)";
    _ease-spring:      "cubic-bezier(0.34, 1.56, 0.64, 1)";

    /* Durations */
    _duration-fast:    "120ms";
    _duration-base:    "200ms";
    _duration-slow:    "350ms";
}

/* ══════════════════════════════════════════════════════════════════════════════
 * § 7  ICON MAP (Nerd Font codepoints used in quicknote.sh output)
 *      Documented here for maintainability — referenced in scripts.
 * ══════════════════════════════════════════════════════════════════════════════
 */
/*
 * ICON REFERENCE — QUICKNOTE
 * ─────────────────────────────────────────────────────────────────────────────
 *  󱞁   nf-md-note_text_outline         Main note icon
 *  󰐃   nf-md-pin                        Pinned note
 *  󰐄   nf-md-pin_off                    Unpinned
 *  󰙏   nf-md-filter_variant             Filter / search
 *  󰒺   nf-md-sort                       Sort
 *  󰬴   nf-md-alphabetical               Word count
 *  󰃰   nf-md-calendar_clock             Date created
 *  󰏫   nf-md-pencil                     Edit
 *  󰆏   nf-md-content_copy               Copy
 *  󰆴   nf-md-delete                     Delete
 *  󰓻   nf-md-tag_multiple               Tags
 *  󰔛   nf-md-history                    Recent
 *  ⭐  star                              Favorite/high priority
 *  🔴  red circle                       High priority
 *  🟡  yellow circle                    Medium priority
 *  🟢  green circle                     Normal priority
 *  🔵  blue circle                      Low priority
 *  󱝶   nf-md-note_multiple_outline      Note list header
 *  󰅖   nf-md-close                      Clear search
 *  󰍉   nf-md-magnify                    Search icon
 * ─────────────────────────────────────────────────────────────────────────────
 */