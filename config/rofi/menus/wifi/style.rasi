/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — WiFi Menu Style: Electric Green                 ║
   ║                                                                              ║
   ║  Green network accent on deep dark glass. Connected = bright green,        ║
   ║  good signal = teal, weak signal = yellow/orange, open = muted.           ║
   ║                                                                              ║
   ║  Color system:                                                               ║
   ║  • Green (#a6e3a1)   — primary accent, connected networks                 ║
   ║  • Teal (#94e2d5)    — secondary, scan/rescan                              ║
   ║  • Sapphire (#74c7ec)— badge, frequency indicators                         ║
   ║  • Yellow (#f9e2af)  — weak signal warning                                 ║
   ║  • Red (#f38ba8)     — toggle off, open/insecure networks                  ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    /* ── Geometry ────────────────────────────────────────────────────────────── */
    wifi-width:                     700px;
    wifi-y-offset:                  -50px;

    /* ── Window ──────────────────────────────────────────────────────────────── */
    wifi-win-bg:                    rgba(17, 17, 27, 0.94);
    wifi-win-border:                rgba(166, 227, 161, 0.30);
    wifi-win-border-width:          1px;
    wifi-win-radius:                18px;

    /* ── Header ──────────────────────────────────────────────────────────────── */
    wifi-header-bg:                 rgba(20, 20, 32, 0.72);
    wifi-header-border:             rgba(49, 50, 68, 0.80);
    wifi-header-border-width:       1px;

    /* ── Primary accent (WiFi green) ─────────────────────────────────────────── */
    wifi-accent:                    #a6e3a1;

    /* ── Frequency badge ─────────────────────────────────────────────────────── */
    wifi-badge-bg:                  rgba(116, 199, 236, 0.12);
    wifi-badge-fg:                  #74c7ec;
    wifi-badge-border:              rgba(116, 199, 236, 0.30);

    /* ── Toggle button (danger - disables wifi) ──────────────────────────────── */
    wifi-toggle-bg:                 rgba(243, 139, 168, 0.10);
    wifi-toggle-fg:                 #f38ba8;
    wifi-toggle-border:             rgba(243, 139, 168, 0.28);

    /* ── Scan button ─────────────────────────────────────────────────────────── */
    wifi-scan-bg:                   rgba(148, 226, 213, 0.10);
    wifi-scan-fg:                   #94e2d5;
    wifi-scan-border:               rgba(148, 226, 213, 0.28);

    /* ── Hotspot button ──────────────────────────────────────────────────────── */
    wifi-hotspot-bg:                rgba(203, 164, 247, 0.10);
    wifi-hotspot-fg:                #cba4f7;
    wifi-hotspot-border:            rgba(203, 164, 247, 0.28);

    /* ── Status bar ──────────────────────────────────────────────────────────── */
    wifi-status-bg:                 rgba(22, 22, 34, 0.60);
    wifi-status-border:             rgba(49, 50, 68, 0.80);

    /* ── Connection info ─────────────────────────────────────────────────────── */
    wifi-conn-fg:                   #a6e3a1;
    wifi-sep-color:                 rgba(69, 71, 90, 0.55);

    /* ── Status badge (connected) ────────────────────────────────────────────── */
    wifi-badge-off-bg:              rgba(166, 227, 161, 0.12);
    wifi-badge-off-fg:              #a6e3a1;
    wifi-badge-off-border:          rgba(166, 227, 161, 0.30);

    /* ── Search bar ──────────────────────────────────────────────────────────── */
    wifi-search-bg:                 rgba(30, 30, 46, 0.55);
    wifi-search-border:             rgba(49, 50, 68, 0.85);

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    wifi-text:                      #cdd6f4;
    wifi-muted:                     rgba(108, 112, 134, 0.65);
    wifi-highlight:                 #94e2d5;

    /* ── Count badge ──────────────────────────────────────────────────────────── */
    wifi-count-bg:                  rgba(166, 227, 161, 0.12);
    wifi-count-fg:                  #a6e3a1;
    wifi-count-border:              rgba(166, 227, 161, 0.28);

    /* ── List view ────────────────────────────────────────────────────────────── */
    wifi-listview-bg:               transparent;
    wifi-list-padding-v:            6px;
    wifi-list-spacing:              1px;
    wifi-list-lines:                11;

    /* ── Elements ────────────────────────────────────────────────────────────── */
    wifi-element-radius:            @radius-sm;
    wifi-element-padding-v:         7px;
    wifi-element-padding-h:         16px;
    wifi-element-margin-h:          6px;
    wifi-element-fg:                #cdd6f4;

    /* ── Connected ───────────────────────────────────────────────────────────── */
    wifi-connected-bg:              rgba(166, 227, 161, 0.08);
    wifi-connected-fg:              #a6e3a1;

    /* ── Selected ────────────────────────────────────────────────────────────── */
    wifi-selected-bg:               rgba(166, 227, 161, 0.88);
    wifi-selected-fg:               #1e1e2e;

    /* ── Alternate ───────────────────────────────────────────────────────────── */
    wifi-alt-bg:                    rgba(30, 30, 46, 0.25);
    wifi-alt-fg:                    #9399b2;

    /* ── Footer ──────────────────────────────────────────────────────────────── */
    wifi-footer-bg:                 rgba(17, 17, 27, 0.75);
    wifi-footer-border:             rgba(49, 50, 68, 0.70);
    wifi-hint-fg:                   rgba(88, 91, 112, 0.65);

    /* ── Message ─────────────────────────────────────────────────────────────── */
    wifi-msg-bg:                    rgba(166, 227, 161, 0.08);
    wifi-msg-fg:                    #a6adc8;
    wifi-msg-border:                rgba(166, 227, 161, 0.25);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(17, 17, 27, 0.94);
    border-color:       rgba(166, 227, 161, 0.30);
    border:             1px;
    border-radius:      18px;
}

wifi-header {
    background-color:   rgba(20, 20, 32, 0.72);
    border-color:       rgba(49, 50, 68, 0.80);
}

wifi-title-icon  { text-color: #a6e3a1; }
wifi-title-text  { text-color: #cdd6f4; }

wifi-freq-badge {
    background-color:   rgba(116, 199, 236, 0.12);
    text-color:         #74c7ec;
    border-color:       rgba(116, 199, 236, 0.30);
}

wifi-toggle-btn {
    background-color:   rgba(243, 139, 168, 0.10);
    text-color:         #f38ba8;
    border-color:       rgba(243, 139, 168, 0.28);
}

wifi-scan-btn {
    background-color:   rgba(148, 226, 213, 0.10);
    text-color:         #94e2d5;
    border-color:       rgba(148, 226, 213, 0.28);
}

wifi-hotspot-btn {
    background-color:   rgba(203, 164, 247, 0.10);
    text-color:         #cba4f7;
    border-color:       rgba(203, 164, 247, 0.28);
}

wifi-status-bar {
    background-color:   rgba(22, 22, 34, 0.60);
    border-color:       rgba(49, 50, 68, 0.80);
}

wifi-conn-icon   { text-color: #a6e3a1; }
wifi-conn-ssid   { text-color: #a6e3a1; font: "JetBrainsMono Nerd Font Bold 11"; }
wifi-conn-sep-1,
wifi-conn-sep-2  { text-color: rgba(69, 71, 90, 0.55); }
wifi-conn-ip,
wifi-conn-speed  { text-color: rgba(108, 112, 134, 0.60); }

wifi-conn-badge {
    background-color:   rgba(166, 227, 161, 0.12);
    text-color:         #a6e3a1;
    border-color:       rgba(166, 227, 161, 0.30);
}

wifi-searchbar {
    background-color:   rgba(30, 30, 46, 0.55);
    border-color:       rgba(49, 50, 68, 0.85);
}

wifi-search-icon { text-color: #a6e3a1; }
entry            { text-color: #cdd6f4; placeholder-color: rgba(108,112,134,0.55); }

num-filtered-rows {
    background-color:   rgba(166, 227, 161, 0.12);
    text-color:         #a6e3a1;
    border-color:       rgba(166, 227, 161, 0.28);
}

case-indicator { text-color: #a6e3a1; }

/* ── Network element states ───────────────────────────────────────────────── */
element normal.normal {
    background-color:   transparent;
    text-color:         #cdd6f4;
}

element normal.active {
    background-color:   rgba(166, 227, 161, 0.08);
    text-color:         #a6e3a1;
}

element normal.urgent {
    background-color:   rgba(243, 139, 168, 0.08);
    text-color:         #f38ba8;
}

element selected.normal {
    background-color:   rgba(166, 227, 161, 0.88);
    text-color:         #1e1e2e;
}

element selected.active {
    background-color:   #a6e3a1;
    text-color:         #1e1e2e;
}

element selected.urgent {
    background-color:   #f38ba8;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.25);
    text-color:         #9399b2;
}

element-text { highlight: bold #94e2d5; }

/* ── Footer ───────────────────────────────────────────────────────────────── */
wifi-footer {
    background-color:   rgba(17, 17, 27, 0.75);
    border-color:       rgba(49, 50, 68, 0.70);
}

wifi-hint-connect,
wifi-hint-forget,
wifi-hint-scan,
wifi-hint-disc   { text-color: rgba(88, 91, 112, 0.65); }

wifi-hint-sep-1,
wifi-hint-sep-2,
wifi-hint-sep-3  { text-color: rgba(49, 50, 68, 0.70); }

wifi-footer-iface { text-color: rgba(69, 71, 90, 0.40); }

/* ── Message ──────────────────────────────────────────────────────────────── */
message {
    background-color:   rgba(166, 227, 161, 0.08);
    border-color:       rgba(166, 227, 161, 0.25);
}

textbox { text-color: #a6adc8; }