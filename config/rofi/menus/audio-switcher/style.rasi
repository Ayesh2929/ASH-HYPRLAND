/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Audio Switcher Style: Electric Cyan             ║
   ║                                                                              ║
   ║  Sky/Cyan accent for audio management — fresh, clean, tech-forward.        ║
   ║  Active device glows green, muted devices are dimmed, volume bars          ║
   ║  use gradient color to indicate level intensity.                           ║
   ║                                                                              ║
   ║  Color system:                                                               ║
   ║  • Sky (#89dceb)     — primary accent, search, volume bars                 ║
   ║  • Teal (#94e2d5)    — active default device                               ║
   ║  • Sapphire (#74c7ec)— header tabs, selected active                        ║
   ║  • Red (#f38ba8)     — muted devices, mute action                          ║
   ║  • Green (#a6e3a1)   — PipeWire running status                             ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    /* ── Geometry ────────────────────────────────────────────────────────────── */
    au-width:                       680px;
    au-height:                      0px;
    au-y-offset:                    -50px;

    /* ── Window ──────────────────────────────────────────────────────────────── */
    au-win-bg:                      rgba(17, 17, 27, 0.95);
    au-win-border:                  rgba(137, 220, 235, 0.28);
    au-win-border-width:            1px;
    au-win-radius:                  18px;

    /* ── Header ──────────────────────────────────────────────────────────────── */
    au-header-bg:                   rgba(20, 20, 32, 0.75);
    au-header-border:               rgba(49, 50, 68, 0.80);
    au-header-border-width:         1px;

    /* ── Primary accent (sky/cyan) ────────────────────────────────────────────── */
    au-accent:                      #89dceb;

    /* ── Tab buttons ─────────────────────────────────────────────────────────── */
    au-tab-active-bg:               rgba(137, 220, 235, 0.85);
    au-tab-active-fg:               #1e1e2e;
    au-tab-active-border:           rgba(137, 220, 235, 1.0);
    au-tab-bg:                      rgba(49, 50, 68, 0.45);
    au-tab-fg:                      #a6adc8;
    au-tab-border:                  rgba(69, 71, 90, 0.45);

    /* ── Server info bar ─────────────────────────────────────────────────────── */
    au-server-bg:                   rgba(22, 22, 34, 0.65);
    au-server-border:               rgba(49, 50, 68, 0.80);
    au-server-fg:                   #a6adc8;

    /* ── Server status badge ─────────────────────────────────────────────────── */
    au-status-bg:                   rgba(166, 227, 161, 0.12);
    au-status-fg:                   #a6e3a1;
    au-status-border:               rgba(166, 227, 161, 0.28);

    /* ── Search bar ──────────────────────────────────────────────────────────── */
    au-search-bg:                   rgba(30, 30, 46, 0.58);
    au-search-border:               rgba(49, 50, 68, 0.85);

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    au-text:                        #cdd6f4;
    au-muted:                       rgba(108, 112, 134, 0.65);
    au-sep-color:                   rgba(69, 71, 90, 0.55);
    au-highlight:                   #89dceb;

    /* ── Count badge ──────────────────────────────────────────────────────────── */
    au-count-bg:                    rgba(137, 220, 235, 0.10);
    au-count-fg:                    #89dceb;
    au-count-border:                rgba(137, 220, 235, 0.25);

    /* ── List view ────────────────────────────────────────────────────────────── */
    au-listview-bg:                 transparent;
    au-list-padding-v:              6px;
    au-list-spacing:                1px;
    au-list-lines:                  11;

    /* ── Elements ─────────────────────────────────────────────────────────────── */
    au-element-radius:              @radius-sm;
    au-element-padding-v:           8px;
    au-element-padding-h:           16px;
    au-element-margin-h:            6px;
    au-element-fg:                  #cdd6f4;

    /* ── Default device (active) ──────────────────────────────────────────────── */
    au-default-bg:                  rgba(148, 226, 213, 0.10);
    au-default-fg:                  #94e2d5;

    /* ── Selected ─────────────────────────────────────────────────────────────── */
    au-selected-bg:                 rgba(137, 220, 235, 0.88);
    au-selected-fg:                 #1e1e2e;

    /* ── Alternate ────────────────────────────────────────────────────────────── */
    au-alt-bg:                      rgba(30, 30, 46, 0.25);
    au-alt-fg:                      #9399b2;

    /* ── Message ──────────────────────────────────────────────────────────────── */
    au-msg-bg:                      rgba(137, 220, 235, 0.08);
    au-msg-fg:                      #a6adc8;
    au-msg-border:                  rgba(137, 220, 235, 0.25);

    /* ── Footer ───────────────────────────────────────────────────────────────── */
    au-footer-bg:                   rgba(17, 17, 27, 0.78);
    au-footer-border:               rgba(49, 50, 68, 0.70);
    au-hint-primary:                #89dceb;
    au-hint-fg:                     rgba(108, 112, 134, 0.65);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(17, 17, 27, 0.95);
    border-color:       rgba(137, 220, 235, 0.28);
    border:             1px;
    border-radius:      18px;
}

au-header {
    background-color:   rgba(20, 20, 32, 0.75);
    border-color:       rgba(49, 50, 68, 0.80);
}

au-title-icon   { text-color: #89dceb; }
au-title-text   { text-color: #cdd6f4; }

au-tab-playback {
    background-color:   rgba(137, 220, 235, 0.85);
    text-color:         #1e1e2e;
    border-color:       rgba(137, 220, 235, 1.0);
}

au-tab-record, au-tab-streams {
    background-color:   rgba(49, 50, 68, 0.45);
    text-color:         #a6adc8;
    border-color:       rgba(69, 71, 90, 0.45);
}

au-server-bar {
    background-color:   rgba(22, 22, 34, 0.65);
    border-color:       rgba(49, 50, 68, 0.80);
}

au-server-icon   { text-color: #89dceb; }
au-server-name   { text-color: #a6adc8; }
au-server-sep-1,
au-server-sep-2  { text-color: rgba(69, 71, 90, 0.55); }
au-server-rate,
au-server-latency { text-color: rgba(108, 112, 134, 0.60); }

au-server-status {
    background-color:   rgba(166, 227, 161, 0.12);
    text-color:         #a6e3a1;
    border-color:       rgba(166, 227, 161, 0.28);
}

au-searchbar {
    background-color:   rgba(30, 30, 46, 0.58);
    border-color:       rgba(49, 50, 68, 0.85);
}

au-search-icon   { text-color: #89dceb; }
entry            { text-color: #cdd6f4; placeholder-color: rgba(108,112,134,0.55); }
au-device-counts { text-color: rgba(88,91,112,0.50); }

num-filtered-rows {
    background-color:   rgba(137, 220, 235, 0.10);
    text-color:         #89dceb;
    border-color:       rgba(137, 220, 235, 0.25);
}

/* ── Device element states ────────────────────────────────────────────────── */
element normal.normal {
    background-color:   transparent;
    text-color:         #cdd6f4;
}

element normal.active {
    /* Default/active device: teal glow */
    background-color:   rgba(148, 226, 213, 0.10);
    text-color:         #94e2d5;
}

element normal.urgent {
    /* Muted device: dimmed red tint */
    background-color:   rgba(243, 139, 168, 0.08);
    text-color:         rgba(108, 112, 134, 0.60);
}

element selected.normal {
    background-color:   rgba(137, 220, 235, 0.88);
    text-color:         #1e1e2e;
}

element selected.active {
    background-color:   #89dceb;
    text-color:         #1e1e2e;
}

element selected.urgent {
    background-color:   rgba(243, 139, 168, 0.25);
    text-color:         #f38ba8;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.25);
    text-color:         #9399b2;
}

element-text { highlight: bold #89dceb; }

/* ── Message ──────────────────────────────────────────────────────────────── */
message {
    background-color:   rgba(137, 220, 235, 0.08);
    border-color:       rgba(137, 220, 235, 0.25);
}

textbox { text-color: #a6adc8; }

/* ── Footer ───────────────────────────────────────────────────────────────── */
au-footer {
    background-color:   rgba(17, 17, 27, 0.78);
    border-color:       rgba(49, 50, 68, 0.70);
}

au-hint-default  { text-color: #89dceb; }
au-hint-vol,
au-hint-mute,
au-hint-profile  { text-color: rgba(108, 112, 134, 0.65); }

au-hint-sep-1,
au-hint-sep-2,
au-hint-sep-3    { text-color: rgba(49, 50, 68, 0.70); }

au-backend-label { text-color: rgba(69, 71, 90, 0.40); }