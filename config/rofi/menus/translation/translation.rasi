    text-color:             @fg-muted;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

/* ══════════════════════════════════════════════════════════════════════════════
 * ── SECTION C: CONTENT BODY (three-panel row)
 * ══════════════════════════════════════════════════════════════════════════════
 */
content-body {
    background-color:       transparent;
    orientation:            horizontal;
    spacing:                0px;
    expand:                 true;
    children:               [ translation-panels, history-panel ];
}

/* ══════════════════════════════════════════════════════════════════════════════
 * ── SECTION C1: TRANSLATION PANELS (input + output stacked)
 * ══════════════════════════════════════════════════════════════════════════════
 */
translation-panels {
    background-color:       transparent;
    border:                 0px 1px 0px 0px solid;
    border-color:           @border-panel;
    orientation:            vertical;
    spacing:                0px;
    expand:                 true;
    children:               [ input-panel, panel-divider, output-panel ];
}

/* ── Input Panel ───────────────────────────────────────────────────────────── */
input-panel {
    background-color:       @bg-input-panel;
    border:                 0px;
    padding:                0px;
    orientation:            vertical;
    spacing:                0px;
    expand:                 true;
    children:               [
                                input-toolbar,
                                input-area,
                                input-statusbar
                            ];
}

input-toolbar {
    background-color:       @bg-surface;
    border:                 0px 0px 1px 0px solid;
    border-color:           @border-subtle;
    padding:                6px 16px;
    orientation:            horizontal;
    spacing:                8px;
    expand:                 false;
    children:               [
                                itb-lang-badge,
                                itb-sep,
                                itb-label,
                                spacer,
                                itb-paste,
                                itb-tts-src,
                                itb-clear
                            ];
}

itb-lang-badge {
    background-color:       @accent-alpha;
    border-radius:          @radius-pill;
    padding:                3px 10px;
    expand:                 false;
    content:                "🇺🇸  English";
    font:                   @font-ui-med;
    text-color:             @accent;
    vertical-align:         0.5;
    horizontal-align:       0.5;
}

itb-sep {
    background-color:       @border-subtle;
    expand:                 false;
    width:                  1px;
    margin:                 5px 2px;
}

itb-label {
    background-color:       transparent;
    content:                "Source";
    font:                   @font-small;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    horizontal-align:       0.0;
    expand:                 false;
}

itb-paste {
    background-color:       transparent;
    border-radius:          @radius-sm;
    padding:                4px 8px;
    expand:                 false;
    content:                "󰨿";
    font:                   @font-icon-sm;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

itb-tts-src {
    background-color:       transparent;
    border-radius:          @radius-sm;
    padding:                4px 8px;
    expand:                 false;
    content:                "󰂚";
    font:                   @font-icon-sm;
    text-color:             @fg-tts;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

itb-clear {
    background-color:       transparent;
    border-radius:          @radius-sm;
    padding:                4px 8px;
    expand:                 false;
    content:                "󰅖";
    font:                   @font-icon-sm;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

/* ── The actual Rofi input entry lives here ──────────────────────────────── */
input-area {
    background-color:       transparent;
    padding:                0px;
    orientation:            vertical;
    expand:                 true;
    children:               [ inputbar ];
}

inputbar {
    background-color:       transparent;
    border:                 0px;
    padding:                16px 18px;
    spacing:                0px;
    expand:                 true;
    orientation:            vertical;
    children:               [ prompt, entry, case-indicator ];
}

prompt {
    background-color:       transparent;
    enabled:                false;
    expand:                 false;
    text-color:             @fg-muted;
}

entry {
    background-color:       transparent;
    border:                 0px;
    padding:                0px;
    expand:                 true;
    font:                   @font-result;
    text-color:             @fg-primary;
    vertical-align:         0.0;
    horizontal-align:       0.0;
    placeholder:            "Type or paste text to translate…";
    placeholder-color:      @fg-placeholder;
    cursor:                 text;
}

case-indicator {
    background-color:       transparent;
    text-color:             @fg-muted;
    font:                   @font-small;
    expand:                 false;
}

input-statusbar {
    background-color:       @bg-surface;
    border:                 1px 0px 0px 0px solid;
    border-color:           @border-subtle;
    padding:                6px 16px;
    orientation:            horizontal;
    spacing:                10px;
    expand:                 false;
    children:               [
                                isb-detect-badge,
                                spacer,
                                isb-char-count,
                                isb-word-count
                            ];
}

isb-detect-badge {
    background-color:       @bg-detect-badge;
    border-radius:          @radius-pill;
    padding:                3px 10px;
    expand:                 false;
    content:                "󰍉  Detected: English";
    font:                   @font-small;
    text-color:             @fg-detect;
    vertical-align:         0.5;
}

isb-char-count {
    background-color:       transparent;
    content:                "0 / 5000";
    font:                   @font-char-count;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    expand:                 false;
}

isb-word-count {
    background-color:       transparent;
    content:                "0 words";
    font:                   @font-char-count;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    expand:                 false;
}

/* ── Panel Divider ─────────────────────────────────────────────────────────── */
panel-divider {
    background-color:       @border-panel;
    expand:                 false;
    height:                 1px;
}

/* ── Output Panel ──────────────────────────────────────────────────────────── */
output-panel {
    background-color:       @bg-output-panel;
    border:                 0px;
    padding:                0px;
    orientation:            vertical;
    spacing:                0px;
    expand:                 true;
    children:               [
                                output-toolbar,
                                output-area,
                                output-phonetic-bar,
                                output-actions
                            ];
}

output-toolbar {
    background-color:       @bg-surface;
    border:                 0px 0px 1px 0px solid;
    border-color:           @border-subtle;
    padding:                6px 16px;
    orientation:            horizontal;
    spacing:                8px;
    expand:                 false;
    children:               [
                                otb-lang-badge,
                                otb-sep,
                                otb-label,
                                spacer,
                                otb-engine-badge,
                                otb-confidence
                            ];
}

otb-lang-badge {
    background-color:       @accent-alpha;
    border-radius:          @radius-pill;
    padding:                3px 10px;
    expand:                 false;
    content:                "🇩🇪  Deutsch";
    font:                   @font-ui-med;
    text-color:             @accent;
    vertical-align:         0.5;
    horizontal-align:       0.5;
}

otb-sep {
    background-color:       @border-subtle;
    expand:                 false;
    width:                  1px;
    margin:                 5px 2px;
}

otb-label {
    background-color:       transparent;
    content:                "Translation";
    font:                   @font-small;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    horizontal-align:       0.0;
    expand:                 false;
}

otb-engine-badge {
    background-color:       @bg-provider-badge;
    border-radius:          @radius-pill;
    padding:                3px 9px;
    expand:                 false;
    content:                "🌐 Google";
    font:                   @font-provider;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
}

otb-confidence {
    background-color:       transparent;
    content:                "● 98%";
    font:                   @font-small;
    text-color:             @fg-success;
    vertical-align:         0.5;
    expand:                 false;
}

output-area {
    background-color:       transparent;
    padding:                16px 18px 8px 18px;
    expand:                 true;
    orientation:            vertical;
    spacing:                0px;
    children:               [ output-result, output-empty ];
}

output-result {
    background-color:       transparent;
    content:                "Translation will appear here…";
    font:                   @font-result;
    text-color:             @fg-secondary;
    vertical-align:         0.0;
    horizontal-align:       0.0;
    expand:                 true;
}

output-empty {
    background-color:       transparent;
    content:                "";
    font:                   @font-small;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    expand:                 false;
}

output-phonetic-bar {
    background-color:       @bg-surface;
    border:                 1px 0px 0px 0px solid;
    border-color:           @border-subtle;
    padding:                6px 18px;
    orientation:            horizontal;
    spacing:                8px;
    expand:                 false;
    children:               [
                                phonetic-icon,
                                phonetic-text,
                                spacer,
                                phonetic-romanize
                            ];
}

phonetic-icon {
    background-color:       transparent;
    content:                "󱁬";
    font:                   @font-icon-sm;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    expand:                 false;
}

phonetic-text {
    background-color:       transparent;
    content:                "Phonetic / romanisation shown here";
    font:                   @font-phonetic;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    horizontal-align:       0.0;
    expand:                 true;
}

phonetic-romanize {
    background-color:       transparent;
    content:                "Romanize";
    font:                   @font-xsmall;
    text-color:             @fg-accent;
    vertical-align:         0.5;
    expand:                 false;
    cursor:                 pointer;
}

output-actions {
    background-color:       @bg-surface;
    border:                 1px 0px 0px 0px solid;
    border-color:           @border-subtle;
    padding:                8px 16px;
    orientation:            horizontal;
    spacing:                8px;
    expand:                 false;
    children:               [
                                oa-tts,
                                oa-copy,
                                oa-export,
                                oa-retry,
                                spacer,
                                oa-fav,
                                oa-word-arts
                            ];
}

oa-tts {
    background-color:       @bg-tts-btn;
    border:                 1px solid;
    border-color:           @border-subtle;
    border-radius:          @radius-sm;
    padding:                6px 12px;
    expand:                 false;
    content:                "󰂚  Listen";
    font:                   @font-ui;
    text-color:             @fg-tts;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

oa-copy {
    background-color:       @accent;
    border-radius:          @radius-sm;
    padding:                6px 14px;
    expand:                 false;
    content:                "󰆏  Copy";
    font:                   @font-ui;
    text-color:             @bg-window;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

oa-export {
    background-color:       @bg-surface-raised;
    border:                 1px solid;
    border-color:           @border-subtle;
    border-radius:          @radius-sm;
    padding:                6px 10px;
    expand:                 false;
    content:                "󰈮";
    font:                   @font-icon-sm;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

oa-retry {
    background-color:       @bg-surface-raised;
    border:                 1px solid;
    border-color:           @border-subtle;
    border-radius:          @radius-sm;
    padding:                6px 10px;
    expand:                 false;
    content:                "󰑐";
    font:                   @font-icon-sm;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

oa-fav {
    background-color:       @bg-fav-btn;
    border:                 1px solid;
    border-color:           @border-subtle;
    border-radius:          @radius-sm;
    padding:                6px 10px;
    expand:                 false;
    content:                "★";
    font:                   @font-icon-sm;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

oa-word-arts {
    background-color:       transparent;
    content:                "6 alt. translations";
    font:                   @font-small;
    text-color:             @fg-accent;
    vertical-align:         0.5;
    horizontal-align:       1.0;
    expand:                 false;
    cursor:                 pointer;
}

/* ══════════════════════════════════════════════════════════════════════════════
 * ── SECTION C2: HISTORY PANEL
 * ══════════════════════════════════════════════════════════════════════════════
 */
history-panel {
    background-color:       @bg-history-panel;
    border:                 0px;
    border-radius:          0px;
    orientation:            vertical;
    spacing:                0px;
    expand:                 false;
    width:                  260px;
    children:               [
                                history-header,
                                history-search,
                                listview,
                                history-footer
                            ];
}

history-header {
    background-color:       @bg-surface;
    border:                 0px 0px 1px 0px solid;
    border-color:           @border-history;
    padding:                8px 14px;
    orientation:            horizontal;
    spacing:                8px;
    expand:                 false;
    children:               [ hdr-icon, hdr-title, spacer, hdr-clear ];
}

hdr-icon {
    background-color:       transparent;
    content:                "󰹑";
    font:                   @font-icon-md;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    expand:                 false;
}

hdr-title {
    background-color:       transparent;
    content:                "History";
    font:                   @font-ui-med;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.0;
    expand:                 true;
}

hdr-clear {
    background-color:       transparent;
    content:                "Clear";
    font:                   @font-xsmall;
    text-color:             @fg-accent;
    vertical-align:         0.5;
    horizontal-align:       1.0;
    expand:                 false;
    cursor:                 pointer;
}

history-search {
    background-color:       @bg-input;
    border:                 1px solid;
    border-color:           @border-subtle;
    border-radius:          @radius-sm;
    margin:                 8px 10px 4px 10px;
    padding:                5px 10px;
    orientation:            horizontal;
    spacing:                6px;
    expand:                 false;
    children:               [ hs-icon, hs-placeholder ];
}

hs-icon {
    background-color:       transparent;
    content:                "󰍉";
    font:                   @font-icon-sm;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    expand:                 false;
}

hs-placeholder {
    background-color:       transparent;
    content:                "Search history…";
    font:                   @font-small;
    text-color:             @fg-placeholder;
    vertical-align:         0.5;
    expand:                 true;
}

/* ── List view (history items rendered here) ─────────────────────────────── */
listview {
    background-color:       transparent;
    border:                 0px;
    padding:                4px 0px;
    spacing:                1px;
    expand:                 true;
    orientation:            vertical;
    dynamic:                true;
    scrollbar:              true;
    scroll-method:          0;
    fixed-height:           false;
    fixed-columns:          true;
    lines:                  9999;
    columns:                1;
}

scrollbar {
    background-color:       @bg-scrollbar;
    border:                 0px;
    border-radius:          4px;
    handle-color:           @border-subtle;
    handle-width:           3px;
    padding:                2px;
    width:                  6px;
}

/* ── History list items ──────────────────────────────────────────────────── */
element {
    background-color:       transparent;
    border:                 0px;
    border-radius:          @radius-sm;
    margin:                 0px 6px;
    padding:                8px 10px;
    orientation:            horizontal;
    spacing:                8px;
    cursor:                 pointer;
}

element normal.normal {
    background-color:       transparent;
    text-color:             @fg-secondary;
}

element normal.active {
    background-color:       @accent-alpha;
    text-color:             @accent;
}

element normal.urgent {
    background-color:       transparent;
    text-color:             @fg-accent;
}

element selected.normal {
    background-color:       @selection-bg;
    border:                 1px solid;
    border-color:           @selection-border;
    text-color:             @selection-fg;
}

element selected.active {
    background-color:       @accent;
    text-color:             @bg-window;
}

element selected.urgent {
    background-color:       @accent4;
    text-color:             @bg-window;
}

element alternate.normal {
    background-color:       transparent;
    text-color:             @fg-secondary;
}

element alternate.active {
    background-color:       @accent-alpha;
    text-color:             @accent;
}

element-icon {
    background-color:       transparent;
    size:                   1.8em;
    border:                 0px;
    padding:                0px;
    expand:                 false;
    vertical-align:         0.5;
    horizontal-align:       0.5;
}

element-text {
    background-color:       transparent;
    expand:                 true;
    vertical-align:         0.5;
    horizontal-align:       0.0;
    text-color:             inherit;
    font:                   @font-history;
    highlight:              bold @accent;
    cursor:                 inherit;
}

history-footer {
    background-color:       @bg-surface;
    border:                 1px 0px 0px 0px solid;
    border-color:           @border-history;
    border-radius:          0px 0px @radius-xl 0px;
    padding:                7px 14px;
    orientation:            horizontal;
    spacing:                0px;
    expand:                 false;
    children:               [ hf-count, spacer, hf-fav-toggle ];
}

hf-count {
    background-color:       transparent;
    content:                "󰹑  24 translations";
    font:                   @font-small;
    text-color:             @fg-muted;
    vertical-align:         0.5;
}

hf-fav-toggle {
    background-color:       transparent;
    content:                "★  Favourites only";
    font:                   @font-small;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    expand:                 false;
    cursor:                 pointer;
}

/* ══════════════════════════════════════════════════════════════════════════════
 * ── SECTION D: FOOTER
 * ══════════════════════════════════════════════════════════════════════════════
 */
footer {
    background-color:       @bg-footer;
    border:                 1px 0px 0px 0px solid;
    border-color:           @border-subtle;
    border-radius:          0px 0px @radius-xl @radius-xl;
    padding:                8px 20px;
    orientation:            horizontal;
    spacing:                0px;
    expand:                 false;
    children:               [ footer-hints-left, spacer, footer-status ];
}

footer-hints-left {
    background-color:       transparent;
    orientation:            horizontal;
    spacing:                18px;
    expand:                 false;
    children:               [
                                fh-enter,
                                fh-ctrl-s,
                                fh-ctrl-c,
                                fh-ctrl-t,
                                fh-ctrl-r,
                                fh-ctrl-d,
                                fh-esc
                            ];
}

fh-enter {
    background-color:       transparent;
    content:                "⏎ Translate";
    font:                   @font-hint;
    text-color:             @fg-hint;
    vertical-align:         0.5;
}

fh-ctrl-s {
    background-color:       transparent;
    content:                "^S Swap";
    font:                   @font-hint;
    text-color:             @fg-hint;
    vertical-align:         0.5;
}

fh-ctrl-c {
    background-color:       transparent;
    content:                "^C Copy";
    font:                   @font-hint;
    text-color:             @fg-hint;
    vertical-align:         0.5;
}

fh-ctrl-t {
    background-color:       transparent;
    content:                "^T TTS";
    font:                   @font-hint;
    text-color:             @fg-hint;
    vertical-align:         0.5;
}

fh-ctrl-r {
    background-color:       transparent;
    content:                "^R Retry";
    font:                   @font-hint;
    text-color:             @fg-hint;
    vertical-align:         0.5;
}

fh-ctrl-d {
    background-color:       transparent;
    content:                "^D Detect";
    font:                   @font-hint;
    text-color:             @fg-hint;
    vertical-align:         0.5;
}

fh-esc {
    background-color:       transparent;
    content:                "Esc Close";
    font:                   @font-hint;
    text-color:             @fg-hint;
    vertical-align:         0.5;
}

footer-status {
    background-color:       transparent;
    orientation:            horizontal;
    spacing:                14px;
    expand:                 false;
    children:               [
                                fs-provider-status,
                                fs-divider,
                                fs-latency,
                                fs-divider2,
                                fs-cache
                            ];
}

fs-provider-status {
    background-color:       transparent;
    content:                "● Google — Online";
    font:                   @font-hint;
    text-color:             @fg-success;
    vertical-align:         0.5;
}

fs-divider {
    background-color:       @border-subtle;
    expand:                 false;
    width:                  1px;
    margin:                 6px 0px;
}

fs-latency {
    background-color:       transparent;
    content:                "󰓅  142ms";
    font:                   @font-hint;
    text-color:             @fg-hint;
    vertical-align:         0.5;
}

fs-divider2 {
    background-color:       @border-subtle;
    expand:                 false;
    width:                  1px;
    margin:                 6px 0px;
}

fs-cache {
    background-color:       transparent;
    content:                "󰋗  Cache: 847";
    font:                   @font-hint;
    text-color:             @fg-hint;
    vertical-align:         0.5;
}

/* ── Rofi internals (message, textbox, num-rows) ─────────────────────────── */
message {
    background-color:       transparent;
    border:                 0px;
    padding:                0px;
    margin:                 0px;
}

textbox {
    background-color:       transparent;
    padding:                0px;
    border:                 0px;
    text-color:             @fg-muted;
    font:                   @font-small;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    highlight:              none;
    blink:                  false;
    markup:                 true;
}

num-rows {
    background-color:       transparent;
    text-color:             @fg-muted;
    font:                   @font-small;
    expand:                 false;
}

num-filtered-rows {
    background-color:       transparent;
    text-color:             @accent;
    font:                   @font-small;
    expand:                 false;
}