/* ══════════════════════════════════════════════════════════════════════════════
 * ASH DOTFILES v5.0 OMEGA — TRANSLATION ULTRA PREMIUM UI
 * ══════════════════════════════════════════════════════════════════════════════
 * File    : translation.rasi
 * Author  : Ash Dotfiles v5.0 Omega
 * License : MIT
 * Desc    : Ultra premium real-time translation interface for Rofi.
 *
 *           Layout (1080 × 680px):
 *           ┌─────────────────────────────────────────────────────────┐
 *           │  HEADER — logo · title · provider switcher · settings  │
 *           ├────────────────────────────────────────────────────────-│
 *           │  LANG BAR — [source lang pills] ⇄ [target lang pills]  │
 *           ├───────────────────────────────┬─────────────────────────┤
 *           │  INPUT PANEL                  │  HISTORY PANEL          │
 *           │  • search/entry               │  • recent 10 pairs      │
 *           │  • char counter               │  • favourite pairs      │
 *           │  • TTS + clipboard btns       │  • search history       │
 *           ├───────────────────────────────┤                         │
 *           │  OUTPUT PANEL                 │                         │
 *           │  • translation result         │                         │
 *           │  • phonetic / romanisation    │                         │
 *           │  • TTS + copy + export btns   │                         │
 *           ├───────────────────────────────┴─────────────────────────┤
 *           │  FOOTER — keybind hints · engine status · word count    │
 *           └─────────────────────────────────────────────────────────┘
 *
 *           Keybind map (10 custom bindings):
 *           Ctrl+S  → Swap source ↔ target language
 *           Ctrl+C  → Copy translation to clipboard
 *           Ctrl+T  → Text-to-speech (result)
 *           Ctrl+H  → Toggle history panel
 *           Ctrl+F  → Add to favourites
 *           Ctrl+E  → Export translation
 *           Ctrl+P  → Paste from clipboard → translate
 *           Ctrl+R  → Retry with next provider
 *           Ctrl+D  → Detect source language
 *           Ctrl+X  → Clear all
 * ══════════════════════════════════════════════════════════════════════════════
 */

/* ── Design token import ────────────────────────────────────────────────── */
@import "style.rasi"

/* ══════════════════════════════════════════════════════════════════════════════
 * CONFIGURATION BLOCK
 * ══════════════════════════════════════════════════════════════════════════════
 */
configuration {
    /* ── Modi ───────────────────────────────────────────────────────────── */
    modi:                   "translation:~/.config/rofi/menus/translation/translation.sh";
    display-translation:    " 󰗊  Translate";

    /* ── Input ──────────────────────────────────────────────────────────── */
    case-sensitive:         false;
    cycle:                  true;
    filter:                 "";
    placeholder:            "󰗊  Type or paste text to translate…";

    /* ── Matching ───────────────────────────────────────────────────────── */
    matching:               "fuzzy";
    tokenize:               true;
    sort:                   false;

    /* ── Scroll ─────────────────────────────────────────────────────────── */
    scroll-method:          0;
    window-thumbnail:       false;

    /* ── Core Keybinds ──────────────────────────────────────────────────── */
    kb-accept-entry:        "Return,KP_Enter";
    kb-accept-alt:          "shift+Return";
    kb-remove-char-back:    "BackSpace";
    kb-remove-word-back:    "ctrl+BackSpace";
    kb-remove-to-eol:       "ctrl+k";
    kb-remove-to-sol:       "ctrl+u";
    kb-move-front:          "ctrl+a";
    kb-move-end:            "ctrl+e";
    kb-cancel:              "Escape,ctrl+g";
    kb-row-up:              "Up,ctrl+p";
    kb-row-down:            "Down,ctrl+n";
    kb-page-next:           "ctrl+f,ctrl+Right";
    kb-page-prev:           "ctrl+b,ctrl+Left";
    kb-row-first:           "ctrl+Home";
    kb-row-last:            "ctrl+End";
    kb-mode-next:           "ctrl+Tab";
    kb-mode-previous:       "ctrl+shift+Tab";

    /* ── Custom Action Keybinds ─────────────────────────────────────────── */
    kb-custom-1:            "ctrl+s";        /* Swap languages         */
    kb-custom-2:            "ctrl+c";        /* Copy result            */
    kb-custom-3:            "ctrl+t";        /* TTS result             */
    kb-custom-4:            "ctrl+h";        /* Toggle history         */
    kb-custom-5:            "ctrl+f";        /* Favourite pair         */
    kb-custom-6:            "ctrl+e";        /* Export translation     */
    kb-custom-7:            "ctrl+p";        /* Paste → translate      */
    kb-custom-8:            "ctrl+r";        /* Retry / next provider  */
    kb-custom-9:            "ctrl+d";        /* Detect source lang     */
    kb-custom-10:           "ctrl+x";        /* Clear all              */

    /* ── Language Quick-select (Alt+1–9) ────────────────────────────────── */
    kb-select-1:            "alt+1";
    kb-select-2:            "alt+2";
    kb-select-3:            "alt+3";
    kb-select-4:            "alt+4";
    kb-select-5:            "alt+5";
    kb-select-6:            "alt+6";
    kb-select-7:            "alt+7";
    kb-select-8:            "alt+8";
    kb-select-9:            "alt+9";

    /* ── Performance ────────────────────────────────────────────────────── */
    threads:                0;
    lazy-grab:              false;
}

/* ══════════════════════════════════════════════════════════════════════════════
 * ROOT WINDOW
 * ══════════════════════════════════════════════════════════════════════════════
 */
window {
    /* Geometry */
    width:                  1080px;
    height:                 680px;
    x-offset:               0px;
    y-offset:               0px;
    location:               center;
    anchor:                 center;

    /* Glass decoration */
    background-color:       @bg-window;
    border:                 1px solid;
    border-color:           @border-window;
    border-radius:          @radius-xl;

    /* Typography */
    font:                   @font-base;
    text-color:             @fg-primary;

    /* Wayland blur support flag */
    transparency:           "real";
    cursor:                 "default";
}

/* ══════════════════════════════════════════════════════════════════════════════
 * MAINBOX — ROOT LAYOUT
 * ══════════════════════════════════════════════════════════════════════════════
 */
mainbox {
    background-color:       transparent;
    border:                 0px;
    spacing:                0px;
    padding:                0px;
    orientation:            vertical;
    children:               [ header, lang-bar, content-body, footer ];
}

/* ══════════════════════════════════════════════════════════════════════════════
 * ── SECTION A: HEADER
 * ══════════════════════════════════════════════════════════════════════════════
 */
header {
    background-color:       @bg-header;
    border:                 0px 0px 1px 0px solid;
    border-color:           @border-subtle;
    border-radius:          @radius-xl @radius-xl 0px 0px;
    padding:                0px 20px;
    orientation:            horizontal;
    spacing:                14px;
    expand:                 false;
    children:               [
                                header-brand,
                                spacer,
                                provider-switcher,
                                header-divider,
                                header-controls
                            ];
}

/* ── Brand block ───────────────────────────────────────────────────────────── */
header-brand {
    background-color:       transparent;
    orientation:            horizontal;
    spacing:                10px;
    expand:                 false;
    children:               [ brand-icon-wrap, brand-text-wrap ];
}

brand-icon-wrap {
    background-color:       @accent-alpha;
    border-radius:          @radius-md;
    padding:                10px 12px;
    expand:                 false;
    children:               [ brand-icon ];
}

brand-icon {
    background-color:       transparent;
    content:                "󰗊";
    font:                   @font-icon-xl;
    text-color:             @accent;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    expand:                 false;
}

brand-text-wrap {
    background-color:       transparent;
    orientation:            vertical;
    spacing:                3px;
    expand:                 false;
    children:               [ brand-title, brand-subtitle ];
}

brand-title {
    background-color:       transparent;
    content:                "Translate";
    font:                   @font-title;
    text-color:             @fg-primary;
    vertical-align:         0.5;
    horizontal-align:       0.0;
}

brand-subtitle {
    background-color:       transparent;
    content:                "100+ languages · 6 engines · AI-powered";
    font:                   @font-xsmall;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    horizontal-align:       0.0;
}

/* ── Provider Switcher ─────────────────────────────────────────────────────── */
provider-switcher {
    background-color:       transparent;
    orientation:            horizontal;
    spacing:                6px;
    expand:                 false;
    children:               [
                                prov-label,
                                prov-google,
                                prov-deepl,
                                prov-libretranslate,
                                prov-ollama,
                                prov-lingva,
                                prov-mymemory
                            ];
}

prov-label {
    background-color:       transparent;
    content:                "Engine:";
    font:                   @font-small;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    expand:                 false;
}

prov-google {
    background-color:       @accent;
    border-radius:          @radius-pill;
    padding:                4px 10px;
    expand:                 false;
    content:                "🌐 Google";
    font:                   @font-provider;
    text-color:             @bg-window;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

prov-deepl {
    background-color:       @bg-provider-badge;
    border:                 1px solid;
    border-color:           @border-provider;
    border-radius:          @radius-pill;
    padding:                4px 10px;
    expand:                 false;
    content:                "🔒 DeepL";
    font:                   @font-provider;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

prov-libretranslate {
    background-color:       @bg-provider-badge;
    border:                 1px solid;
    border-color:           @border-provider;
    border-radius:          @radius-pill;
    padding:                4px 10px;
    expand:                 false;
    content:                "⚡ Libre";
    font:                   @font-provider;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

prov-ollama {
    background-color:       @bg-provider-badge;
    border:                 1px solid;
    border-color:           @border-provider;
    border-radius:          @radius-pill;
    padding:                4px 10px;
    expand:                 false;
    content:                "🤖 Ollama";
    font:                   @font-provider;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

prov-lingva {
    background-color:       @bg-provider-badge;
    border:                 1px solid;
    border-color:           @border-provider;
    border-radius:          @radius-pill;
    padding:                4px 10px;
    expand:                 false;
    content:                "⚡ Lingva";
    font:                   @font-provider;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

prov-mymemory {
    background-color:       @bg-provider-badge;
    border:                 1px solid;
    border-color:           @border-provider;
    border-radius:          @radius-pill;
    padding:                4px 10px;
    expand:                 false;
    content:                "🌐 MyMem";
    font:                   @font-provider;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

header-divider {
    background-color:       @border-subtle;
    expand:                 false;
    width:                  1px;
    margin:                 12px 4px;
}

/* ── Header Controls ───────────────────────────────────────────────────────── */
header-controls {
    background-color:       transparent;
    orientation:            horizontal;
    spacing:                6px;
    expand:                 false;
    children:               [ ctrl-history, ctrl-fav, ctrl-settings ];
}

ctrl-history {
    background-color:       @bg-surface;
    border:                 1px solid;
    border-color:           @border-subtle;
    border-radius:          @radius-sm;
    padding:                6px 10px;
    expand:                 false;
    content:                "󰹑";
    font:                   @font-icon-md;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

ctrl-fav {
    background-color:       @bg-surface;
    border:                 1px solid;
    border-color:           @border-subtle;
    border-radius:          @radius-sm;
    padding:                6px 10px;
    expand:                 false;
    content:                "★";
    font:                   @font-icon-sm;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

ctrl-settings {
    background-color:       @bg-surface;
    border:                 1px solid;
    border-color:           @border-subtle;
    border-radius:          @radius-sm;
    padding:                6px 10px;
    expand:                 false;
    content:                "󰒓";
    font:                   @font-icon-md;
    text-color:             @fg-secondary;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

spacer {
    background-color:       transparent;
    expand:                 true;
}

/* ══════════════════════════════════════════════════════════════════════════════
 * ── SECTION B: LANGUAGE BAR
 * ══════════════════════════════════════════════════════════════════════════════
 */
lang-bar {
    background-color:       @bg-lang-bar;
    border:                 0px 0px 1px 0px solid;
    border-color:           @border-subtle;
    padding:                8px 20px;
    orientation:            horizontal;
    spacing:                10px;
    expand:                 false;
    children:               [
                                source-lang-group,
                                swap-area,
                                target-lang-group
                            ];
}

/* ── Source language group ─────────────────────────────────────────────────── */
source-lang-group {
    background-color:       transparent;
    orientation:            horizontal;
    spacing:                6px;
    expand:                 true;
    children:               [
                                lang-src-detect,
                                lang-src-en,
                                lang-src-de,
                                lang-src-fr,
                                lang-src-es,
                                lang-src-zh,
                                lang-src-ja,
                                lang-src-ru,
                                lang-src-ar,
                                lang-src-more
                            ];
}

lang-src-detect {
    background-color:       @bg-detect-badge;
    border-radius:          @radius-pill;
    padding:                4px 11px;
    expand:                 false;
    content:                "󰍉  Auto";
    font:                   @font-ui;
    text-color:             @fg-detect;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

lang-src-en {
    background-color:       @bg-lang-btn-active;
    border:                 1px solid;
    border-color:           @border-active-lang;
    border-radius:          @radius-pill;
    padding:                4px 11px;
    expand:                 false;
    content:                "🇺🇸 EN";
    font:                   @font-lang-code;
    text-color:             @fg-lang-active;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

