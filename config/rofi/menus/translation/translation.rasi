/* ── Swap area ─────────────────────────────────────────────────────────────── */
swap-area {
    background-color:       transparent;
    orientation:            horizontal;
    spacing:                8px;
    expand:                 false;
    children:               [ swap-label-src, swap-btn, swap-label-tgt ];
}

swap-label-src {
    background-color:       transparent;
    content:                "SRC";
    font:                   @font-xsmall;
    text-color:             @fg-muted;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    expand:                 false;
}

swap-btn {
    background-color:       @bg-swap-btn;
    border-radius:          @radius-pill;
    padding:                6px 14px;
    expand:                 false;
    content:                "󰒊";
    font:                   @font-icon-lg;
    text-color:             @fg-swap;
    vertical-align:         0.5;
    horizontal-align:       0.5;
    cursor:                 pointer;
}

swap-label-tgt {
    background-color:       transparent;
