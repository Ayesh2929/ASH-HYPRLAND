/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Emoji Picker Style: Warm Amber                  ║
   ║                                                                              ║
   ║  Warm amber/peach/yellow palette. Emoji are colorful enough — the UI      ║
   ║  stays warm and neutral to let emoji colors pop.                           ║
   ║                                                                              ║
   ║  Color system:                                                               ║
   ║  • Yellow (#f9e2af)  — primary accent, search icon, count                  ║
   ║  • Peach (#fab387)   — secondary, skin button, category selected            ║
   ║  • Rosewater (#f5e0dc)— header, subtle highlights                           ║
   ║  • Mauve (#cba4f7)   — symbol button, copy action                          ║
   ║  • Teal (#94e2d5)    — recent entries                                       ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    /* ── Geometry ────────────────────────────────────────────────────────────── */
    em-width:                       720px;
    em-height:                      0px;
    em-y-offset:                    -50px;

    /* ── Window ──────────────────────────────────────────────────────────────── */
    em-win-bg:                      rgba(17, 17, 27, 0.95);
    em-win-border:                  rgba(249, 226, 175, 0.28);
    em-win-border-width:            1px;
    em-win-radius:                  18px;

    /* ── Header ──────────────────────────────────────────────────────────────── */
    em-header-bg:                   rgba(20, 20, 32, 0.72);
    em-header-border:               rgba(49, 50, 68, 0.80);
    em-header-border-width:         1px;

    /* ── Primary accent (warm yellow) ────────────────────────────────────────── */
    em-accent:                      #f9e2af;

    /* ── Generic buttons ─────────────────────────────────────────────────────── */
    em-btn-bg:                      rgba(49, 50, 68, 0.45);
    em-btn-fg:                      #a6adc8;
    em-btn-border:                  rgba(69, 71, 90, 0.45);

    /* ── Symbol button ───────────────────────────────────────────────────────── */
    em-sym-bg:                      rgba(203, 164, 247, 0.10);
    em-sym-fg:                      #cba4f7;
    em-sym-border:                  rgba(203, 164, 247, 0.28);

    /* ── Category strip ──────────────────────────────────────────────────────── */
    em-cat-bg:                      rgba(22, 22, 34, 0.60);
    em-cat-border:                  rgba(49, 50, 68, 0.80);
    em-cat-btn-bg:                  transparent;
    em-cat-btn-fg:                  rgba(108, 112, 134, 0.75);
    em-cat-btn-selected-bg:         rgba(249, 226, 175, 0.85);
    em-cat-btn-selected-fg:         #1e1e2e;
    em-cat-btn-selected-border:     rgba(249, 226, 175, 1.0);

    /* ── Search bar ──────────────────────────────────────────────────────────── */
    em-search-bg:                   rgba(30, 30, 46, 0.58);
    em-search-border:               rgba(49, 50, 68, 0.85);

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    em-text:                        #cdd6f4;
    em-muted:                       rgba(108, 112, 134, 0.65);
    em-highlight:                   #f9e2af;
    em-sep-color:                   rgba(69, 71, 90, 0.55);

    /* ── Count badge ──────────────────────────────────────────────────────────── */
    em-count-bg:                    rgba(249, 226, 175, 0.10);
    em-count-fg:                    #f9e2af;
    em-count-border:                rgba(249, 226, 175, 0.25);

    /* ── List view ────────────────────────────────────────────────────────────── */
    em-listview-bg:                 transparent;
    em-list-padding-v:              6px;
    em-list-spacing:                1px;
    em-list-lines:                  12;

    /* ── Elements ────────────────────────────────────────────────────────────── */
    em-element-radius:              @radius-sm;
    em-element-padding-v:           7px;
    em-element-padding-h:           14px;
    em-element-margin-h:            5px;
    em-element-fg:                  #cdd6f4;

    /* ── Recent entries ──────────────────────────────────────────────────────── */
    em-recent-bg:                   rgba(148, 226, 213, 0.08);
    em-recent-fg:                   #94e2d5;

    /* ── Selected ────────────────────────────────────────────────────────────── */
    em-selected-bg:                 rgba(249, 226, 175, 0.88);
    em-selected-fg:                 #1e1e2e;

    /* ── Alternate rows ──────────────────────────────────────────────────────── */
    em-alt-bg:                      rgba(30, 30, 46, 0.25);
    em-alt-fg:                      #9399b2;

    /* ── Preview ─────────────────────────────────────────────────────────────── */
    em-preview-bg:                  rgba(30, 30, 46, 0.55);
    em-preview-fg:                  #a6adc8;
    em-preview-border:              rgba(69, 71, 90, 0.60);

    /* ── Footer ──────────────────────────────────────────────────────────────── */
    em-footer-bg:                   rgba(17, 17, 27, 0.78);
    em-footer-border:               rgba(49, 50, 68, 0.70);
    em-hint-primary:                #f9e2af;
    em-hint-fg:                     rgba(108, 112, 134, 0.65);
}

/* ── Applied ──────────────────────────────────────────────────────────────── */
window {
    background-color:   rgba(17, 17, 27, 0.95);
    border-color:       rgba(249, 226, 175, 0.28);
    border:             1px;
    border-radius:      18px;
}

em-header {
    background-color:   rgba(20, 20, 32, 0.72);
    border-color:       rgba(49, 50, 68, 0.80);
}

em-title-emoji  { text-color: #cdd6f4; }
em-title-text   { text-color: #cdd6f4; }

em-skin-btn, em-recent-btn {
    background-color:   rgba(49, 50, 68, 0.45);
    text-color:         #a6adc8;
    border-color:       rgba(69, 71, 90, 0.45);
}

em-sym-btn {
    background-color:   rgba(203, 164, 247, 0.10);
    text-color:         #cba4f7;
    border-color:       rgba(203, 164, 247, 0.28);
}

em-category-strip {
    background-color:   rgba(22, 22, 34, 0.60);
    border-color:       rgba(49, 50, 68, 0.80);
}

em-total-count { text-color: rgba(108, 112, 134, 0.55); }

button {
    background-color:   transparent;
    text-color:         rgba(108, 112, 134, 0.75);
    border:             0px;
}

button.selected {
    background-color:   rgba(249, 226, 175, 0.85);
    text-color:         #1e1e2e;
    border:             1px;
    border-color:       rgba(249, 226, 175, 1.0);
}

em-searchbar {
    background-color:   rgba(30, 30, 46, 0.58);
    border-color:       rgba(49, 50, 68, 0.85);
}

em-search-icon  { text-color: #f9e2af; }
entry           { text-color: #cdd6f4; placeholder-color: rgba(108,112,134,0.55); }
em-shortcode-hint { text-color: rgba(88,91,112,0.45); }

num-filtered-rows {
    background-color:   rgba(249, 226, 175, 0.10);
    text-color:         #f9e2af;
    border-color:       rgba(249, 226, 175, 0.25);
}

element normal.normal  { background-color: transparent; text-color: #cdd6f4; }
element normal.active  { background-color: rgba(148,226,213,0.08); text-color: #94e2d5; }
element normal.urgent  { background-color: rgba(250,179,135,0.08); text-color: #fab387; }

element selected.normal {
    background-color:   rgba(249, 226, 175, 0.88);
    text-color:         #1e1e2e;
}

element selected.active { background-color: #94e2d5; text-color: #1e1e2e; }
element selected.urgent { background-color: #fab387; text-color: #1e1e2e; }

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.25);
    text-color:         #9399b2;
}

element-text { highlight: bold #f9e2af; }

message {
    background-color:   rgba(30, 30, 46, 0.55);
    border-color:       rgba(69, 71, 90, 0.60);
}

textbox { text-color: #a6adc8; }

em-footer {
    background-color:   rgba(17, 17, 27, 0.78);
    border-color:       rgba(49, 50, 68, 0.70);
}

em-hint-type   { text-color: #f9e2af; }
em-hint-copy,
em-hint-typeonly,
em-hint-recent { text-color: rgba(108, 112, 134, 0.65); }

em-hint-sep-1,
em-hint-sep-2,
em-hint-sep-3  { text-color: rgba(49, 50, 68, 0.70); }

em-unicode-display { text-color: rgba(69, 71, 90, 0.40); }