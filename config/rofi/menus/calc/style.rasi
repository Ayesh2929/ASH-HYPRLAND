/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Calculator Style: Teal Precision                 ║
   ║                                                                              ║
   ║  Clean, precise aesthetic with teal/sapphire accent. Calculator UIs        ║
   ║  need clarity above all — monospace font, high contrast result, subtle      ║
   ║  history list and minimal decoration.                                       ║
   ║                                                                              ║
   ║  Color system:                                                               ║
   ║  • Teal (#94e2d5)    — primary accent, result value, copy action           ║
   ║  • Sapphire (#74c7ec)— secondary, expression prefix, history icons         ║
   ║  • Green (#a6e3a1)   — positive results, correct calculations              ║
   ║  • Red (#f38ba8)     — errors, clear button, negative results              ║
   ║  • Yellow (#f9e2af)  — memory slot, operator hints                         ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    /* ── Geometry ────────────────────────────────────────────────────────────── */
    ca-width:                       580px;
    ca-height:                      0px;
    ca-y-offset:                    -60px;

    /* ── Window ──────────────────────────────────────────────────────────────── */
    ca-win-bg:                      rgba(17, 17, 27, 0.96);
    ca-win-border:                  rgba(148, 226, 213, 0.30);
    ca-win-border-width:            1px;
    ca-win-radius:                  16px;

    /* ── Header ──────────────────────────────────────────────────────────────── */
    ca-header-bg:                   rgba(20, 20, 32, 0.75);
    ca-header-border:               rgba(49, 50, 68, 0.80);
    ca-header-border-width:         1px;

    /* ── Primary accent (teal) ────────────────────────────────────────────────── */
    ca-accent:                      #94e2d5;

    /* ── Mode badge ───────────────────────────────────────────────────────────── */
    ca-badge-bg:                    rgba(116, 199, 236, 0.12);
    ca-badge-fg:                    #74c7ec;
    ca-badge-border:                rgba(116, 199, 236, 0.28);

    /* ── Generic buttons ──────────────────────────────────────────────────────── */
    ca-btn-bg:                      rgba(49, 50, 68, 0.45);
    ca-btn-fg:                      #a6adc8;
    ca-btn-border:                  rgba(69, 71, 90, 0.45);

    /* ── Danger/clear button ──────────────────────────────────────────────────── */
    ca-danger-bg:                   rgba(243, 139, 168, 0.10);
    ca-danger-fg:                   #f38ba8;
    ca-danger-border:               rgba(243, 139, 168, 0.28);

    /* ── Input display (expression) ───────────────────────────────────────────── */
    ca-display-bg:                  rgba(24, 24, 37, 0.85);
    ca-display-border:              rgba(49, 50, 68, 0.90);
    ca-display-padding-v:           14px;
    ca-display-padding-h:           20px;
    ca-expr-prefix-fg:              rgba(116, 199, 236, 0.50);
    ca-expr-fg:                     #cdd6f4;

    /* ── Result display ───────────────────────────────────────────────────────── */
    ca-result-bg:                   rgba(14, 14, 22, 0.90);
    ca-result-border:               rgba(49, 50, 68, 0.85);
    ca-result-padding-v:            16px;
    ca-result-padding-h:            20px;
    ca-result-label-fg:             rgba(148, 226, 213, 0.50);
    ca-result-fg:                   #94e2d5;
    ca-result-extra-fg:             rgba(108, 112, 134, 0.65);

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    ca-text:                        #cdd6f4;
    ca-muted:                       rgba(108, 112, 134, 0.60);
    ca-highlight:                   #94e2d5;
    ca-sep-color:                   rgba(69, 71, 90, 0.55);

    /* ── List view ────────────────────────────────────────────────────────────── */
    ca-listview-bg:                 transparent;
    ca-list-padding-v:              5px;
    ca-list-spacing:                1px;
    ca-list-lines:                  8;

    /* ── Elements ─────────────────────────────────────────────────────────────── */
    ca-element-radius:              @radius-sm;
    ca-element-padding-v:           7px;
    ca-element-padding-h:           16px;
    ca-element-margin-h:            5px;
    ca-element-fg:                  #cdd6f4;

    /* ── Memory slot ──────────────────────────────────────────────────────────── */
    ca-memory-bg:                   rgba(249, 226, 175, 0.08);
    ca-memory-fg:                   #f9e2af;

    /* ── Selected ─────────────────────────────────────────────────────────────── */
    ca-selected-bg:                 rgba(148, 226, 213, 0.85);
    ca-selected-fg:                 #1e1e2e;

    /* ── Alternate rows ───────────────────────────────────────────────────────── */
    ca-alt-bg:                      rgba(30, 30, 46, 0.25);
    ca-alt-fg:                      #9399b2;

    /* ── Message ──────────────────────────────────────────────────────────────── */
    ca-msg-bg:                      rgba(148, 226, 213, 0.08);
    ca-msg-fg:                      #a6adc8;
    ca-msg-border:                  rgba(148, 226, 213, 0.25);

    /* ── Footer ───────────────────────────────────────────────────────────────── */
    ca-footer-bg:                   rgba(17, 17, 27, 0.78);
    ca-footer-border:               rgba(49, 50, 68, 0.70);
    ca-hint-primary:                #94e2d5;
    ca-hint-fg:                     rgba(108, 112, 134, 0.65);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(17, 17, 27, 0.96);
    border-color:       rgba(148, 226, 213, 0.30);
    border:             1px;
    border-radius:      16px;
}

ca-header {
    background-color:   rgba(20, 20, 32, 0.75);
    border-color:       rgba(49, 50, 68, 0.80);
}

ca-title-icon   { text-color: #94e2d5; }
ca-title-text   { text-color: #cdd6f4; }

ca-mode-badge {
    background-color:   rgba(116, 199, 236, 0.12);
    text-color:         #74c7ec;
    border-color:       rgba(116, 199, 236, 0.28);
}

ca-history-btn {
    background-color:   rgba(49, 50, 68, 0.45);
    text-color:         #a6adc8;
    border-color:       rgba(69, 71, 90, 0.45);
}

ca-clear-btn {
    background-color:   rgba(243, 139, 168, 0.10);
    text-color:         #f38ba8;
    border-color:       rgba(243, 139, 168, 0.28);
}

ca-display {
    background-color:   rgba(24, 24, 37, 0.85);
    border-color:       rgba(49, 50, 68, 0.90);
}

ca-expr-prefix { text-color: rgba(116, 199, 236, 0.50); }
ca-expr-suffix { text-color: rgba(148, 226, 213, 0.35); }
entry          { text-color: #cdd6f4; placeholder-color: rgba(108, 112, 134, 0.55); font: "JetBrainsMono Nerd Font Bold 14"; }

ca-result-display {
    background-color:   rgba(14, 14, 22, 0.90);
    border-color:       rgba(49, 50, 68, 0.85);
}

ca-result-label { text-color: rgba(148, 226, 213, 0.50); }
ca-result-value { text-color: #94e2d5; font: "JetBrainsMono Nerd Font Bold 22"; }
ca-result-extra { text-color: rgba(108, 112, 134, 0.60); }

element normal.normal  { background-color: transparent; text-color: #cdd6f4; }
element normal.active  { background-color: rgba(249,226,175,0.08); text-color: #f9e2af; }
element normal.urgent  { background-color: rgba(243,139,168,0.08); text-color: #f38ba8; }

element selected.normal {
    background-color:   rgba(148, 226, 213, 0.85);
    text-color:         #1e1e2e;
}

element selected.active {
    background-color:   #94e2d5;
    text-color:         #1e1e2e;
}

element selected.urgent {
    background-color:   #f38ba8;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.25);
    text-color:         #9399b2;
}

element-text { highlight: bold #94e2d5; }

message {
    background-color:   rgba(148, 226, 213, 0.08);
    border-color:       rgba(148, 226, 213, 0.25);
}

textbox { text-color: #a6adc8; }

ca-footer {
    background-color:   rgba(17, 17, 27, 0.78);
    border-color:       rgba(49, 50, 68, 0.70);
}

ca-hint-copy       { text-color: #94e2d5; }
ca-hint-expr,
ca-hint-hist,
ca-hint-mem        { text-color: rgba(108, 112, 134, 0.65); }

ca-hint-sep-1,
ca-hint-sep-2,
ca-hint-sep-3      { text-color: rgba(49, 50, 68, 0.70); }

ca-precision-display { text-color: rgba(69, 71, 90, 0.40); }