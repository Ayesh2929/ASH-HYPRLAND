/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Process Killer / Task Manager                    ║
   ║                                                                              ║
   ║  Full process management via Rofi. View all processes sorted by CPU/RAM,  ║
   ║  send signals (SIGTERM/SIGKILL/SIGSTOP/SIGCONT), freeze, renice and        ║
   ║  filter by user/type. Emergency kill-all for hung applications.            ║
   ║                                                                              ║
   ║  Sort modes:                                                                 ║
   ║  󰊚 CPU%     󰍛 RAM%     󰬷 PID     󰂷 Name      ⏱ Runtime                     ║
   ║                                                                              ║
   ║  Process type icons:                                                         ║
   ║  󰖟 Browser    󰆍 Terminal    󰅩 Editor     󰊗 Game        󰋩 System             ║
   ║  󰙯 Social     󰝚 Media       󰡨 Docker     󰕙 X/Wayland   󰻁 Background        ║
   ║                                                                              ║
   ║  Layout:                                                                     ║
   ║  ╔═══════════════════════════════════════════════════════════════════╗      ║
   ║  ║  󰻁 Process Manager      [CPU] [MEM] [PID] [Name]  [User: all]    ║      ║
   ║  ╠═══════════════════════════════════════════════════════════════════╣      ║
   ║  ║  CPU: 12.4%  ·  RAM: 4.2/15.6G  ·  Tasks: 312  ·  Load: 0.8    ║      ║
   ║  ╠═══════════════════════════════════════════════════════════════════╣      ║
   ║  ║  󰍉 Filter processes by name, PID or command…           312 procs ║      ║
   ║  ╠═══════════════════════════════════════════════════════════════════╣      ║
   ║  ║  󰖟  firefox        PID:1234  CPU:8.2%  RAM:512MB  $USER  2h14m   ║      ║
   ║  ║  󰋩  Xwayland        PID:891   CPU:3.1%  RAM:86MB   $USER  5h03m   ║      ║
   ║  ║  󰡨  postgres        PID:2341  CPU:1.4%  RAM:240MB  root   1d03h   ║      ║
   ║  ║  󰆍  kitty           PID:4521  CPU:0.8%  RAM:32MB   $USER  0h22m   ║      ║
   ║  ╠═══════════════════════════════════════════════════════════════════╣      ║
   ║  ║  ↩ kill(TERM)  ⌥↩ kill(KILL)  ^S stop  ^C cont  ^N renice  ^I info ║    ║
   ║  ╚═══════════════════════════════════════════════════════════════════╝      ║
   ║                                                                              ║
   ║  Usage: ~/.config/rofi/menus/process-killer/process-killer.sh             ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

@import "../../colors.rasi"
@import "../../fonts.rasi"
@import "style.rasi"

/* ══════════════════════════════════════════════════════════════════════════════
   §01  CONFIGURATION
   ══════════════════════════════════════════════════════════════════════════════ */

configuration {
    modes:              "pk:~/.config/rofi/menus/process-killer/process-killer.sh";
    show-icons:         false;
    font:               "JetBrainsMono Nerd Font 12";
    case-sensitive:     false;
    matching:           "fuzzy";
    sort:               false;
    click-to-exit:      true;
    steal-focus:        false;
    fixed-num-lines:    false;
    display-pk:         "";

    kb-custom-1:        "ctrl+s";         /* SIGSTOP (freeze) */
    kb-custom-2:        "ctrl+c";         /* SIGCONT (resume) */
    kb-custom-3:        "ctrl+n";         /* Renice */
    kb-custom-4:        "ctrl+i";         /* Process info */
    kb-custom-5:        "ctrl+r";         /* Refresh */
    kb-custom-6:        "ctrl+u";         /* Toggle user filter */
    kb-custom-7:        "ctrl+t";         /* Sort by CPU */
    kb-custom-8:        "ctrl+m";         /* Sort by MEM */
    kb-custom-9:        "ctrl+p";         /* Sort by PID */
    kb-custom-10:       "ctrl+k";         /* Kill all matching name */
    kb-custom-11:       "ctrl+e";         /* Open htop/btop */
    kb-custom-12:       "alt+Return";     /* Force kill (SIGKILL) */
    kb-custom-13:       "ctrl+h";         /* Toggle show all / user only */
    kb-custom-14:       "ctrl+d";         /* Strace process */
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  WINDOW
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    width:              @pk-width;
    height:             @pk-height;
    x-offset:           0px;
    y-offset:           @pk-y-offset;
    location:           center;
    anchor:             center;
    fullscreen:         false;

    background-color:   @pk-win-bg;
    border-color:       @pk-win-border;
    border:             @pk-win-border-width;
    border-radius:      @pk-win-radius;

    padding:            0px;
    cursor:             "default";
}

/* ══════════════════════════════════════════════════════════════════════════════
   §03  MAIN BOX
   ══════════════════════════════════════════════════════════════════════════════ */

mainbox {
    background-color:   transparent;
    border:             0px;
    padding:            0px;
    spacing:            0px;
    orientation:        vertical;
    children:           [pk-header, pk-sys-bar, pk-searchbar, listview, pk-footer];
}

/* ══════════════════════════════════════════════════════════════════════════════
   §04  HEADER — TITLE + SORT CONTROLS
   ══════════════════════════════════════════════════════════════════════════════ */

pk-header {
    background-color:   @pk-header-bg;
    border:             0px 0px @pk-header-border-width 0px;
    border-color:       @pk-header-border;
    border-radius:      @pk-win-radius @pk-win-radius 0px 0px;
    padding:            11px 18px;
    spacing:            8px;
    orientation:        horizontal;
    expand:             false;
    children:           [pk-title-icon, pk-title-text, pk-header-spacer, pk-sort-cpu, pk-sort-mem, pk-sort-pid, pk-sort-name, pk-user-filter];
}

pk-title-icon {
    background-color:   transparent;
    text-color:         @pk-accent;
    font:               "Symbols Nerd Font Mono 18";
    str:                "󰻁";
    expand:             false;
    vertical-align:     0.5;
}

pk-title-text {
    background-color:   transparent;
    text-color:         @pk-text;
    font:               "JetBrainsMono Nerd Font Bold 14";
    str:                "Process Manager";
    expand:             false;
    vertical-align:     0.5;
}

pk-header-spacer {
    background-color:   transparent;
    expand:             true;
}

pk-sort-cpu {
    background-color:   @pk-sort-active-bg;
    text-color:         @pk-sort-active-fg;
    border:             1px;
    border-color:       @pk-sort-active-border;
    border-radius:      @radius-pill;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "󰊚 CPU";
    padding:            2px 10px;
    expand:             false;
    vertical-align:     0.5;
    cursor:             pointer;
}

pk-sort-mem {
    background-color:   @pk-sort-bg;
    text-color:         @pk-sort-fg;
    border:             1px;
    border-color:       @pk-sort-border;
    border-radius:      @radius-pill;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "󰍛 MEM";
    padding:            2px 10px;
    expand:             false;
    vertical-align:     0.5;
    cursor:             pointer;
}

pk-sort-pid {
    background-color:   @pk-sort-bg;
    text-color:         @pk-sort-fg;
    border:             1px;
    border-color:       @pk-sort-border;
    border-radius:      @radius-pill;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "󰬷 PID";
    padding:            2px 10px;
    expand:             false;
    vertical-align:     0.5;
    cursor:             pointer;
}

pk-sort-name {
    background-color:   @pk-sort-bg;
    text-color:         @pk-sort-fg;
    border:             1px;
    border-color:       @pk-sort-border;
    border-radius:      @radius-pill;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "󰂷 Name";
    padding:            2px 10px;
    expand:             false;
    vertical-align:     0.5;
    cursor:             pointer;
}

pk-user-filter {
    background-color:   @pk-user-bg;
    text-color:         @pk-user-fg;
    border:             1px;
    border-color:       @pk-user-border;
    border-radius:      @radius-pill;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "󰀄 Mine";
    padding:            2px 10px;
    expand:             false;
    vertical-align:     0.5;
    cursor:             pointer;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §05  SYSTEM RESOURCE BAR
   ══════════════════════════════════════════════════════════════════════════════ */

pk-sys-bar {
    background-color:   @pk-sys-bg;
    border:             0px 0px 1px 0px;
    border-color:       @pk-sys-border;
    padding:            6px 18px;
    spacing:            6px;
    orientation:        horizontal;
    expand:             false;
    children:           [pk-sys-cpu, pk-sys-sep-1, pk-sys-ram, pk-sys-sep-2, pk-sys-tasks, pk-sys-sep-3, pk-sys-load, pk-sys-spacer, pk-sys-uptime];
}

pk-sys-cpu {
    background-color:   transparent;
    text-color:         @pk-cpu-fg;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "󰊚 CPU: ──%";
    expand:             false;
    vertical-align:     0.5;
}

pk-sys-sep-1, pk-sys-sep-2, pk-sys-sep-3 {
    background-color:   transparent;
    text-color:         @pk-sep-color;
    font:               "JetBrainsMono Nerd Font 11";
    str:                "  ·  ";
    expand:             false;
    vertical-align:     0.5;
}

pk-sys-ram {
    background-color:   transparent;
    text-color:         @pk-ram-fg;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "󰍛 RAM: ─/─G";
    expand:             false;
    vertical-align:     0.5;
}

pk-sys-tasks {
    background-color:   transparent;
    text-color:         @pk-muted;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "Tasks: ─";
    expand:             false;
    vertical-align:     0.5;
}

pk-sys-load {
    background-color:   transparent;
    text-color:         @pk-muted;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "Load: ─.─";
    expand:             false;
    vertical-align:     0.5;
}

pk-sys-spacer {
    background-color:   transparent;
    expand:             true;
}

pk-sys-uptime {
    background-color:   transparent;
    text-color:         @pk-muted;
    font:               "JetBrainsMono Nerd Font 9";
    str:                "up ─h";
    expand:             false;
    vertical-align:     0.5;
    horizontal-align:   1.0;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §06  SEARCH BAR
   ══════════════════════════════════════════════════════════════════════════════ */

pk-searchbar {
    background-color:   @pk-search-bg;
    border:             0px 0px 1px 0px;
    border-color:       @pk-search-border;
    padding:            8px 18px;
    spacing:            8px;
    orientation:        horizontal;
    expand:             false;
    children:           [pk-search-icon, entry, num-filtered-rows, pk-process-count];
}

inputbar {
    background-color:   transparent;
    border:             0px;
    padding:            0px;
    children:           [entry];
}

pk-search-icon {
    background-color:   transparent;
    text-color:         @pk-accent;
    font:               "Symbols Nerd Font Mono 13";
    str:                "󰍉";
    expand:             false;
    vertical-align:     0.5;
}

entry {
    background-color:   transparent;
    text-color:         @pk-text;
    placeholder-color:  @pk-muted;
    placeholder:        "Filter by name, PID, command or user…";
    font:               "JetBrainsMono Nerd Font 12";
    cursor:             text;
    expand:             true;
    blink:              true;
}

num-filtered-rows {
    background-color:   @pk-count-bg;
    text-color:         @pk-count-fg;
    border:             1px;
    border-color:       @pk-count-border;
    border-radius:      @radius-pill;
    font:               "JetBrainsMono Nerd Font 10";
    padding:            1px 8px;
    expand:             false;
    vertical-align:     0.5;
}

pk-process-count {
    background-color:   transparent;
    text-color:         @pk-muted;
    font:               "JetBrainsMono Nerd Font 9";
    str:                "0 procs";
    expand:             false;
    vertical-align:     0.5;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §07  LIST VIEW — PROCESS LIST
   ══════════════════════════════════════════════════════════════════════════════ */

listview {
    background-color:   @pk-listview-bg;
    border:             0px;
    padding:            @pk-list-padding-v 0px;
    margin:             0px;
    spacing:            @pk-list-spacing;
    columns:            1;
    lines:              @pk-list-lines;
    fixed-height:       true;
    dynamic:            true;
    layout:             vertical;
    flow:               vertical;
    cycle:              true;
    scrollbar:          false;
    expand:             true;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §08  PROCESS ELEMENTS
   ══════════════════════════════════════════════════════════════════════════════ */

element {
    background-color:   transparent;
    border:             0px;
    border-radius:      @pk-element-radius;
    padding:            @pk-element-padding-v @pk-element-padding-h;
    margin:             0px @pk-element-margin-h;
    spacing:            0px;
    orientation:        horizontal;
    cursor:             pointer;
}

/* ── Normal: regular user process ────────────────────────────────────────── */
element normal.normal {
    background-color:   transparent;
    text-color:         @pk-element-fg;
}

/* ── Active: high CPU process ────────────────────────────────────────────── */
element normal.active {
    background-color:   @pk-high-cpu-bg;
    text-color:         @pk-high-cpu-fg;
}

/* ── Urgent: system/root process ─────────────────────────────────────────── */
element normal.urgent {
    background-color:   @pk-system-bg;
    text-color:         @pk-system-fg;
}

/* ── Selected states ─────────────────────────────────────────────────────── */
element selected.normal {
    background-color:   @pk-selected-bg;
    text-color:         @pk-selected-fg;
}

element selected.active {
    background-color:   @red;
    text-color:         @base;
}

element selected.urgent {
    background-color:   @yellow;
    text-color:         @base;
}

/* ── Alternate rows ───────────────────────────────────────────────────────── */
element alternate.normal {
    background-color:   @pk-alt-bg;
    text-color:         @pk-alt-fg;
}

element alternate.active {
    background-color:   @pk-high-cpu-alt-bg;
    text-color:         @pk-high-cpu-fg;
}

element-icon {
    background-color:   transparent;
    size:               0px;
    padding:            0px;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    font:               "JetBrainsMono Nerd Font 12";
    cursor:             inherit;
    expand:             true;
    vertical-align:     0.5;
    highlight:          bold @pk-highlight;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §09  MESSAGE — PROCESS DETAIL / SIGNAL RESULT
   ══════════════════════════════════════════════════════════════════════════════ */

message {
    background-color:   @pk-msg-bg;
    border:             1px;
    border-color:       @pk-msg-border;
    border-radius:      @radius-sm;
    padding:            5px 16px;
    margin:             0px 6px 3px 6px;
    expand:             false;
}

textbox {
    background-color:   transparent;
    text-color:         @pk-msg-fg;
    font:               "JetBrainsMono Nerd Font 11";
    highlight:          none;
    markup:             true;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §10  FOOTER
   ══════════════════════════════════════════════════════════════════════════════ */

pk-footer {
    background-color:   @pk-footer-bg;
    border:             1px 0px 0px 0px;
    border-color:       @pk-footer-border;
    border-radius:      0px 0px @pk-win-radius @pk-win-radius;
    padding:            8px 18px;
    spacing:            0px;
    orientation:        horizontal;
    expand:             false;
    children:           [pk-hint-term, pk-hint-sep-1, pk-hint-kill, pk-hint-sep-2, pk-hint-stop, pk-hint-sep-3, pk-hint-renice, pk-hint-sep-4, pk-hint-info, pk-footer-spacer, pk-htop-hint];
}

pk-hint-term {
    background-color:   transparent;
    text-color:         @pk-hint-primary;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "↩ SIGTERM";
    expand:             false;
    vertical-align:     0.5;
}

pk-hint-sep-1, pk-hint-sep-2,
pk-hint-sep-3, pk-hint-sep-4 {
    background-color:   transparent;
    text-color:         @pk-sep-color;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "  │  ";
    expand:             false;
    vertical-align:     0.5;
}

pk-hint-kill {
    background-color:   transparent;
    text-color:         @pk-hint-danger;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "⌥↩ SIGKILL";
    expand:             false;
    vertical-align:     0.5;
}

pk-hint-stop {
    background-color:   transparent;
    text-color:         @pk-hint-fg;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "^S freeze";
    expand:             false;
    vertical-align:     0.5;
}

pk-hint-renice {
    background-color:   transparent;
    text-color:         @pk-hint-fg;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "^N renice";
    expand:             false;
    vertical-align:     0.5;
}

pk-hint-info {
    background-color:   transparent;
    text-color:         @pk-hint-fg;
    font:               "JetBrainsMono Nerd Font 10";
    str:                "^I info";
    expand:             false;
    vertical-align:     0.5;
}

pk-footer-spacer {
    background-color:   transparent;
    expand:             true;
}

pk-htop-hint {
    background-color:   transparent;
    text-color:         rgba(88, 91, 112, 0.40);
    font:               "JetBrainsMono Nerd Font 9";
    str:                "^E btop  ·  ASH v5.0";
    expand:             false;
    vertical-align:     0.5;
    horizontal-align:   1.0;
}