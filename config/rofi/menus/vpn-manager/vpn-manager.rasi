/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — VPN Manager Theme                                 ║
   ║                                                                              ║
   ║  Deep navy glass with a green "secure" accent — matches the VPN status       ║
   ║  module in the Waybar panel.                                                 ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

configuration {
    show-icons:                     true;
    drun-display-format:            "{name}";
    disable-history:                false;
    sorting-method:                 "fzf";
    case-sensitive:                 false;
    matching:                       "normal";
    hover-select:                   true;
}

@import "~/.config/rofi/menus/vpn-manager/style.rasi"
