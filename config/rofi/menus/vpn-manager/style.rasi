/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — VPN Manager Style: Secure Green                  ║
   ║                                                                              ║
   ║  • Green  (#a6e3a1) — connected / secure state                              ║
   ║  • Blue   (#89b4fa) — selectable profiles                                   ║
   ║  • Red    (#f38ba8) — failures                                              ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    vpn-width:                      560px;
    vpn-y-offset:                   -50px;

    vpn-win-bg:                     rgba(17, 17, 27, 0.94);
    vpn-win-border:                 #a6e3a1cc;
    vpn-main-bg:                    rgba(24, 24, 37, 0.96);

    vpn-fg:                         #cdd6f4ff;
    vpn-fg-dim:                     #9399b2ff;
    vpn-accent:                     #a6e3a1ff;
    vpn-accent-alt:                 #89b4faff;
    vpn-urgent:                     #f38ba8ff;

    vpn-font:                       "JetBrainsMono Nerd Font 11";
    vpn-radius:                     14px;
    vpn-padding:                    14px;
}

window {
    width:                          var(vpn-width);
    y-offset:                       var(vpn-y-offset);
    background-color:               var(vpn-win-bg);
    border:                         2px;
    border-color:                   var(vpn-win-border);
    border-radius:                  var(vpn-radius);
    padding:                        var(vpn-padding);
}

mainbox {
    background-color:               transparent;
    spacing:                        10px;
}

inputbar {
    background-color:               var(vpn-main-bg);
    text-color:                     var(vpn-fg);
    border-radius:                  10px;
    padding:                        8px 12px;
    font:                           var(vpn-font);
}

prompt {
    text-color:                     var(vpn-accent);
    padding:                        0 8px 0 0;
}

entry {
    text-color:                     var(vpn-fg);
    placeholder:                    "Select a VPN profile…";
    placeholder-color:              var(vpn-fg-dim);
}

listview {
    background-color:               transparent;
    lines:                          10;
    scrollbar:                      false;
    border:                         0;
}

element {
    background-color:               transparent;
    text-color:                     var(vpn-fg);
    padding:                        9px 12px;
    border-radius:                  8px;
    font:                           var(vpn-font);
}

element selected {
    background-color:               var(vpn-main-bg);
    text-color:                     var(vpn-accent-alt);
}

element urgent {
    text-color:                     var(vpn-urgent);
}

element-text {
    background-color:               transparent;
    vertical-align:                 0.5;
}

element-icon {
    size:                           1.05em;
    padding:                        0 10px 0 0;
}
