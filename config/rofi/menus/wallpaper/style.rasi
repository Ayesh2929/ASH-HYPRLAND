/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Wallpaper Menu Style: Warm Glass               ║
   ║                                                                              ║
   ║  Warm peach/yellow accent on deep dark glass. Evokes warmth of sunsets,   ║
   ║  landscapes and natural wallpapers. Gold highlights, amber selection.      ║
   ║                                                                              ║
   ║  Color system:                                                               ║
   ║  • Peach (#fab387)   — primary accent, icons, selected border              ║
   ║  • Yellow (#f9e2af)  — secondary accent, active states                     ║
   ║  • Flamingo (#f2cdcd)— badge, AI button                                   ║
   ║  • Green (#a6e3a1)   — download accent                                    ║
   ║  • Blue (#89b4fa)    — count badge                                         ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

/* ══════════════════════════════════════════════════════════════════════════════
   §01  TOKEN SYSTEM
   ══════════════════════════════════════════════════════════════════════════════ */

* {
    /* ── Geometry ────────────────────────────────────────────────────────────── */
    wp-width:                       720px;
    wp-height:                      0px;
    wp-y-offset:                    -50px;

    /* ── Window ──────────────────────────────────────────────────────────────── */
    wp-win-bg:                      rgba(17, 17, 27, 0.94);
    wp-win-border:                  rgba(250, 179, 135, 0.30);
    wp-win-border-width:            1px;
    wp-win-radius:                  18px;

    /* ── Header ──────────────────────────────────────────────────────────────── */
    wp-header-bg:                   rgba(20, 20, 32, 0.72);
    wp-header-border:               rgba(49, 50, 68, 0.80);
    wp-header-border-width:         1px;

    /* ── Accent colors ───────────────────────────────────────────────────────── */
    wp-accent:                      #fab387;      /* Peach */
    wp-accent-2:                    #f9e2af;      /* Yellow */
    wp-accent-3:                    #a6e3a1;      /* Green (download) */

    /* ── Header action buttons ───────────────────────────────────────────────── */
    wp-action-bg:                   rgba(49, 50, 68, 0.45);
    wp-action-fg:                   #a6adc8;
    wp-action-border:               rgba(69, 71, 90, 0.45);
    wp-action-border-width:         1px;

    /* ── AI button (special accent) ──────────────────────────────────────────── */
    wp-ai-bg:                       rgba(203, 164, 247, 0.12);
    wp-ai-fg:                       #cba4f7;
    wp-ai-border:                   rgba(203, 164, 247, 0.30);

    /* ── Search bar ──────────────────────────────────────────────────────────── */
    wp-search-bg:                   rgba(30, 30, 46, 0.55);
    wp-search-border:               rgba(49, 50, 68, 0.85);

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    wp-text:                        #cdd6f4;
    wp-subtext:                     #a6adc8;
    wp-muted:                       rgba(108, 112, 134, 0.60);
    wp-highlight:                   #f9e2af;

    /* ── Count badge ──────────────────────────────────────────────────────────── */
    wp-count-bg:                    rgba(250, 179, 135, 0.12);
    wp-count-fg:                    #fab387;
    wp-count-border:                rgba(250, 179, 135, 0.30);

    /* ── Category strip ──────────────────────────────────────────────────────── */
    wp-category-bg:                 rgba(22, 22, 34, 0.60);
    wp-category-border:             rgba(49, 50, 68, 0.80);

    /* ── Mode buttons ────────────────────────────────────────────────────────── */
    wp-btn-bg:                      transparent;
    wp-btn-fg:                      rgba(108, 112, 134, 0.75);
    wp-btn-border:                  transparent;
    wp-btn-border-width:            0px;
    wp-btn-selected-bg:             rgba(250, 179, 135, 0.85);
    wp-btn-selected-fg:             #1e1e2e;
    wp-btn-selected-border:         rgba(250, 179, 135, 1.0);

    /* ── List view ────────────────────────────────────────────────────────────── */
    wp-listview-bg:                 transparent;
    wp-list-padding-v:              6px;
    wp-list-spacing:                1px;
    wp-list-lines:                  12;

    /* ── Elements ────────────────────────────────────────────────────────────── */
    wp-element-radius:              @radius-sm;
    wp-element-padding-v:           7px;
    wp-element-padding-h:           16px;
    wp-element-margin-h:            6px;
    wp-element-fg:                  #cdd6f4;
    wp-active-bg:                   rgba(250, 179, 135, 0.10);
    wp-selected-bg:                 rgba(250, 179, 135, 0.88);
    wp-selected-fg:                 #1e1e2e;
    wp-alt-bg:                      rgba(30, 30, 46, 0.25);
    wp-alt-fg:                      #9399b2;

    /* ── Status bar ──────────────────────────────────────────────────────────── */
    wp-status-bg:                   rgba(17, 17, 27, 0.75);
    wp-status-border:               rgba(49, 50, 68, 0.70);
    wp-status-fg:                   rgba(108, 112, 134, 0.70);
    wp-status-sep:                  rgba(49, 50, 68, 0.80);
    wp-hint-fg:                     rgba(88, 91, 112, 0.60);

    /* ── Message ─────────────────────────────────────────────────────────────── */
    wp-msg-bg:                      rgba(250, 179, 135, 0.08);
    wp-msg-fg:                      #a6adc8;
    wp-msg-border:                  rgba(250, 179, 135, 0.25);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(17, 17, 27, 0.94);
    border-color:       rgba(250, 179, 135, 0.30);
    border:             1px;
    border-radius:      18px;
}

/* ── Header ───────────────────────────────────────────────────────────────── */
wp-header {
    background-color:   rgba(20, 20, 32, 0.72);
    border-color:       rgba(49, 50, 68, 0.80);
}

wp-title-icon   { text-color: #fab387; }
wp-title-text   { text-color: #cdd6f4; }

wp-action-browse,
wp-action-download,
wp-action-slideshow {
    background-color:   rgba(49, 50, 68, 0.45);
    text-color:         #a6adc8;
    border-color:       rgba(69, 71, 90, 0.45);
}

wp-action-ai {
    background-color:   rgba(203, 164, 247, 0.12);
    text-color:         #cba4f7;
    border-color:       rgba(203, 164, 247, 0.30);
}

/* ── Search ───────────────────────────────────────────────────────────────── */
wp-searchbar {
    background-color:   rgba(30, 30, 46, 0.55);
    border-color:       rgba(49, 50, 68, 0.85);
}

wp-search-icon { text-color: #fab387; }
entry          { text-color: #cdd6f4; placeholder-color: rgba(108, 112, 134, 0.55); }

num-filtered-rows {
    background-color:   rgba(250, 179, 135, 0.12);
    text-color:         #fab387;
    border-color:       rgba(250, 179, 135, 0.30);
}

case-indicator { text-color: #fab387; }

/* ── Category strip ───────────────────────────────────────────────────────── */
wp-category-strip {
    background-color:   rgba(22, 22, 34, 0.60);
    border-color:       rgba(49, 50, 68, 0.80);
}

wp-wallpaper-count { text-color: rgba(108, 112, 134, 0.60); }

button {
    background-color:   transparent;
    text-color:         rgba(108, 112, 134, 0.75);
    border:             0px;
}

button.selected {
    background-color:   rgba(250, 179, 135, 0.85);
    text-color:         #1e1e2e;
    border-color:       rgba(250, 179, 135, 1.0);
    border:             1px;
}

/* ── List elements ────────────────────────────────────────────────────────── */
element normal.normal  { background-color: transparent; text-color: #cdd6f4; }
element normal.active  { background-color: rgba(250,179,135,0.10); text-color: #fab387; }
element normal.urgent  { background-color: rgba(243,139,168,0.10); text-color: #f38ba8; }

element selected.normal {
    background-color:   rgba(250, 179, 135, 0.88);
    text-color:         #1e1e2e;
}

element selected.active {
    background-color:   #fab387;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.25);
    text-color:         #9399b2;
}

/* Match highlight in warm gold */
element-text { highlight: bold #f9e2af; }

/* ── Status bar ───────────────────────────────────────────────────────────── */
wp-status-bar {
    background-color:   rgba(17, 17, 27, 0.75);
    border-color:       rgba(49, 50, 68, 0.70);
}

wp-status-transition,
wp-status-duration,
wp-status-monitor { text-color: rgba(108, 112, 134, 0.70); }

wp-status-sep-1,
wp-status-sep-2   { text-color: rgba(49, 50, 68, 0.80); }

wp-status-hint    { text-color: rgba(88, 91, 112, 0.60); }

/* ── Message ──────────────────────────────────────────────────────────────── */
message {
    background-color:   rgba(250, 179, 135, 0.08);
    border-color:       rgba(250, 179, 135, 0.25);
}

textbox { text-color: #a6adc8; }