/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — SSH Connect Style: Terminal Cyan                 ║
   ║                                                                              ║
   ║  Terminal-inspired cyan/teal aesthetic. SSH = secure shell = dark          ║
   ║  terminal feel with electric cyan accent. Online = green, offline = muted. ║
   ║                                                                              ║
   ║  Color system:                                                               ║
   ║  • Sky (#89dceb)     — primary accent, SSH icon, search                    ║
   ║  • Teal (#94e2d5)    — secondary, online indicators, tabs                  ║
   ║  • Sapphire (#74c7ec)— count badges, latency                               ║
   ║  • Green (#a6e3a1)   — online/reachable hosts                              ║
   ║  • Yellow (#f9e2af)  — favorites star                                       ║
   ║  • Red (#f38ba8)     — offline hosts, danger actions                       ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    /* ── Geometry ────────────────────────────────────────────────────────────── */
    sh-width:                       760px;
    sh-height:                      0px;
    sh-y-offset:                    -50px;

    /* ── Window ──────────────────────────────────────────────────────────────── */
    sh-win-bg:                      rgba(17, 17, 27, 0.96);
    sh-win-border:                  rgba(137, 220, 235, 0.28);
    sh-win-border-width:            1px;
    sh-win-radius:                  18px;

    /* ── Header ──────────────────────────────────────────────────────────────── */
    sh-header-bg:                   rgba(20, 20, 32, 0.80);
    sh-header-border:               rgba(49, 50, 68, 0.80);
    sh-header-border-width:         1px;

    /* ── Primary accent (sky/cyan — SSH terminal) ─────────────────────────────── */
    sh-accent:                      #89dceb;

    /* ── Add host button ──────────────────────────────────────────────────────── */
    sh-add-bg:                      rgba(166, 227, 161, 0.12);
    sh-add-fg:                      #a6e3a1;
    sh-add-border:                  rgba(166, 227, 161, 0.28);

    /* ── Generic buttons ──────────────────────────────────────────────────────── */
    sh-btn-bg:                      rgba(49, 50, 68, 0.45);
    sh-btn-fg:                      #a6adc8;
    sh-btn-border:                  rgba(69, 71, 90, 0.45);

    /* ── Category strip ───────────────────────────────────────────────────────── */
    sh-cat-bg:                      rgba(22, 22, 34, 0.68);
    sh-cat-border:                  rgba(49, 50, 68, 0.80);
    sh-tab-bg:                      transparent;
    sh-tab-fg:                      rgba(108, 112, 134, 0.80);
    sh-tab-selected-bg:             rgba(137, 220, 235, 0.85);
    sh-tab-selected-fg:             #1e1e2e;
    sh-tab-selected-border:         rgba(137, 220, 235, 1.0);

    /* ── Search bar ───────────────────────────────────────────────────────────── */
    sh-search-bg:                   rgba(30, 30, 46, 0.60);
    sh-search-border:               rgba(49, 50, 68, 0.85);

    /* ── Count badge ──────────────────────────────────────────────────────────── */
    sh-count-bg:                    rgba(116, 199, 236, 0.10);
    sh-count-fg:                    #74c7ec;
    sh-count-border:                rgba(116, 199, 236, 0.25);

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    sh-text:                        #cdd6f4;
    sh-muted:                       rgba(108, 112, 134, 0.65);
    sh-sep-color:                   rgba(69, 71, 90, 0.55);
    sh-highlight:                   #89dceb;

    /* ── List ─────────────────────────────────────────────────────────────────── */
    sh-listview-bg:                 transparent;
    sh-list-padding-v:              5px;
    sh-list-spacing:                1px;
    sh-list-lines:                  11;

    /* ── Elements ─────────────────────────────────────────────────────────────── */
    sh-element-radius:              @radius-sm;
    sh-element-padding-v:           7px;
    sh-element-padding-h:           16px;
    sh-element-margin-h:            5px;
    sh-element-fg:                  #cdd6f4;

    /* ── Online host ──────────────────────────────────────────────────────────── */
    sh-online-bg:                   rgba(166, 227, 161, 0.07);
    sh-online-fg:                   #a6e3a1;
    sh-online-alt-bg:               rgba(166, 227, 161, 0.04);

    /* ── Favorite host ────────────────────────────────────────────────────────── */
    sh-fav-bg:                      rgba(249, 226, 175, 0.07);
    sh-fav-fg:                      #f9e2af;

    /* ── Selected ─────────────────────────────────────────────────────────────── */
    sh-selected-bg:                 rgba(137, 220, 235, 0.88);
    sh-selected-fg:                 #1e1e2e;

    /* ── Alternate ────────────────────────────────────────────────────────────── */
    sh-alt-bg:                      rgba(30, 30, 46, 0.25);
    sh-alt-fg:                      #9399b2;

    /* ── Message ──────────────────────────────────────────────────────────────── */
    sh-msg-bg:                      rgba(137, 220, 235, 0.08);
    sh-msg-fg:                      #a6adc8;
    sh-msg-border:                  rgba(137, 220, 235, 0.25);

    /* ── Footer ───────────────────────────────────────────────────────────────── */
    sh-footer-bg:                   rgba(17, 17, 27, 0.80);
    sh-footer-border:               rgba(49, 50, 68, 0.70);
    sh-hint-primary:                #89dceb;
    sh-hint-fg:                     rgba(108, 112, 134, 0.65);
    sh-hint-accent:                 #f9e2af;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(17, 17, 27, 0.96);
    border-color:       rgba(137, 220, 235, 0.28);
    border:             1px;
    border-radius:      18px;
}

sh-header {
    background-color:   rgba(20, 20, 32, 0.80);
    border-color:       rgba(49, 50, 68, 0.80);
}

sh-title-icon   { text-color: #89dceb; }
sh-title-text   { text-color: #cdd6f4; }

sh-btn-add {
    background-color:   rgba(166, 227, 161, 0.12);
    text-color:         #a6e3a1;
    border-color:       rgba(166, 227, 161, 0.28);
}

sh-btn-keys, sh-btn-config {
    background-color:   rgba(49, 50, 68, 0.45);
    text-color:         #a6adc8;
    border-color:       rgba(69, 71, 90, 0.45);
}

sh-category-strip {
    background-color:   rgba(22, 22, 34, 0.68);
    border-color:       rgba(49, 50, 68, 0.80);
}

sh-host-count { text-color: rgba(108, 112, 134, 0.55); }

button {
    background-color:   transparent;
    text-color:         rgba(108, 112, 134, 0.80);
    border:             0px;
}

button.selected {
    background-color:   rgba(137, 220, 235, 0.85);
    text-color:         #1e1e2e;
    border:             1px;
    border-color:       rgba(137, 220, 235, 1.0);
}

sh-searchbar {
    background-color:   rgba(30, 30, 46, 0.60);
    border-color:       rgba(49, 50, 68, 0.85);
}

sh-search-icon  { text-color: #89dceb; }
sh-search-hint  { text-color: rgba(88, 91, 112, 0.45); }
entry           { text-color: #cdd6f4; placeholder-color: rgba(108,112,134,0.55); font: "JetBrainsMono Nerd Font 12"; }

num-filtered-rows {
    background-color:   rgba(116, 199, 236, 0.10);
    text-color:         #74c7ec;
    border-color:       rgba(116, 199, 236, 0.25);
}

/* ── Host element states ──────────────────────────────────────────────────── */
element normal.normal  { background-color: transparent; text-color: #cdd6f4; }
element normal.active  { background-color: rgba(166,227,161,0.07); text-color: #a6e3a1; }
element normal.urgent  { background-color: rgba(249,226,175,0.07); text-color: #f9e2af; }

element selected.normal {
    background-color:   rgba(137, 220, 235, 0.88);
    text-color:         #1e1e2e;
}

element selected.active {
    background-color:   #89dceb;
    text-color:         #1e1e2e;
}

element selected.urgent {
    background-color:   #f9e2af;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.25);
    text-color:         #9399b2;
}

element alternate.active {
    background-color:   rgba(166, 227, 161, 0.04);
    text-color:         #a6e3a1;
}

/* Monospace critical for column alignment */
element-text {
    font:               "JetBrainsMono Nerd Font 12";
    highlight:          bold #89dceb;
    text-color:         inherit;
}

/* ── Message ──────────────────────────────────────────────────────────────── */
message {
    background-color:   rgba(137, 220, 235, 0.08);
    border-color:       rgba(137, 220, 235, 0.25);
}

textbox { text-color: #a6adc8; }

/* ── Footer ───────────────────────────────────────────────────────────────── */
sh-footer {
    background-color:   rgba(17, 17, 27, 0.80);
    border-color:       rgba(49, 50, 68, 0.70);
}

sh-hint-connect  { text-color: #89dceb; }
sh-hint-sftp,
sh-hint-tunnel,
sh-hint-copy     { text-color: rgba(108, 112, 134, 0.65); }
sh-hint-fav      { text-color: #f9e2af; }

sh-hint-sep-1,
sh-hint-sep-2,
sh-hint-sep-3,
sh-hint-sep-4    { text-color: rgba(49, 50, 68, 0.70); }

sh-ssh-version   { text-color: rgba(69, 71, 90, 0.38); }