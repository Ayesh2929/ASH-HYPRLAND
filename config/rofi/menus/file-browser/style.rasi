/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — File Browser Style: Forest Depth                 ║
   ║                                                                              ║
   ║  Deep green/teal accent for file management — evokes directory trees,      ║
   ║  file systems and organized structure. Directories in blue, executables    ║
   ║  in green, special files in yellow, errors in red.                         ║
   ║                                                                              ║
   ║  Color system:                                                               ║
   ║  • Blue (#89b4fa)    — primary accent, search, directories                  ║
   ║  • Teal (#94e2d5)    — secondary, navigation tabs                           ║
   ║  • Green (#a6e3a1)   — executables, success states                          ║
   ║  • Sapphire (#74c7ec)— count badges, filter counts                          ║
   ║  • Yellow (#f9e2af)  — symlinks, special files                              ║
   ║  • Red (#f38ba8)     — delete action, broken links                         ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    /* ── Geometry ────────────────────────────────────────────────────────────── */
    fb-width:                       740px;
    fb-height:                      0px;
    fb-y-offset:                    -50px;

    /* ── Window ──────────────────────────────────────────────────────────────── */
    fb-win-bg:                      rgba(17, 17, 27, 0.96);
    fb-win-border:                  rgba(137, 180, 250, 0.28);
    fb-win-border-width:            1px;
    fb-win-radius:                  18px;

    /* ── Header ──────────────────────────────────────────────────────────────── */
    fb-header-bg:                   rgba(20, 20, 32, 0.80);
    fb-header-border:               rgba(49, 50, 68, 0.80);
    fb-header-border-width:         1px;

    /* ── Primary accent (blue — file system) ─────────────────────────────────── */
    fb-accent:                      #89b4fa;

    /* ── Path display ────────────────────────────────────────────────────────── */
    fb-path-bg:                     rgba(137, 180, 250, 0.12);
    fb-path-fg:                     #89b4fa;
    fb-path-border:                 rgba(137, 180, 250, 0.25);

    /* ── Header buttons ──────────────────────────────────────────────────────── */
    fb-btn-bg:                      rgba(49, 50, 68, 0.45);
    fb-btn-fg:                      #a6adc8;
    fb-btn-border:                  rgba(69, 71, 90, 0.45);

    /* ── Location strip ──────────────────────────────────────────────────────── */
    fb-loc-bg:                      rgba(22, 22, 34, 0.65);
    fb-loc-border:                  rgba(49, 50, 68, 0.80);

    /* ── Tab buttons ─────────────────────────────────────────────────────────── */
    fb-tab-bg:                      transparent;
    fb-tab-fg:                      rgba(108, 112, 134, 0.80);
    fb-tab-selected-bg:             rgba(137, 180, 250, 0.85);
    fb-tab-selected-fg:             #1e1e2e;
    fb-tab-selected-border:         rgba(137, 180, 250, 1.0);

    /* ── Search bar ──────────────────────────────────────────────────────────── */
    fb-search-bg:                   rgba(30, 30, 46, 0.60);
    fb-search-border:               rgba(49, 50, 68, 0.85);

    /* ── Count badge ──────────────────────────────────────────────────────────── */
    fb-count-bg:                    rgba(116, 199, 236, 0.10);
    fb-count-fg:                    #74c7ec;
    fb-count-border:                rgba(116, 199, 236, 0.25);

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    fb-text:                        #cdd6f4;
    fb-muted:                       rgba(108, 112, 134, 0.65);
    fb-sep-color:                   rgba(69, 71, 90, 0.55);
    fb-highlight:                   #89b4fa;

    /* ── List view ────────────────────────────────────────────────────────────── */
    fb-listview-bg:                 transparent;
    fb-list-padding-v:              5px;
    fb-list-spacing:                1px;
    fb-list-lines:                  12;

    /* ── Elements ─────────────────────────────────────────────────────────────── */
    fb-element-radius:              @radius-sm;
    fb-element-padding-v:           6px;
    fb-element-padding-h:           16px;
    fb-element-margin-h:            5px;
    fb-element-fg:                  #cdd6f4;

    /* ── Directory entries ───────────────────────────────────────────────────── */
    fb-dir-bg:                      rgba(137, 180, 250, 0.08);
    fb-dir-fg:                      #89b4fa;
    fb-dir-alt-bg:                  rgba(137, 180, 250, 0.05);

    /* ── Selected ─────────────────────────────────────────────────────────────── */
    fb-selected-bg:                 rgba(137, 180, 250, 0.88);
    fb-selected-fg:                 #1e1e2e;

    /* ── Alternate rows ───────────────────────────────────────────────────────── */
    fb-alt-bg:                      rgba(30, 30, 46, 0.25);
    fb-alt-fg:                      #9399b2;

    /* ── Preview message ──────────────────────────────────────────────────────── */
    fb-preview-bg:                  rgba(30, 30, 46, 0.55);
    fb-preview-fg:                  #a6adc8;
    fb-preview-border:              rgba(69, 71, 90, 0.60);

    /* ── Status bar ───────────────────────────────────────────────────────────── */
    fb-status-bg:                   rgba(17, 17, 27, 0.80);
    fb-status-border:               rgba(49, 50, 68, 0.70);
    fb-hint-primary:                #89b4fa;
    fb-hint-fg:                     rgba(108, 112, 134, 0.65);
    fb-hint-danger:                 rgba(243, 139, 168, 0.70);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(17, 17, 27, 0.96);
    border-color:       rgba(137, 180, 250, 0.28);
    border:             1px;
    border-radius:      18px;
}

fb-header {
    background-color:   rgba(20, 20, 32, 0.80);
    border-color:       rgba(49, 50, 68, 0.80);
}

fb-title-icon   { text-color: #89b4fa; }
fb-title-text   { text-color: #cdd6f4; }

fb-current-path {
    background-color:   rgba(137, 180, 250, 0.12);
    text-color:         #89b4fa;
    border-color:       rgba(137, 180, 250, 0.25);
}

fb-btn-up, fb-btn-hidden, fb-btn-sort {
    background-color:   rgba(49, 50, 68, 0.45);
    text-color:         #a6adc8;
    border-color:       rgba(69, 71, 90, 0.45);
}

fb-location-strip {
    background-color:   rgba(22, 22, 34, 0.65);
    border-color:       rgba(49, 50, 68, 0.80);
}

fb-dir-stats { text-color: rgba(108, 112, 134, 0.55); }

button {
    background-color:   transparent;
    text-color:         rgba(108, 112, 134, 0.80);
    border:             0px;
}

button.selected {
    background-color:   rgba(137, 180, 250, 0.85);
    text-color:         #1e1e2e;
    border:             1px;
    border-color:       rgba(137, 180, 250, 1.0);
}

fb-searchbar {
    background-color:   rgba(30, 30, 46, 0.60);
    border-color:       rgba(49, 50, 68, 0.85);
}

fb-search-icon  { text-color: #89b4fa; }
fb-size-display { text-color: rgba(88, 91, 112, 0.50); }
entry           { text-color: #cdd6f4; placeholder-color: rgba(108,112,134,0.55); }

num-filtered-rows {
    background-color:   rgba(116, 199, 236, 0.10);
    text-color:         #74c7ec;
    border-color:       rgba(116, 199, 236, 0.25);
}

/* ── File element states ──────────────────────────────────────────────────── */
element normal.normal {
    background-color:   transparent;
    text-color:         #cdd6f4;
}

element normal.active {
    /* Directory: blue tint */
    background-color:   rgba(137, 180, 250, 0.08);
    text-color:         #89b4fa;
}

element normal.urgent {
    /* Executable: green tint */
    background-color:   rgba(166, 227, 161, 0.07);
    text-color:         #a6e3a1;
}

element selected.normal {
    background-color:   rgba(137, 180, 250, 0.88);
    text-color:         #1e1e2e;
}

element selected.active {
    /* Selected directory */
    background-color:   #89b4fa;
    text-color:         #1e1e2e;
}

element selected.urgent {
    /* Selected executable */
    background-color:   #a6e3a1;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.25);
    text-color:         #9399b2;
}

element alternate.active {
    background-color:   rgba(137, 180, 250, 0.05);
    text-color:         #89b4fa;
}

/* Monospace critical for file listing alignment */
element-text {
    font:               "JetBrainsMono Nerd Font 12";
    highlight:          bold #89b4fa;
    text-color:         inherit;
}

/* ── Preview message ──────────────────────────────────────────────────────── */
message {
    background-color:   rgba(30, 30, 46, 0.55);
    border-color:       rgba(69, 71, 90, 0.60);
}

textbox { text-color: #a6adc8; font: "JetBrainsMono Nerd Font 11"; }

/* ── Status bar ───────────────────────────────────────────────────────────── */
fb-status-bar {
    background-color:   rgba(17, 17, 27, 0.80);
    border-color:       rgba(49, 50, 68, 0.70);
}

fb-status-path   { text-color: #89b4fa; }
fb-status-sep-1,
fb-status-sep-2,
fb-status-sep-3,
fb-status-sep-4  { text-color: rgba(69, 71, 90, 0.55); }
fb-status-count  { text-color: rgba(108, 112, 134, 0.60); }
fb-hint-open     { text-color: #89b4fa; }
fb-hint-copy     { text-color: rgba(108, 112, 134, 0.65); }
fb-hint-del      { text-color: rgba(243, 139, 168, 0.65); }
fb-hint-term     { text-color: rgba(108, 112, 134, 0.50); }