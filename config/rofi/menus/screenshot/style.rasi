/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Screenshot Menu Style: Glass Teal               ║
   ║                                                                              ║
   ║  Teal/sky accent on deep dark glass. Screenshots feel fresh and clean.    ║
   ║  Catppuccin sky/teal accent color system with frosted glass surfaces.      ║
   ║                                                                              ║
   ║  Color system:                                                               ║
   ║  • Sky (#89dceb)    — primary accent, selected items                       ║
   ║  • Teal (#94e2d5)   — active states, hover                                 ║
   ║  • Sapphire (#74c7ec) — badge, headers                                     ║
   ║  • Peach (#fab387)  — match highlight                                      ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

/* ══════════════════════════════════════════════════════════════════════════════
   §01  COMPLETE TOKEN SYSTEM
   ══════════════════════════════════════════════════════════════════════════════ */

* {
    /* ── Geometry ────────────────────────────────────────────────────────────── */
    sc-width:                       560px;
    sc-y-offset:                    -50px;

    /* ── Window surface ───────────────────────────────────────────────────────── */
    sc-win-bg:                      rgba(17, 17, 27, 0.94);
    sc-win-border:                  rgba(137, 220, 235, 0.30);
    sc-win-border-width:            1px;
    sc-win-radius:                  18px;

    /* ── Header ──────────────────────────────────────────────────────────────── */
    sc-header-bg:                   rgba(20, 20, 32, 0.72);
    sc-header-border:               rgba(49, 50, 68, 0.80);
    sc-header-border-width:         1px;

    /* ── Accent ──────────────────────────────────────────────────────────────── */
    sc-accent:                      #89dceb;      /* Sky */
    sc-accent-2:                    #94e2d5;      /* Teal */
    sc-accent-3:                    #74c7ec;      /* Sapphire */

    /* ── Badge ───────────────────────────────────────────────────────────────── */
    sc-badge-bg:                    rgba(137, 220, 235, 0.12);
    sc-badge-fg:                    #89dceb;
    sc-badge-border:                rgba(137, 220, 235, 0.30);

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    sc-text:                        #cdd6f4;
    sc-subtext:                     #a6adc8;
    sc-muted:                       rgba(108, 112, 134, 0.60);
    sc-highlight:                   #fab387;

    /* ── Input bar ────────────────────────────────────────────────────────────── */
    sc-inputbar-bg:                 rgba(30, 30, 46, 0.55);
    sc-inputbar-border:             rgba(49, 50, 68, 0.85);
    sc-inputbar-border-width:       1px;

    /* ── List view ────────────────────────────────────────────────────────────── */
    sc-listview-bg:                 transparent;
    sc-list-padding-v:              6px;
    sc-list-spacing:                1px;
    sc-list-lines:                  14;

    /* ── Elements ────────────────────────────────────────────────────────────── */
    sc-element-radius:              @radius-sm;
    sc-element-padding-v:           7px;
    sc-element-padding-h:           16px;
    sc-element-margin-h:            6px;
    sc-element-fg:                  #cdd6f4;
    sc-active-bg:                   rgba(137, 220, 235, 0.10);
    sc-selected-bg:                 rgba(137, 220, 235, 0.88);
    sc-selected-fg:                 #1e1e2e;
    sc-alt-bg:                      rgba(30, 30, 46, 0.25);
    sc-alt-fg:                      #9399b2;

    /* ── Section header items (non-selectable) ───────────────────────────────── */
    sc-section-bg:                  transparent;
    sc-section-fg:                  rgba(116, 199, 236, 0.60);

    /* ── Footer ──────────────────────────────────────────────────────────────── */
    sc-footer-bg:                   rgba(17, 17, 27, 0.75);
    sc-footer-border:               rgba(49, 50, 68, 0.70);
    sc-footer-border-width:         1px;
    sc-hint-fg:                     rgba(88, 91, 112, 0.60);
    sc-path-fg:                     rgba(116, 199, 236, 0.40);

    /* ── Message ─────────────────────────────────────────────────────────────── */
    sc-msg-bg:                      rgba(137, 220, 235, 0.08);
    sc-msg-fg:                      #a6adc8;
    sc-msg-border:                  rgba(137, 220, 235, 0.25);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(17, 17, 27, 0.94);
    border-color:       rgba(137, 220, 235, 0.30);
    border:             1px;
    border-radius:      18px;
}

/* ── Header ───────────────────────────────────────────────────────────────── */
sc-header {
    background-color:   rgba(20, 20, 32, 0.72);
    border-color:       rgba(49, 50, 68, 0.80);
}

sc-title-icon   { text-color: #89dceb; }
sc-title-text   { text-color: #cdd6f4; }
sc-version-badge {
    background-color: rgba(137, 220, 235, 0.12);
    text-color: #89dceb;
    border-color: rgba(137, 220, 235, 0.30);
}

/* ── Search filter ────────────────────────────────────────────────────────── */
sc-inputbar {
    background-color:   rgba(30, 30, 46, 0.55);
    border-color:       rgba(49, 50, 68, 0.85);
}
prompt  { text-color: #89dceb; }
entry   { text-color: #cdd6f4; placeholder-color: rgba(108, 112, 134, 0.55); }
num-filtered-rows { text-color: rgba(88, 91, 112, 0.55); }

/* ── Section header items ─────────────────────────────────────────────────── */
/* Section headers are non-selectable — styled as dividers */
element normal.normal {
    background-color:   transparent;
    text-color:         #cdd6f4;
}

/* Section header detection: items starting with "───" */
element selected.normal {
    background-color:   rgba(137, 220, 235, 0.88);
    text-color:         #1e1e2e;
}

element selected.active {
    background-color:   #89dceb;
    text-color:         #1e1e2e;
}

element normal.active {
    background-color:   rgba(137, 220, 235, 0.10);
    text-color:         #89dceb;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.25);
    text-color:         #9399b2;
}

element alternate.active {
    background-color:   rgba(137, 220, 235, 0.06);
    text-color:         #89dceb;
}

element-text { highlight: bold #fab387; }

/* ── Footer ───────────────────────────────────────────────────────────────── */
sc-footer {
    background-color:   rgba(17, 17, 27, 0.75);
    border-color:       rgba(49, 50, 68, 0.70);
}

sc-footer-actions { text-color: rgba(88, 91, 112, 0.60); }
sc-footer-path    { text-color: rgba(116, 199, 236, 0.40); }

/* ── Message ──────────────────────────────────────────────────────────────── */
message {
    background-color:   rgba(137, 220, 235, 0.08);
    border-color:       rgba(137, 220, 235, 0.25);
}
textbox { text-color: #a6adc8; }

/* ══════════════════════════════════════════════════════════════════════════════
   §03  SECTION HEADER VISUAL STYLE
   Section dividers (non-selectable items like "─── CAPTURE ───") use
   a muted label style to visually group the options below them.
   ══════════════════════════════════════════════════════════════════════════════ */

/* Non-selectable section headers get a special treatment */
element {
    /* Default padding for all elements */
    padding:            7px 16px;
}

/* Section label padding override (they have different padding) */
/* Cannot do per-item CSS in rofi without plugin — visual grouping
   is achieved via font styling in the str content */