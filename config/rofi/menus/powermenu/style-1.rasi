/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Power Menu Style 1: Glassmorphism Red           ║
   ║                                                                              ║
   ║  Premium frosted glass window with red danger accent on selected buttons,  ║
   ║  dark translucent surfaces, blur depth and catppuccin-aligned colors.      ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

/* ══════════════════════════════════════════════════════════════════════════════
   §01  COMPLETE TOKEN SYSTEM — STYLE 1
   ══════════════════════════════════════════════════════════════════════════════ */

* {
    /* ── Geometry ────────────────────────────────────────────────────────────── */
    pm-width:                       460px;
    pm-height:                      0px;
    pm-y-offset:                    -40px;
    pm-columns:                     6;

    /* ── Window ──────────────────────────────────────────────────────────────── */
    pm-win-bg:                      rgba(17, 17, 27, 0.94);
    pm-win-border:                  rgba(203, 164, 247, 0.28);
    pm-win-border-width:            1px;
    pm-win-radius:                  20px;

    /* ── Header / user section ───────────────────────────────────────────────── */
    pm-header-bg:                   rgba(20, 20, 32, 0.70);

    /* ── Avatar ──────────────────────────────────────────────────────────────── */
    pm-avatar-bg:                   rgba(203, 164, 247, 0.15);
    pm-avatar-border:               rgba(203, 164, 247, 0.35);
    pm-avatar-fg:                   #cba4f7;

    /* ── User info text ──────────────────────────────────────────────────────── */
    pm-username-fg:                 #cdd6f4;
    pm-hostname-fg:                 rgba(203, 164, 247, 0.80);
    pm-datetime-fg:                 #a6adc8;
    pm-uptime-fg:                   rgba(108, 112, 134, 0.75);

    /* ── Dividers ────────────────────────────────────────────────────────────── */
    pm-divider:                     rgba(49, 50, 68, 0.65);

    /* ── Button section ──────────────────────────────────────────────────────── */
    pm-button-section-bg:           transparent;
    pm-button-section-padding:      20px 16px;
    pm-button-spacing:              8px;

    /* ── Action buttons: default ─────────────────────────────────────────────── */
    pm-btn-bg:                      rgba(30, 30, 46, 0.50);
    pm-btn-fg:                      #cdd6f4;
    pm-btn-border:                  rgba(49, 50, 68, 0.60);
    pm-btn-border-width:            1px;
    pm-btn-radius:                  14px;
    pm-btn-padding-v:               16px;
    pm-btn-padding-h:               10px;
    pm-btn-font:                    "JetBrainsMono Nerd Font 12";

    /* ── Action buttons: alternate rows ──────────────────────────────────────── */
    pm-btn-alt-bg:                  rgba(24, 24, 37, 0.50);

    /* ── Action buttons: selected (DANGER RED) ───────────────────────────────── */
    pm-btn-selected-bg:             rgba(243, 139, 168, 0.85);
    pm-btn-selected-fg:             #1e1e2e;
    pm-btn-selected-border:         rgba(243, 139, 168, 1.0);
    pm-btn-selected-border-width:   2px;

    /* ── Footer ──────────────────────────────────────────────────────────────── */
    pm-footer-bg:                   rgba(17, 17, 27, 0.80);
    pm-footer-padding-v:            10px;
    pm-footer-padding-h:            16px;

    /* ── Cancel button ───────────────────────────────────────────────────────── */
    pm-cancel-bg:                   transparent;
    pm-cancel-fg:                   rgba(108, 112, 134, 0.80);
    pm-cancel-border:               rgba(69, 71, 90, 0.60);
    pm-cancel-border-width:         1px;

    /* ── Hint text ────────────────────────────────────────────────────────────── */
    pm-hint-fg:                     rgba(88, 91, 112, 0.55);

    /* ── Confirmation dialog ─────────────────────────────────────────────────── */
    pm-confirm-bg:                  rgba(243, 139, 168, 0.10);
    pm-confirm-fg:                  #cdd6f4;
    pm-confirm-border:              rgba(243, 139, 168, 0.35);
    pm-confirm-border-width:        1px;
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(17, 17, 27, 0.94);
    border-color:       rgba(203, 164, 247, 0.28);
    border:             1px;
    border-radius:      20px;
}

user-section {
    background-color:   rgba(20, 20, 32, 0.70);
    border-radius:      20px 20px 0px 0px;
}

user-avatar {
    background-color:   rgba(203, 164, 247, 0.15);
    border-color:       rgba(203, 164, 247, 0.35);
}

avatar-icon { text-color: #cba4f7; }
user-name   { text-color: #cdd6f4; }
user-host   { text-color: rgba(203, 164, 247, 0.75); }
user-datetime { text-color: #a6adc8; }
user-uptime { text-color: rgba(108, 112, 134, 0.70); }

pm-divider-1, pm-divider-2 { background-color: rgba(49, 50, 68, 0.65); }

element {
    background-color:   rgba(30, 30, 46, 0.50);
    border-color:       rgba(49, 50, 68, 0.60);
    border:             1px;
    border-radius:      14px;
}

element normal.normal {
    background-color:   rgba(30, 30, 46, 0.50);
    text-color:         #cdd6f4;
    border-color:       rgba(49, 50, 68, 0.60);
}

element selected.normal {
    /* Red danger selection */
    background-color:   rgba(243, 139, 168, 0.85);
    text-color:         #1e1e2e;
    border-color:       rgba(243, 139, 168, 1.0);
    border:             2px;
}

element alternate.normal {
    background-color:   rgba(24, 24, 37, 0.50);
    text-color:         #a6adc8;
    border-color:       rgba(49, 50, 68, 0.50);
}

/* Special color per action type when selected */
/* Lock → blue */
/* Suspend → yellow */
/* Logout → orange */
/* These require per-entry CSS which rofi applies via element-index */

pm-footer {
    background-color:   rgba(17, 17, 27, 0.80);
    border-radius:      0px 0px 20px 20px;
}

cancel-btn {
    text-color:         rgba(108, 112, 134, 0.80);
    border-color:       rgba(69, 71, 90, 0.60);
    border:             1px;
}

pm-footer-hint { text-color: rgba(88, 91, 112, 0.55); }

message {
    background-color:   rgba(243, 139, 168, 0.10);
    border-color:       rgba(243, 139, 168, 0.35);
    border:             1px;
}

textbox { text-color: #cdd6f4; }