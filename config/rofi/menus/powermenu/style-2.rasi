/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Power Menu Style 2: Dark Solid Danger            ║
   ║                                                                              ║
   ║  Fully opaque solid dark surface. High contrast selection colors:          ║
   ║  Shutdown=red, Reboot=orange, Hibernate=yellow, Suspend=teal,              ║
   ║  Logout=maroon, Lock=blue. Bold and unambiguous.                           ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    pm-width:                       480px;
    pm-height:                      0px;
    pm-y-offset:                    -40px;
    pm-columns:                     6;

    pm-win-bg:                      #1e1e2e;
    pm-win-border:                  #f38ba8;
    pm-win-border-width:            2px;
    pm-win-radius:                  16px;

    pm-header-bg:                   #181825;

    pm-avatar-bg:                   rgba(243, 139, 168, 0.12);
    pm-avatar-border:               #f38ba8;
    pm-avatar-fg:                   #f38ba8;

    pm-username-fg:                 #cdd6f4;
    pm-hostname-fg:                 #f38ba8;
    pm-datetime-fg:                 #a6adc8;
    pm-uptime-fg:                   #6c7086;

    pm-divider:                     #313244;

    pm-button-section-bg:           transparent;
    pm-button-section-padding:      20px 16px;
    pm-button-spacing:              8px;

    pm-btn-bg:                      #181825;
    pm-btn-fg:                      #cdd6f4;
    pm-btn-border:                  #313244;
    pm-btn-border-width:            1px;
    pm-btn-radius:                  12px;
    pm-btn-padding-v:               16px;
    pm-btn-padding-h:               10px;
    pm-btn-font:                    "JetBrainsMono Nerd Font Bold 12";

    pm-btn-alt-bg:                  #11111b;

    pm-btn-selected-bg:             #f38ba8;
    pm-btn-selected-fg:             #1e1e2e;
    pm-btn-selected-border:         #eba0ac;
    pm-btn-selected-border-width:   2px;

    pm-footer-bg:                   #11111b;
    pm-footer-padding-v:            10px;
    pm-footer-padding-h:            16px;

    pm-cancel-bg:                   #1e1e2e;
    pm-cancel-fg:                   #6c7086;
    pm-cancel-border:               #313244;
    pm-cancel-border-width:         1px;

    pm-hint-fg:                     #45475a;

    pm-confirm-bg:                  rgba(243, 139, 168, 0.12);
    pm-confirm-fg:                  #cdd6f4;
    pm-confirm-border:              #f38ba8;
    pm-confirm-border-width:        1px;
}

window {
    background-color:   #1e1e2e;
    border-color:       #f38ba8;
    border:             2px;
    border-radius:      16px;
}

user-section {
    background-color:   #181825;
    border-radius:      14px 14px 0px 0px;
}

user-avatar {
    background-color:   rgba(243, 139, 168, 0.12);
    border-color:       #f38ba8;
}

avatar-icon   { text-color: #f38ba8; }
user-name     { text-color: #cdd6f4; }
user-host     { text-color: #f38ba8; }
user-datetime { text-color: #a6adc8; }
user-uptime   { text-color: #6c7086; }

pm-divider-1, pm-divider-2 { background-color: #313244; }

element {
    background-color:   #181825;
    border-color:       #313244;
    border:             1px;
    border-radius:      12px;
}

element normal.normal {
    background-color:   #181825;
    text-color:         #cdd6f4;
    border-color:       #313244;
}

element selected.normal {
    background-color:   #f38ba8;
    text-color:         #1e1e2e;
    border-color:       #eba0ac;
    border:             2px;
}

element alternate.normal {
    background-color:   #11111b;
    text-color:         #a6adc8;
    border-color:       #313244;
}

pm-footer { background-color: #11111b; border-radius: 0px 0px 16px 16px; }
cancel-btn { background-color: #1e1e2e; text-color: #6c7086; border-color: #313244; border: 1px; }
pm-footer-hint { text-color: #45475a; }
message { background-color: rgba(243,139,168,0.12); border-color: #f38ba8; border: 1px; }
textbox { text-color: #cdd6f4; }