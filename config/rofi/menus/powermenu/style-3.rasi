/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Power Menu Style 3: Vertical Minimal            ║
   ║                                                                              ║
   ║  Tall vertical layout with large icon-only buttons in a 2×3 grid.         ║
   ║  Ultra-clean, no labels, pure icon communication. Each action type gets    ║
   ║  its own signature accent color. For touchscreen / large displays.         ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    pm-width:                       280px;
    pm-height:                      0px;
    pm-y-offset:                    0px;
    pm-columns:                     2;           /* 2-column 3-row grid */

    pm-win-bg:                      rgba(17, 17, 27, 0.96);
    pm-win-border:                  rgba(203, 164, 247, 0.20);
    pm-win-border-width:            1px;
    pm-win-radius:                  22px;

    pm-header-bg:                   rgba(22, 22, 34, 0.80);

    pm-avatar-bg:                   rgba(203, 164, 247, 0.12);
    pm-avatar-border:               rgba(203, 164, 247, 0.30);
    pm-avatar-fg:                   #cba4f7;

    pm-username-fg:                 #cdd6f4;
    pm-hostname-fg:                 rgba(203, 164, 247, 0.70);
    pm-datetime-fg:                 #9399b2;
    pm-uptime-fg:                   rgba(108, 112, 134, 0.60);

    pm-divider:                     rgba(49, 50, 68, 0.60);

    pm-button-section-bg:           transparent;
    pm-button-section-padding:      12px 12px;
    pm-button-spacing:              8px;

    /* Large pill buttons for touch */
    pm-btn-bg:                      rgba(30, 30, 46, 0.55);
    pm-btn-fg:                      #cdd6f4;
    pm-btn-border:                  rgba(49, 50, 68, 0.50);
    pm-btn-border-width:            1px;
    pm-btn-radius:                  16px;
    pm-btn-padding-v:               24px;
    pm-btn-padding-h:               16px;
    pm-btn-font:                    "JetBrainsMono Nerd Font 22";

    pm-btn-alt-bg:                  rgba(24, 24, 37, 0.55);

    /* Accent selection */
    pm-btn-selected-bg:             rgba(203, 164, 247, 0.85);
    pm-btn-selected-fg:             #1e1e2e;
    pm-btn-selected-border:         rgba(203, 164, 247, 1.0);
    pm-btn-selected-border-width:   2px;

    pm-footer-bg:                   rgba(15, 15, 24, 0.70);
    pm-footer-padding-v:            8px;
    pm-footer-padding-h:            14px;

    pm-cancel-bg:                   transparent;
    pm-cancel-fg:                   rgba(88, 91, 112, 0.70);
    pm-cancel-border:               rgba(49, 50, 68, 0.50);
    pm-cancel-border-width:         1px;

    pm-hint-fg:                     rgba(69, 71, 90, 0.60);

    pm-confirm-bg:                  rgba(203, 164, 247, 0.10);
    pm-confirm-fg:                  #cdd6f4;
    pm-confirm-border:              rgba(203, 164, 247, 0.30);
    pm-confirm-border-width:        1px;
}

window {
    background-color:   rgba(17, 17, 27, 0.96);
    border-color:       rgba(203, 164, 247, 0.20);
    border:             1px;
    border-radius:      22px;
}

user-section {
    background-color:   rgba(22, 22, 34, 0.80);
    border-radius:      22px 22px 0px 0px;
    padding:            20px 20px 16px 20px;
    orientation:        vertical;
    spacing:            8px;
}

user-avatar {
    background-color:   rgba(203, 164, 247, 0.12);
    border-color:       rgba(203, 164, 247, 0.30);
    margin:             0px auto;
}

avatar-icon { text-color: #cba4f7; font: "Symbols Nerd Font Mono 32"; }
user-name   { text-color: #cdd6f4; horizontal-align: 0.5; }
user-host   { text-color: rgba(203,164,247,0.70); horizontal-align: 0.5; }
user-datetime { text-color: #9399b2; horizontal-align: 0.5; }
user-uptime { text-color: rgba(108,112,134,0.60); horizontal-align: 0.5; }

pm-divider-1, pm-divider-2 { background-color: rgba(49,50,68,0.60); }

element {
    background-color:   rgba(30, 30, 46, 0.55);
    border-color:       rgba(49, 50, 68, 0.50);
    border:             1px;
    border-radius:      16px;
    padding:            24px 16px;
}

element normal.normal  { background-color: rgba(30, 30, 46, 0.55); text-color: #9399b2; }
element selected.normal {
    background-color:   rgba(203, 164, 247, 0.85);
    text-color:         #1e1e2e;
    border-color:       rgba(203, 164, 247, 1.0);
    border:             2px;
}
element alternate.normal { background-color: rgba(24, 24, 37, 0.55); text-color: #585b70; }

element-text {
    font:               "JetBrainsMono Nerd Font 20";
    horizontal-align:   0.5;
}

pm-footer {
    background-color:   rgba(15, 15, 24, 0.70);
    border-radius:      0px 0px 22px 22px;
}

cancel-btn { text-color: rgba(88,91,112,0.70); border-color: rgba(49,50,68,0.50); }
pm-footer-hint { text-color: rgba(69,71,90,0.55); }
message { background-color: rgba(203,164,247,0.10); border-color: rgba(203,164,247,0.30); }
textbox { text-color: #cdd6f4; horizontal-align: 0.5; }