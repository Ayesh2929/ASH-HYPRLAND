/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Theme Picker Style: Meta Glass                   ║
   ║                                                                              ║
   ║  The theme picker styles itself using the CURRENT active theme colors,     ║
   ║  creating a beautiful self-referential meta-theme experience.               ║
   ║  Uses Catppuccin Mocha as the base fallback palette.                       ║
   ║                                                                              ║
   ║  Color philosophy:                                                            ║
   ║  • Mauve (#cba4f7) — primary: theme picker uses mauve accent naturally     ║
   ║  • Blue (#89b4fa)  — secondary: navigation, categories                     ║
   ║  • Yellow (#f9e2af)— favorites indicator                                   ║
   ║  • Green (#a6e3a1) — active theme indicator                                ║
   ║  • Teal (#94e2d5)  — live reload, hot-swap indicator                       ║
   ║  • Purple gradient — AI generation button                                   ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

* {
    /* ── Geometry ────────────────────────────────────────────────────────────── */
    tp-width:                       760px;
    tp-height:                      0px;
    tp-y-offset:                    -50px;

    /* ── Window ──────────────────────────────────────────────────────────────── */
    tp-win-bg:                      rgba(17, 17, 27, 0.95);
    tp-win-border:                  rgba(203, 164, 247, 0.30);
    tp-win-border-width:            1px;
    tp-win-radius:                  18px;

    /* ── Header ──────────────────────────────────────────────────────────────── */
    tp-header-bg:                   rgba(20, 20, 32, 0.78);
    tp-header-border:               rgba(49, 50, 68, 0.80);
    tp-header-border-width:         1px;

    /* ── Primary accent (mauve — theme picker "signature" color) ──────────────── */
    tp-accent:                      #cba4f7;

    /* ── AI button (purple gradient feel) ────────────────────────────────────── */
    tp-ai-bg:                       rgba(203, 164, 247, 0.15);
    tp-ai-fg:                       #cba4f7;
    tp-ai-border:                   rgba(203, 164, 247, 0.35);
    tp-ai-hint-fg:                  #cba4f7;

    /* ── Generic action buttons ──────────────────────────────────────────────── */
    tp-btn-bg:                      rgba(49, 50, 68, 0.45);
    tp-btn-fg:                      #a6adc8;
    tp-btn-border:                  rgba(69, 71, 90, 0.45);

    /* ── Favorites button ────────────────────────────────────────────────────── */
    tp-fav-bg:                      rgba(249, 226, 175, 0.12);
    tp-fav-fg:                      #f9e2af;
    tp-fav-border:                  rgba(249, 226, 175, 0.30);

    /* ── Mode toggle button ──────────────────────────────────────────────────── */
    tp-mode-bg:                     rgba(49, 50, 68, 0.45);
    tp-mode-fg:                     #89b4fa;
    tp-mode-border:                 rgba(137, 180, 250, 0.30);

    /* ── Category strip ──────────────────────────────────────────────────────── */
    tp-cat-bg:                      rgba(22, 22, 34, 0.65);
    tp-cat-border:                  rgba(49, 50, 68, 0.80);
    tp-cat-btn-bg:                  transparent;
    tp-cat-btn-fg:                  rgba(108, 112, 134, 0.80);
    tp-cat-btn-selected-bg:         rgba(203, 164, 247, 0.85);
    tp-cat-btn-selected-fg:         #1e1e2e;
    tp-cat-btn-selected-border:     rgba(203, 164, 247, 1.0);

    /* ── Search bar ──────────────────────────────────────────────────────────── */
    tp-search-bg:                   rgba(30, 30, 46, 0.58);
    tp-search-border:               rgba(49, 50, 68, 0.85);

    /* ── Text ─────────────────────────────────────────────────────────────────── */
    tp-text:                        #cdd6f4;
    tp-muted:                       rgba(108, 112, 134, 0.65);
    tp-sep-color:                   rgba(69, 71, 90, 0.55);
    tp-highlight:                   #f9e2af;

    /* ── Count badge ──────────────────────────────────────────────────────────── */
    tp-count-bg:                    rgba(203, 164, 247, 0.10);
    tp-count-fg:                    #cba4f7;
    tp-count-border:                rgba(203, 164, 247, 0.25);

    /* ── List view ────────────────────────────────────────────────────────────── */
    tp-listview-bg:                 transparent;
    tp-list-padding-v:              5px;
    tp-list-spacing:                1px;
    tp-list-lines:                  11;

    /* ── Elements ─────────────────────────────────────────────────────────────── */
    tp-element-radius:              @radius-sm;
    tp-element-padding-v:           7px;
    tp-element-padding-h:           16px;
    tp-element-margin-h:            5px;
    tp-element-fg:                  #cdd6f4;

    /* ── Active (currently applied) theme indicator ───────────────────────────── */
    tp-active-bg:                   rgba(166, 227, 161, 0.08);
    tp-active-fg:                   #a6e3a1;

    /* ── Favorite item ───────────────────────────────────────────────────────── */
    tp-fav-item-bg:                 rgba(249, 226, 175, 0.07);
    tp-fav-item-fg:                 #f9e2af;

    /* ── Selected ─────────────────────────────────────────────────────────────── */
    tp-selected-bg:                 rgba(203, 164, 247, 0.88);
    tp-selected-fg:                 #1e1e2e;

    /* ── Alternate rows ───────────────────────────────────────────────────────── */
    tp-alt-bg:                      rgba(30, 30, 46, 0.25);
    tp-alt-fg:                      #9399b2;

    /* ── Status bar ───────────────────────────────────────────────────────────── */
    tp-status-bg:                   rgba(22, 22, 34, 0.70);
    tp-status-border:               rgba(49, 50, 68, 0.75);

    /* ── Live reload badge ────────────────────────────────────────────────────── */
    tp-reload-bg:                   rgba(148, 226, 213, 0.12);
    tp-reload-fg:                   #94e2d5;
    tp-reload-border:               rgba(148, 226, 213, 0.28);

    /* ── Footer ───────────────────────────────────────────────────────────────── */
    tp-footer-bg:                   rgba(17, 17, 27, 0.78);
    tp-footer-border:               rgba(49, 50, 68, 0.70);
    tp-hint-primary:                #cba4f7;
    tp-hint-fg:                     rgba(108, 112, 134, 0.65);

    /* ── Message / info panel ────────────────────────────────────────────────── */
    tp-msg-bg:                      rgba(203, 164, 247, 0.08);
    tp-msg-fg:                      #a6adc8;
    tp-msg-border:                  rgba(203, 164, 247, 0.25);
}

/* ══════════════════════════════════════════════════════════════════════════════
   §02  APPLIED STYLES
   ══════════════════════════════════════════════════════════════════════════════ */

window {
    background-color:   rgba(17, 17, 27, 0.95);
    border-color:       rgba(203, 164, 247, 0.30);
    border:             1px;
    border-radius:      18px;
}

tp-header {
    background-color:   rgba(20, 20, 32, 0.78);
    border-color:       rgba(49, 50, 68, 0.80);
}

tp-title-icon   { text-color: #cba4f7; }
tp-title-text   { text-color: #cdd6f4; }

tp-btn-ai {
    background-color:   rgba(203, 164, 247, 0.15);
    text-color:         #cba4f7;
    border-color:       rgba(203, 164, 247, 0.35);
}

tp-btn-random, tp-btn-toggle-mode {
    background-color:   rgba(49, 50, 68, 0.45);
    text-color:         #a6adc8;
    border-color:       rgba(69, 71, 90, 0.45);
}

tp-btn-favorites {
    background-color:   rgba(249, 226, 175, 0.12);
    text-color:         #f9e2af;
    border-color:       rgba(249, 226, 175, 0.30);
}

tp-category-strip {
    background-color:   rgba(22, 22, 34, 0.65);
    border-color:       rgba(49, 50, 68, 0.80);
}

tp-theme-count { text-color: rgba(108, 112, 134, 0.55); }

button {
    background-color:   transparent;
    text-color:         rgba(108, 112, 134, 0.80);
    border:             0px;
}

button.selected {
    background-color:   rgba(203, 164, 247, 0.85);
    text-color:         #1e1e2e;
    border:             1px;
    border-color:       rgba(203, 164, 247, 1.0);
}

tp-searchbar {
    background-color:   rgba(30, 30, 46, 0.58);
    border-color:       rgba(49, 50, 68, 0.85);
}

tp-search-icon  { text-color: #cba4f7; }
tp-search-meta  { text-color: rgba(88, 91, 112, 0.45); }
entry           { text-color: #cdd6f4; placeholder-color: rgba(108,112,134,0.55); }

num-filtered-rows {
    background-color:   rgba(203, 164, 247, 0.10);
    text-color:         #cba4f7;
    border-color:       rgba(203, 164, 247, 0.25);
}

/* ── Theme element states ─────────────────────────────────────────────────── */
element normal.normal  { background-color: transparent; text-color: #cdd6f4; }
element normal.active  { background-color: rgba(166,227,161,0.08); text-color: #a6e3a1; }
element normal.urgent  { background-color: rgba(249,226,175,0.07); text-color: #f9e2af; }

element selected.normal {
    background-color:   rgba(203, 164, 247, 0.88);
    text-color:         #1e1e2e;
}

element selected.active {
    background-color:   #a6e3a1;
    text-color:         #1e1e2e;
}

element selected.urgent {
    background-color:   #f9e2af;
    text-color:         #1e1e2e;
}

element alternate.normal {
    background-color:   rgba(30, 30, 46, 0.25);
    text-color:         #9399b2;
}

element-text { highlight: bold #f9e2af; }

/* ── Status bar ───────────────────────────────────────────────────────────── */
tp-status-bar {
    background-color:   rgba(22, 22, 34, 0.70);
    border-color:       rgba(49, 50, 68, 0.75);
}

tp-status-icon       { text-color: #cba4f7; }
tp-status-active     { text-color: #cdd6f4; }
tp-status-sep-1,
tp-status-sep-2      { text-color: rgba(69, 71, 90, 0.55); }
tp-status-accent     { text-color: #cba4f7; }
tp-status-reload     {
    background-color: rgba(148, 226, 213, 0.12);
    text-color: #94e2d5;
    border-color: rgba(148, 226, 213, 0.28);
}
tp-status-actions    { text-color: rgba(88, 91, 112, 0.50); }

/* ── Footer ───────────────────────────────────────────────────────────────── */
tp-footer {
    background-color:   rgba(17, 17, 27, 0.78);
    border-color:       rgba(49, 50, 68, 0.70);
}

tp-hint-apply   { text-color: #cba4f7; }
tp-hint-preview,
tp-hint-random  { text-color: rgba(108, 112, 134, 0.65); }
tp-hint-ai      { text-color: #cba4f7; }

tp-hint-sep-1,
tp-hint-sep-2,
tp-hint-sep-3   { text-color: rgba(49, 50, 68, 0.70); }

tp-version { text-color: rgba(69, 71, 90, 0.40); }

/* ── Message ──────────────────────────────────────────────────────────────── */
message {
    background-color:   rgba(203, 164, 247, 0.08);
    border-color:       rgba(203, 164, 247, 0.25);
}
textbox { text-color: #a6adc8; }