* {
    background-color: #1e1e2e;
    text-color: #cdd6f4;
    border-color: #89b4fa;
    selected-normal-background: #313244;
    selected-normal-foreground: #89b4fa;
    selected-urgent-background: #f38ba8;
    selected-urgent-foreground: #1e1e2e;
    selected-active-background: #89b4fa;
    selected-active-foreground: #1e1e2e;
}

window {
    width: 600px;
    location: center;
    anchor: center;
    fullscreen: false;
    border: 2px;
    border-radius: 12px;
    padding: 16px;
}

mainbox {
    children: [inputbar, listview];
}

inputbar {
    children: [prompt, entry];
    spacing: 8px;
    margin-bottom: 8px;
}

prompt {
    enabled: true;
    padding: 8px 12px;
    background-color: #313244;
    border-radius: 8px;
    text-color: #89b4fa;
    font: "JetBrains Mono Nerd Font 14";
}

entry {
    padding: 8px 12px;
    background-color: #313244;
    border-radius: 8px;
    text-color: #cdd6f4;
    placeholder-color: #6c7086;
    font: "JetBrains Mono Nerd Font 14";
}

listview {
    lines: 10;
    columns: 1;
    spacing: 4px;
    scrollbar: true;
    cycle: true;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
}

element-icon {
    size: 24px;
    margin-right: 12px;
}

element-text {
    vertical-align: 0.5;
}