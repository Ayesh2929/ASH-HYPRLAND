* {
    background-color: #eff1f5;
    text-color: #4c4f69;
    border-color: #1e66f5;
    selected-normal-background: #e6e9ef;
    selected-normal-foreground: #1e66f5;
    selected-urgent-background: #d20f39;
    selected-urgent-foreground: #eff1f5;
    selected-active-background: #1e66f5;
    selected-active-foreground: #eff1f5;
}

window {
    width: 600px;
    location: center;
    anchor: center;
    fullscreen: false;
    border: 2px;
    border-radius: 12px;
    padding: 16px;
}

mainbox {
    children: [inputbar, listview];
}

inputbar {
    children: [prompt, entry];
    spacing: 8px;
    margin-bottom: 8px;
}

prompt {
    enabled: true;
    padding: 8px 12px;
    background-color: #e6e9ef;
    border-radius: 8px;
    text-color: #1e66f5;
    font: "JetBrains Mono Nerd Font 14";
}

entry {
    padding: 8px 12px;
    background-color: #e6e9ef;
    border-radius: 8px;
    text-color: #4c4f69;
    placeholder-color: #7287fd;
    font: "JetBrains Mono Nerd Font 14";
}

listview {
    lines: 10;
    columns: 1;
    spacing: 4px;
    scrollbar: true;
    cycle: true;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
}

element-icon {
    size: 24px;
    margin-right: 12px;
}

element-text {
    vertical-align: 0.5;
}