/* ╔══════════════════════════════════════════════════════════════════════════════╗
   ║  ASH DOTFILES v5.0 OMEGA — Rofi Font System                                 ║
   ║                                                                              ║
   ║  Typography tokens and size scales for all Rofi surfaces.                  ║
   ║  JetBrainsMono Nerd Font as primary with Noto Sans fallback.               ║
   ║  Responsive sizing based on monitor DPI via Rofi's font-size tokens.       ║
   ╚══════════════════════════════════════════════════════════════════════════════╝ */

/* ══════════════════════════════════════════════════════════════════════════════
   §01  FONT FAMILY DEFINITIONS
   ══════════════════════════════════════════════════════════════════════════════ */

* {
    /* ── Primary: Monospace with Nerd Font icons ──────────────────────────────── */
    font-mono:          "JetBrainsMono Nerd Font 12";
    font-mono-sm:       "JetBrainsMono Nerd Font 11";
    font-mono-lg:       "JetBrainsMono Nerd Font 13";
    font-mono-xl:       "JetBrainsMono Nerd Font 14";
    font-mono-bold:     "JetBrainsMono Nerd Font Bold 12";

    /* ── Secondary: Sans-serif for readability ────────────────────────────────── */
    font-sans:          "Noto Sans 12";
    font-sans-sm:       "Noto Sans 11";
    font-sans-lg:       "Noto Sans 13";
    font-sans-bold:     "Noto Sans Bold 12";

    /* ── Icon font ────────────────────────────────────────────────────────────── */
    font-icon:          "Symbols Nerd Font Mono 14";
    font-icon-sm:       "Symbols Nerd Font Mono 12";
    font-icon-lg:       "Symbols Nerd Font Mono 16";

    /* ── Default (used in configuration {} font: property) ───────────────────── */
    /* Inherited by all elements unless overridden */

    /* ══════════════════════════════════════════════════════════════════════════
       §02  TYPOGRAPHY SCALE (Pango markup sizes)
       ══════════════════════════════════════════════════════════════════════════ */

    /* Size scale in points */
    size-xxs:           8;
    size-xs:            9;
    size-sm:            10;
    size-base:          12;
    size-md:            13;
    size-lg:            14;
    size-xl:            16;
    size-2xl:           18;
    size-3xl:           20;
    size-4xl:           24;
    size-5xl:           28;
    size-6xl:           32;
    size-7xl:           40;
    size-8xl:           48;

    /* ══════════════════════════════════════════════════════════════════════════
       §03  SEMANTIC FONT ASSIGNMENTS
       ══════════════════════════════════════════════════════════════════════════ */

    /* Application launcher */
    font-app-name:      "JetBrainsMono Nerd Font 12";
    font-app-desc:      "JetBrainsMono Nerd Font 10";
    font-category:      "JetBrainsMono Nerd Font Bold 11";

    /* Prompt + input */
    font-prompt:        "JetBrainsMono Nerd Font Bold 12";
    font-input:         "JetBrainsMono Nerd Font 12";
    font-placeholder:   "JetBrainsMono Nerd Font 11";

    /* Menus (powermenu, wifi, bluetooth etc.) */
    font-menu-item:     "JetBrainsMono Nerd Font 13";
    font-menu-item-sm:  "JetBrainsMono Nerd Font 11";
    font-menu-icon:     "Symbols Nerd Font Mono 18";
    font-menu-label:    "JetBrainsMono Nerd Font 10";

    /* Time/date (used in some menus) */
    font-time:          "JetBrainsMono Nerd Font Bold 28";
    font-date:          "JetBrainsMono Nerd Font 14";

    /* Message/error bar */
    font-message:       "JetBrainsMono Nerd Font 11";

    /* ══════════════════════════════════════════════════════════════════════════
       §04  LINE HEIGHT & SPACING
       ══════════════════════════════════════════════════════════════════════════ */

    /* Item row heights (in pixels) */
    row-height:         40;         /* Standard list item height */
    row-height-sm:      32;         /* Compact mode */
    row-height-lg:      52;         /* Large mode (with icons + description) */
    row-height-icon:    56;         /* Mode with large icons */

    /* Padding scales */
    padding-xs:         4px;
    padding-sm:         8px;
    padding-md:         12px;
    padding-lg:         16px;
    padding-xl:         24px;
    padding-2xl:        32px;

    /* Margin scales */
    margin-xs:          4px;
    margin-sm:          8px;
    margin-md:          12px;
    margin-lg:          16px;

    /* ══════════════════════════════════════════════════════════════════════════
       §05  BORDER RADIUS SCALE
       ══════════════════════════════════════════════════════════════════════════ */

    radius-none:        0px;
    radius-xs:          4px;
    radius-sm:          6px;
    radius-md:          10px;
    radius-lg:          14px;
    radius-xl:          20px;
    radius-2xl:         28px;
    radius-pill:        9999px;

    /* ══════════════════════════════════════════════════════════════════════════
       §06  BORDER WIDTH SCALE
       ══════════════════════════════════════════════════════════════════════════ */

    border-none:        0px;
    border-thin:        1px;
    border-base:        2px;
    border-thick:       3px;
    border-heavy:       4px;

    /* ══════════════════════════════════════════════════════════════════════════
       §07  ICON SIZE SCALE
       ══════════════════════════════════════════════════════════════════════════ */

    icon-size-xs:       16px;
    icon-size-sm:       20px;
    icon-size-md:       24px;
    icon-size-lg:       32px;
    icon-size-xl:       40px;
    icon-size-2xl:      48px;
    icon-size-3xl:      64px;

    /* ══════════════════════════════════════════════════════════════════════════
       §08  GRID & LAYOUT TOKENS
       ══════════════════════════════════════════════════════════════════════════ */

    /* Column counts for grid launchers */
    grid-cols-3:        3;
    grid-cols-4:        4;
    grid-cols-5:        5;
    grid-cols-6:        6;
    grid-cols-7:        7;

    /* Column item size for icon grids */
    grid-item-size:     100px;
    grid-item-size-lg:  120px;
    grid-item-size-xl:  140px;

    /* Number of visible rows */
    rows-compact:       5;
    rows-default:       8;
    rows-extended:      12;
    rows-full:          16;
}