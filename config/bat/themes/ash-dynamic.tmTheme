<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
╔══════════════════════════════════════════════════════════════════════════════╗
║  ASH DOTFILES v5.0 OMEGA — BAT THEME: ASH DYNAMIC                         ║
║                                                                            ║
║  Format: TextMate (.tmTheme) — compatible with bat, Sublime Text,         ║
║          Neovim (nvim-treesitter), VS Code (partial), Helix               ║
║                                                                            ║
║  Base Palette: Catppuccin Mocha                                            ║
║  Primary Accent: Mauve #cba6f7                                             ║
║  Style: Deep dark with perceptually-balanced syntax colors                ║
║                                                                            ║
║  Color Philosophy:                                                          ║
║  • Keywords    → Mauve/Lavender   (special, stands out)                   ║
║  • Types       → Blue/Sapphire    (structural, cool)                      ║
║  • Functions   → Blue/Teal        (callable, active)                      ║
║  • Strings     → Green            (data, warm)                            ║
║  • Numbers     → Peach            (literals, warm-neutral)                ║
║  • Comments    → Overlay1         (deemphasized, readable)                ║
║  • Variables   → Text/Subtext     (ambient, neutral)                      ║
║  • Operators   → Sky/Teal         (punctuation, functional)               ║
║  • Constants   → Peach/Flamingo   (fixed values, memorable)               ║
║  • Errors      → Red              (critical, attention-grabbing)          ║
║                                                                            ║
║  Auto-updated by: ash theme apply <name>                                   ║
║  Token: {{COLOR_*}} replaced by ASH color engine                          ║
╚══════════════════════════════════════════════════════════════════════════╝
-->
<plist version="1.0">
<dict>

  <!-- ════════════════════════════════════════════════════════════════════
       THEME METADATA
       ════════════════════════════════════════════════════════════════════ -->

  <key>name</key>
  <string>ASH Dynamic</string>

  <key>author</key>
  <string>ASH Dotfiles v5.0</string>

  <key>semanticClass</key>
  <string>theme.dark.ash-dynamic</string>

  <key>colorSpaceName</key>
  <string>sRGB</string>

  <!-- ════════════════════════════════════════════════════════════════════
       GLOBAL SETTINGS — Editor chrome colors
       ════════════════════════════════════════════════════════════════════ -->

  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>

        <!-- Background — Catppuccin Base #1e1e2e -->
        <key>background</key>
        <string>#1e1e2e</string>

        <!-- Foreground — Catppuccin Text #cdd6f4 -->
        <key>foreground</key>
        <string>#cdd6f4</string>

        <!-- Caret / cursor — Catppuccin Mauve #cba6f7 -->
        <key>caret</key>
        <string>#cba6f7</string>

        <!-- Line highlight — Catppuccin Surface0 with alpha -->
        <key>lineHighlight</key>
        <string>#313244a0</string>

        <!-- Selection background — Catppuccin Surface1 -->
        <key>selection</key>
        <string>#45475a80</string>

        <!-- Selection border — Catppuccin Surface2 -->
        <key>selectionBorder</key>
        <string>#585b70</string>

        <!-- Inactive selection — dimmer -->
        <key>inactiveSelection</key>
        <string>#31324450</string>

        <!-- Indent guides — very subtle -->
        <key>guide</key>
        <string>#313244</string>

        <!-- Active indent guide — slightly brighter -->
        <key>activeGuide</key>
        <string>#45475a</string>

        <!-- Stack indent guide -->
        <key>stackGuide</key>
        <string>#3b3d50</string>

        <!-- Bracket matcher highlight -->
        <key>bracketContentsForeground</key>
        <string>#cba6f780</string>

        <!-- Invisible characters (spaces, tabs) -->
        <key>invisibles</key>
        <string>#313244</string>

        <!-- Find matches — Catppuccin Yellow with alpha -->
        <key>findHighlight</key>
        <string>#f9e2af40</string>

        <!-- Find match border -->
        <key>findHighlightForeground</key>
        <string>#1e1e2e</string>

        <!-- Gutter (line numbers area) -->
        <key>gutterForeground</key>
        <string>#6c7086</string>

        <!-- Ruler (80-char column indicator) -->
        <key>rulers</key>
        <string>#313244</string>

        <!-- Tags — XML/HTML matching tags -->
        <key>tagsOptions</key>
        <string>underline</string>

      </dict>
    </dict>

    <!-- ════════════════════════════════════════════════════════════════════
         COMMENTS — Overlay1 (#7f849c) dimmed but readable
         ════════════════════════════════════════════════════════════════════ -->

