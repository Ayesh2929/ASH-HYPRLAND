# cliphist is configured mainly via command-line flags.
# Add the following to your Hyprland autostart:
#
#   exec-once = wl-paste --type text  --watch cliphist store
#   exec-once = wl-paste --type image --watch cliphist store
#
# And bind a key in Hyprland to:
#   bind = SUPER, V, exec, cliphist list | rofi -dmenu | cliphist decode | wl-copy
#
# Or use the ASH rofi clipboard menu:
#   bind = SUPER, V, exec, ash shot color  # or rofi clipboard menu