# ── Import color definitions ───────────────────────────────────────────────────
include colors.conf

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🎨  APPEARANCE — Core visual settings
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Font ──────────────────────────────────────────────────────────────────────
# Font for UI elements (statusbar, inputbar, notification)
# Format: "FontName [style] size"
set font                        "Inter 11"

# Monospace font for completion and shortcuts display
# set guifont                   "JetBrainsMono Nerd Font 10"

# ── Window ────────────────────────────────────────────────────────────────────
# Show window title in title bar
set window-title-basename       true
set window-title-page           true
set window-title-home-tilde     true

# Window icon (requires file in icon theme)
# set window-icon               ""

# ── Page ──────────────────────────────────────────────────────────────────────
# Padding between pages (pixels)
set page-padding                8

# Padding around the page within the view area
set page-right-to-left          false

# Default page store in cache
set page-cache-size             50

# Render in a second thread (parallel rendering)
set render-loading              true
set render-loading-fg           "#cdd6f4"
set render-loading-bg           "#1e1e2e"

# ── Statusbar ─────────────────────────────────────────────────────────────────
# Display file path, page number, zoom level in statusbar
set statusbar-basename          false
set statusbar-home-tilde        true
set statusbar-page-percent      false

# Hide statusbar initially (toggle with 'b')
set show-hidden                 false
set show-scrollbars             false

# ── Scrollbars ────────────────────────────────────────────────────────────────
set scrollbar-width             4

# ── Search ────────────────────────────────────────────────────────────────────
# Case-insensitive search by default
set search-hadjust              true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🔍  ZOOM & NAVIGATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Zoom ──────────────────────────────────────────────────────────────────────
# Minimum and maximum zoom levels (percent)
set zoom-min                    10
set zoom-max                    10000

# Zoom step size (percent per keypress)
set zoom-step                   10

# Default zoom level on open
set zoom-center                 false

# ── Scroll ────────────────────────────────────────────────────────────────────
# Scroll step (pixels per keypress)
set scroll-step                 40

# Full-page scroll (percentage of view for Page Up/Down)
set scroll-full-overlap         0.02

# Horizontal scroll step
set scroll-hstep                40

# Smooth scrolling (requires compositor support)
set scroll-page-aware           true
set scroll-wrap                 false

# ── Navigation ────────────────────────────────────────────────────────────────
# Wrap around pages when navigating with arrows
set advance-pages-per-row       false

# ── View Modes ────────────────────────────────────────────────────────────────
# Initial view mode: "normal" | "fullscreen" | "presentation"
# set view-mode                 "normal"

# Restore previous view mode on open
# set restore-zoom              true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📄  DOCUMENT — Rendering & processing
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Rendering ─────────────────────────────────────────────────────────────────
# DPI for rendering (higher = sharper on HiDPI, more RAM)
# Set to your display DPI: 96=1x, 192=2x HiDPI, 144=1.5x
set page-right-to-left          false

# Enable incremental rendering (show page as it loads)
# set incremental-search        true

# Number of pages rendered in parallel
# set n-completion-items        15

# ── Links ─────────────────────────────────────────────────────────────────────
# Show link decorations
set show-recent                 5

# ── Synctex ───────────────────────────────────────────────────────────────────
# Forward/inverse search for LaTeX (pairs with Neovim)
set synctex                     true
set synctex-editor-command      "nvim +%{line} %{input}"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📐  RECOLOR — Dark mode document theming
#  Converts white/bright PDFs to dark Catppuccin theme
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Recolor (dark mode) — converts document colors
# Toggle with 'c' keybind defined below
set recolor                     true

# ── Recolor strategy ──────────────────────────────────────────────────────────
# "true"  = recolor everything (all elements)
# "false" = keep original colors for images, only recolor text/bg
set recolor-keephue             false

# Recolor reverse video (swap fg/bg for inverted content)
set recolor-reverse-video       false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ⌨️  KEYBINDINGS — Vim-style navigation
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Scroll ────────────────────────────────────────────────────────────────────
# Vim-style scroll
map j                           scroll down
map k                           scroll up
map h                           scroll left
map l                           scroll right

# Half-page scroll
map <C-d>                       scroll half-down
map <C-u>                       scroll half-up

# Full-page scroll
map <C-f>                       scroll full-down
map <C-b>                       scroll full-up
map <Space>                     scroll full-down
map <S-Space>                   scroll full-up

# ── Page Navigation ───────────────────────────────────────────────────────────
map J                           navigate next
map K                           navigate previous
map <Right>                     navigate next
map <Left>                      navigate previous
map gt                          navigate next
map gT                          navigate previous

# Go to first/last page
map gg                          goto top
map G                           goto bottom
map g                           goto top

# Go to specific page (type number then G)
map nG                          goto number

# ── Zoom ──────────────────────────────────────────────────────────────────────
map +                           zoom in
map -                           zoom out
map =                           zoom original
map 0                           zoom original

# Fit to width/height
map W                           adjust_window best-fit
map s                           adjust_window width
map a                           adjust_window height

# ── Rotation ──────────────────────────────────────────────────────────────────
map r                           rotate rotate-cw
map R                           rotate rotate-ccw
map <C-r>                       rotate rotate-cw

# ── View Mode ─────────────────────────────────────────────────────────────────
map f                           toggle_fullscreen
map <F11>                       toggle_fullscreen
map p                           toggle_presentation

# ── Recolor (dark mode) ───────────────────────────────────────────────────────
map c                           recolor

# ── Search ────────────────────────────────────────────────────────────────────
map /                           search forward
map ?                           search backward
map n                           search forward-continue
map N                           search backward-continue

# ── Bookmarks ─────────────────────────────────────────────────────────────────
map m                           feedkeys ":bookmark-add "
map b                           feedkeys ":bookmark-open "
map <C-m>                       feedkeys ":bookmark-delete "

# ── Index / TOC ───────────────────────────────────────────────────────────────
map <Tab>                       toggle_index
map i                           toggle_index

# ── Statusbar / UI ────────────────────────────────────────────────────────────
map B                           toggle_statusbar
map <C-s>                       toggle_statusbar
map <C-i>                       toggle_inputbar

# ── Column/Row Layout ─────────────────────────────────────────────────────────
# Single page
map 1                           set pages-per-row 1
# Two pages side by side
map 2                           set pages-per-row 2
# Three pages
map 3                           set pages-per-row 3

# ── Copy ──────────────────────────────────────────────────────────────────────
# Copy selected text to clipboard
map y                           yank

# ── Follow links ──────────────────────────────────────────────────────────────
map F                           toggle_index
map <Return>                    navigate next

# ── Quit ──────────────────────────────────────────────────────────────────────
map q                           quit
map Q                           quit
map <C-q>                       quit
map ZQ                          quit

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🖥️  INDEX (Table of Contents) — Panel keybindings
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

unmap [index] <C-n>
unmap [index] <C-p>

map [index] j                   navigate_index down
map [index] k                   navigate_index up
map [index] h                   navigate_index collapse
map [index] l                   navigate_index expand
map [index] L                   navigate_index expand-all
map [index] H                   navigate_index collapse-all
map [index] <Return>            navigate_index select
map [index] <Space>             navigate_index select
map [index] gg                  navigate_index top
map [index] G                   navigate_index bottom
map [index] <Tab>               toggle_index
map [index] i                   toggle_index
map [index] q                   toggle_index

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🔡  INPUTBAR KEYBINDINGS — Command input
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Navigation in inputbar
map [inputbar] <C-a>            goto beginning
map [inputbar] <C-e>            goto end
map [inputbar] <C-u>            kill line-start
map [inputbar] <C-k>            kill line-end
map [inputbar] <C-w>            kill word-start
map [inputbar] <C-d>            delete-char
map [inputbar] <Tab>            completion next
map [inputbar] <S-Tab>          completion previous
map [inputbar] <Up>             history next
map [inputbar] <Down>           history previous

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🖱️  MOUSE — Mouse bindings
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Scroll wheel
map [normal] <ScrollUp>         scroll up
map [normal] <ScrollDown>       scroll down

# Zoom with Ctrl+scroll
map [normal] <C-ScrollUp>       zoom in
map [normal] <C-ScrollDown>     zoom out