# All unread articles (sorted by date)
"query:🔔 All Unread" unread = "yes"

# Today's articles
"query:📅 Today" age between 0:1

# Starred / saved articles
"query:⭐ Starred" flags =~ "s"

# Security alerts only
"query:🚨 Security" tags =~ "security"

# Linux / Arch news
"query:🐧 Linux" tags =~ "linux"

