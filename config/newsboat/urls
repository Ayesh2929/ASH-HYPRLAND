#
# FORMAT:
#   URL [tags...] ["title override"]
#
# TAGS:
#   ~title           — Override displayed title with "title"
#   tag1 tag2 tag3   — Assign one or more tags for filtering
#
# AUTHENTICATION:
#   https://user:password@example.com/feed
#
# FILTERING:
#   "query:unread articles" — Virtual feed showing unread from all
#   "query:tag=tech"        — Virtual feed filtered by tag
#
# NEWSBOAT COMMANDS:
#   t — select tag
#   T — select filter
#   / — search

