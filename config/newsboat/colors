# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  🔥 ASH DOTFILES v5.0 OMEGA — NEWSBOAT COLORS ULTRA                        ║
# ║  🎨 Highlight rules • Article view • Feedlist labels                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
#
# INCLUDED FROM:
#   include "~/.config/newsboat/colors"
#
# FORMAT:
#   highlight <target> <regex> <fg> <bg> [attribute...]
#   TARGETS: article, feedlist, title, url, author, date, podcast, queryfeed
#
# TERMINAL COLORS:
#   color0–color255 (256-color palette), or:
#   default, black, red, green, yellow, blue, magenta, cyan, white
#
# ATTRIBUTES:
#   bold, underline, blink, reverse, dim, standout, default

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📄  ARTICLE VIEW HIGHLIGHTS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Link-like patterns (repo names, GitHub paths)
highlight article       "[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+" color117 default

# Emojis and unicode (fallback highlighting)
# (most terminals handle this natively)

# Section separators
highlight article       "^[=\-]{3,}$"      color59     default

# Blockquote / quoted text
highlight article       "^>[^>].*"          color103    default    italic

# ── Feedlist name patterns ─────────────────────────────────────────────────────

# 🦀 Rust feeds
highlight feedlist      "🦀.*"              color183    default    bold

# 🐧 Linux feeds
highlight feedlist      "🐧.*"              color150    default    bold

# 🔒 Security feeds
highlight feedlist      "🔒.*|🚨.*"         color211    default    bold

# 🤖 AI/ML feeds
highlight feedlist      "🤖.*"              color117    default    bold

# ☁️ Cloud/DevOps
highlight feedlist      "☸️.*|☁️.*|🐳.*"    color111    default    bold

# 📝 Blogs
highlight feedlist      "📝.*|⚙️.*"         color189    default

# 🔬 Science
highlight feedlist      "🔬.*"              color116    default    bold

# 🎮 Gaming
highlight feedlist      "🎮.*"              color215    default    bold

# 🎨 Design
highlight feedlist      "🎨.*"              color218    default    bold

# 💬 Community
highlight feedlist      "💬.*|🦞.*"         color147    default    bold

# 🎙️ Podcasts
highlight feedlist      "🎙️.*"              color222    default    bold

# 📅 Query/virtual feeds
highlight feedlist      "📅.*|🔔.*|⭐.*"    color183    default    bold underline
