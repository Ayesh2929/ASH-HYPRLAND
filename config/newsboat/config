unbind-key          j
unbind-key          h
unbind-key          l
unbind-key          g
unbind-key          G
unbind-key          ^
unbind-key          $
unbind-key          /
unbind-key          ?
unbind-key          n
unbind-key          N
unbind-key          d
unbind-key          u
unbind-key          a
unbind-key          s
unbind-key          R

# ── Navigation ─────────────────────────────────────────────────────────────────
bind-key            j     down            feedlist
bind-key            k     up              feedlist
bind-key            j     next            articlelist
bind-key            k     prev            articlelist
bind-key            j     scroll-down     article
bind-key            k     scroll-up       article
bind-key            J     next-unread     feedlist
bind-key            K     prev-unread     feedlist
bind-key            J     next-unread     articlelist
bind-key            K     prev-unread     articlelist
bind-key            ctrl-d pagedown       feedlist
bind-key            ctrl-u pageup         feedlist
bind-key            ctrl-d pagedown       articlelist
bind-key            ctrl-u pageup         articlelist
bind-key            ctrl-d scroll-halfpage-down article
bind-key            ctrl-u scroll-halfpage-up   article
bind-key            ctrl-f pagedown       article
bind-key            ctrl-b pageup         article
bind-key            gg    goto-first      feedlist
bind-key            G     goto-last       feedlist
bind-key            gg    goto-first      articlelist
bind-key            G     goto-last       articlelist
bind-key            H     first-line      article
bind-key            M     middle-line     article
bind-key            L     last-line       article
bind-key            0     beginning-of-line article
bind-key            $     end-of-line     article

# ── Open ───────────────────────────────────────────────────────────────────────
bind-key            l     open            feedlist
bind-key            l     open            articlelist
bind-key            h     quit            feedlist
bind-key            h     quit            articlelist
bind-key            h     quit            article
bind-key            ENTER open            feedlist
bind-key            ENTER open            articlelist
bind-key            o     open-in-browser article
bind-key            O     open-in-browser-and-mark-read article
bind-key            v     open-in-browser articlelist

# ── Search ─────────────────────────────────────────────────────────────────────
bind-key            /     open-search     feedlist
bind-key            /     open-search     articlelist
bind-key            /     open-search     article
bind-key            n     search-next     feedlist
bind-key            n     search-next     articlelist
bind-key            n     search-next     article
bind-key            N     search-prev     feedlist
bind-key            N     search-prev     articlelist
bind-key            N     search-prev     article

# ── Mark & Read ────────────────────────────────────────────────────────────────
bind-key            a     toggle-article-read   articlelist
bind-key            A     mark-feed-read        feedlist
bind-key            A     mark-feed-read        articlelist
bind-key            m     mark-article-read     articlelist
bind-key            c     catch-up              feedlist

# ── Refresh ────────────────────────────────────────────────────────────────────
bind-key            r     reload          feedlist
bind-key            R     reload-all      feedlist
bind-key            r     reload          articlelist

# ── Save & Export ──────────────────────────────────────────────────────────────
bind-key            s     save-article    articlelist
bind-key            s     save-article    article
bind-key            S     save-article    feedlist

# ── Tags ───────────────────────────────────────────────────────────────────────
bind-key            t     select-tag      feedlist
bind-key            T     select-filter   feedlist
bind-key            ^T    clear-tag       feedlist

# ── Miscellaneous ──────────────────────────────────────────────────────────────
bind-key            q     quit            feedlist
bind-key            q     quit            articlelist
bind-key            q     quit            article
bind-key            ?     help            feedlist
bind-key            ?     help            articlelist
bind-key            ?     help            article
bind-key            i     article-info    article
bind-key            e     enqueue         article
bind-key            d     delete-article  articlelist
bind-key            D     purge-deleted   feedlist
bind-key            ;     cmdline         feedlist
bind-key            :     cmdline         feedlist
bind-key            :     cmdline         articlelist

# ── Macros (leader = , ) ────────────────────────────────────────────────────
macro-prefix         ,

# Open in Firefox
macro f set browser "firefox %u" ; open-in-browser ; set browser "xdg-open %u"

# Open in qutebrowser
macro q set browser "qutebrowser %u" ; open-in-browser ; set browser "xdg-open %u"

# Play with mpv
macro p set browser "mpv --ytdl-format='bestvideo[height<=1080]+bestaudio/best' %u" ; open-in-browser ; set browser "xdg-open %u"

# Download with yt-dlp
macro y set browser "yt-dlp -o '~/Videos/%(title)s.%(ext)s' %u" ; open-in-browser ; set browser "xdg-open %u"

# Copy URL to clipboard (Wayland)
macro c set browser "wl-copy < /dev/null; echo %u | wl-copy" ; open-in-browser ; set browser "xdg-open %u"

# Read article with readable CLI
macro r set browser "readable %u | nvim -R -" ; open-in-browser ; set browser "xdg-open %u"

# Pocket / read-later
macro w set browser "~/.local/bin/pocket-add %u" ; open-in-browser ; set browser "xdg-open %u"

