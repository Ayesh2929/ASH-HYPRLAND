# Cache database location
cache-file          "~/.local/share/newsboat/cache.db"

# Error log
error-log           "~/.local/share/newsboat/error.log"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🔄  REFRESH & SYNC
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Auto-reload feeds on startup
auto-reload         yes

# Reload interval (minutes)
reload-time         30

# Number of parallel download threads
reload-threads      8

# Download timeout (seconds)
download-timeout    30

# Maximum items per feed to download
download-full-page  no

# Maximum number of articles per feed to keep in cache
max-items           500

# Keep articles for N days (0 = forever)
keep-articles-days  30

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🌐  BROWSER & CONTENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Browser to open articles
# Use xdg-open for system default
browser              "xdg-open %u"

# Alternative: open in specific browser
# browser            "firefox %u"
# browser            "qutebrowser %u"

# Text-mode browser for reading inside newsboat
# (readable, clean articles inline)
# browser            "w3m %u"
# browser            "lynx %u"
# browser            "elinks %u"

# Open articles with readable view (via readable cli)
# browser            "readable %u | less -R"

# Open with mpv (for podcast feeds / YouTube RSS)
# macro p set browser "mpv %u" ; open-in-browser ; set browser "xdg-open %u"

# Use clipboard to copy URL
# macro y set browser "echo %u | wl-copy" ; open-in-browser ; set browser "xdg-open %u"

# HTML renderer
html-renderer        "w3m -T text/html"

# External pager for reading articles
# pager              "nvim -R -"

# Use internal pager (default)
# pager              internal

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🎨  FORMATTING & DISPLAY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Feed list format ──────────────────────────────────────────────────────────
# %n = feed name
# %u = feed URL
# %t = total items
# %U = unread items
# %T = tags
# %d = description
# %l = last fetch time
feedlist-format      "%4i %n %> (%U/%t)"

# ── Article list format ────────────────────────────────────────────────────────
# %i = index
# %f = flags
# %T = tags
# %t = title
# %a = author
# %d = date
# %L = article link
# %c = content
articlelist-format   "%4i %f %D  %-30t  %T  %a"

# Date format (strftime)
articlelist-title-format "Articles in feed '%T' (%u unread, %t total) - %U"

# Date format for articles
datetime-format      "%b %d, %Y  %H:%M"

# Feed list title
feedlist-title-format "Your feeds (%u unread, %t total)"

# Search result title
searchresult-title-format "Search result (%u unread, %t total)"

# File dialog title
filebrowser-title-format "%?O?Open File&Save File? - %f"

# Help title
help-title-format    "Help"

# Select tag title
selecttag-title-format "Select tag"

# Select filter title
selectfilter-title-format "Select filter"

# URL view title
urlview-title-format "URLs"

# Dialog title for tag
dirbrowser-title-format "%?O?Open Directory&Save File? - %f"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🔤  TEXT WRAPPING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Article text wrap width (0 = terminal width)
text-width           88

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🔔  NOTIFICATIONS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Show desktop notification when new articles arrive
notify-always        no
notify-screen        no
notify-xterm         no

# Notification format
notify-format        "📰 newsboat: %d new articles in %f feeds"

# Notification program (dunst / libnotify)
notify-program       "notify-send"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
