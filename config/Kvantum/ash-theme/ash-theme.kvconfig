%  EFFECT OVERRIDES — Fine-tune rendering behavior
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[Effects]
% Enable compositing for translucency effects
compositing=true
% Menu drop shadow
menu_shadow=true
% Tooltip shadow
tooltip_shadow=true
% Window shadow depth
shadow_depth=12
% Blurring (requires compositor blur support — Hyprland/KWin)
blurring=true
% Translucency amount (0=opaque, 255=fully transparent)
opacity=200
% Inactive window translucency
inactive_opacity=180
% Menu translucency
menu_opacity=210
% Tooltip translucency
tooltip_opacity=215