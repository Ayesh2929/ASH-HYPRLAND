% ║                                                                            ║
% ║  Base Palette : Catppuccin Mocha                                          ║
% ║  Primary      : Mauve #cba6f7                                             ║
% ║  Style        : Glassmorphism + Depth + Premium Roundness                 ║
% ║  Target       : Qt5/Qt6 applications on Hyprland/Wayland                  ║
% ║  Kvantum Ver  : 1.0.0+                                                    ║
% ║                                                                            ║
% ║  Applies to:                                                               ║
% ║  • VLC Media Player    • qBittorrent   • KeePassXC                        ║
% ║  • Kdenlive            • Krita         • LibreOffice Qt                   ║
% ║  • Dolphin             • Konsole       • Kate / KWrite                    ║
% ║  • All Qt5/Qt6 apps    • Electron apps (partial)                          ║
% ║                                                                            ║
% ║  Auto-updated by: ash theme apply <name>                                  ║
% ╚══════════════════════════════════════════════════════════════════════════╝

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  GENERAL — Global theme properties
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[%General]

% Author and metadata
author=ASH Dotfiles v5.0
comment=Premium Glassmorphism Qt theme — Catppuccin Mocha + ASH Dynamic Color Engine
x11drag=true
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=0
toolbar_interior_spacing=2
spread_progressbar=true
progressbar_animation=true
composite=true
menu_shadow_depth=8
tooltip_shadow_depth=6
splitter_width=4
scroll_width=10
scroll_min_extent=50
slim_scrollbars=true
scroll_arrows=false
transient_scrollbar=true
scroll_jump_workaround=false
vertical_spin_indicators=false
spin_button_width=16
combo_as_lineedit=false
combo_menu=false
combo_focus_rect=true
button_width_from_label=true
center_toolbar_handle=true
fill_rubberband=false
menubar_mouse_tracking=true
merge_menubar_with_window=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
combo_icon_size=16

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  WINDOW GEOMETRY
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

window.interior.x=0
window.interior.y=0
window.interior.width=0
window.interior.height=0
window.border.top=0
window.border.bottom=0
window.border.left=0
window.border.right=0

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  COLOR PALETTE — Catppuccin Mocha
%  Format: R,G,B (0-255)
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[ColorScheme]

% Window background — Catppuccin Base #1e1e2e
window.color=30,30,46
% Window text — Catppuccin Text #cdd6f4
windowText.color=205,214,244
% Base view background — Catppuccin Mantle #181825
base.color=24,24,37
% Alternate view background — Catppuccin Surface0 #313244
alternateBase.color=49,50,68
% Tooltip background — Catppuccin Surface1 #45475a
toolTipBase.color=69,71,90
% Tooltip text — Catppuccin Text #cdd6f4
toolTipText.color=205,214,244
% Primary text color
text.color=205,214,244
% Button background — Catppuccin Surface0 #313244
button.color=49,50,68
% Button text
buttonText.color=205,214,244
% Bright text (inverted)
brightText.color=205,214,244
% Highlight / selection — Catppuccin Mauve #cba6f7
highlight.color=203,166,247
% Highlighted text
highlightedText.color=17,17,27
% Link color — Catppuccin Blue #89b4fa
link.color=137,180,250
% Visited link — Catppuccin Mauve
linkVisited.color=203,166,247
% Light (used for 3D highlights)
light.color=69,71,90
% Midlight
midlight.color=49,50,68
% Dark
dark.color=17,17,27
% Mid
mid.color=30,30,46
% Shadow
shadow.color=11,11,27

% Disabled state overrides
disabled.windowText.color=108,112,134
disabled.text.color=108,112,134
disabled.buttonText.color=108,112,134
disabled.highlight.color=69,71,90
disabled.highlightedText.color=108,112,134

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  WINDOW FRAME
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[Window]
interior=true
interior.element=Window
frame=false
frame.element=none
interior.x=1
interior.y=1
interior.width=-2
interior.height=-2

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  PUSH BUTTON — Main actionable buttons
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[PanelButtonCommand]
frame=true
frame.element=PanelButtonCommand
interior=true
interior.element=PanelButtonCommand
indicator.size=0
text.normal.color=205,214,244
text.focus.color=205,214,244
text.press.color=17,17,27
text.toggle.color=205,214,244
text.disabled.color=108,112,134
frame.top=3
frame.bottom=3
frame.left=5
frame.right=5
interior.x=3
interior.y=3
interior.width=-6
interior.height=-6
min_width=16
min_height=8
inherits=PanelButtonCommand

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  TOOL BUTTON — Toolbar buttons
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[PanelButtonTool]
inherits=PanelButtonCommand
frame=true
frame.element=PanelButtonTool
interior=true
interior.element=PanelButtonTool
text.normal.color=163,173,196
text.focus.color=205,214,244
text.press.color=203,166,247

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  LINE EDIT — Text input fields
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[LineEdit]
frame=true
frame.element=LineEdit
interior=true
interior.element=LineEdit
frame.top=3
frame.bottom=3
frame.left=5
frame.right=5
interior.x=3
interior.y=3
interior.width=-6
interior.height=-6
text.normal.color=205,214,244
text.focus.color=205,214,244
text.disabled.color=108,112,134

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  INDICATOR — Checkbox / Radio indicator dot
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[Indicator]
frame=true
frame.element=Indicator
interior=true
interior.element=Indicator
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior.x=2
interior.y=2
interior.width=-4
interior.height=-4

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  CHECKBOX — Check box widget
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[CheckBox]
inherits=Indicator
indicator.element=CheckBox

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  RADIO BUTTON
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[RadioButton]
inherits=CheckBox
indicator.element=RadioButton

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  COMBO BOX — Dropdown selector
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[ComboBox]
inherits=PanelButtonCommand
frame=true
frame.element=ComboBox
interior=true
interior.element=ComboBox
indicator.size=20
indicator.element=ComboBox
text.normal.color=205,214,244
text.focus.color=205,214,244
text.disabled.color=108,112,134

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  SPIN BOX — Numeric input with increment/decrement
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[SpinBox]
inherits=LineEdit
frame.element=SpinBox
interior.element=SpinBox
indicator.size=20
indicator.element=SpinBox

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  TAB BAR — Application tab widget
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[Tab]
frame=true
frame.element=Tab
interior=true
interior.element=Tab
frame.top=3
frame.bottom=3
frame.left=5
frame.right=5
interior.x=3
interior.y=3
interior.width=-6
interior.height=-6
text.normal.color=108,112,134
text.focus.color=205,214,244
text.press.color=203,166,247
text.toggle.color=203,166,247
indicator.size=0
inherits=Tab

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  TAB FRAME — Container for tab content
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[TabFrame]
frame=true
frame.element=TabFrame
interior=true
interior.element=TabFrame
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior.x=3
interior.y=3
interior.width=-6
interior.height=-6

% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
%  SCROLLBAR — Overlay scrollbar system
% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[ScrollbarGroove]
frame=false
interior=true
interior.element=ScrollbarGroove

[ScrollbarSlider]
frame=true
frame.element=ScrollbarSlider
interior=true
interior.element=ScrollbarSlider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior.x=3
interior.y=3
interior.width=-6
interior.height=-6

[Scrollbar]
min_width=6
max_width=10
min_height=6
max_height=10
groove_color=49,50,68

