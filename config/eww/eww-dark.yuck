(defwindow bar
  :stacking "fg"
  :layer "top"
  :anchor "top"
  :exclusivity "exclusive"
  :geometry (geometry 0 0 1920 30)
  (box :orientation "h" :space-evenly false :spacing 10
    (box :class "workspaces" :orientation "h" :spacing 5
      (for i (range 1 11) (button :class "ws" :onclick (format "hyprctl dispatch workspace %d" i) (label :text (number->string i))))
    )
    (label :class "window-title" :text "{{hyprland.active_window.title}}")
    (label :class "clock" :text "{{date}}")
  )
)

(defstyle *
  :font "JetBrains Mono Nerd Font 12"
  :foreground "#cdd6f4"
  :background "#1e1e2e"
)

(defstyle bar
  :background "#1e1e2e"
  :border "#89b4fa"
  :border-width 2
)

(defstyle workspaces
  :background "#313244"
  :padding 10
  :border-radius 8
)

(defstyle ws
  :padding 5
  :margin 2
  :border-radius 4
  :foreground "#6c7086"
)

(defstyle ws:selected
  :background "#89b4fa"
  :foreground "#1e1e2e"
)