(defwindow bar
  :stacking "fg"
  :layer "top"
  :anchor "top"
  :exclusivity "exclusive"
  :geometry (geometry 0 0 1920 30)
  (box :orientation "h" :space-evenly false :spacing 10
    (box :class "workspaces" :orientation "h" :spacing 5
      (for i (range 1 11) (button :class "ws" :onclick (format "hyprctl dispatch workspace %d" i) (label :text (number->string i))))
    )
    (label :class "window-title" :text "{{hyprland.active_window.title}}")
    (label :class "clock" :text "{{date}}")
  )
)

(defwindow dashboard
  :stacking "fg"
  :layer "top"
  :anchor "center"
  :exclusivity "exclusive"
  :geometry (geometry 300 200 1320 680)
  (box :orientation "v" :spacing 20 :class "dashboard"
    (label :text "ASH Dashboard" :class "title")
    (box :orientation "h" :spacing 20
      (box :orientation "v" :spacing 10
        (label :text "System" :class "section")
        (label :text "{{cpu_usage}}% CPU" :class "metric")
        (label :text "{{mem_usage}}% RAM" :class "metric")
      )
      (box :orientation "v" :spacing 10
        (label :text "Workspaces" :class "section")
        (for i (range 1 11) (label :text (format "Workspace %d" i) :class "ws-item"))
      )
    )
  )
)

(defstyle *
  :font "JetBrains Mono Nerd Font 12"
  :foreground "#cdd6f4"
  :background "#1e1e2e"
)

(defstyle bar
  :background "#1e1e2e"
  :border "#89b4fa"
  :border-width 2
)

(defstyle workspaces
  :background "#313244"
  :padding 10
  :border-radius 8
)

(defstyle ws
  :padding 5
  :margin 2
  :border-radius 4
  :foreground "#6c7086"
)

(defstyle ws:selected
  :background "#89b4fa"
  :foreground "#1e1e2e"
)

(defstyle dashboard
  :background "#1e1e2e"
  :border "#89b4fa"
  :border-width 2
  :border-radius 12
  :padding 20
)

(defstyle title
  :font "JetBrains Mono Nerd Font 20"
  :foreground "#89b4fa"
  :margin-bottom 10
)

(defstyle section
  :font "JetBrains Mono Nerd Font 14"
  :foreground "#f9e2af"
)

(defstyle metric
  :font "JetBrains Mono Nerd Font 13"
  :foreground "#a6adc8"
)