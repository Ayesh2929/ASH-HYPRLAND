{
  "$$section0":  "━━ ASH DOTFILES v5.0 OMEGA — DOCKER DAEMON CONFIG ULTRA ━━━━━━━━",

  "$$section1":  "━━ DOCKERD ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",

  "containerd":                 "/run/containerd/containerd.sock",

  "$$section11": "━━ METRICS ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",

  "metrics-addr":               "127.0.0.1:9323",

  "$$section12": "━━ RUNTIME ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",

  "default-runtime":            "runc",

  "runtimes": {
    "runc": {
      "path": "runc"
    },
    "crun": {
      "path": "/usr/bin/crun"
    }
  },

  "$$section13": "━━ SWARM ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",

  "$$section14": "━━ MISC ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",

  "live-restore":               true,

  "icc":                        false,

  "userland-proxy":             false,

  "ip-forward":                 true,

  "ip-masq":                    true,

  "iptables":                   true,

  "ip6tables":                  false,

  "ipv6":                       false,

  "raw-logs":                   false,

  "shutdown-timeout":           30,

  "debug":                      false,

  "hosts": [
    "unix:///var/run/docker.sock"
  ],

  "tls":                        false,

  "authorization-plugins":      []
}