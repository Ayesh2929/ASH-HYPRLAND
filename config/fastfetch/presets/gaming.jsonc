// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH FASTFETCH — GAMING PRESET                                             ║
// ║                                                                            ║
// ║  ░██████╗░░█████╗░███╗░░░███╗██╗███╗░░██╗░██████╗░                       ║
// ║  ██╔════╝░██╔══██╗████╗░████║██║████╗░██║██╔════╝░                       ║
// ║  ██║░░██╗░███████║██╔████╔██║██║██╔██╗██║██║░░██╗░                       ║
// ║  ██║░░╚██╗██╔══██║██║╚██╔╝██║██║██║╚████║██║░░╚██╗                       ║
// ║  ╚██████╔╝██║░░██║██║░╚═╝░██║██║██║░╚███║╚██████╔╝                       ║
// ║  ░╚═════╝░╚═╝░░╚═╝╚═╝░░░░░╚═╝╚═╝╚═╝░░╚══╝░╚═════╝░                       ║
// ║                                                                            ║
// ║  Style   : Gaming-optimized • Performance metrics • Neon accent           ║
// ║  Focus   : GPU · FPS · RAM · CPU · Game libraries                        ║
// ║  Colors  : Cyberpunk neon (magenta + cyan)                                ║
// ║  Usage   : fastfetch --config ~/.config/fastfetch/presets/gaming.jsonc    ║
// ╚══════════════════════════════════════════════════════════════════════════╝

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // ── Display ───────────────────────────────────────────────────────────────

    "display": {
        "color": {
            "keys":      "95",   // Bright magenta — gaming neon
            "title":     "95",
            "separator": "90"
        },
        "separator": "  \u001b[90m▸\u001b[0m  ",
        "keyWidth": 20,
        "padding": { "left": 1 },
        "brightColor": true,
        "colorLogo": true,
        "percentType": 9,
        "sizeUnit": "auto",
        "sizeNdigits": 1,
        "temperatureUnit": "celsius",
        "bar": {
            "charElapsed": "█",
            "charTotal":   "▒",
            "width": 14,
            "border": false
        }
    },

    // ── Logo — Gaming ASCII art ────────────────────────────────────────────────

    "logo": {
        "source": "auto",
        "type": "auto",
        "padding": { "top": 0, "left": 1, "right": 2 },
        "position": "left",
        "colorPicker": {}
    },

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    //  MODULES — Gaming-Optimized Information
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    "modules": [

        // ╔══════════════════════════════════════════════════════╗
        // ║  GAMING HEADER                                      ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;95m ██████╗  ██████╗  ██████╗  ██████╗  ██╗███╗  ██╗ ██████╗ \u001b[0m",
            "key": ""
        },
        {
            "type": "custom",
            "format": "\u001b[1;95m ██╔════╝ ██╔══██╗ ██╔═══╝  ██╔══██╗ ██║████╗ ██║ ██╔════╝ \u001b[0m",
            "key": ""
        },
        {
            "type": "custom",
            "format": "\u001b[1;96m ██║  ███╗██████╔╝ ████╗░░  ██████╔╝ ██║██╔██╗ ██║ ██║  ███╗ \u001b[0m",
            "key": ""
        },
        {
            "type": "custom",
            "format": "\u001b[1;96m ██║   ██║██╔══██╗ ██╔═╝░░  ██╔══██╗ ██║██║╚████║ ██║   ██║ \u001b[0m",
            "key": ""
        },
        {
            "type": "custom",
            "format": "\u001b[1;95m ╚██████╔╝██║  ██║ ██║░░░░  ██║  ██║ ██║██║ ╚███║ ╚██████╔╝ \u001b[0m",
            "key": ""
        },
        {
            "type": "custom",
            "format": "\u001b[90m  ╚═════╝ ╚═╝  ╚═╝ ╚═╝░░░░  ╚═╝  ╚═╝ ╚═╝╚═╝  ╚══╝  ╚═════╝  \u001b[0m",
            "key": ""
        },

        // Player info
        {
            "type": "title",
            "format": "\u001b[90m  ┌ \u001b[1;95mPLAYER\u001b[90m ──────────────────────────────────────────┐\u001b[0m\n\u001b[90m  │\u001b[0m  \u001b[1;95m{user-name}\u001b[0m\u001b[90m@\u001b[0m\u001b[1;96m{host-name}\u001b[0m\n\u001b[90m  └─────────────────────────────────────────────────┘\u001b[0m",
            "key": ""
        },

        { "type": "break" },

        // ╔══════════════════════════════════════════════════════╗
        // ║  PERFORMANCE METRICS                                ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;95m ⚡ PERFORMANCE\u001b[0m",
            "key": ""
        },

        // CPU
        {
            "type": "cpu",
            "key": "  CPU              ",
            "keyColor": "95",
            "showPeCoreCount": true,
            "temp": true,
            "format": "\u001b[1m{name}\u001b[0m  \u001b[90m{num-cores}c/{num-threads}t @ {max-frequency}\u001b[0m  🌡 \u001b[{temp-color}m{temp}\u001b[0m",
            "tempColor": { "green": 70, "yellow": 85, "red": 95 }
        },
        {
            "type": "cpuusage",
            "key": "  CPU Load         ",
            "keyColor": "95",
            "format": "{all}%  {bar}",
            "separate": false
        },

        // GPU (Gaming's most critical component)
        {
            "type": "gpu",
            "key": "󰍹  GPU              ",
            "keyColor": "95",
            "temp": true,
            "format": "\u001b[1m{name}\u001b[0m  \u001b[90m{vram-size}GB\u001b[0m  🌡 \u001b[{temp-color}m{temp}\u001b[0m",
            "tempColor": { "green": 75, "yellow": 88, "red": 95 }
        },
        {
            "type": "command",
            "key": "  GPU Usage        ",
            "keyColor": "95",
            "text": "nvidia-smi --query-gpu=utilization.gpu,utilization.memory,power.draw --format=csv,noheader,nounits 2>/dev/null | awk -F',' '{printf \"GPU: %s%% · VRAM: %s%% · Power: %sW\", $1, $2, int($3)}' || cat /sys/class/drm/card0/device/gpu_busy_percent 2>/dev/null | xargs -I{} echo 'GPU: {}% (AMD)' || echo 'nvidia-smi not found'"
        },
        {
            "type": "command",
            "key": "  GPU Clock        ",
            "keyColor": "95",
            "text": "nvidia-smi --query-gpu=clocks.current.graphics,clocks.current.memory --format=csv,noheader,nounits 2>/dev/null | awk -F',' '{printf \"Core: %s MHz · VRAM: %s MHz\", $1, $2}' || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "  GPU Driver       ",
            "keyColor": "95",
            "text": "nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1 | xargs -I{} echo 'NVIDIA {}' || glxinfo 2>/dev/null | grep 'OpenGL renderer' | sed 's/OpenGL renderer string: //' || echo 'N/A'"
        },

        // RAM
        {
            "type": "memory",
            "key": "  RAM              ",
            "keyColor": "95",
            "format": "{used} / {total} ({percentage}%)  {bar}"
        },

        // Display & Refresh rate (critical for gaming)
        {
            "type": "display",
            "key": "󰍹  Monitor          ",
            "keyColor": "95",
            "format": "{name}: \u001b[1m{width}×{height}\u001b[0m @ \u001b[1;96m{refresh-rate}Hz\u001b[0m ({output})"
        },

        { "type": "break" },

        // ╔══════════════════════════════════════════════════════╗
        // ║  GAMING SOFTWARE                                    ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;96m 🎮 GAMING SOFTWARE\u001b[0m",
            "key": ""
        },

        // Kernel with gaming patches
        {
            "type": "kernel",
            "key": "  Kernel           ",
            "keyColor": "96",
            "format": "{sysname} {release} \u001b[90m({version})\u001b[0m"
        },

        // Graphics APIs
        {
            "type": "opengl",
            "key": "  OpenGL           ",
            "keyColor": "96",
            "format": "{version} ({renderer})"
        },
        {
            "type": "vulkan",
            "key": "  Vulkan           ",
            "keyColor": "96"
        },

        // Game launchers
        {
            "type": "command",
            "key": "  Steam            ",
            "keyColor": "96",
            "text": "steam --version 2>/dev/null | head -1 || flatpak info com.valvesoftware.Steam 2>/dev/null | grep Version | awk '{print $2}' | xargs -I{} echo 'Flatpak {}' || echo 'Not installed'"
        },
        {
            "type": "command",
            "key": "  Lutris           ",
            "keyColor": "96",
            "text": "lutris --version 2>/dev/null || flatpak info net.lutris.Lutris 2>/dev/null | grep Version | awk '{print \"Flatpak\", $2}' || echo 'Not installed'"
        },
        {
            "type": "command",
            "key": "  Heroic           ",
            "keyColor": "96",
            "text": "heroic --version 2>/dev/null || flatpak info com.heroicgameslauncher.hgl 2>/dev/null | grep Version | awk '{print \"Flatpak\", $2}' || echo 'Not installed'"
        },

        // Wine / Proton
        {
            "type": "command",
            "key": "  Wine             ",
            "keyColor": "96",
            "text": "wine --version 2>/dev/null || echo 'Not installed'"
        },
        {
            "type": "command",
            "key": "  Proton-GE        ",
            "keyColor": "96",
            "text": "ls ~/.steam/root/compatibilitytools.d/ 2>/dev/null | grep -i 'proton\\|GE' | sort -V | tail -1 || echo 'Not found'"
        },

        // Gaming optimizations
        {
            "type": "command",
            "key": "  GameMode         ",
            "keyColor": "96",
            "text": "gamemoded -s 2>/dev/null | grep -q 'active' && echo '✅ Active' || systemctl --user is-active gamemoded 2>/dev/null | xargs -I{} echo '{}' || which gamemode 2>/dev/null | xargs -I{} echo '✅ Installed' || echo '❌ Not installed'"
        },
        {
            "type": "command",
            "key": "  MangoHUD         ",
            "keyColor": "96",
            "text": "mangohud --version 2>/dev/null | head -1 || echo 'Not installed'"
        },
        {
            "type": "command",
            "key": "  VKD3D-Proton     ",
            "keyColor": "96",
            "text": "ls /usr/lib/vkd3d-proton/ 2>/dev/null | head -1 | xargs -I{} echo 'Installed' || ls ~/.steam/root/compatibilitytools.d/*/files/lib64/vkd3d-proton/ 2>/dev/null && echo 'Via Proton' || echo 'Not installed'"
        },
        {
            "type": "command",
            "key": "  DXVK             ",
            "keyColor": "96",
            "text": "pacman -Q dxvk-bin 2>/dev/null | awk '{print $2}' || dpkg -l dxvk 2>/dev/null | awk 'NR==4{print $3}' || echo 'Check Proton'"
        },

        { "type": "break" },

        // ╔══════════════════════════════════════════════════════╗
        // ║  SYSTEM INFO (condensed for gaming)                 ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;90m 💻 SYSTEM\u001b[0m",
            "key": ""
        },

        {
            "type": "os",
            "key": "  OS               ",
            "keyColor": "90",
            "format": "{pretty-name} {arch}"
        },
        {
            "type": "wm",
            "key": "  WM               ",
            "keyColor": "90"
        },
        {
            "type": "shell",
            "key": "  Shell            ",
            "keyColor": "90",
            "format": "{name} {version}"
        },
        {
            "type": "uptime",
            "key": "  Uptime           ",
            "keyColor": "90"
        },
        {
            "type": "disk",
            "key": "󰋊  Disk /           ",
            "keyColor": "90",
            "folders": "/",
            "format": "{used} / {total} ({percentage}%)  {bar}"
        },

        // Network for gaming (ping matters!)
        {
            "type": "localip",
            "key": "󰖩  LAN              ",
            "keyColor": "90",
            "showIpv4": true,
            "showIpv6": false,
            "defaultRouteOnly": true
        },
        {
            "type": "command",
            "key": "  Ping (1.1.1.1)   ",
            "keyColor": "90",
            "text": "ping -c1 -W2 1.1.1.1 2>/dev/null | tail -1 | awk -F'/' '{printf \"%.0fms avg\", $5}' || echo 'No internet'"
        },

        // Audio
        {
            "type": "sound",
            "key": "󰕾  Audio            ",
            "keyColor": "90"
        },

        // Currently playing
        {
            "type": "player",
            "key": "  Now Playing      ",
            "keyColor": "90",
            "format": "{artist} — {title} ({status})"
        },

        { "type": "break" },

        // ╔══════════════════════════════════════════════════════╗
        // ║  NEON COLOR STRIP                                   ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[95m ● \u001b[91m● \u001b[93m● \u001b[92m● \u001b[96m● \u001b[94m● \u001b[95m● \u001b[91m● \u001b[93m● \u001b[92m●\u001b[0m",
            "key": ""
        },
        {
            "type": "custom",
            "format": "\u001b[90m  ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄\u001b[0m",
            "key": ""
        }
    ]
}