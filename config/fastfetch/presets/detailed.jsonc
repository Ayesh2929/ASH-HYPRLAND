// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH FASTFETCH — DETAILED PRESET                                           ║
// ║                                                                            ║
// ║  ██████╗░███████╗████████╗░█████╗░██╗██╗░░░░░███████╗██████╗░            ║
// ║  ██╔══██╗██╔════╝╚══██╔══╝██╔══██╗██║██║░░░░░██╔════╝██╔══██╗           ║
// ║  ██║░░██║█████╗░░░░░██║░░░███████║██║██║░░░░░█████╗░░██║░░██║           ║
// ║  ██║░░██║██╔══╝░░░░░██║░░░██╔══██║██║██║░░░░░██╔══╝░░██║░░██║           ║
// ║  ██████╔╝███████╗░░░██║░░░██║░░██║██║███████╗███████╗██████╔╝           ║
// ║  ╚═════╝░╚══════╝░░░╚═╝░░░╚═╝░░╚═╝╚═╝╚══════╝╚══════╝╚═════╝░           ║
// ║                                                                            ║
// ║  Style   : Comprehensive • All modules • Developer info                   ║
// ║  Sections: System · Desktop · Hardware · Network · Dev · Security         ║
// ║  Usage   : fastfetch --config ~/.config/fastfetch/presets/detailed.jsonc  ║
// ╚══════════════════════════════════════════════════════════════════════════╝

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // ── Display ───────────────────────────────────────────────────────────────

    "display": {
        "color": {
            "keys":      "35",
            "title":     "94",
            "separator": "90"
        },
        "separator": "  \u001b[90m│\u001b[0m  ",
        "keyWidth": 20,
        "padding": { "left": 1 },
        "brightColor": true,
        "colorLogo": true,
        "percentType": 9,
        "sizeUnit": "auto",
        "sizeNdigits": 2,
        "temperatureUnit": "celsius",
        "bar": {
            "charElapsed": "█",
            "charTotal":   "░",
            "width": 14,
            "border": false
        }
    },

    // ── Logo ──────────────────────────────────────────────────────────────────

    "logo": {
        "source": "auto",
        "type": "auto",
        "padding": { "top": 0, "left": 1, "right": 3 },
        "position": "left"
    },

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    //  MODULES — Complete System Information
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    "modules": [

        // ╔═══════════════════════════════╗
        // ║  HEADER                       ║
        // ╚═══════════════════════════════╝

        {
            "type": "title",
            "format": "\u001b[1;35m{user-name}\u001b[0m\u001b[90m@\u001b[0m\u001b[1;34m{host-name}\u001b[0m",
            "key": ""
        },
        {
            "type": "separator",
            "string": "═",
            "color": { "separator": "35" }
        },

        // ╔═══════════════════════════════╗
        // ║  SYSTEM INFO                  ║
        // ╚═══════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;90m  ╭─── SYSTEM ──────────────────────────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "os",
            "key": "  │  OS                ",
            "keyColor": "34",
            "format": "{pretty-name} {arch} (build {build-id})"
        },
        {
            "type": "kernel",
            "key": "  │  Kernel            ",
            "keyColor": "34",
            "format": "{sysname} {release} {version}"
        },
        {
            "type": "host",
            "key": "  │  Host              ",
            "keyColor": "34",
            "format": "{family} {name} ({version})"
        },
        {
            "type": "bios",
            "key": "  │  BIOS              ",
            "keyColor": "34",
            "format": "{vendor} {version} ({release-date})"
        },
        {
            "type": "board",
            "key": "  │  Motherboard       ",
            "keyColor": "34",
            "format": "{vendor} {name} {version}"
        },
        {
            "type": "chassis",
            "key": "  │  Chassis           ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": "  │  Uptime            ",
            "keyColor": "34"
        },
        {
            "type": "bootmgr",
            "key": "  │  Boot Manager      ",
            "keyColor": "34"
        },
        {
            "type": "initSystem",
            "key": "  │  Init System       ",
            "keyColor": "34"
        },
        {
            "type": "processes",
            "key": "  │  Processes         ",
            "keyColor": "34"
        },
        {
            "type": "users",
            "key": "  │  Users             ",
            "keyColor": "34"
        },
        {
            "type": "locale",
            "key": "  │  Locale            ",
            "keyColor": "34"
        },
        {
            "type": "timezone",
            "key": "  │  Timezone          ",
            "keyColor": "34"
        },

        { "type": "break" },

        // ╔═══════════════════════════════╗
        // ║  DESKTOP ENVIRONMENT          ║
        // ╚═══════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;90m  ╭─── DESKTOP ─────────────────────────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "wm",
            "key": "  │  WM                ",
            "keyColor": "35",
            "format": "{name} {version}"
        },
        {
            "type": "wmtheme",
            "key": "  │  WM Theme          ",
            "keyColor": "35"
        },
        {
            "type": "de",
            "key": "  │  DE                ",
            "keyColor": "35",
            "format": "{name} {version}"
        },
        {
            "type": "gtk",
            "key": "  │  GTK3 Theme        ",
            "keyColor": "35",
            "version": 3
        },
        {
            "type": "gtk",
            "key": "  │  GTK4 Theme        ",
            "keyColor": "35",
            "version": 4
        },
        {
            "type": "icons",
            "key": "  │  Icons             ",
            "keyColor": "35"
        },
        {
            "type": "cursor",
            "key": "  │  Cursor            ",
            "keyColor": "35",
            "format": "{name} ({size}px)"
        },
        {
            "type": "font",
            "key": "  │  System Font       ",
            "keyColor": "35"
        },
        {
            "type": "wallpaper",
            "key": "  │  Wallpaper         ",
            "keyColor": "35"
        },
        {
            "type": "display",
            "key": "󰍹  │  Display           ",
            "keyColor": "35",
            "format": "{name} ({width}×{height} @ {refresh-rate}Hz)"
        },

        { "type": "break" },

        // ╔═══════════════════════════════╗
        // ║  SOFTWARE                     ║
        // ╚═══════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;90m  ╭─── SOFTWARE ────────────────────────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "shell",
            "key": "  │  Shell             ",
            "keyColor": "36",
            "format": "{name} {version}"
        },
        {
            "type": "terminal",
            "key": "  │  Terminal          ",
            "keyColor": "36",
            "format": "{name} {version}"
        },
        {
            "type": "terminalfont",
            "key": "  │  Terminal Font     ",
            "keyColor": "36",
            "format": "{name} {size}pt"
        },
        {
            "type": "editor",
            "key": "  │  Editor            ",
            "keyColor": "36",
            "format": "{name} {version}"
        },
        {
            "type": "browser",
            "key": "  │  Browser           ",
            "keyColor": "36",
            "format": "{name} {version}"
        },
        {
            "type": "packages",
            "key": "󰏖  │  Packages          ",
            "keyColor": "36"
        },
        {
            "type": "opengl",
            "key": "  │  OpenGL            ",
            "keyColor": "36"
        },
        {
            "type": "vulkan",
            "key": "  │  Vulkan            ",
            "keyColor": "36"
        },

        { "type": "break" },

        // ╔═══════════════════════════════╗
        // ║  HARDWARE                     ║
        // ╚═══════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;90m  ╭─── HARDWARE ────────────────────────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "cpu",
            "key": "  │  CPU               ",
            "keyColor": "33",
            "showPeCoreCount": true,
            "temp": true,
            "format": "{name} ({num-p-cores}P+{num-e-cores}E/{num-threads}T) @ {max-frequency} 🌡 {temp}",
            "tempColor": { "green": 60, "yellow": 80, "red": 90 }
        },
        {
            "type": "cpuusage",
            "key": "  │  CPU Usage         ",
            "keyColor": "33",
            "format": "{all}% avg · {bar}"
        },
        {
            "type": "gpu",
            "key": "󰍹  │  GPU               ",
            "keyColor": "33",
            "temp": true,
            "format": "{name} {vram-size}GB VRAM 🌡 {temp}",
            "tempColor": { "green": 70, "yellow": 85, "red": 95 }
        },
        {
            "type": "memory",
            "key": "  │  RAM               ",
            "keyColor": "33",
            "format": "{used} / {total} ({percentage}%)  {bar}"
        },
        {
            "type": "swap",
            "key": "  │  Swap              ",
            "keyColor": "33",
            "format": "{used} / {total} ({percentage}%)  {bar}"
        },
        {
            "type": "disk",
            "key": "󰋊  │  /                 ",
            "keyColor": "33",
            "folders": "/",
            "format": "{used} / {total} ({percentage}%)  {bar}"
        },
        {
            "type": "disk",
            "key": "󰋊  │  /home             ",
            "keyColor": "33",
            "folders": "/home",
            "format": "{used} / {total} ({percentage}%)  {bar}"
        },
        {
            "type": "physicaldisk",
            "key": "  │  Drives            ",
            "keyColor": "33"
        },

        { "type": "break" },

        // ╔═══════════════════════════════╗
        // ║  CONNECTIVITY                 ║
        // ╚═══════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;90m  ╭─── CONNECTIVITY ───────────────────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "localip",
            "key": "󰖩  │  LAN               ",
            "keyColor": "36",
            "showIpv4": true,
            "showIpv6": true,
            "defaultRouteOnly": false,
            "format": "{ifname}: {ipv4} / {ipv6}"
        },
        {
            "type": "publicip",
            "key": "󰈀  │  WAN               ",
            "keyColor": "36",
            "timeout": 3000,
            "url": "https://api.ipify.org"
        },
        {
            "type": "wifi",
            "key": "  │  WiFi              ",
            "keyColor": "36",
            "format": "{ssid} ({signal-quality}% · {frequency}GHz · {protocol})"
        },
        {
            "type": "bluetooth",
            "key": "  │  Bluetooth         ",
            "keyColor": "36"
        },
        {
            "type": "dns",
            "key": "  │  DNS               ",
            "keyColor": "36"
        },

        { "type": "break" },

        // ╔═══════════════════════════════╗
        // ║  DEV ENVIRONMENT              ║
        // ╚═══════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;90m  ╭─── DEVELOPER ───────────────────────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "command",
            "key": "  │  Neovim            ",
            "keyColor": "32",
            "text": "nvim --version 2>/dev/null | head -1 | sed 's/NVIM //'"
        },
        {
            "type": "command",
            "key": "  │  Node.js           ",
            "keyColor": "32",
            "text": "node --version 2>/dev/null | tr -d 'v' || echo 'not installed'"
        },
        {
            "type": "command",
            "key": "  │  Python            ",
            "keyColor": "32",
            "text": "python3 --version 2>/dev/null | awk '{print $2}' || echo 'not installed'"
        },
        {
            "type": "command",
            "key": "  │  Rust              ",
            "keyColor": "32",
            "text": "rustc --version 2>/dev/null | awk '{print $2}' || echo 'not installed'"
        },
        {
            "type": "command",
            "key": "  │  Go                ",
            "keyColor": "32",
            "text": "go version 2>/dev/null | awk '{print $3}' | tr -d 'go' || echo 'not installed'"
        },
        {
            "type": "command",
            "key": "  │  Docker            ",
            "keyColor": "32",
            "text": "docker --version 2>/dev/null | awk '{print $3}' | tr -d ',' || echo 'not installed'"
        },
        {
            "type": "command",
            "key": "  │  Git               ",
            "keyColor": "32",
            "text": "git --version 2>/dev/null | awk '{print $3}' || echo 'not installed'"
        },

        { "type": "break" },

        // ╔═══════════════════════════════╗
        // ║  POWER & AUDIO                ║
        // ╚═══════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;90m  ╭─── POWER & AUDIO ──────────────────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "battery",
            "key": "  │  Battery           ",
            "keyColor": "32",
            "format": "{percentage}% ({status}) ⚡ {capacity} · 🌡 {temp}",
            "tempColor": { "green": 35, "yellow": 45, "red": 55 }
        },
        {
            "type": "poweradapter",
            "key": "󱊦  │  Power Adapter     ",
            "keyColor": "32"
        },
        {
            "type": "sound",
            "key": "󰕾  │  Audio             ",
            "keyColor": "32"
        },
        {
            "type": "player",
            "key": "󰝚  │  Media Player      ",
            "keyColor": "32",
            "format": "{name}: {artist} — {title} [{status}]"
        },

        { "type": "break" },

        // ── Color strip ────────────────────────────────────────────────────
        {
            "type": "colors",
            "paddingLeft": 4,
            "symbol": "circle"
        },
        { "type": "break" }
    ]
}