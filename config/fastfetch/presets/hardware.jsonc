// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH FASTFETCH — HARDWARE PRESET                                           ║
// ║                                                                            ║
// ║  ██╗░░██╗░█████╗░██████╗░██████╗░░██╗░░░░░░░██╗░█████╗░██████╗░███████╗ ║
// ║  ██║░░██║██╔══██╗██╔══██╗██╔══██╗░██║░░██╗░░██║██╔══██╗██╔══██╗██╔════╝ ║
// ║  ███████║███████║██████╔╝██║░░██║░╚██╗████╗██╔╝███████║██████╔╝█████╗░░ ║
// ║  ██╔══██║██╔══██║██╔══██╗██║░░██║░░████╔═████║░██╔══██║██╔══██╗██╔══╝░░ ║
// ║  ██║░░██║██║░░██║██║░░██║██████╔╝░░╚██╔╝░╚██╔╝░██║░░██║██║░░██║███████╗ ║
// ║  ╚═╝░░╚═╝╚═╝░░╚═╝╚═╝░░╚═╝╚═════╝░░░╚═╝░░░╚═╝░░╚═╝░░╚═╝╚═╝░░╚═╝╚══════╝ ║
// ║                                                                            ║
// ║  Style   : Hardware-focused • No logo • Deep component analysis           ║
// ║  Sections: CPU · GPU · Memory · Storage · Thermal · Power                 ║
// ║  Usage   : fastfetch --config ~/.config/fastfetch/presets/hardware.jsonc  ║
// ╚══════════════════════════════════════════════════════════════════════════╝

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // ── Display ───────────────────────────────────────────────────────────────

    "display": {
        "color": {
            "keys":      "33",   // Yellow — hardware color
            "title":     "33",
            "separator": "90"
        },
        "separator": "  \u001b[90m│\u001b[0m  ",
        "keyWidth": 22,
        "padding": { "left": 1 },
        "brightColor": true,
        "colorLogo": false,
        "percentType": 9,
        "sizeUnit": "auto",
        "sizeNdigits": 2,
        "temperatureUnit": "celsius",
        "bar": {
            "charElapsed": "▓",
            "charTotal":   "░",
            "width": 16,
            "border": false
        }
    },

    // ── No Logo (hardware focus) ───────────────────────────────────────────────

    "logo": {
        "source": "none",
        "type": "none"
    },

    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    //  MODULES — Deep Hardware Analysis
    // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    "modules": [

        // ╔══════════════════════════════════════════════════════╗
        // ║  HARDWARE REPORT HEADER                             ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;33m╔════════════════════════════════════════════════════╗\u001b[0m",
            "key": ""
        },
        {
            "type": "custom",
            "format": "\u001b[1;33m║  🖥️  ASH HARDWARE REPORT  ·  {date}     ║\u001b[0m",
            "key": ""
        },
        {
            "type": "custom",
            "format": "\u001b[1;33m╚════════════════════════════════════════════════════╝\u001b[0m",
            "key": ""
        },
        {
            "type": "host",
            "key": "  System Model       ",
            "format": "\u001b[1m{family} {name} {version}\u001b[0m"
        },
        {
            "type": "bios",
            "key": "  BIOS               ",
            "format": "{vendor} {version} · {release-date}"
        },
        {
            "type": "board",
            "key": "  Motherboard        ",
            "format": "{vendor} {name} {version}"
        },
        {
            "type": "chassis",
            "key": "  Chassis Type       "
        },

        { "type": "break" },

        // ╔══════════════════════════════════════════════════════╗
        // ║  CPU SECTION                                        ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;33m ─────────────────────── CPU ───────────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "cpu",
            "key": "  Processor          ",
            "keyColor": "33",
            "showPeCoreCount": true,
            "format": "{name}",
            "temp": false
        },
        {
            "type": "cpu",
            "key": "  Architecture       ",
            "keyColor": "33",
            "format": "{arch}"
        },
        {
            "type": "cpu",
            "key": "  Cores / Threads    ",
            "keyColor": "33",
            "format": "{num-p-cores} P-cores + {num-e-cores} E-cores = {num-cores}c / {num-threads}t",
            "showPeCoreCount": true,
            "temp": false
        },
        {
            "type": "cpu",
            "key": "  Frequency          ",
            "keyColor": "33",
            "format": "{base-frequency} base · {max-frequency} boost",
            "temp": false
        },
        {
            "type": "cpu",
            "key": "  Temperature 🌡      ",
            "keyColor": "33",
            "format": "{temp}",
            "temp": true,
            "tempColor": { "green": 60, "yellow": 80, "red": 90 }
        },
        {
            "type": "cpuusage",
            "key": "  Current Usage      ",
            "keyColor": "33",
            "format": "{all}%  {bar}",
            "separate": false
        },
        {
            "type": "command",
            "key": "  Cache L2/L3        ",
            "keyColor": "33",
            "text": "lscpu 2>/dev/null | awk '/L2 cache/{l2=$3} /L3 cache/{l3=$3} END{printf \"%s / %s\", l2, l3}' || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "  Governor           ",
            "keyColor": "33",
            "text": "cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "  Vulnerabilities     ",
            "keyColor": "33",
            "text": "grep -l 'Vulnerable' /sys/devices/system/cpu/vulnerabilities/* 2>/dev/null | wc -l | xargs -I{} echo '{} CVEs mitigated' || echo 'All mitigated'"
        },

        { "type": "break" },

        // ╔══════════════════════════════════════════════════════╗
        // ║  GPU SECTION                                        ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;33m ─────────────────────── GPU ───────────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "gpu",
            "key": "󰍹  GPU Model           ",
            "keyColor": "33",
            "format": "{name}",
            "temp": false
        },
        {
            "type": "gpu",
            "key": "  VRAM               ",
            "keyColor": "33",
            "format": "{vram-size}",
            "temp": false
        },
        {
            "type": "gpu",
            "key": "  Temperature 🌡      ",
            "keyColor": "33",
            "format": "{temp}",
            "temp": true,
            "tempColor": { "green": 70, "yellow": 85, "red": 95 }
        },
        {
            "type": "gpu",
            "key": "  Driver             ",
            "keyColor": "33",
            "format": "{driver} {driver-version}",
            "temp": false
        },
        {
            "type": "opengl",
            "key": "  OpenGL             ",
            "keyColor": "33"
        },
        {
            "type": "vulkan",
            "key": "  Vulkan             ",
            "keyColor": "33"
        },
        {
            "type": "opencl",
            "key": "  OpenCL             ",
            "keyColor": "33"
        },
        {
            "type": "command",
            "key": "  NVIDIA CUDA        ",
            "keyColor": "33",
            "text": "nvidia-smi --query-gpu=driver_version,cuda_version --format=csv,noheader 2>/dev/null | head -1 | sed 's/,/ · CUDA /' || echo 'N/A (not NVIDIA)'"
        },
        {
            "type": "command",
            "key": "  GPU Usage          ",
            "keyColor": "33",
            "text": "nvidia-smi --query-gpu=utilization.gpu,utilization.memory --format=csv,noheader,nounits 2>/dev/null | awk -F, '{printf \"GPU: %s%% · VRAM: %s%%\", $1, $2}' || cat /sys/class/drm/card0/device/gpu_busy_percent 2>/dev/null | xargs -I{} echo 'GPU: {}%' || echo 'N/A'"
        },

        { "type": "break" },

        // ╔══════════════════════════════════════════════════════╗
        // ║  MEMORY SECTION                                     ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;33m ───────────────────── MEMORY ──────────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "memory",
            "key": "  RAM Total          ",
            "keyColor": "33",
            "format": "{total}"
        },
        {
            "type": "memory",
            "key": "  RAM Used           ",
            "keyColor": "33",
            "format": "{used} ({percentage}%)  {bar}"
        },
        {
            "type": "memory",
            "key": "  RAM Available      ",
            "keyColor": "33",
            "format": "{available}"
        },
        {
            "type": "swap",
            "key": "  Swap Total         ",
            "keyColor": "33",
            "format": "{total}"
        },
        {
            "type": "swap",
            "key": "  Swap Used          ",
            "keyColor": "33",
            "format": "{used} ({percentage}%)  {bar}"
        },
        {
            "type": "command",
            "key": "  RAM Type/Speed     ",
            "keyColor": "33",
            "text": "sudo dmidecode -t memory 2>/dev/null | grep -E 'Type:|Speed:' | grep -v 'Error|Unknown|No Module' | head -2 | awk 'NR==1{type=$2} NR==2{speed=$2\" \"$3} END{printf \"%s @ %s\", type, speed}' || echo 'Run as root for details'"
        },
        {
            "type": "command",
            "key": "  RAM Slots          ",
            "keyColor": "33",
            "text": "sudo dmidecode -t memory 2>/dev/null | grep -c 'Memory Device' || echo 'Run as root for details'"
        },

        { "type": "break" },

        // ╔══════════════════════════════════════════════════════╗
        // ║  STORAGE SECTION                                    ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;33m ──────────────────── STORAGE ──────────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "physicaldisk",
            "key": "  Physical Drives    ",
            "keyColor": "33",
            "format": "{name} ({type}) {size} — {rotational}"
        },
        {
            "type": "disk",
            "key": "󰋊  /  (Root)          ",
            "keyColor": "33",
            "folders": "/",
            "format": "{used} / {total} ({percentage}%)  {bar}  [{filesystem}]"
        },
        {
            "type": "disk",
            "key": "󰋊  /home             ",
            "keyColor": "33",
            "folders": "/home",
            "format": "{used} / {total} ({percentage}%)  {bar}  [{filesystem}]"
        },
        {
            "type": "disk",
            "key": "󰋊  /boot             ",
            "keyColor": "33",
            "folders": "/boot",
            "format": "{used} / {total} ({percentage}%)  [{filesystem}]"
        },
        {
            "type": "command",
            "key": "  NVMe Drives        ",
            "keyColor": "33",
            "text": "ls /dev/nvme* 2>/dev/null | head -3 | tr '\\n' ' ' || echo 'None detected'"
        },
        {
            "type": "command",
            "key": "  NVMe Temp 🌡       ",
            "keyColor": "33",
            "text": "nvme smart-log /dev/nvme0 2>/dev/null | grep 'temperature' | awk '{print $3\"°C\"}' | head -1 || echo 'N/A'"
        },

        { "type": "break" },

        // ╔══════════════════════════════════════════════════════╗
        // ║  NETWORK HARDWARE                                   ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;33m ──────────────────── NETWORK ──────────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "localip",
            "key": "󰖩  LAN                ",
            "keyColor": "33",
            "showIpv4": true,
            "showIpv6": false,
            "defaultRouteOnly": false,
            "format": "{ifname} · {ipv4}"
        },
        {
            "type": "wifi",
            "key": "  WiFi               ",
            "keyColor": "33",
            "format": "{ssid} · {signal-quality}% · {frequency}GHz · {protocol} · {security}"
        },
        {
            "type": "bluetooth",
            "key": "  Bluetooth          ",
            "keyColor": "33"
        },
        {
            "type": "command",
            "key": "  Network Cards      ",
            "keyColor": "33",
            "text": "lspci 2>/dev/null | grep -i 'network\\|ethernet\\|wireless' | sed 's/.*: //' | head -3 || echo 'N/A'"
        },

        { "type": "break" },

        // ╔══════════════════════════════════════════════════════╗
        // ║  POWER & THERMAL                                    ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;33m ────────────────── POWER & THERMAL ────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "battery",
            "key": "  Battery            ",
            "keyColor": "32",
            "format": "{percentage}% · {status} · {capacity}Wh · {temp}°C · Cycle: {cycle-count}",
            "tempColor": { "green": 35, "yellow": 45, "red": 55 }
        },
        {
            "type": "poweradapter",
            "key": "󱊦  Power Adapter      ",
            "keyColor": "32"
        },
        {
            "type": "command",
            "key": "  CPU Package Power  ",
            "keyColor": "32",
            "text": "cat /sys/class/powercap/intel-rapl/intel-rapl:0/energy_uj 2>/dev/null | awk '{printf \"%.1f W\", $1/1000000}' || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "  Fan Speeds         ",
            "keyColor": "32",
            "text": "sensors 2>/dev/null | grep -i 'fan' | awk '{print $1, $2}' | head -3 | tr '\\n' ' ' || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "  All Temps 🌡       ",
            "keyColor": "32",
            "text": "sensors 2>/dev/null | grep -E '°C' | grep -v '+0.0°C' | head -6 | awk '{printf \"%s:%s  \", $1, $2}' || echo 'Install lm-sensors'"
        },

        { "type": "break" },

        // ╔══════════════════════════════════════════════════════╗
        // ║  USB & PERIPHERALS                                  ║
        // ╚══════════════════════════════════════════════════════╝

        {
            "type": "custom",
            "format": "\u001b[1;33m ──────────────────── PERIPHERALS ──────────────────\u001b[0m",
            "key": ""
        },
        {
            "type": "display",
            "key": "  Display            ",
            "keyColor": "33",
            "format": "{name}: {width}×{height} @ {refresh-rate}Hz ({output})"
        },
        {
            "type": "sound",
            "key": "󰕾  Audio              ",
            "keyColor": "33"
        },
        {
            "type": "command",
            "key": "  USB Devices        ",
            "keyColor": "33",
            "text": "lsusb 2>/dev/null | grep -v 'Linux Foundation\\|root hub' | wc -l | xargs -I{} echo '{} connected'"
        },
        {
            "type": "command",
            "key": "  Webcam             ",
            "keyColor": "33",
            "text": "ls /dev/video* 2>/dev/null | head -2 | tr '\\n' ' ' || echo 'None detected'"
        },

        { "type": "break" },

        // ── Color strip ────────────────────────────────────────────────────
        {
            "type": "colors",
            "paddingLeft": 3,
            "symbol": "square"
        }
    ]
}