// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Waybar Module: Clock (12-Hour Format)            ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "clock": {

        // ── Primary format: 12h with AM/PM ───────────────────────────────────
        "format":       "  {:%I:%M %p}",

        // ── Alt format (on right-click toggle): full date ─────────────────────
        "format-alt":   "  {:%A, %B %d %Y  ·  %I:%M:%S %p}",

        // ── Tooltip: calendar ─────────────────────────────────────────────────
        "tooltip-format": "<span size='10pt' font='JetBrainsMono Nerd Font'><big>{:%A, %B %d %Y}</big>\nWeek {:%W}  ·  Day {:%j}/365\n\n<tt><small>{calendar}</small></tt></span>",

        // ── Calendar configuration ────────────────────────────────────────────
        "calendar": {
            "mode":             "month",
            "mode-mon-col":     3,
            "weeks-pos":        "right",
            "on-scroll":        1,
            "on-click-right":   "mode",
            "format": {
                "months":       "<span color='#cba4f7'><b>{}</b></span>",
                "days":         "<span color='#cdd6f4'>{}</span>",
                "weeks":        "<span color='#89dceb'><b>W{}</b></span>",
                "weekdays":     "<span color='#a6e3a1'><b>{}</b></span>",
                "today":        "<span color='#f38ba8' font_weight='bold'><u><b>{}</b></u></span>"
            }
        },

        // ── Mouse interaction ─────────────────────────────────────────────────
        "actions": {
            "on-click":         "mode",
            "on-click-right":   "tz_up",
            "on-scroll-up":     "shift_up",
            "on-scroll-down":   "shift_down"
        },

        // ── Update interval ───────────────────────────────────────────────────
        "interval":     1,

        // ── Timezone (empty = system timezone) ────────────────────────────────
        "timezone":     ""
    }
}