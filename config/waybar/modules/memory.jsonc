// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Waybar Module: Memory (RAM)                      ║
// ║                                                                              ║
// ║  RAM and swap usage with detailed tooltip breakdown, state-based colors   ║
// ║  and system monitor integration.                                            ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "memory": {

        // ── Display format ────────────────────────────────────────────────────
        "format":           "󰍛 {percentage}%",

        // ── Alt format: show used/total ────────────────────────────────────────
        "format-alt":       "󰍛 {used:0.1f}G/{total:0.1f}G",

        // ── Tooltip ───────────────────────────────────────────────────────────
        "tooltip-format":   "RAM:  {used:0.2f}G / {total:0.2f}G ({percentage}%)\nFree: {free:0.2f}G\nAvail: {avail:0.2f}G\n\nSwap: {swapUsed:0.2f}G / {swapTotal:0.2f}G ({swapPercentage}%)\n\nClick to open system monitor",

        // ── State thresholds ──────────────────────────────────────────────────
        "states": {
            "good":         0,
            "warning":      75,
            "critical":     90
        },

        // ── Update interval ───────────────────────────────────────────────────
        "interval":         5,

        // ── Mouse interaction ─────────────────────────────────────────────────
        "on-click":         "kitty --class monitoring -e btop",
        "on-click-right":   "kitty --class monitoring -e btop"
    }
}