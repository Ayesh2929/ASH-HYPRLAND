// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Waybar Module: CPU Temperature                   ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "temperature": {

        // ── Thermal zone (empty = auto-detect hottest) ────────────────────────
        // "thermal-zone": 2,
        // "hwmon-path":   "/sys/class/hwmon/hwmon2/temp1_input",

        // ── Critical threshold ────────────────────────────────────────────────
        "critical-threshold":       80,

        // ── Display formats ───────────────────────────────────────────────────
        "format":                   "󰔏 {temperatureC}°C",
        "format-critical":          "󰸂 {temperatureC}°C",

        // ── Alt format: Fahrenheit ────────────────────────────────────────────
        // "format-alt":            "󰔏 {temperatureF}°F",

        // ── Icons ─────────────────────────────────────────────────────────────
        "format-icons":             ["󱃂", "󰔐", "󰔏", "󰔎", "󰸂"],

        // ── Tooltip ───────────────────────────────────────────────────────────
        "tooltip-format":           "CPU Temperature: {temperatureC}°C ({temperatureF}°F)\nCritical threshold: {criticalThreshold}°C",

        // ── Update interval ───────────────────────────────────────────────────
        "interval":                 5,

        // ── Mouse interaction ─────────────────────────────────────────────────
        "on-click":                 "kitty --class monitoring -e btop"
    }
}