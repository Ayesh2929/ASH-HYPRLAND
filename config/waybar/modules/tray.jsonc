// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Waybar Module: System Tray                       ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "tray": {

        // ── Icon size in pixels ───────────────────────────────────────────────
        "icon-size":            16,

        // ── Spacing between tray icons ────────────────────────────────────────
        "spacing":              8,

        // ── Show passive items (apps that don't have click actions) ───────────
        "show-passive-items":   false,

        // ── Reverse item order ────────────────────────────────────────────────
        "reverse-direction":    false
    }
}