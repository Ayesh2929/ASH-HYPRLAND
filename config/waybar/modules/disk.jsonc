// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Waybar Module: Disk Usage                        ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "disk": {

        // ── Mount path to monitor ─────────────────────────────────────────────
        "path":             "/",

        // ── Display format ────────────────────────────────────────────────────
        "format":           "󰋊 {percentage_used}%",
        "format-alt":       "󰋊 {used}/{total}",

        // ── Tooltip ───────────────────────────────────────────────────────────
        "tooltip-format":   "Disk: {path}\n\nUsed:  {used} ({percentage_used}%)\nFree:  {free} ({percentage_free}%)\nTotal: {total}\n\nClick to open file manager",

        // ── State thresholds ──────────────────────────────────────────────────
        "states": {
            "good":         0,
            "warning":      80,
            "critical":     95
        },

        // ── Update interval ───────────────────────────────────────────────────
        "interval":         30,

        // ── Unit ──────────────────────────────────────────────────────────────
        "unit":             "GB",

        // ── Mouse interaction ─────────────────────────────────────────────────
        "on-click":         "kitty --class yazi -e yazi /",
        "on-click-right":   "kitty -e df -h"
    }
}