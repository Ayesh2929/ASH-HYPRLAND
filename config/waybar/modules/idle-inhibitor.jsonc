// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Waybar Module: Idle Inhibitor                    ║
// ║                                                                              ║
// ║  Toggle to prevent screen sleep/lock when active.                         ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "idle_inhibitor": {

        // ── Icons for each state ──────────────────────────────────────────────
        "format":               "{icon}",
        "format-icons": {
            "activated":        "󰒳",    // Eye — screen stays on
            "deactivated":      "󰒲"     // Sleeping eye — normal idle
        },

        // ── Tooltip ───────────────────────────────────────────────────────────
        "tooltip-format-activated":   "Idle inhibitor: ON\n\nScreen will not sleep\nClick to deactivate",
        "tooltip-format-deactivated": "Idle inhibitor: OFF\n\nScreen sleeps normally\nClick to keep screen on",

        // ── Start in deactivated state ─────────────────────────────────────────
        "start-activated":      false,

        // ── Timeout before auto-deactivating (seconds, 0 = never) ─────────────
        "timeout":              0
    }
}