// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Waybar Module: Power Profiles Daemon             ║
// ║                                                                              ║
// ║  Cycles between power-saver, balanced and performance profiles.           ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "power-profiles-daemon": {

        // ── Display format ────────────────────────────────────────────────────
        "format":               "{icon}",

        // ── Profile icons ─────────────────────────────────────────────────────
        "format-icons": {
            "default":          "󱐌",
            "performance":      "󰓅",    // Rocket — max performance
            "balanced":         "󰾅",    // Balance scale
            "power-saver":      "󰁹"     // Battery — conservation
        },

        // ── Tooltip ───────────────────────────────────────────────────────────
        "tooltip-format":       "Power Profile: {profile}\nDriver: {driver}\n\nScroll or click to cycle profiles",

        // ── Mouse interaction ─────────────────────────────────────────────────
        "on-click":             "powerprofilesctl set performance",
        "on-click-right":       "powerprofilesctl set power-saver",
        "on-click-middle":      "powerprofilesctl set balanced",
        "on-scroll-up":         "powerprofilesctl set performance",
        "on-scroll-down":       "powerprofilesctl set power-saver"
    }
}