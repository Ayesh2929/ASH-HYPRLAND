// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Waybar Module: GameMode                          ║
// ║                                                                              ║
// ║  Shows when Feral GameMode is active (gamemoded running).                 ║
// ║  Visible only when a game is running with gamemode enabled.               ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "gamemode": {

        // ── Display format ────────────────────────────────────────────────────
        "format":               "{glyph} {count}",
        "format-alt":           "{glyph} GameMode ON",

        // ── Glyph (icon) ──────────────────────────────────────────────────────
        "glyph":                "󰊗",

        // ── Hide when not active ──────────────────────────────────────────────
        "hide-not-running":     true,

        // ── Use game icon (requires icon theme support) ───────────────────────
        "use-icon":             true,
        "icon-name":            "input-gaming-symbolic",
        "icon-spacing":         4,
        "icon-size":            14,

        // ── Tooltip ───────────────────────────────────────────────────────────
        "tooltip":              true,
        "tooltip-format":       "GameMode active\nGames running: {count}\n\n{tooltip}",

        // ── Mouse interaction ─────────────────────────────────────────────────
        "on-click":             "ash mode default",
        "on-click-right":       "gamemoderun true"
    }
}