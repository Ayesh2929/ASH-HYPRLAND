// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Waybar Module: Hyprland Keyboard Language        ║
// ║                                                                              ║
// ║  Shows active keyboard layout/variant with flag emoji and click-to-cycle.  ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "hyprland/language": {

        // ── Display format ────────────────────────────────────────────────────
        // {short}    — abbreviated layout name (e.g. "US", "DE")
        // {long}     — full layout name
        // {variant}  — layout variant (e.g. "dvorak", "colemak")
        // {flag}     — flag emoji for the layout country
        "format":                   "󰌌 {short}",
        "format-en":                "󰌌 EN",
        "format-de":                "󰌌 DE",
        "format-fr":                "󰌌 FR",
        "format-ru":                "󰌌 RU",
        "format-ja":                "󰌌 JA",
        "format-zh":                "󰌌 ZH",

        // ── Keyboard device (empty = all keyboards) ───────────────────────────
        "keyboard-name":            "",

        // ── Mouse interaction ─────────────────────────────────────────────────
        "on-click":                 "hyprctl switchxkblayout all next",
        "on-click-right":           "hyprctl switchxkblayout all prev",

        // ── Tooltip ───────────────────────────────────────────────────────────
        "tooltip":                  true,
        "tooltip-format":           "Layout: {long}\nVariant: {variant}\n\nClick to switch layout"
    }
}