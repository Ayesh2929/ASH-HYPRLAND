// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Waybar Module: Clock (24-Hour Format)            ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "clock": {

        // ── Primary format: 24h ───────────────────────────────────────────────
        "format":       "  {:%H:%M}",

        // ── Alt format: full date + seconds ──────────────────────────────────
        "format-alt":   "  {:%A, %B %d %Y  ·  %H:%M:%S}",

        // ── Tooltip calendar ─────────────────────────────────────────────────
        "tooltip-format": "<span size='10pt' font='JetBrainsMono Nerd Font'><big>{:%A, %B %d %Y}</big>\n<span color='#89dceb'>Week {:%W}</span>  ·  <span color='#a6e3a1'>Day {:%j}/365</span>\n<span color='#cba4f7'>{:%Z} UTC%z</span>\n\n<tt><small>{calendar}</small></tt></span>",

        "calendar": {
            "mode":             "month",
            "mode-mon-col":     3,
            "weeks-pos":        "right",
            "on-scroll":        1,
            "format": {
                "months":       "<span color='#cba4f7'><b>{}</b></span>",
                "days":         "<span color='#cdd6f4'>{}</span>",
                "weeks":        "<span color='#89dceb'><b>W{}</b></span>",
                "weekdays":     "<span color='#a6e3a1'><b>{}</b></span>",
                "today":        "<span color='#f38ba8'><u><b>{}</b></u></span>"
            }
        },

        "actions": {
            "on-click":         "mode",
            "on-click-right":   "tz_up",
            "on-scroll-up":     "shift_up",
            "on-scroll-down":   "shift_down"
        },

        "interval":     1
    }
}