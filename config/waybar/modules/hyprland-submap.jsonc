// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Waybar Module: Hyprland Submap                   ║
// ║                                                                              ║
// ║  Shows the currently active Hyprland keybind submap (modal mode).         ║
// ║  Hidden when in default (no submap). Animated indicator with clear labels. ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "hyprland/submap": {

        // ── Display format ────────────────────────────────────────────────────
        // {submap} — the active submap name
        "format":                   "󰌌 <span color='#cba4f7'><b>{}</b></span>",

        // ── Show/hide behavior ────────────────────────────────────────────────
        // false = only show when a submap is active (hidden in normal mode)
        // true  = always visible (shows "default" when no submap)
        "always-on":                false,

        // ── Tooltip ───────────────────────────────────────────────────────────
        "tooltip":                  true,
        "tooltip-format":           "Active mode: {}\nPress Escape or Return to exit"
    }
}