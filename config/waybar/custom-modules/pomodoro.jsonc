// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Custom Module: Pomodoro Timer                    ║
// ║                                                                              ║
// ║  Pomodoro focus timer with work/break cycle tracking, session count       ║
// ║  and visual progress. Runs via ash plugin pomodoro-plus.                  ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "custom/pomodoro": {
        "format":           "{}",
        "return-type":      "json",
        "exec":             "~/.config/waybar/scripts/pomodoro.sh --status",
        "interval":         1,
        "signal":           27,
        "on-click":         "~/.config/waybar/scripts/pomodoro.sh --toggle && pkill -SIGUSR1 waybar",
        "on-click-right":   "~/.config/waybar/scripts/pomodoro.sh --reset && pkill -SIGUSR1 waybar",
        "on-click-middle":  "~/.config/waybar/scripts/pomodoro.sh --skip && pkill -SIGUSR1 waybar",
        "tooltip":          true,
        "escape":           false
    }
}

// ── Script skeleton: ~/.config/waybar/scripts/pomodoro.sh ────────────────────
