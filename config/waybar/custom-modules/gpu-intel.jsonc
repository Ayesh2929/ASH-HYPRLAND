// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Custom Module: Intel GPU Monitor                 ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "custom/gpu-intel": {
        "format":           "󰾲 {}",
        "return-type":      "json",
        "exec":             "~/.config/waybar/scripts/gpu-intel.sh",
        "exec-if":          "which intel_gpu_top &>/dev/null || ls /sys/class/drm/renderD128 &>/dev/null",
        "interval":         5,
        "on-click":         "kitty --class monitoring -e intel_gpu_top",
        "tooltip":          true,
        "escape":           false
    }
}