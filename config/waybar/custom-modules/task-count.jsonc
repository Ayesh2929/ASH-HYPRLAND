// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Custom Module: Task Count (Taskwarrior/Todo)     ║
// ║                                                                              ║
// ║  Pending task count via taskwarrior or todo.txt with urgency breakdown.   ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "custom/tasks": {
        "format":           "󰄳 {}",
        "return-type":      "json",
        "exec":             "~/.config/waybar/scripts/task-count.sh",
        "exec-if":          "which task &>/dev/null || [ -f ~/todo.txt ]",
        "interval":         300,
        "signal":           28,
        "on-click":         "kitty --class floating -e task list",
        "on-click-right":   "kitty --class floating -e bash -c 'task add \"$(rofi -dmenu -p \"Add task\")\"'",
        "on-click-middle":  "pkill -SIGUSR1 waybar",
        "tooltip":          true,
        "escape":           true
    }
}

