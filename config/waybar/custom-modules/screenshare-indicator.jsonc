// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Custom Module: Screen Share Indicator            ║
// ║                                                                              ║
// ║  Detects active XDG portal screen capture sessions.                       ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "custom/screenshare": {
        "format":           "{}",
        "return-type":      "json",
        "exec":             "~/.config/waybar/scripts/screenshare.sh",
        "interval":         5,
        "signal":           31,
        "on-click":         "pkill -f 'xdg-desktop-portal' && pkill -SIGUSR1 waybar",
        "tooltip":          true,
        "escape":           false
    }
}

