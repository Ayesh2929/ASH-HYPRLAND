// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Custom Module: GitHub Notifications              ║
// ║                                                                              ║
// ║  Unread GitHub notification count via GitHub CLI (gh).                    ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "custom/github-notif": {
        "format":           "󰊤 {}",
        "return-type":      "json",
        "exec":             "~/.config/waybar/scripts/github-notif.sh",
        "exec-if":          "gh auth status &>/dev/null",
        "interval":         300,
        "signal":           22,
        "on-click":         "xdg-open https://github.com/notifications",
        "on-click-right":   "gh api /notifications --method PATCH --field read=true &>/dev/null && pkill -SIGUSR1 waybar",
        "tooltip":          true,
        "escape":           true
    }
}

