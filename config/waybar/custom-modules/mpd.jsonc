// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Custom Module: MPD (Music Player Daemon)         ║
// ║                                                                              ║
// ║  MPD status via mpc with full playback control, elapsed time and           ║
// ║  playlist position display.                                                  ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "mpd": {

        // ── Format strings ────────────────────────────────────────────────────
        "format":                   "{stateIcon} {artist} — {title}",
        "format-disconnected":      "󰝚 MPD offline",
        "format-stopped":           "󰓛  Stopped",

        // ── Alt format: elapsed/total ──────────────────────────────────────────
        // "format-alt":            "{stateIcon} {elapsed}/{duration}",

        // ── State icons ───────────────────────────────────────────────────────
        "state-icons": {
            "paused":       "󰏤",
            "playing":      "󰎇"
        },

        // ── Consuming/repeat/random/single icons ──────────────────────────────
        "consume-icons": {
            "on":           " "
        },
        "random-icons": {
            "on":           "󰒝 "
        },
        "repeat-icons": {
            "on":           "󰑖 "
        },
        "single-icons": {
            "on":           "󰑘 "
        },

        // ── Tooltip ───────────────────────────────────────────────────────────
        "tooltip-format":           "MPD: {state}\n\nTitle:  {title}\nArtist: {artist}\nAlbum:  {album}\n\nElapsed: {elapsed}/{duration}\nPlaylist: {songPosition}/{queueLength}",
        "tooltip-format-disconnected": "MPD is not running",

        // ── MPD connection settings ───────────────────────────────────────────
        "server":                   "localhost",
        "port":                     6600,
        // "password":              "secret",

        // ── Max display length ────────────────────────────────────────────────
        "max-length":               45,

        // ── Mouse controls ────────────────────────────────────────────────────
        "on-click":                 "mpc toggle",
        "on-click-right":           "mpc next",
        "on-click-middle":          "mpc prev",
        "on-scroll-up":             "mpc next",
        "on-scroll-down":           "mpc prev",

        // ── Update interval ───────────────────────────────────────────────────
        "interval":                 2
    }
}