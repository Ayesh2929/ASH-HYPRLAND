// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Custom Module: VPN Status                        ║
// ║                                                                              ║
// ║  VPN connection state via nmcli/wg-quick/openvpn detection.               ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "custom/vpn": {
        "format":           "{}",
        "return-type":      "json",
        "exec":             "~/.config/waybar/scripts/vpn-status.sh",
        "interval":         15,
        "signal":           25,
        "on-click":         "~/.config/rofi/menus/vpn-manager/vpn-manager.sh 2>/dev/null || nmtui",
        "on-click-right":   "nmcli connection down $(nmcli -g NAME,TYPE connection show --active | grep vpn | cut -d: -f1 | head -1) 2>/dev/null",
        "tooltip":          true,
        "escape":           false
    }
}

