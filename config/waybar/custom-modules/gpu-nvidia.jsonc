// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Custom Module: NVIDIA GPU Monitor                ║
// ║                                                                              ║
// ║  NVIDIA GPU utilization, VRAM usage, temperature and power draw           ║
// ║  via nvidia-smi. Updates every 3 seconds.                                  ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "custom/gpu-nvidia": {
        "format":           "󰾲 {}",
        "return-type":      "json",
        "exec":             "~/.config/waybar/scripts/gpu-nvidia.sh",
        "exec-if":          "which nvidia-smi &>/dev/null",
        "interval":         3,
        "on-click":         "kitty --class monitoring -e nvtop",
        "on-click-right":   "nvidia-settings",
        "tooltip":          true,
        "escape":           false
    }
}

