// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Custom Module: Pacman/AUR Updates               ║
// ║                                                                              ║
// ║  Pending system updates count with urgent badge on critical count.        ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "custom/updates-pacman": {
        "format":           "󰀠 {}",
        "return-type":      "json",
        "exec":             "~/.config/waybar/scripts/updates-pacman.sh",
        "exec-if":          "which checkupdates &>/dev/null",
        "interval":         3600,
        "signal":           20,
        "on-click":         "kitty --class floating -e bash -c 'paru -Syu; read -p \"Press Enter to close\"'",
        "on-click-right":   "~/.config/waybar/scripts/updates-pacman.sh --refresh && pkill -SIGUSR1 waybar",
        "tooltip":          true,
        "escape":           true
    }
}

