// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Custom Module: Stock Ticker                      ║
// ║                                                                              ║
// ║  Real-time stock price via Yahoo Finance API. Color-coded by movement.    ║
// ║  Configure tickers in the script. Updates every 5 minutes.               ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "custom/stocks": {
        "format":           "{}",
        "return-type":      "json",
        "exec":             "~/.config/waybar/scripts/stock-ticker.sh",
        "exec-if":          "ping -c1 -W2 finance.yahoo.com &>/dev/null",
        "interval":         300,
        "signal":           33,
        "on-click":         "xdg-open https://finance.yahoo.com",
        "on-click-right":   "pkill -SIGUSR1 waybar",
        "tooltip":          true,
        "escape":           false
    }
}

