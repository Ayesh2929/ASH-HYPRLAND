// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Custom Module: Screen Recording Indicator        ║
// ║                                                                              ║
// ║  Shows a pulsing red indicator when wf-recorder is active.               ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
{
    "custom/recording": {
        "format":           "{}",
        "return-type":      "json",
        "exec":             "~/.config/waybar/scripts/recording.sh",
        "interval":         3,
        "signal":           30,
        "on-click":         "pkill --signal SIGINT wf-recorder && pkill -SIGUSR1 waybar",
        "tooltip":          true,
        "escape":           false
    }
}

