// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  ASH DOTFILES v5.0 OMEGA — Zen Bar Layout                                   ║
// ║                                                                              ║
// ║  Absolute minimum. Clock only. Everything else hidden.                    ║
// ║  For deep focus, meditation, writing, reading.                            ║
// ║  Click clock → shows full date. Right-click → temporary status peek.     ║
// ║                                                                              ║
// ║  Activate: ash bar layout zen-bar                                         ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
[{
    "name":             "zen-bar",
    "output":           ["DP-1","eDP-1"],
    "position":         "top",
    "height":           26,
    "width":            120,
    "margin-top":       6,
    "margin-left":      0,
    "margin-right":     0,
    "margin-bottom":    0,
    "layer":            "top",
    "exclusive":        false,
    "passthrough":      true,
    "gtk-layer-shell":  true,
    "spacing":          0,
    "ipc":              true,

    "modules-left":   [],
    "modules-center": ["clock"],
    "modules-right":  [],

    "clock": {
        "format":       "{:%H:%M}",
        "format-alt":   "{:%A, %B %d %Y · %H:%M:%S}",
        "interval":     60,
        "tooltip-format": "<big>{:%A, %B %d %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "actions": {
            "on-click":       "mode",
            "on-click-right": "mode"
        }
    }
}]