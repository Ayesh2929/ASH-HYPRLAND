# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🔧  GLOBAL DEFAULTS — Applied to ALL connections
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Host *

    # ── Connection ────────────────────────────────────────────────────────────
    # TCP keepalive to prevent dropped idle connections
    ServerAliveInterval                 60
    ServerAliveCountMax                 10
    TCPKeepAlive                        yes

    # Multiplexing — reuse existing connections (huge speed boost)
    ControlMaster                       auto
    ControlPath                         ~/.ssh/sockets/%r@%h:%p
    ControlPersist                      10m

    # Connection timeout (seconds)
    ConnectTimeout                      30

    # Compression (useful over slow links)
    Compression                         yes

    # ── Retry failed connections ──────────────────────────────────────────────
    # Host key verification
    StrictHostKeyChecking               ask
    UpdateHostKeys                      yes
    VerifyHostKeyDNS                    ask

    # Only use modern, secure ciphers (CHACHA20 preferred on Wayland)
    Ciphers                             chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr

    # Only modern MACs
    MACs                                hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com,hmac-sha2-512,hmac-sha2-256

    # Only secure key exchange algorithms
    KexAlgorithms                       curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512,diffie-hellman-group-exchange-sha256

    # Host key algorithms (prefer Ed25519)
    HostKeyAlgorithms                   ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,rsa-sha2-512,rsa-sha2-256

    # Public key types to use
    PubkeyAcceptedAlgorithms            ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256

    # Disable legacy / insecure options
    EnableSSHKeysign                    no
    NoHostAuthenticationForLocalhost    no
    PasswordAuthentication              no
    ChallengeResponseAuthentication     no
    GSSAPIAuthentication                no
    GSSAPIDelegateCredentials           no
    KbdInteractiveAuthentication        no
    BatchMode                           no

    # Roaming (security fix)
    UseRoaming                          no

    # ── Identity files (global order) ─────────────────────────────────────────
    IdentityFile                        ~/.ssh/id_ed25519
    IdentityFile                        ~/.ssh/id_rsa
    IdentityFile                        ~/.ssh/id_ecdsa

    # ── Hash known hosts (privacy) ────────────────────────────────────────────
    HashKnownHosts                      yes

    # ── Logging ───────────────────────────────────────────────────────────────
    LogLevel                            ERROR

    # ── Visual host key fingerprint ───────────────────────────────────────────
    VisualHostKey                       yes

    # ── Escape character ──────────────────────────────────────────────────────
    EscapeChar                          ~

    # ── Terminal ──────────────────────────────────────────────────────────────
    RequestTTY                          auto
    SendEnv                             LANG LC_*

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🏠  LOCALHOST — Relaxed settings
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Host localhost 127.0.0.1 ::1
    StrictHostKeyChecking               no
    UserKnownHostsFile                  /dev/null
    LogLevel                            QUIET
    NoHostAuthenticationForLocalhost    yes

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🔗  GITHUB — Optimized
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Host github.com
    HostName                            github.com
    User                                git
    IdentityFile                        ~/.ssh/id_ed25519_github
    IdentitiesOnly                      yes
    PreferredAuthentications            publickey
    AddKeysToAgent                      yes
    ServerAliveInterval                 60
    # Avoid DNS lookup (faster)
    # StrictHostKeyChecking             yes

Host gist.github.com
    HostName                            gist.github.com
    User                                git
    IdentityFile                        ~/.ssh/id_ed25519_github
    IdentitiesOnly                      yes

# GitHub Actions / CI (separate key)
Host github-actions
    HostName                            github.com
    User                                git
    IdentityFile                        ~/.ssh/id_ed25519_github_ci
    IdentitiesOnly                      yes

