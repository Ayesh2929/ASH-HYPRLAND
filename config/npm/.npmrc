# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  🔥 ASH DOTFILES v5.0 OMEGA — NPM CONFIG ULTRA                             ║
# ║  📦 Registry • Cache • Security • Performance • Prefix • Audit             ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
#
# Locations npm reads this file from (in priority order):
#   1. Per-project:  .npmrc  (in project root)
#   2. Per-user:     ~/.config/npm/.npmrc  or  ~/.npmrc
#   3. Global:       /etc/npmrc  (set with --globalconfig)
#   4. Built-in:     /usr/lib/node_modules/npm/npmrc
#
# View current config: npm config list
# Edit this file:      npm config edit
# Set a value:         npm config set KEY=VALUE
# Unset a value:       npm config delete KEY

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🌐  REGISTRY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Primary registry (official npm registry)
registry=https://registry.npmjs.org/

# ── Scoped registries ─────────────────────────────────────────────────────────
# Route scoped packages to different registries

# Example: private org packages
# @myorg:registry=https://npm.pkg.github.com/
# //npm.pkg.github.com/:_authToken=${NPM_GITHUB_TOKEN}

# Example: corporate registry
# @corp:registry=https://registry.corp.example.com/
# //registry.corp.example.com/:_authToken=${NPM_CORP_TOKEN}

# Example: GitHub Package Registry for a specific org
# @github-org:registry=https://npm.pkg.github.com/
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🔑  AUTHENTICATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# npm auth token (set with: npm login or npm config set //registry.npmjs.org/:_authToken TOKEN)
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Strict SSL (NEVER disable in production)
strict-ssl=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📁  PATHS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Global install prefix (where global packages are installed)
# Default on Linux: /usr
# Set to user dir to avoid sudo: ~/.local
prefix=${HOME}/.local

# Cache directory (where npm stores downloaded packages)
cache=${HOME}/.cache/npm

# Store downloaded tarballs here
# store-dir=${HOME}/.local/share/pnpm  # (for pnpm)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ⚡  PERFORMANCE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Maximum number of simultaneous network requests
maxsockets=50

# Fetch retry count
fetch-retries=5

# Fetch retry factor (exponential backoff multiplier)
fetch-retry-factor=2

# Fetch retry minimum timeout (ms)
fetch-retry-mintimeout=10000

# Fetch retry maximum timeout (ms)
fetch-retry-maxtimeout=60000

# Fetch timeout (ms)
fetch-timeout=300000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📦  INSTALL BEHAVIOUR
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Save exact versions (no ^ or ~ in package.json)
save-exact=false

# Save prefix (^ for compatible, ~ for patch, '' for exact)
save-prefix=^

# Don't save to package.json by default
# save=false

# Prefer offline installs (use cache if available)
prefer-offline=true

# Audit level: none | info | low | moderate | high | critical
# This controls which audit issues are reported as errors during install
audit-level=moderate

# Auto-run audit after install
# (set to false for faster installs, run manually: npm audit)
# audit=true

# Automatically install peer dependencies
# Options: auto | legacy | false
legacy-peer-deps=false

# Package lock
# package-lock=true

# Lockfile version
# lockfile-version=3

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🔒  SECURITY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Ignore scripts (don't run package scripts: install, postinstall, etc.)
# Enable for security-sensitive environments
# ignore-scripts=false

# Signature verification (npm 8+)
# verify-signatures=true

# Disable telemetry / data collection
# (this is for npm, not notarize)
ci=false

# Don't send usage metrics to npm
# Usage metrics: https://docs.npmjs.com/cli/v10/using-npm/config#send-metrics
# send-metrics=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🎨  OUTPUT & DISPLAY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Log level: silent | error | warn | notice | http | timing | info | verbose | silly
loglevel=warn

# Color output
color=true

# Progress bar: true | false
progress=true

# Unicode in output
unicode=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🛠️  SCRIPTS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Script shell (default: sh on Unix, cmd on Windows)
# script-shell=/bin/fish

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📋  PACKAGE INIT DEFAULTS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Default values for npm init
init-author-name=Your Name
init-author-email=you@example.com
init-author-url=https://github.com/your-username
init-license=MIT
init-version=0.1.0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📋  VERSION MANAGEMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Tag when publishing (npm publish)
tag=latest

# Sign git tags when running npm version
# sign-git-tag=true

# Commit message for npm version
# message=chore: bump version to v%s

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🌐  PROXY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# HTTP/HTTPS proxy (if behind corporate proxy)
# proxy=http://proxy.corp.example.com:8080
# https-proxy=http://proxy.corp.example.com:8080
# no-proxy=localhost,127.0.0.1,.internal.example.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🔧  NODE-GYP / NATIVE MODULES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Node.js headers download URL (for native module compilation)
# nodedir=/usr/include/node

# Python version for node-gyp
# python=/usr/bin/python3

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📊  ENGINE CHECKS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Strict engine version checking (fail if engines field mismatch)
engine-strict=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🧩  WORKSPACES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Workspaces mode: include | exclude | only
# workspaces=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📋  PNPM SPECIFIC (if using pnpm)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# pnpm reads .npmrc for registry settings
# Additional pnpm config in ~/.config/pnpm/rc or .npmrc:
#
# auto-install-peers=true
# dedupe-peer-dependents=true
# resolution-mode=highest
# hoist=true
# hoist-pattern[]=*eslint*
# hoist-pattern[]=*prettier*
# public-hoist-pattern[]=*
# shamefully-hoist=false
# strict-peer-dependencies=false
# prefer-workspace-packages=false
# link-workspace-packages=true
# prefer-frozen-lockfile=true
# recursive-install=true
# reporter=default
# node-linker=hoisted
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📋  BUN SPECIFIC (if using bun)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Bun reads ~/.bunfig.toml for its config
# Registry config in .npmrc is also respected by bun
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📋  YARN SPECIFIC (if using yarn)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Yarn (Berry) reads .yarnrc.yml for its config
# Yarn Classic reads .npmrc for some settings
# Registry config is respected by both