# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  👥  PEER 04 — Another device (mobile phone, laptop, etc.)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# [Peer]
# # Name: Phone (Pixel 8 Pro)
# PublicKey = <PHONE_PUBLIC_KEY>
# AllowedIPs = 10.8.0.5/32
# # No endpoint needed — phone connects outbound
# # No keepalive — battery optimization
