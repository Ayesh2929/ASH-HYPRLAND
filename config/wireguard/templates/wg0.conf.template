# PublicKey = <HOMELAB_PUBLIC_KEY>
# PresharedKey = <HOMELAB_PSK>
# Endpoint = <HOMELAB_PUBLIC_IP>:51821
# # Only route homelab subnet through this peer
# AllowedIPs = 10.8.0.1/32, 192.168.1.0/24
