#  🔧  MISC
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Work directory for Go workspace mode (go work)
# GOWORK=off  # Disable workspace mode
# GOWORK=/home/user/projects/go.work  # Use specific workspace file

# Install suffix for go install (for different build tags)
GOINSECURE=

# Module mode
# "mod"    = use module-aware mode (default)
# "vendor" = use vendor directory
# "off"    = fail if module is needed
GOFLAGS=-mod=mod
