ncmpcpp_directory                   = ~/.config/ncmpcpp
lyrics_directory                    = ~/.local/share/ncmpcpp/lyrics
visualizer_fifo_path                = /tmp/mpd.fifo
visualizer_output_name              = mpd_visualizer

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  🎨  COLORS — ASH CATPPUCCIN MOCHA
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

colors_enabled                      = yes

# ── Base colors ───────────────────────────────────────
color1                              = white
color2                              = cyan

# ── Main window ───────────────────────────────────────
main_window_color                   = white

# ── Header ────────────────────────────────────────────
header_window_color                 = cyan
header_visibility                   = yes

# ── Status bar ────────────────────────────────────────
statusbar_color                     = cyan
statusbar_visibility                = yes
statusbar_time_color                = default

# ── Progress bar ──────────────────────────────────────
progressbar_color                   = black
progressbar_elapsed_color           = cyan
progressbar_look                    = ▃▃▃

# ── Player state colors ───────────────────────────────
player_state_color                  = cyan
alternative_ui_separator_color      = black

# ── Active column ─────────────────────────────────────
active_column_color                 = cyan

# ── Volume ────────────────────────────────────────────
volume_color                        = cyan

# ── Visualizer ────────────────────────────────────────
visualizer_color                    = cyan,magenta,white,blue,green

# ── State flags color ─────────────────────────────────
state_line_color                    = black
state_flags_color                   = cyan

# ── Song highlighting ─────────────────────────────────
current_item_prefix                 = $(cyan)$r
current_item_suffix                 = $/r$(end)
current_item_inactive_column_prefix = $(white)$r
current_item_inactive_column_suffix = $/r$(end)

# ── Browser sort ──────────────────────────────────────
browser_sort_mode                   = name
browser_sort_format                 = {%a - }{%t}|{%f} {%l}

# ── Tag editor ────────────────────────────────────────
tag_editor_extended_numeration      = no

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  📝  SONG FORMAT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Song format for playlist view
song_list_format                    = {$4%a $8⟩$9 }{$2%t$9}|{$8%f$9} $R{$3[%b]$9 }{$5(%l)$9}

# Song format for status bar (now playing)
song_status_bar_format              = {%t}|{%f} $R {%a}  {[%b]}  {(%l)}

# Song format for window title
song_window_title_format            = {%a - }{%t}|{%f}

# Song format for library
song_library_format                 = {%n. }{%t}|{%f}

# Song format for columns
song_columns_list_format            = (20)[cyan]{a} (6f)[green]{NE} (50)[white]{t|f:Title} (20)[magenta]{b} (7f)[cyan]{l}

# Alternative format
alternative_header_first_line_format  = $b$0$aqqu$/a $2{%t}|{%f}$/b $0$atqq$/a
alternative_header_second_line_format = {{$4$b%a$/b$9}{ ⟩ $3%b$9}{ ⟩ [$5%y$9]}}|{%D}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
