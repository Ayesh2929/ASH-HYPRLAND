user_interface                      = alternative

# Alternative UI: progressbar height
alternative_ui_separator            = ─

# Visualizer type: spectrum | wave | wave_filled | ellipse
visualizer_type                     = spectrum

# Visualizer — show FPS counter
visualizer_fps                      = 60

# Visualizer — look
visualizer_look                     = ●▉

# Visualizer — autoscale
visualizer_autoscale                = yes

# Visualizer — mono mode (sum L+R)
visualizer_in_stereo                = yes

# Visualizer — spectrum smoothing
visualizer_spectrum_smooth_look     = yes

# Visualizer — peak color
visualizer_spectrum_peak_color      = magenta

# Visualizer — gain
visualizer_gain                     = 10

# Header: show bitrate in status bar
