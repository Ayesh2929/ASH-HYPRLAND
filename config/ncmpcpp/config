# Timestamps
clock_display_seconds               = yes

# Tab size
tab_size                            = 4

# Seek time step (seconds)
seek_time                           = 2

# Volume change step
volume_change_step                  = 2

# Autocenter
autocenter_mode                     = yes

# Center during play
centered_cursor                     = yes

# Follow now playing in library
follow_now_playing_lyrics           = yes

# Fetch lyrics in background
fetch_lyrics_in_background          = yes

# Show lyrics in status bar (bottom)
lyrics_db                           = 1

# External lyrics editor
external_editor                     = nvim

# Use external editor for lyrics
use_console_editor                  = yes

