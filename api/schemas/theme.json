{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ash-dotfiles.dev/schemas/api-theme.json",
  "title": "ASH API Theme (request/response)",
  "type": "object",
  "required": [
    "name",
    "colors"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "variant": {
      "type": "string",
      "enum": [
        "dark",
        "light"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "colors": {
      "type": "object",
      "required": [
        "base",
        "mantle",
        "crust",
        "surface",
        "overlay",
        "text",
        "subtext",
        "accent",
        "mint",
        "sky",
        "gold",
        "rose",
        "violet"
      ],
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "mantle": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "crust": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "overlay": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "subtext": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "mint": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "sky": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "gold": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "rose": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "violet": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}