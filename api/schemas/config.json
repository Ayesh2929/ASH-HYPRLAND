{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ash-dotfiles.dev/schemas/api-config.json",
  "title": "ASH Effective Config",
  "type": "object",
  "required": [
    "paths",
    "counts"
  ],
  "properties": {
    "paths": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "themes": {
          "type": "string"
        },
        "plugins": {
          "type": "string"
        },
        "snapshots": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "themes": {
          "type": "integer",
          "minimum": 0
        },
        "plugins": {
          "type": "integer",
          "minimum": 0
        },
        "snapshots": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": true
}